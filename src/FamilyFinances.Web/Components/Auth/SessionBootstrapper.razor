@using System.Net.Http.Json
@using FamilyFinances.Web.Auth
@using Microsoft.JSInterop
@inject IApiTokenStore TokenStore
@inject JwtAuthStateProvider AuthProvider
@inject ISessionInitializationService SessionInit
@inject ILogger<SessionBootstrapper> Logger
@inject IJSRuntime JS

<script>
    window.sessionHelper = {
        hasActiveSession: function() {
            return sessionStorage.getItem('ff_session_active') === 'true';
        },
        
        markSessionActive: function() {
            sessionStorage.setItem('ff_session_active', 'true');
        },
        
        clearSessionActive: function() {
            sessionStorage.removeItem('ff_session_active');
        },
        
        getSession: async function () {
            try {
                const response = await fetch('/auth/session', {
                    method: 'GET',
                    credentials: 'include'
                });

                if (response.status === 204 || !response.ok) {
                    return { hasSession: false };
                }

                const data = await response.json();
                return { 
                    hasSession: true, 
                    accessToken: data.accessToken 
                };
            } catch (error) {
                console.error('Session recovery error:', error);
                return { hasSession: false };
            }
        }
    };
</script>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            var currentToken = TokenStore.GetAccessToken();
            if (!string.IsNullOrWhiteSpace(currentToken))
            {
                Logger.LogInformation("SessionBootstrapper: Token already in memory");
                return;
            }

            // Only recover session if there's an active session flag in sessionStorage
            // This flag is cleared when the browser tab is closed, differentiating "fresh start" from "F5 reload"
            var hasActiveSession = await JS.InvokeAsync<bool>("sessionHelper.hasActiveSession");
            
            if (!hasActiveSession)
            {
                Logger.LogInformation("SessionBootstrapper: No active session flag, requiring fresh login");
                return;
            }

            var result = await JS.InvokeAsync<SessionResult>("sessionHelper.getSession");

            if (!result.HasSession || string.IsNullOrWhiteSpace(result.AccessToken))
            {
                await JS.InvokeVoidAsync("sessionHelper.clearSessionActive");
                return;
            }

            Logger.LogInformation("SessionBootstrapper: Session recovered successfully");
            
            TokenStore.SetAccessToken(result.AccessToken);
            await AuthProvider.RefreshAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "SessionBootstrapper: Error during session recovery");
        }
        finally
        {
            SessionInit.MarkAsInitialized();
        }
    }

    private sealed class SessionResult
    {
        public bool HasSession { get; set; }
        public string? AccessToken { get; set; }
    }
}
