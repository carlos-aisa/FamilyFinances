@using System.Net.Http.Json
@using FamilyFinances.Web.Auth
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Nav
@inject IApiTokenStore TokenStore
@inject JwtAuthStateProvider AuthProvider

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        // If we already have a token in memory, skip
        if (!string.IsNullOrWhiteSpace(TokenStore.GetAccessToken()))
        {
            return;
        }

        // Call /auth/session endpoint to get token from HttpOnly cookie
        var http = HttpClientFactory.CreateClient();
        var url = new Uri(new Uri(Nav.BaseUri), "auth/session");

        try
        {
            var response = await http.GetAsync(url);
            if (!response.IsSuccessStatusCode)
            {
                return;
            }

            var payload = await response.Content.ReadFromJsonAsync<SessionResponse>();
            if (payload is null || string.IsNullOrWhiteSpace(payload.AccessToken))
            {
                return;
            }

            TokenStore.SetAccessToken(payload.AccessToken);
            await AuthProvider.RefreshAsync();
        }
        catch
        {
            // Silently fail - user is not authenticated
        }
    }

    private sealed class SessionResponse
    {
        public string AccessToken { get; set; } = "";
    }
}
