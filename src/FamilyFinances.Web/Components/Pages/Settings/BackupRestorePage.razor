@page "/settings/backup-restore"
@rendermode InteractiveServer
@using FamilyFinances.Application.Operations.BackupRestore.Dtos
@using FamilyFinances.Web.Api
@using FamilyFinances.Web.Components.Base
@using Microsoft.Extensions.Localization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using FamilyFinances.Web
@inherits ApiPageBase

@inject BackupApi BackupApi
@inject IJSRuntime JS
@inject ILogger<BackupRestorePage> Logger
@inject IStringLocalizer<SharedResource> L

<AuthorizeView Roles="Admin">
    <Authorized>
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <h3 class="mb-1">
                    <i class="bi bi-shield-lock me-2"></i>@L["BackupRestore_Title"]
                </h3>
                <p class="text-muted mb-0">@L["BackupRestore_Subtitle"]</p>
            </div>
            <a class="btn btn-outline-secondary" href="/settings">
                <i class="bi bi-arrow-left me-1"></i>@L["BackupRestore_BackToSettings"]
            </a>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-header fw-semibold">@L["BackupRestore_SafetyNotice_Title"]</div>
            <div class="card-body">
                <ul class="mb-0">
                    <li>@L["BackupRestore_SafetyNotice_Line1"]</li>
                    <li>@L["BackupRestore_SafetyNotice_Line2"]</li>
                    <li>@L["BackupRestore_SafetyNotice_Line3"]</li>
                </ul>
            </div>
        </div>

        <div class="card shadow-sm mb-4" data-testid="backup-restore-database-path-card">
            <div class="card-header fw-semibold">@L["BackupRestore_DatabasePath_Title"]</div>
            <div class="card-body">
                <p class="text-muted mb-2">@L["BackupRestore_DatabasePath_Description"]</p>
                <div class="font-monospace small text-break" data-testid="backup-restore-database-path">
                    @(string.IsNullOrWhiteSpace(_databaseFilePath)
                        ? L["BackupRestore_DatabasePath_Unavailable"]
                        : _databaseFilePath)
                </div>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(_successMessage))
        {
            <div class="alert alert-success" role="alert" data-testid="backup-restore-success">
                <i class="bi bi-check-circle me-2"></i>@_successMessage
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="alert alert-danger" role="alert" data-testid="backup-restore-error">
                <i class="bi bi-exclamation-triangle me-2"></i>@_errorMessage
            </div>
        }

        <div class="row g-4">
            <div class="col-12 col-xl-5">
                <div class="card shadow-sm h-100">
                    <div class="card-header fw-semibold">@L["BackupRestore_CreateBackup_CardTitle"]</div>
                    <div class="card-body d-flex flex-column">
                        <p class="text-muted">
                            @L["BackupRestore_CreateBackup_Description"]
                        </p>
                        <button class="btn btn-primary mt-auto"
                                @onclick="CreateBackupAsync"
                                disabled="@IsBusy"
                                data-testid="backup-restore-create-button">
                            @if (_isExporting)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            }
                            else
                            {
                                <i class="bi bi-download me-1"></i>
                            }
                            @L["BackupRestore_CreateBackup_Button"]
                        </button>

                        @if (_lastBackupCreatedAtUtc is not null)
                        {
                            <small class="text-muted mt-2">
                                @L["BackupRestore_CreateBackup_LastExport", _lastBackupCreatedAtUtc.Value.ToString("yyyy-MM-dd HH:mm:ss 'UTC'")]
                            </small>
                        }
                    </div>
                </div>
            </div>

            <div class="col-12 col-xl-7">
                <div class="card shadow-sm h-100">
                    <div class="card-header fw-semibold">@L["BackupRestore_Restore_CardTitle"]</div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label fw-semibold" for="restore-file-input">@L["BackupRestore_Restore_FileLabel"]</label>
                            <InputFile id="restore-file-input"
                                       class="form-control"
                                       OnChange="OnRestoreFileSelectedAsync"
                                       accept=".ffbackup"
                                       disabled="@IsBusy"
                                       data-testid="backup-restore-file-input" />
                        </div>

                        @if (!string.IsNullOrWhiteSpace(_selectedFileName))
                        {
                            <p class="mb-3">
                                <span class="badge bg-secondary-subtle text-secondary-emphasis">@L["BackupRestore_Restore_SelectedFile", _selectedFileName!]</span>
                            </p>
                        }

                        @if (_isPrechecking)
                        {
                            <div class="alert alert-info py-2">
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                @L["BackupRestore_Restore_PrecheckRunning"]
                            </div>
                        }
                        else if (_precheckResult is not null)
                        {
                            <div class="border rounded p-3 mb-3" data-testid="backup-restore-precheck-summary">
                                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
                                    <strong>@L["BackupRestore_Restore_PrecheckResult"]</strong>
                                    <span class="badge @(_precheckResult.IsCompatible ? "bg-success" : "bg-danger")">
                                        @(_precheckResult.IsCompatible ? L["BackupRestore_Restore_Compatible"] : L["BackupRestore_Restore_Incompatible"])
                                    </span>
                                </div>
                                <dl class="row mb-0 small">
                                    <dt class="col-sm-5">@L["BackupRestore_Restore_FormatVersion"]</dt>
                                    <dd class="col-sm-7">@(_precheckResult.FormatVersion ?? "-")</dd>
                                    <dt class="col-sm-5">@L["BackupRestore_Restore_SourceAppVersion"]</dt>
                                    <dd class="col-sm-7">@(_precheckResult.SourceAppVersion ?? "-")</dd>
                                    <dt class="col-sm-5">@L["BackupRestore_Restore_CreatedAtUtc"]</dt>
                                    <dd class="col-sm-7">@(_precheckResult.CreatedAtUtc?.ToString("yyyy-MM-dd HH:mm:ss 'UTC'") ?? "-")</dd>
                                    <dt class="col-sm-5">@L["BackupRestore_Restore_SourceMigration"]</dt>
                                    <dd class="col-sm-7">@(_precheckResult.SourceMigration ?? "-")</dd>
                                </dl>

                                @if (_precheckResult.Errors.Count > 0)
                                {
                                    <div class="mt-3">
                                        <strong class="text-danger d-block mb-1">@L["BackupRestore_Restore_Errors"]</strong>
                                        <ul class="mb-0">
                                            @foreach (var error in _precheckResult.Errors)
                                            {
                                                <li class="text-danger">@error</li>
                                            }
                                        </ul>
                                    </div>
                                }

                                @if (_precheckResult.Warnings.Count > 0)
                                {
                                    <div class="mt-3">
                                        <strong class="text-warning d-block mb-1">@L["BackupRestore_Restore_Warnings"]</strong>
                                        <ul class="mb-0">
                                            @foreach (var warning in _precheckResult.Warnings)
                                            {
                                                <li>@warning</li>
                                            }
                                        </ul>
                                    </div>
                                }
                            </div>
                        }

                        <div class="mb-3">
                            <label class="form-label fw-semibold">@L["BackupRestore_Restore_ConfirmationLabel"]</label>
                            <input class="form-control"
                                   type="text"
                                   placeholder="@L["BackupRestore_Restore_ConfirmationPlaceholder"]"
                                   @bind="_restoreConfirmationText"
                                   disabled="@IsBusy"
                                   data-testid="backup-restore-confirmation-input" />
                            <small class="text-muted">@L["BackupRestore_Restore_ConfirmationHint"]</small>
                        </div>

                        <button class="btn btn-danger"
                                @onclick="ApplyRestoreAsync"
                                disabled="@(!CanApplyRestore)"
                                data-testid="backup-restore-apply-button">
                            @if (_isApplying)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            }
                            else
                            {
                                <i class="bi bi-arrow-repeat me-1"></i>
                            }
                            @L["BackupRestore_Restore_ApplyButton"]
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm mt-4">
            <div class="card-header fw-semibold">@L["BackupRestore_OperationLog_Title"]</div>
            <div class="card-body">
                @if (_operationLog.Count == 0)
                {
                    <p class="text-muted mb-0">@L["BackupRestore_OperationLog_Empty"]</p>
                }
                else
                {
                    <ul class="mb-0">
                        @foreach (var entry in _operationLog)
                        {
                            <li>@entry</li>
                        }
                    </ul>
                }
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle me-2"></i>
            @L["BackupRestore_NotAuthorized"]
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private const long MaxUploadSizeBytes = 209_715_200; // 200 MB

    private readonly List<string> _operationLog = [];
    private RestorePrecheckResultDto? _precheckResult;
    private IBrowserFile? _selectedFile;
    private string? _selectedFileName;
    private string _restoreConfirmationText = string.Empty;
    private string? _successMessage;
    private string? _errorMessage;
    private string? _databaseFilePath;
    private DateTimeOffset? _lastBackupCreatedAtUtc;
    private bool _isExporting;
    private bool _isPrechecking;
    private bool _isApplying;

    private bool IsBusy => _isExporting || _isPrechecking || _isApplying;

    private bool CanApplyRestore =>
        !IsBusy &&
        _selectedFile is not null &&
        _precheckResult?.IsCompatible == true &&
        string.Equals(_restoreConfirmationText, "RESTORE", StringComparison.Ordinal);

    protected override async Task OnInitializedAsync()
    {
        var databaseInfo = await ExecuteApiAsync(ct => BackupApi.GetDatabaseInfoAsync(ct));
        _databaseFilePath = databaseInfo?.DatabaseFilePath;
    }

    private async Task CreateBackupAsync()
    {
        _isExporting = true;
        ClearMessages();

        try
        {
            var download = await ExecuteApiAsync(ct => BackupApi.ExportBackupAsync(ct));
            if (download is null)
                return;

            await using var contentStream = new MemoryStream(download.Content);
            using var streamReference = new DotNetStreamReference(contentStream);
            await JS.InvokeVoidAsync(
                "familyFinancesCharts.downloadStreamFile",
                download.FileName,
                download.ContentType,
                streamReference);

            _lastBackupCreatedAtUtc = DateTimeOffset.UtcNow;
            _successMessage = L["BackupRestore_Success_BackupCreated", download.FileName];
            AddLog(L["BackupRestore_Log_BackupCreated", download.FileName]);
        }
        catch (BackupApiException ex)
        {
            HandleBackupApiException(ex);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Backup export failed unexpectedly.");
            _errorMessage = L["BackupRestore_Error_BackupExportFailed", ex.Message];
            AddLog(L["BackupRestore_Log_BackupExportFailed", ex.Message]);
        }
        finally
        {
            _isExporting = false;
        }
    }

    private async Task OnRestoreFileSelectedAsync(InputFileChangeEventArgs eventArgs)
    {
        ClearMessages();
        _precheckResult = null;
        _restoreConfirmationText = string.Empty;

        var file = eventArgs.File;
        if (file is null)
        {
            _selectedFile = null;
            _selectedFileName = null;
            return;
        }

        _selectedFile = file;
        _selectedFileName = file.Name;

        if (!file.Name.EndsWith(".ffbackup", StringComparison.OrdinalIgnoreCase))
        {
            _selectedFile = null;
            _precheckResult = null;
            _errorMessage = L["BackupRestore_Error_InvalidFileExtension"];
            AddLog(L["BackupRestore_Log_InvalidFileExtension"]);
            return;
        }

        if (file.Size <= 0)
        {
            _selectedFile = null;
            _precheckResult = null;
            _errorMessage = L["BackupRestore_Error_EmptyFile"];
            AddLog(L["BackupRestore_Log_EmptyFile"]);
            return;
        }

        if (file.Size > MaxUploadSizeBytes)
        {
            _selectedFile = null;
            _precheckResult = null;
            _errorMessage = L["BackupRestore_Error_FileTooLarge"];
            AddLog(L["BackupRestore_Log_FileTooLarge"]);
            return;
        }

        await RunPrecheckAsync();
    }

    private async Task RunPrecheckAsync()
    {
        if (_selectedFile is null)
            return;

        _isPrechecking = true;
        ClearMessages();

        try
        {
            var precheck = await ExecuteApiAsync(ct => BackupApi.PrecheckRestoreAsync(_selectedFile, ct));
            if (precheck is null)
                return;

            _precheckResult = precheck;

            if (_precheckResult.IsCompatible)
            {
                _successMessage = L["BackupRestore_Success_PrecheckPassed"];
                AddLog(L["BackupRestore_Log_PrecheckPassed"]);
            }
            else
            {
                _errorMessage = BuildErrorMessage(
                    L["BackupRestore_Error_PrecheckFailed"],
                    _precheckResult.Errors);
                AddLog(L["BackupRestore_Log_PrecheckFailed"]);
            }
        }
        catch (BackupApiException ex)
        {
            HandleBackupApiException(ex);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Restore pre-check failed unexpectedly.");
            _errorMessage = L["BackupRestore_Error_PrecheckUnexpected", ex.Message];
            AddLog(L["BackupRestore_Log_PrecheckUnexpected", ex.Message]);
        }
        finally
        {
            _isPrechecking = false;
        }
    }

    private async Task ApplyRestoreAsync()
    {
        if (!CanApplyRestore || _selectedFile is null)
            return;

        _isApplying = true;
        ClearMessages();

        try
        {
            var result = await ExecuteApiAsync(ct => BackupApi.ApplyRestoreAsync(_selectedFile, ct));
            if (result is null)
                return;

            if (!result.Applied)
            {
                _errorMessage = BuildErrorMessage(L["BackupRestore_Error_ApplyFailed"], result.Errors);
                AddLog(L["BackupRestore_Log_ApplyFailed"]);
                return;
            }

            var appliedAtUtc = result.AppliedAtUtc?.ToString("yyyy-MM-dd HH:mm:ss 'UTC'") ?? "unknown time";
            _successMessage = L["BackupRestore_Success_ApplySucceeded", appliedAtUtc];
            AddLog(L["BackupRestore_Log_ApplySucceeded", appliedAtUtc]);

            if (result.RequiresReauthentication)
            {
                AddLog(L["BackupRestore_Log_RequiresReauthentication"]);
                await ForceReauthenticationAsync();
            }
        }
        catch (BackupApiException ex)
        {
            HandleBackupApiException(ex);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Restore apply failed unexpectedly.");
            _errorMessage = L["BackupRestore_Error_ApplyUnexpected", ex.Message];
            AddLog(L["BackupRestore_Log_ApplyUnexpected", ex.Message]);
        }
        finally
        {
            _isApplying = false;
        }
    }

    private async Task ForceReauthenticationAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("sessionHelper.clearSessionActive");
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Session active flag could not be cleared from JS.");
        }

        var http = HttpClientFactory.CreateClient();
        var url = new Uri(new Uri(Nav.BaseUri), "auth/session");
        await http.DeleteAsync(url);

        TokenStore.Clear();
        await AuthProvider.RefreshAsync();
        Nav.NavigateTo("/login?reason=restore");
    }

    private void HandleBackupApiException(BackupApiException ex)
    {
        if (ex.StatusCode == System.Net.HttpStatusCode.Conflict &&
            string.Equals(ex.Reason, "OperationInProgress", StringComparison.Ordinal))
        {
            _errorMessage = L["BackupRestore_Error_OperationInProgress"];
            AddLog(L["BackupRestore_Log_OperationInProgress"]);
            return;
        }

        _errorMessage = ex.Message;
        AddLog(L["BackupRestore_Log_ApiError", ex.Message]);
    }

    private static string BuildErrorMessage(string prefix, IReadOnlyList<string> errors)
    {
        if (errors.Count == 0)
            return prefix;

        return $"{prefix} {string.Join(" ", errors)}";
    }

    private void AddLog(string message)
    {
        _operationLog.Insert(0, $"[{DateTimeOffset.UtcNow:yyyy-MM-dd HH:mm:ss 'UTC'}] {message}");
    }

    private void ClearMessages()
    {
        _successMessage = null;
        _errorMessage = null;
    }
}
