@page "/settings"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Localization
@using Microsoft.JSInterop
@using FamilyFinances.Web.Features.Localization
@using FamilyFinances.Web.Features.HostOps
@using FamilyFinances.Web

@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> L
@inject ILanHostOperationsService LanHostOps

<AuthorizeView>
    <Authorized>
        <div class="d-flex align-items-center justify-content-between mb-4 ff-page-header ff-settings-header">
            <div>
                <h3 class="mb-1 ff-page-title">
                    <i class="bi bi-gear me-2"></i>@L["Settings_Title"]
                </h3>
                <p class="text-muted mb-0 ff-page-subtitle">@L["Settings_Subtitle"]</p>
            </div>
        </div>

        <div class="row g-3 ff-settings-grid">
            <div class="col-12 col-xl-4">
                <div class="card shadow-sm h-100 ff-panel ff-settings-card">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@L["Settings_Appearance_Title"]</h5>
                        <p class="text-muted mb-3">
                            @L["Settings_Appearance_Desc"]
                        </p>

                        <label class="form-label fw-semibold" for="theme-mode-buttons">@L["Settings_ThemeMode_Label"]</label>
                        <div id="theme-mode-buttons" class="btn-group mb-2" role="group" aria-label="@L["Settings_ThemeMode_Aria"]">
                            <button type="button"
                                    class="btn @(GetThemeButtonClass("dark"))"
                                    @onclick="SetDarkThemeAsync"
                                    disabled="@_isThemeBusy"
                                    data-testid="settings-theme-dark">
                                <i class="bi bi-moon me-1"></i>@L["Settings_Theme_Dark"]
                            </button>
                            <button type="button"
                                    class="btn @(GetThemeButtonClass("light"))"
                                    @onclick="SetLightThemeAsync"
                                    disabled="@_isThemeBusy"
                                    data-testid="settings-theme-light">
                                <i class="bi bi-sun me-1"></i>@L["Settings_Theme_Light"]
                            </button>
                        </div>

                        <small class="text-muted">
                            @L["Settings_CurrentMode", CurrentThemeLabel]
                        </small>
                    </div>
                </div>
            </div>

            <div class="col-12 col-xl-4">
                <div class="card shadow-sm h-100 ff-panel ff-settings-card">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@L["Settings_Language_Title"]</h5>
                        <p class="text-muted mb-3">
                            @L["Settings_Language_Desc"]
                        </p>

                        <label class="form-label fw-semibold" for="settings-language-selector">@L["Settings_Language_Label"]</label>
                        <select id="settings-language-selector"
                                class="form-select"
                                aria-label="@L["Settings_Language_Aria"]"
                                value="@_selectedCulture"
                                @onchange="OnCultureChanged"
                                disabled="@_isCultureBusy">
                            <option value="es-ES">@L["Nav_LanguageSpanish"]</option>
                            <option value="en-US">@L["Nav_LanguageEnglish"]</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="col-12 col-xl-4">
                <div class="card shadow-sm h-100 ff-panel ff-settings-card">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@L["Settings_Backup_Title"]</h5>
                        <p class="text-muted mb-3">
                            @L["Settings_Backup_Desc"]
                        </p>
                        <div class="mt-auto">
                            <a class="btn btn-primary" href="/settings/backup-restore">
                                <i class="bi bi-shield-lock me-1"></i>@L["Settings_Backup_OpenButton"]
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <AuthorizeView Roles="Admin" Context="adminCtx">
                <Authorized>
                    <div class="col-12">
                        <div class="card shadow-sm ff-panel ff-settings-card">
                            <div class="card-body">
                                <h5 class="card-title">@L["Settings_Network_Title"]</h5>
                                <p class="text-muted mb-3">@L["Settings_Network_Desc"]</p>

                                @if (!string.IsNullOrWhiteSpace(_networkMessage))
                                {
                                    <div class="alert @(_networkError ? "alert-danger" : "alert-info") mb-3" data-testid="settings-network-message">
                                        @_networkMessage
                                    </div>
                                }

                                <div class="form-check form-switch mb-3">
                                    <input id="settings-lan-toggle"
                                           class="form-check-input"
                                           type="checkbox"
                                           checked="@_lanEnabled"
                                           @onchange="OnLanToggleChanged"
                                           disabled="@(_isNetworkBusy || !_lanOperationsAllowed)"
                                           data-testid="settings-lan-toggle" />
                                    <label class="form-check-label" for="settings-lan-toggle">
                                        @L["Settings_Network_EnableLan"]
                                    </label>
                                </div>

                                <div class="row g-3">
                                    <div class="col-12 col-md-4">
                                        <label class="form-label fw-semibold" for="settings-lan-host">@L["Settings_Network_HostLabel"]</label>
                                        <input id="settings-lan-host"
                                               class="form-control"
                                               value="@_lanHostName"
                                               @onchange="OnLanHostChanged"
                                               disabled="@(_isNetworkBusy || !_lanOperationsAllowed)"
                                               data-testid="settings-lan-host" />
                                    </div>
                                    <div class="col-12 col-md-3">
                                        <label class="form-label fw-semibold" for="settings-lan-port">@L["Settings_Network_PortLabel"]</label>
                                        <input id="settings-lan-port"
                                               class="form-control"
                                               type="number"
                                               min="1025"
                                               max="65535"
                                               value="@_lanPort"
                                               @onchange="OnLanPortChanged"
                                               disabled="@(_isNetworkBusy || !_lanOperationsAllowed)"
                                               data-testid="settings-lan-port" />
                                    </div>
                                    <div class="col-12 col-md-5">
                                        <label class="form-label fw-semibold">@L["Settings_Network_LanUrl"]</label>
                                        <div class="form-control-plaintext" data-testid="settings-lan-url">
                                            @LanUrl
                                        </div>
                                    </div>
                                </div>

                                <div class="mt-3 d-flex gap-2 flex-wrap">
                                    <button type="button"
                                            class="btn btn-primary"
                                            @onclick="ApplyLanSettingsAsync"
                                            disabled="@(_isNetworkBusy || !_lanOperationsAllowed)"
                                            data-testid="settings-network-apply">
                                        @L["Settings_Network_Apply"]
                                    </button>
                                    <button type="button"
                                            class="btn btn-outline-secondary"
                                            @onclick="RegenerateCertificateAsync"
                                            disabled="@(_isNetworkBusy || !_lanOperationsAllowed)"
                                            data-testid="settings-network-regenerate">
                                        @L["Settings_Network_RegenerateCert"]
                                    </button>
                                </div>

                                <div class="small text-muted mt-3" data-testid="settings-network-cert">
                                    @L["Settings_Network_CertThumb", _certificateThumb ?? L["Settings_Network_CertMissing"]]
                                </div>
                                <div class="small text-muted">
                                    @L["Settings_Network_MobileGuide"]
                                </div>
                            </div>
                        </div>
                    </div>
                </Authorized>
            </AuthorizeView>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle me-2"></i>
            @L["Settings_LoginRequired"]
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private string _theme = "dark";
    private bool _isThemeBusy = true;
    private bool _isCultureBusy = true;
    private bool _isNetworkBusy = true;
    private bool _networkError;
    private string? _networkMessage;
    private bool _lanEnabled;
    private int _lanPort = 5443;
    private string _lanHostName = Environment.MachineName;
    private string? _certificateThumb;
    private bool _lanOperationsAllowed = true;
    private string _selectedCulture = WebLocalizationOptions.DefaultCulture;

    private string CurrentThemeLabel => _theme == "light" ? L["Settings_Theme_Light"] : L["Settings_Theme_Dark"];
    private string LanUrl => $"https://{_lanHostName}:{_lanPort}";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await LoadThemeAsync();
        await LoadCultureAsync();
        await LoadLanStatusAsync();

        StateHasChanged();
    }

    private async Task LoadThemeAsync()
    {
        try
        {
            var theme = await JS.InvokeAsync<string>("themeHelper.getTheme");
            _theme = string.Equals(theme, "light", StringComparison.OrdinalIgnoreCase)
                ? "light"
                : "dark";
        }
        catch
        {
            _theme = "dark";
        }
        finally
        {
            _isThemeBusy = false;
        }
    }

    private async Task LoadCultureAsync()
    {
        try
        {
            var persistedCulture = await JS.InvokeAsync<string>("cultureHelper.getCulture");
            _selectedCulture = WebLocalizationOptions.Normalize(persistedCulture);
        }
        catch
        {
            _selectedCulture = WebLocalizationOptions.DefaultCulture;
        }
        finally
        {
            _isCultureBusy = false;
        }
    }

    private async Task LoadLanStatusAsync()
    {
        try
        {
            var status = await LanHostOps.GetStatusAsync();
            _lanEnabled = status.Enabled;
            _lanPort = status.HttpsPort;
            _lanHostName = string.IsNullOrWhiteSpace(status.HostName) ? Environment.MachineName : status.HostName;
            _certificateThumb = status.CertificateThumb;
            _lanOperationsAllowed = !status.AccessLimited;

            if (status.AccessLimited)
            {
                _networkError = true;
                _networkMessage = L["Settings_Network_ElevationRequired"];
            }
            else
            {
                _networkMessage = null;
                _networkError = false;
            }
        }
        catch (Exception)
        {
            _lanOperationsAllowed = false;
            _networkError = true;
            _networkMessage = L["Settings_Network_LoadError"];
        }
        finally
        {
            _isNetworkBusy = false;
        }
    }

    private async Task SetThemeAsync(string theme)
    {
        if (_isThemeBusy || !IsValidTheme(theme) || _theme == theme)
            return;

        _isThemeBusy = true;
        try
        {
            var applied = await JS.InvokeAsync<string>("themeHelper.setTheme", theme);
            _theme = string.Equals(applied, "light", StringComparison.OrdinalIgnoreCase) ? "light" : "dark";
        }
        catch
        {
            // Keep previous state when JS theme helper is unavailable.
        }
        finally
        {
            _isThemeBusy = false;
        }
    }

    private Task SetDarkThemeAsync() => SetThemeAsync("dark");
    private Task SetLightThemeAsync() => SetThemeAsync("light");

    private async Task OnCultureChanged(ChangeEventArgs args)
    {
        if (_isCultureBusy)
            return;

        _isCultureBusy = true;
        var selected = WebLocalizationOptions.Normalize(args.Value?.ToString());

        try
        {
            _selectedCulture = await JS.InvokeAsync<string>("cultureHelper.setCulture", selected);
        }
        catch
        {
            _selectedCulture = selected;
        }
        finally
        {
            _isCultureBusy = false;
        }

        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }

    private Task OnLanToggleChanged(ChangeEventArgs args)
    {
        _lanEnabled = args.Value is bool value && value;
        return Task.CompletedTask;
    }

    private Task OnLanHostChanged(ChangeEventArgs args)
    {
        _lanHostName = string.IsNullOrWhiteSpace(args.Value?.ToString())
            ? Environment.MachineName
            : args.Value!.ToString()!;
        return Task.CompletedTask;
    }

    private Task OnLanPortChanged(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var port))
        {
            _lanPort = port;
        }

        return Task.CompletedTask;
    }

    private async Task ApplyLanSettingsAsync()
    {
        _isNetworkBusy = true;
        _networkMessage = null;
        _networkError = false;

        try
        {
            if (!_lanOperationsAllowed)
            {
                _networkError = true;
                _networkMessage = L["Settings_Network_ElevationRequired"];
                return;
            }

            var result = await LanHostOps.ApplyAsync(
                new LanAccessRequest(_lanEnabled, _lanPort, _lanHostName, false),
                actor: "settings-ui");

            if (!result.Succeeded)
            {
                _networkError = true;
                _networkMessage = result.Message;
                return;
            }

            if (result.Status is not null)
            {
                _lanEnabled = result.Status.Enabled;
                _lanPort = result.Status.HttpsPort;
                _lanHostName = string.IsNullOrWhiteSpace(result.Status.HostName) ? Environment.MachineName : result.Status.HostName;
                _certificateThumb = result.Status.CertificateThumb;
            }

            _networkMessage = L["Settings_Network_ApplySuccess"];
        }
        catch (Exception)
        {
            _networkError = true;
            _networkMessage = L["Settings_Network_ApplyError"];
        }
        finally
        {
            _isNetworkBusy = false;
        }
    }

    private async Task RegenerateCertificateAsync()
    {
        _isNetworkBusy = true;
        _networkMessage = null;
        _networkError = false;

        try
        {
            if (!_lanOperationsAllowed)
            {
                _networkError = true;
                _networkMessage = L["Settings_Network_ElevationRequired"];
                return;
            }

            var result = await LanHostOps.RegenerateCertificateAsync(_lanPort, _lanHostName, "settings-ui");
            if (!result.Succeeded)
            {
                _networkError = true;
                _networkMessage = result.Message;
                return;
            }

            if (result.Status is not null)
            {
                _certificateThumb = result.Status.CertificateThumb;
                _lanEnabled = result.Status.Enabled;
            }

            _networkMessage = L["Settings_Network_RegenerateSuccess"];
        }
        catch (Exception)
        {
            _networkError = true;
            _networkMessage = L["Settings_Network_RegenerateError"];
        }
        finally
        {
            _isNetworkBusy = false;
        }
    }

    private string GetThemeButtonClass(string theme)
    {
        return string.Equals(_theme, theme, StringComparison.Ordinal)
            ? "btn-primary"
            : "btn-outline-secondary";
    }

    private static bool IsValidTheme(string theme)
    {
        return string.Equals(theme, "dark", StringComparison.Ordinal) ||
               string.Equals(theme, "light", StringComparison.Ordinal);
    }
}
