@page "/history/transactions"
@inherits ApiPageBase
@implements IDisposable
@using System.Globalization
@using FamilyFinances.Application.Ledger.Transactions.Dtos
@using FamilyFinances.Web
@using FamilyFinances.Web.Api
@using FamilyFinances.Web.Components.Base
@using FamilyFinances.Web.Components.Pages.Transactions
@using FamilyFinances.Web.Features.Reports
@using FamilyFinances.Web.State
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.Extensions.Localization
@inject HistoryApi HistoryApi
@inject HistoryRefreshNotifier HistoryRefreshNotifier
@inject IStringLocalizer<SharedResource> L

<HistoryTabs />

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-12 col-md-3">
                <label class="form-label fw-semibold">
                    <i class="bi bi-calendar3 me-1"></i>@L["History_Year"]
                </label>
                <InputSelect class="form-select" @bind-Value="_selectedYear" @bind-Value:after="LoadTransactionsAsync">
                    @foreach (var year in _yearOptions)
                    {
                        <option value="@year">@year</option>
                    }
                </InputSelect>
            </div>
            <div class="col-12 col-md-3">
                <button class="btn btn-outline-secondary" @onclick="LoadTransactionsAsync" disabled="@_isBusy">
                    <i class="bi bi-arrow-clockwise me-1"></i>@L["History_Refresh"]
                </button>
            </div>
        </div>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="alert alert-danger">
        <i class="bi bi-exclamation-triangle me-2"></i>@_error
    </div>
}

@if (_isBusy)
{
    <div class="d-flex justify-content-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">@L["Common_Loading"]</span>
        </div>
    </div>
}
else if (_items.Count == 0)
{
    <div class="alert alert-info mb-0">
        <i class="bi bi-info-circle me-2"></i>@L["HistoryTransactions_NoDataForYear", _selectedYear]
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3 ff-w-120">@L["HistoryTransactions_Table_Date"]</th>
                            <th class="ff-w-100">@L["HistoryTransactions_Table_Type"]</th>
                            <th>@L["HistoryTransactions_Table_Description"]</th>
                            <th class="text-end pe-3 ff-w-180">@L["HistoryTransactions_Table_Amount"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in _items)
                        {
                            <tr>
                                <td class="ps-3">
                                    <div class="d-flex flex-column">
                                        <span class="fw-semibold">@item.BookedOn.ToString("dd MMM", CultureInfo.CurrentCulture)</span>
                                        <small class="text-muted">@item.BookedOn.Year</small>
                                    </div>
                                </td>
                                <td>@GetTypeBadge(item.Type)</td>
                                <td>
                                    <div class="d-flex flex-column">
                                        <a class="fw-semibold text-decoration-none"
                                           href='@BuildReadOnlyDetailUrl(item.Id, TransactionOrigin.HistoryTransactions, _selectedYear, null)'>
                                            @item.Headline
                                        </a>
                                        <small class="text-muted">@item.Subheadline</small>
                                    </div>
                                </td>
                                <td class="text-end pe-3">
                                    <span class="badge @GetAmountBadgeClass(item.Type) fs-6 px-3 py-2">
                                        @MoneyFormatter.FormatEuros(item.Amount)
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@code {
    private readonly List<int> _yearOptions = [];
    private readonly List<TransactionListItemDto> _items = [];
    private int _selectedYear = DateTime.Today.Year;
    private bool _isBusy;
    private string? _error;
    private IDisposable? _refreshSubscription;

    protected override async Task OnInitializedAsync()
    {
        ApplyNavigationContext();
        _refreshSubscription = HistoryRefreshNotifier.Subscribe(OnHistoryRefreshRequested);
        await LoadYearsAsync();
        await LoadTransactionsAsync();
    }

    private void ApplyNavigationContext()
    {
        var query = QueryHelpers.ParseQuery(Nav.ToAbsoluteUri(Nav.Uri).Query);
        if (!query.TryGetValue(TransactionOriginContext.YearQueryKey, out var rawYear))
            return;

        if (int.TryParse(rawYear.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var year) && year >= 1)
            _selectedYear = year;
    }

    private async Task LoadYearsAsync()
    {
        await ExecuteApiAsync(async ct =>
        {
            var years = await HistoryApi.ListFiscalYearsAsync(ct);
            _yearOptions.Clear();
            _yearOptions.AddRange(years.Select(x => x.Year).Distinct().OrderByDescending(x => x));

            if (_yearOptions.Count == 0)
                _yearOptions.Add(DateTime.Today.Year);

            if (!_yearOptions.Contains(_selectedYear))
                _selectedYear = _yearOptions[0];
        });
    }

    private async Task LoadTransactionsAsync()
    {
        if (_isBusy)
            return;

        _isBusy = true;
        _error = null;
        _items.Clear();

        try
        {
            await ExecuteApiAsync(async ct =>
            {
                var items = await HistoryApi.ListHistoricalTransactionsAsync(_selectedYear, 1000, ct);
                _items.AddRange(items);
            });
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private RenderFragment GetTypeBadge(TransactionListItemType type) => builder =>
    {
        var (css, text) = type switch
        {
            TransactionListItemType.Expense => ("badge bg-danger-subtle text-danger", L["TransactionType_Expense"].Value),
            TransactionListItemType.Income => ("badge bg-success-subtle text-success", L["TransactionType_Income"].Value),
            TransactionListItemType.Transfer => ("badge bg-primary-subtle text-primary", L["TransactionType_Transfer"].Value),
            TransactionListItemType.Refund => ("badge bg-info-subtle text-info", L["TransactionType_Refund"].Value),
            _ => ("badge bg-secondary-subtle text-secondary", L["TransactionType_Unknown"].Value)
        };

        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", css);
        builder.AddContent(2, text);
        builder.CloseElement();
    };

    private static string GetAmountBadgeClass(TransactionListItemType type) => type switch
    {
        TransactionListItemType.Expense => "bg-danger-subtle text-danger",
        TransactionListItemType.Income => "bg-success-subtle text-success",
        TransactionListItemType.Transfer => "bg-info-subtle text-info",
        TransactionListItemType.Refund => "bg-info-subtle text-info",
        _ => "bg-secondary-subtle text-secondary"
    };

    private static string BuildReadOnlyDetailUrl(
        Guid transactionId,
        TransactionOrigin origin,
        int year,
        Guid? accountId)
    {
        var query = new Dictionary<string, string?>
        {
            [TransactionOriginContext.OriginQueryKey] = origin switch
            {
                TransactionOrigin.HistoryMovements => "history-movements",
                _ => "history-transactions"
            },
            [TransactionOriginContext.YearQueryKey] = year.ToString(CultureInfo.InvariantCulture),
            ["readonly"] = "true"
        };

        if (accountId is not null)
            query[TransactionOriginContext.AccountIdQueryKey] = accountId.Value.ToString();

        return QueryHelpers.AddQueryString($"/transactions/{transactionId}", query);
    }

    private void OnHistoryRefreshRequested()
    {
        _ = InvokeAsync(async () =>
        {
            await LoadYearsAsync();
            await LoadTransactionsAsync();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        _refreshSubscription?.Dispose();
    }
}

