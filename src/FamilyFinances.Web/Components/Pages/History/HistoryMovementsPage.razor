@page "/history/movements"
@inherits ApiPageBase
@implements IDisposable
@using System.Globalization
@using FamilyFinances.Application.Ledger.Accounts.Dtos
@using FamilyFinances.Application.Reporting.Dtos
@using FamilyFinances.Web
@using FamilyFinances.Web.Api
@using FamilyFinances.Web.Components.Base
@using FamilyFinances.Web.Components.Pages.Transactions
@using FamilyFinances.Web.Features.Reports
@using FamilyFinances.Web.State
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.Extensions.Localization
@inject HistoryApi HistoryApi
@inject IAccountsApi AccountsApi
@inject HistoryRefreshNotifier HistoryRefreshNotifier
@inject IStringLocalizer<SharedResource> L

<HistoryTabs />

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-12 col-md-3">
                <label class="form-label fw-semibold">@L["History_Year"]</label>
                <InputSelect class="form-select" @bind-Value="_selectedYear" @bind-Value:after="LoadMovementsAsync">
                    @foreach (var year in _yearOptions)
                    {
                        <option value="@year">@year</option>
                    }
                </InputSelect>
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label fw-semibold">@L["HistoryMovements_Account"]</label>
                <InputSelect class="form-select" @bind-Value="_selectedAccountId" @bind-Value:after="LoadMovementsAsync" disabled="@(!_accounts.Any())">
                    @foreach (var account in _accounts)
                    {
                        <option value="@account.Id">@account.Name</option>
                    }
                </InputSelect>
            </div>
            <div class="col-12 col-md-3">
                <label class="form-label fw-semibold">@L["HistoryMovements_Search"]</label>
                <input type="text" class="form-control" @bind="_searchQuery" @bind:event="oninput" placeholder="@L["HistoryMovements_SearchPlaceholder"]" />
            </div>
            <div class="col-12 col-md-2">
                <button class="btn btn-primary w-100" @onclick="LoadMovementsAsync" disabled="@_isBusy || !_accounts.Any()">
                    <i class="bi bi-search me-1"></i>@L["HistoryMovements_Search"]
                </button>
            </div>
        </div>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="alert alert-danger">
        <i class="bi bi-exclamation-triangle me-2"></i>@_error
    </div>
}

@if (_isBusy)
{
    <div class="d-flex justify-content-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">@L["Common_Loading"]</span>
        </div>
    </div>
}
else if (_movements is null)
{
    <div class="alert alert-info mb-0">
        <i class="bi bi-info-circle me-2"></i>@L["HistoryMovements_SelectAccountToLoad"]
    </div>
}
else if (_movements.Items.Count == 0)
{
    <div class="alert alert-info mb-0">
        <i class="bi bi-info-circle me-2"></i>@L["HistoryMovements_NoData"]
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3 ff-w-120">@L["HistoryMovements_Table_Date"]</th>
                            <th>@L["HistoryMovements_Table_Description"]</th>
                            <th class="ff-w-220">@L["HistoryMovements_Table_Payee"]</th>
                            <th class="ff-w-220">@L["HistoryMovements_Table_Counterparty"]</th>
                            <th class="text-end pe-3 ff-w-160">@L["HistoryMovements_Table_Amount"]</th>
                            <th class="text-end pe-3 ff-w-200">@L["HistoryMovements_Table_RunningBalance"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var movement in _movements.Items)
                        {
                            <tr>
                                <td class="ps-3">
                                    <div class="d-flex flex-column">
                                        <span class="fw-semibold">@movement.BookedOn.ToString("dd MMM", CultureInfo.CurrentCulture)</span>
                                        <small class="text-muted">@movement.BookedOn.Year</small>
                                    </div>
                                </td>
                                <td>
                                    <a class="text-decoration-none"
                                       href='@BuildReadOnlyDetailUrl(movement.TransactionId, TransactionOrigin.HistoryMovements, _selectedYear, _selectedAccountId)'>
                                        @movement.Description
                                    </a>
                                </td>
                                <td>@(string.IsNullOrWhiteSpace(movement.PayeeName) ? "-" : movement.PayeeName)</td>
                                <td>@(string.IsNullOrWhiteSpace(movement.CounterpartyAccountName) ? "-" : movement.CounterpartyAccountName)</td>
                                <td class="text-end pe-3">@MoneyFormatter.FormatEuros(movement.SignedAmount)</td>
                                <td class="text-end pe-3 fw-semibold">@MoneyFormatter.FormatEuros(movement.RunningBalance)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@code {
    private readonly List<int> _yearOptions = [];
    private readonly List<AccountDto> _accounts = [];
    private AccountMovementsDto? _movements;
    private int _selectedYear = DateTime.Today.Year;
    private Guid _selectedAccountId;
    private bool _isBusy;
    private string _searchQuery = string.Empty;
    private string? _error;
    private IDisposable? _refreshSubscription;

    protected override async Task OnInitializedAsync()
    {
        ApplyNavigationContext();
        _refreshSubscription = HistoryRefreshNotifier.Subscribe(OnHistoryRefreshRequested);
        await LoadFiltersAsync();
        if (_accounts.Count > 0)
            await LoadMovementsAsync();
    }

    private void ApplyNavigationContext()
    {
        var query = QueryHelpers.ParseQuery(Nav.ToAbsoluteUri(Nav.Uri).Query);

        if (query.TryGetValue(TransactionOriginContext.YearQueryKey, out var rawYear) &&
            int.TryParse(rawYear.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var year) &&
            year >= 1)
        {
            _selectedYear = year;
        }

        if (query.TryGetValue(TransactionOriginContext.AccountIdQueryKey, out var rawAccountId) &&
            Guid.TryParse(rawAccountId.ToString(), out var accountId))
        {
            _selectedAccountId = accountId;
        }
    }

    private async Task LoadFiltersAsync()
    {
        await ExecuteApiAsync(async ct =>
        {
            var years = await HistoryApi.ListFiscalYearsAsync(ct);
            _yearOptions.Clear();
            _yearOptions.AddRange(years.Select(x => x.Year).Distinct().OrderByDescending(x => x));

            if (_yearOptions.Count == 0)
                _yearOptions.Add(DateTime.Today.Year);

            if (!_yearOptions.Contains(_selectedYear))
                _selectedYear = _yearOptions[0];

            _accounts.Clear();
            _accounts.AddRange((await AccountsApi.ListAsync(ct))
                .OrderBy(x => x.Nature)
                .ThenBy(x => x.Name));

            if (_accounts.Count > 0 &&
                (_selectedAccountId == Guid.Empty || !_accounts.Any(account => account.Id == _selectedAccountId)))
            {
                _selectedAccountId = _accounts[0].Id;
            }
        });
    }

    private async Task LoadMovementsAsync()
    {
        if (_isBusy || _selectedAccountId == Guid.Empty)
            return;

        _isBusy = true;
        _error = null;
        _movements = null;

        try
        {
            await ExecuteApiAsync(async ct =>
            {
                _movements = await HistoryApi.GetHistoricalMovementsAsync(
                    _selectedAccountId,
                    _selectedYear,
                    string.IsNullOrWhiteSpace(_searchQuery) ? null : _searchQuery.Trim(),
                    1,
                    200,
                    ct);
            });
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private void OnHistoryRefreshRequested()
    {
        _ = InvokeAsync(async () =>
        {
            await LoadFiltersAsync();
            if (_accounts.Count > 0)
                await LoadMovementsAsync();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        _refreshSubscription?.Dispose();
    }

    private static string BuildReadOnlyDetailUrl(
        Guid transactionId,
        TransactionOrigin origin,
        int year,
        Guid? accountId)
    {
        var query = new Dictionary<string, string?>
        {
            [TransactionOriginContext.OriginQueryKey] = origin switch
            {
                TransactionOrigin.HistoryTransactions => "history-transactions",
                _ => "history-movements"
            },
            [TransactionOriginContext.YearQueryKey] = year.ToString(CultureInfo.InvariantCulture),
            ["readonly"] = "true"
        };

        if (accountId is not null)
            query[TransactionOriginContext.AccountIdQueryKey] = accountId.Value.ToString();

        return QueryHelpers.AddQueryString($"/transactions/{transactionId}", query);
    }
}

