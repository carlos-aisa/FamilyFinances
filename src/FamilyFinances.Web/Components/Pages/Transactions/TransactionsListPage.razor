@page "/transactions"
@inherits ApiPageBase
@using FamilyFinances.Application.Ledger.Transactions.Dtos
@using FamilyFinances.Web.Api
@using FamilyFinances.Web.Components.Base
@using System.Globalization
@inject TransactionsApi TransactionsApi

<div class="d-flex align-items-center justify-content-between mb-3">
    <h3 class="m-0">Transactions</h3>
</div>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="alert alert-danger" role="alert">@_error</div>
}

@if (_items is null)
{
    <p>Loading...</p>
}
else if (_items.Count == 0)
{
    <p class="text-muted">No transactions yet.</p>
}
else
{
    <table class="table table-sm align-middle">
        <thead>
            <tr>
                <th style="width: 110px;">Date</th>
                <th>Description</th>
                <th style="width: 140px;" class="text-end">Amount</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in _items)
            {
                <tr>
                    <td>@t.BookedOn</td>
                    <td>
                        <a class="text-decoration-none" href="@($"/transactions/{t.Id}")">
                            <div class="fw-semibold">@t.Headline</div>
                            <div class="text-muted small">@t.Subheadline</div>
                        </a>
                    </td>
                    <td class="text-end fw-semibold">
                        @t.Amount.ToString("C", CultureInfo.CurrentCulture)
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private IReadOnlyList<TransactionListItemDto>? _items;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _error = null;

        try
        {
            await ExecuteApiAsync(async ct =>
            {
                _items = await TransactionsApi.ListAsync(take: 50, ct);
            });
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
}
