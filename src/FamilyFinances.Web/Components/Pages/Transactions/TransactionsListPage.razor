@page "/transactions"
@inherits ApiPageBase
@using FamilyFinances.Application.Ledger.Transactions.Dtos
@using FamilyFinances.Web.Api
@using FamilyFinances.Web.Components.Base
@using System.Globalization
@inject TransactionsApi TransactionsApi

<!-- Header -->
<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h3 class="mb-1">Transactions</h3>
        <p class="text-muted mb-0">
            @if (_items is not null)
            {
                <i class="bi bi-receipt me-1"></i>
                <span>@_items.Count transaction@(_items.Count != 1 ? "s" : "")</span>
            }
        </p>
    </div>

    <div class="d-flex gap-2">
        <button class="btn btn-outline-secondary" @onclick="LoadAsync" disabled="@(_items is null)">
            <i class="bi bi-arrow-clockwise me-1"></i>Refresh
        </button>
        <a class="btn btn-primary" href="/">
            <i class="bi bi-plus-circle me-1"></i>New Transaction
        </a>
    </div>
</div>

<!-- Alerts -->
@if (_result == "deleted")
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2"></i>Transaction deleted successfully.
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-2"></i>@_error
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Content -->
@if (_items is null)
{
    <div class="d-flex justify-content-center align-items-center" style="min-height: 400px;">
        <div class="text-center">
            <div class="spinner-border text-primary mb-3" role="status" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="text-muted">Loading transactions...</p>
        </div>
    </div>
}
else if (_items.Count == 0)
{
    <div class="card shadow-sm">
        <div class="card-body text-center py-5">
            <i class="bi bi-inbox display-1 text-muted mb-3"></i>
            <h5 class="text-muted">No transactions yet</h5>
            <p class="text-muted">Start by creating your first transaction from the dashboard.</p>
            <a class="btn btn-primary mt-3" href="/">
                <i class="bi bi-plus-circle me-1"></i>Go to Dashboard
            </a>
        </div>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="border-0 ps-3" style="width: 120px;">
                                <i class="bi bi-calendar3 me-1"></i>Date
                            </th>
                            <th class="border-0" style="width: 80px;">
                                <i class="bi bi-tag me-1"></i>Type
                            </th>
                            <th class="border-0">
                                <i class="bi bi-file-text me-1"></i>Description
                            </th>
                            <th class="border-0 text-end pe-3" style="width: 160px;">
                                <i class="bi bi-currency-euro me-1"></i>Amount
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in _items)
                        {
                            <tr class="transaction-row" style="cursor: pointer;" @onclick="() => NavigateToDetail(t.Id)">
                                <td class="ps-3">
                                    <div class="d-flex flex-column">
                                        <span class="fw-semibold">@t.BookedOn.ToString("dd MMM", new CultureInfo("es-ES"))</span>
                                        <small class="text-muted">@t.BookedOn.Year</small>
                                    </div>
                                </td>
                                <td>
                                    @GetTypeBadge(t.Type)
                                </td>
                                <td>
                                    <div class="d-flex flex-column">
                                        <span class="fw-semibold text-dark">@t.Headline</span>
                                        <small class="text-muted">@t.Subheadline</small>
                                    </div>
                                </td>
                                <td class="text-end pe-3">
                                    <span class="badge @GetAmountBadgeClass(t.Type) fs-6 px-3 py-2">
                                        @t.Amount.ToString("C", CultureInfo.CurrentCulture)
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        
        <!-- Footer with pagination -->
        <div class="card-footer bg-light">
            <div class="d-flex justify-content-between align-items-center">
                <small class="text-muted">
                    Showing @_items.Count transaction@(_items.Count != 1 ? "s" : "")
                </small>
                @if (_items.Count >= _pageSize)
                {
                    <button class="btn btn-sm btn-primary" @onclick="LoadMoreAsync" disabled="@_isLoadingMore">
                        @if (_isLoadingMore)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                        }
                        else
                        {
                            <i class="bi bi-arrow-down-circle me-1"></i>
                        }
                        Load More
                    </button>
                }
                else
                {
                    <small class="text-muted">
                        <i class="bi bi-info-circle me-1"></i>Click on a transaction to view details
                    </small>
                }
            </div>
        </div>
    </div>
}

<style>
    .transaction-row {
        transition: background-color 0.2s ease-in-out;
    }

    .transaction-row:hover {
        background-color: rgba(13, 110, 253, 0.05) !important;
    }
</style>

@code {
    private IReadOnlyList<TransactionListItemDto>? _items;
    private string? _error;
    private string? _result;
    private bool _isLoadingMore;
    private readonly int _pageSize = 50;

    protected override async Task OnInitializedAsync()
    {
        _result = GetQueryParam("result");
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _error = null;
        _items = null; // Show loading state

        try
        {
            await ExecuteApiAsync(async ct =>
            {
                _items = await TransactionsApi.ListAsync(take: _pageSize, ct);
            });
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _items = Array.Empty<TransactionListItemDto>();
        }
    }

    private async Task LoadMoreAsync()
    {
        if (_isLoadingMore || _items is null)
            return;

        _isLoadingMore = true;
        _error = null;

        try
        {
            await ExecuteApiAsync(async ct =>
            {
                var newItems = await TransactionsApi.ListAsync(take: _items.Count + _pageSize, ct);
                _items = newItems;
            });
        }
        catch (Exception ex)
        {
            _error = $"Failed to load more transactions: {ex.Message}";
        }
        finally
        {
            _isLoadingMore = false;
        }
    }

    private string? GetQueryParam(string key)
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        if (Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query)
            .TryGetValue(key, out var value))
        {
            return value.ToString();
        }

        return null;
    }

    private void NavigateToDetail(Guid transactionId)
    {
        Nav.NavigateTo($"/transactions/{transactionId}");
    }

    private RenderFragment GetTypeBadge(TransactionListItemType type)
    {
        return type switch
        {
            TransactionListItemType.Expense => @<span class="badge bg-danger-subtle text-danger">
                <i class="bi bi-arrow-up-circle me-1"></i>Expense
            </span>,
            TransactionListItemType.Income => @<span class="badge bg-success-subtle text-success">
                <i class="bi bi-arrow-down-circle me-1"></i>Income
            </span>,
            TransactionListItemType.Transfer => @<span class="badge bg-primary-subtle text-primary">
                <i class="bi bi-arrow-left-right me-1"></i>Transfer
            </span>,
            TransactionListItemType.Refund => @<span class="badge bg-info-subtle text-info">
                <i class="bi bi-arrow-counterclockwise me-1"></i>Refund
            </span>,
            _ => @<span class="badge bg-secondary-subtle text-secondary">
                <i class="bi bi-question-circle me-1"></i>Other
            </span>
        };
    }

    private string GetAmountBadgeClass(TransactionListItemType type)
    {
        return type switch
        {
            TransactionListItemType.Expense => "bg-danger-subtle text-danger",
            TransactionListItemType.Income => "bg-success-subtle text-success",
            TransactionListItemType.Transfer => "bg-info-subtle text-info",
            TransactionListItemType.Refund => "bg-info-subtle text-info",
            _ => "bg-secondary-subtle text-secondary"
        };
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender)
            return;

        if (!string.IsNullOrWhiteSpace(_result))
        {
            var cleanUrl = Nav.Uri.Split('?')[0];
            Nav.NavigateTo(cleanUrl, replace: true);
        }
    }
}
