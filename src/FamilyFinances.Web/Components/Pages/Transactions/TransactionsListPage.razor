@page "/transactions"
@inherits ApiPageBase
@using System.Globalization
@using FamilyFinances.Application.Ledger.Transactions.Dtos
@using FamilyFinances.Web.Api
@using FamilyFinances.Web.Components.Base
@using FamilyFinances.Web.Components.Shared
@using FamilyFinances.Web.Features.Reports
@using FamilyFinances.Web
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.Extensions.Localization
@inject TransactionsApi TransactionsApi
@inject IStringLocalizer<SharedResource> L

<!-- Header -->
<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h3 class="mb-1">@L["Transactions_Title"]</h3>
        <p class="text-muted mb-0">
            @if (_items is not null)
            {
                <i class="bi bi-receipt me-1"></i>
                <span>@GetCountLabel(_items.Count)</span>
            }
        </p>
    </div>

    <div class="d-flex gap-2">
        <button class="btn btn-outline-secondary" @onclick="LoadAsync" disabled="@(_items is null)">
            <i class="bi bi-arrow-clockwise me-1"></i>@L["Transactions_Refresh"]
        </button>
        <div class="btn-group">
            <a class="btn btn-primary" href="/">
                <i class="bi bi-plus-circle me-1"></i>@L["Transactions_NewTransaction"]
            </a>
            <button type="button"
                    class="btn btn-primary dropdown-toggle dropdown-toggle-split"
                    data-bs-toggle="dropdown"
                    aria-expanded="false">
                <span class="visually-hidden">@L["Transactions_ToggleDropdown"]</span>
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
                <li>
                    <a class="dropdown-item" href="/">
                        <i class="bi bi-lightning me-2"></i>@L["Transactions_QuickEntry"]
                    </a>
                </li>
                <li>
                    <a class="dropdown-item" href="/transactions/new">
                        <i class="bi bi-pencil me-2"></i>@L["Transactions_SimpleTransaction"]
                    </a>
                </li>
                <li>
                    <a class="dropdown-item" href="/transactions/new-multi">
                        <i class="bi bi-distribute-vertical me-2"></i>@L["Transactions_MultiSplitTransaction"]
                    </a>
                </li>
            </ul>
        </div>
    </div>
</div>

<!-- Filters Card -->
<div class="card shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-3">
            <!-- Quick Date Presets -->
            <div class="col-12">
                <label class="form-label fw-semibold">
                    <i class="bi bi-calendar-range me-1"></i>@L["Transactions_QuickDateFilter"]
                </label>
                <div class="d-flex flex-wrap gap-2">
                    <DateRangePresets OnPresetSelected="HandlePresetSelected" ActivePreset="@_activePreset" />
                    <button class="btn btn-sm btn-outline-secondary" @onclick="ClearDateFilter">
                        <i class="bi bi-x-circle me-1"></i>@L["DatePreset_AllTime"]
                    </button>
                </div>
            </div>

            <!-- Date Range -->
            <div class="col-12 col-md-4">
                <label class="form-label fw-semibold">
                    <i class="bi bi-calendar3 me-1"></i>@L["Transactions_FromDate"]
                </label>
                <input type="date" class="form-control" @bind="_fromDate" @bind:event="oninput" />
            </div>

            <div class="col-12 col-md-4">
                <label class="form-label fw-semibold">
                    <i class="bi bi-calendar3 me-1"></i>@L["Transactions_ToDate"]
                </label>
                <input type="date" class="form-control" @bind="_toDate" @bind:event="oninput" />
            </div>

            <!-- Search -->
            <div class="col-12 col-md-4">
                <label class="form-label fw-semibold">
                    <i class="bi bi-search me-1"></i>@L["Transactions_Search"]
                </label>
                <input type="text" class="form-control" placeholder="@L["Transactions_SearchPlaceholder"]"
                       @bind="_searchQuery" @bind:event="oninput" />
            </div>

            <div class="col-12 col-md-4">
                <label class="form-label fw-semibold">
                    <i class="bi bi-currency-euro me-1"></i>@L["Transactions_AmountFrom"]
                </label>
                <InputNumber @bind-Value="_amountFrom" class="form-control" step="0.01" />
            </div>

            <div class="col-12 col-md-4">
                <label class="form-label fw-semibold">
                    <i class="bi bi-currency-euro me-1"></i>@L["Transactions_AmountTo"]
                </label>
                <InputNumber @bind-Value="_amountTo" class="form-control" step="0.01" />
            </div>
        </div>

        <div class="mt-3">
            <button class="btn btn-primary" @onclick="ApplyFilters">
                <i class="bi bi-filter me-1"></i>@L["Transactions_ApplyFilters"]
            </button>
            <button class="btn btn-outline-secondary ms-2" @onclick="ResetFilters">
                <i class="bi bi-x-circle me-1"></i>@L["Transactions_Reset"]
            </button>
        </div>
    </div>
</div>

<!-- Alerts -->
@if (_result == "deleted")
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2"></i>@L["Transactions_DeletedSuccess"]
        <button type="button" class="btn-close" @onclick="@(() => _result = null)"></button>
    </div>
}
@if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-2"></i>@_error
        <button type="button" class="btn-close" @onclick="@(() => _error = null)"></button>
    </div>
}

<!-- Content -->
@if (_items is null)
{
    <div class="d-flex justify-content-center align-items-center ff-loading-shell">
        <div class="text-center">
            <div class="spinner-border text-primary mb-3 ff-spinner-lg" role="status">
                <span class="visually-hidden">@L["Common_Loading"]</span>
            </div>
            <p class="text-muted">@L["Transactions_LoadingItems"]</p>
        </div>
    </div>
}
else if (_items.Count == 0)
{
    <div class="card shadow-sm">
        <div class="card-body text-center py-5">
            <i class="bi bi-inbox display-1 text-muted mb-3"></i>
            <h5 class="text-muted">@L["Transactions_EmptyTitle"]</h5>
            <p class="text-muted">@L["Transactions_EmptyDescription"]</p>
            <a class="btn btn-primary mt-3" href="/">
                <i class="bi bi-plus-circle me-1"></i>@L["Transactions_GoDashboard"]
            </a>
        </div>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="border-0 ps-3 ff-w-120">
                                <i class="bi bi-calendar3 me-1"></i>@L["Transactions_TableDate"]
                            </th>
                            <th class="border-0 ff-w-80">
                                <i class="bi bi-tag me-1"></i>@L["Transactions_TableType"]
                            </th>
                            <th class="border-0">
                                <i class="bi bi-file-text me-1"></i>@L["Transactions_TableDescription"]
                            </th>
                            <th class="border-0 ff-w-220">
                                <i class="bi bi-person me-1"></i>@L["Transactions_TablePayee"]
                            </th>
                            <th class="border-0 text-end pe-3 ff-w-160">
                                <i class="bi bi-currency-euro me-1"></i>@L["Transactions_TableAmount"]
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in _items)
                        {
                            <tr class="transaction-row ff-clickable" @onclick="() => NavigateToDetail(t.Id)">
                                <td class="ps-3">
                                    <div class="d-flex flex-column">
                                        <span class="fw-semibold">@t.BookedOn.ToString("dd MMM", CultureInfo.CurrentCulture)</span>
                                        <small class="text-muted">@t.BookedOn.Year</small>
                                    </div>
                                </td>
                                <td>
                                    @GetTypeBadge(t.Type)
                                </td>
                                <td>
                                    <div class="d-flex flex-column">
                                        <span class="fw-semibold">@t.Headline</span>
                                        <small class="text-muted">@t.Subheadline</small>
                                    </div>
                                </td>
                                <td>
                                    @if (string.IsNullOrWhiteSpace(t.PayeeName))
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                    else
                                    {
                                        <span>@t.PayeeName</span>
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    <span class="badge @GetAmountBadgeClass(t.Type) fs-6 px-3 py-2">
                                        @t.Amount.ToString("C", CultureInfo.CurrentCulture)
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Footer with pagination -->
        <div class="card-footer bg-light">
            <div class="d-flex justify-content-between align-items-center">
                <small class="text-muted">
                    @GetShowingCountLabel(_items.Count)
                </small>
                @if (_items.Count >= _pageSize && _allItems is not null && _items.Count < _allItems.Count)
                {
                    <button class="btn btn-sm btn-primary" @onclick="LoadMoreAsync" disabled="@_isLoadingMore">
                        @if (_isLoadingMore)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                        }
                        else
                        {
                            <i class="bi bi-arrow-down-circle me-1"></i>
                        }
                        @L["Transactions_LoadMore"]
                    </button>
                }
                else
                {
                    <small class="text-muted">
                        <i class="bi bi-info-circle me-1"></i>@L["Transactions_ClickDetailHint"]
                    </small>
                }
            </div>
        </div>
    </div>
}

<style>
    .transaction-row {
        transition: background-color 0.2s ease-in-out;
    }

    .transaction-row:hover {
        background-color: rgba(13, 110, 253, 0.05) !important;
    }
</style>

@code {
    private IReadOnlyList<TransactionListItemDto>? _items;
    private IReadOnlyList<TransactionListItemDto>? _allItems;
    private string? _error;
    private string? _result;
    private bool _isLoadingMore;
    private readonly int _pageSize = 50;

    private DateOnly? _fromDate;
    private DateOnly? _toDate;
    private string _searchQuery = "";
    private decimal? _amountFrom;
    private decimal? _amountTo;
    private string? _activePreset;

    protected override async Task OnInitializedAsync()
    {
        _result = GetQueryParam("result");
        await LoadAsync();
    }

    private async Task HandlePresetSelected(DateRangePresets.DateRangePreset preset)
    {
        var (from, to) = preset.GetDateRange();
        _fromDate = from;
        _toDate = to;
        _activePreset = preset.Type.ToString().ToLowerInvariant();
        await ApplyFilters();
    }

    private async Task ClearDateFilter()
    {
        _fromDate = null;
        _toDate = null;
        _activePreset = null;
        await ApplyFilters();
    }

    private async Task ApplyFilters()
    {
        if (HasInvalidAmountRange())
        {
            _error = L["Filter_AmountRangeInvalid"];
            return;
        }

        _error = null;
        _items = null;

        try
        {
            await ExecuteApiAsync(async ct =>
            {
                if (_allItems is null)
                {
                    _allItems = await TransactionsApi.ListAsync(take: 1000, ct);
                }

                var filtered = FilterTransactions(_allItems);
                _items = filtered.Take(_pageSize).ToList();
            });
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _items = Array.Empty<TransactionListItemDto>();
        }
    }

    private async Task ResetFilters()
    {
        _fromDate = null;
        _toDate = null;
        _searchQuery = "";
        _amountFrom = null;
        _amountTo = null;
        _activePreset = null;
        await LoadAsync();
    }

    private IReadOnlyList<TransactionListItemDto> FilterTransactions(IReadOnlyList<TransactionListItemDto> items)
    {
        var filtered = items.AsEnumerable();

        if (_fromDate.HasValue)
            filtered = filtered.Where(t => t.BookedOn >= _fromDate.Value);

        if (_toDate.HasValue)
            filtered = filtered.Where(t => t.BookedOn < _toDate.Value);

        if (!string.IsNullOrWhiteSpace(_searchQuery))
        {
                var query = _searchQuery.ToLowerInvariant();
                filtered = filtered.Where(t =>
                    t.Headline.ToLowerInvariant().Contains(query) ||
                    (t.Subheadline?.ToLowerInvariant().Contains(query) ?? false) ||
                    (t.PayeeName?.ToLowerInvariant().Contains(query) ?? false));
        }

        if (_amountFrom.HasValue)
            filtered = filtered.Where(t => t.Amount >= _amountFrom.Value);

        if (_amountTo.HasValue)
            filtered = filtered.Where(t => t.Amount <= _amountTo.Value);

        return filtered.ToList();
    }

    private async Task LoadAsync()
    {
        _error = null;
        _items = null;

        try
        {
            await ExecuteApiAsync(async ct =>
            {
                _allItems = await TransactionsApi.ListAsync(take: 1000, ct);
                _items = _allItems.Take(_pageSize).ToList();
            });
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _items = Array.Empty<TransactionListItemDto>();
        }
    }

    private async Task LoadMoreAsync()
    {
        if (_isLoadingMore || _items is null || _allItems is null)
            return;

        _isLoadingMore = true;
        _error = null;

        try
        {
            await Task.Delay(300);
            var currentCount = _items.Count;
            var hasFilters =
                _fromDate.HasValue ||
                _toDate.HasValue ||
                !string.IsNullOrWhiteSpace(_searchQuery) ||
                _amountFrom.HasValue ||
                _amountTo.HasValue;

            if (hasFilters)
            {
                var filtered = FilterTransactions(_allItems);
                _items = filtered.Take(currentCount + _pageSize).ToList();
            }
            else
            {
                _items = _allItems.Take(currentCount + _pageSize).ToList();
            }
        }
        catch (Exception ex)
        {
            _error = L["Transactions_LoadMoreFailed", ex.Message];
        }
        finally
        {
            _isLoadingMore = false;
        }
    }

    private string? GetQueryParam(string key)
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        if (Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query)
            .TryGetValue(key, out var value))
        {
            return value.ToString();
        }

        return null;
    }

    private bool HasInvalidAmountRange()
        => _amountFrom.HasValue && _amountTo.HasValue && _amountFrom.Value > _amountTo.Value;

    private void NavigateToDetail(Guid transactionId)
    {
        Nav.NavigateTo($"/transactions/{transactionId}");
    }

    private string GetCountLabel(int count)
    {
        return count == 1
            ? L["Transactions_Count_Singular", count]
            : L["Transactions_Count_Plural", count];
    }

    private string GetShowingCountLabel(int count)
    {
        return count == 1
            ? L["Transactions_ShowingCount_Singular", count]
            : L["Transactions_ShowingCount_Plural", count];
    }

    private RenderFragment GetTypeBadge(TransactionListItemType type)
    {
        return type switch
        {
            TransactionListItemType.Expense => @<span class="badge bg-danger-subtle text-danger">
                <i class="bi bi-arrow-up-circle me-1"></i>@L["TransactionType_Expense"]
            </span>,
            TransactionListItemType.Income => @<span class="badge bg-success-subtle text-success">
                <i class="bi bi-arrow-down-circle me-1"></i>@L["TransactionType_Income"]
            </span>,
            TransactionListItemType.Transfer => @<span class="badge bg-primary-subtle text-primary">
                <i class="bi bi-arrow-left-right me-1"></i>@L["TransactionType_Transfer"]
            </span>,
            TransactionListItemType.Refund => @<span class="badge bg-info-subtle text-info">
                <i class="bi bi-arrow-counterclockwise me-1"></i>@L["TransactionType_Refund"]
            </span>,
            _ => @<span class="badge bg-secondary-subtle text-secondary">
                <i class="bi bi-question-circle me-1"></i>@L["TransactionType_Other"]
            </span>
        };
    }

    private string GetAmountBadgeClass(TransactionListItemType type)
    {
        return type switch
        {
            TransactionListItemType.Expense => "bg-danger-subtle text-danger",
            TransactionListItemType.Income => "bg-success-subtle text-success",
            TransactionListItemType.Transfer => "bg-info-subtle text-info",
            TransactionListItemType.Refund => "bg-info-subtle text-info",
            _ => "bg-secondary-subtle text-secondary"
        };
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender)
            return;

        if (!string.IsNullOrWhiteSpace(_result))
        {
            var cleanUrl = Nav.Uri.Split('?')[0];
            Nav.NavigateTo(cleanUrl, replace: true);
        }
    }
}


