@page "/transactions/{Id:guid}/edit"
@inherits ApiPageBase
@using System.ComponentModel.DataAnnotations
@using FamilyFinances.Application.Ledger.Accounts.Dtos
@using FamilyFinances.Application.Ledger.Payees.Dtos
@using FamilyFinances.Application.Ledger.Transactions.Dtos
@using FamilyFinances.Application.Ledger.Transactions.Requests
@using FamilyFinances.Web.Api
@using FamilyFinances.Web.Components.Base
@using FamilyFinances.Web.Components.Shared
@using FamilyFinances.Web
@using Microsoft.Extensions.Localization
@inject TransactionsApi TransactionsApi
@inject IAccountsApi AccountsApi
@inject PayeesApi PayeesApi
@inject NavigationManager NavigationManager
@inject IStringLocalizer<SharedResource> L

<div class="d-flex align-items-center justify-content-between mb-3">
    <h3 class="m-0">
        <i class="bi bi-pencil me-2"></i>@L["TransactionEdit_Title"]
        @if (_isMultiSplit)
        {
            <span class="badge bg-info ms-2">@L["TransactionEdit_MultiSplitBadge"]</span>
        }
    </h3>
    <a class="btn btn-sm btn-outline-secondary" href="@($"/transactions/{Id}")">
        <i class="bi bi-arrow-left me-1"></i>@L["TransactionEdit_Back"]
    </a>
</div>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="alert alert-danger" role="alert">
        <i class="bi bi-exclamation-triangle me-2"></i>@_error
    </div>
}

@if (_loading)
{
    <div class="text-center py-5">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">@L["Common_Loading"]</span>
        </div>
    </div>
}
else if (_isMultiSplit)
{
    <MultiSplitTransactionEditor Accounts="_accounts"
                                 Payees="_payees"
                                 InitialDate="_originalTransaction!.BookedOn"
                                 InitialDescription="@_originalTransaction.Description"
                                 InitialPayeeId="@_originalTransaction.PayeeId"
                                 InitialSplits="_multiSplitModel"
                                 OnValidStateChanged="OnMultiSplitEditorStateChanged" />

    <div class="mt-4 d-flex gap-2">
        <button class="btn btn-primary"
                @onclick="SaveMultiSplitAsync"
                disabled="@(!_canSaveMultiSplit || _saving)">
            @if (_saving)
            {
                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
            }
            else
            {
                <i class="bi bi-check-circle me-1"></i>
            }
            @L["TransactionEdit_SaveChanges"]
        </button>

        <a class="btn btn-secondary" href="@($"/transactions/{Id}")">
            <i class="bi bi-x-circle me-1"></i>@L["TransactionEdit_Cancel"]
        </a>
    </div>
}
else
{
    <EditForm Model="_twoSplitModel" OnValidSubmit="SaveTwoSplitAsync">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="row g-3">
            <div class="col-12 col-md-3">
                <label class="form-label">
                    <i class="bi bi-calendar-event me-1"></i>@L["TransactionEdit_BookedOn"]
                </label>
                <InputDate class="form-control" @bind-Value="_twoSplitModel!.BookedOn" />
            </div>

            <div class="col-12 col-md-5">
                <label class="form-label">
                    <i class="bi bi-pencil me-1"></i>@L["TransactionEdit_Description"]
                </label>
                <InputText class="form-control" @bind-Value="_twoSplitModel!.Description" />
            </div>

            <div class="col-12 col-md-4">
                <label class="form-label">
                    <i class="bi bi-person me-1"></i>@L["TransactionEdit_Payee"]
                </label>
                <InputSelect class="form-select" @bind-Value="_twoSplitModel!.PayeeId">
                    <option value="">-</option>
                    @foreach (var p in _payees)
                    {
                        <option value="@p.Id">@p.Name</option>
                    }
                </InputSelect>
            </div>

            <div class="col-12 col-md-4">
                <label class="form-label">
                    <i class="bi bi-arrow-up-right me-1"></i>@L["TransactionEdit_FromAccount"]
                </label>
                <InputSelect class="form-select" @bind-Value="_twoSplitModel!.FromAccountId">
                    @foreach (var a in _accounts)
                    {
                        <option value="@a.Id">@a.Name</option>
                    }
                </InputSelect>
            </div>

            <div class="col-12 col-md-4">
                <label class="form-label">
                    <i class="bi bi-arrow-down-left me-1"></i>@L["TransactionEdit_ToAccount"]
                </label>
                <InputSelect class="form-select" @bind-Value="_twoSplitModel!.ToAccountId">
                    @foreach (var a in _accounts)
                    {
                        <option value="@a.Id">@a.Name</option>
                    }
                </InputSelect>
            </div>

            <div class="col-12 col-md-4">
                <label class="form-label">
                    <i class="bi bi-currency-euro me-1"></i>@L["TransactionEdit_Amount"]
                </label>
                <InputNumber class="form-control" @bind-Value="_twoSplitModel!.Amount" />
            </div>
        </div>

        <div class="d-flex gap-2 mt-4">
            <button class="btn btn-primary" type="submit" disabled="@_saving">
                @if (_saving)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                }
                else
                {
                    <i class="bi bi-check-circle me-1"></i>
                }
                @L["TransactionEdit_SaveChanges"]
            </button>
            <a class="btn btn-secondary" href="@($"/transactions/{Id}")">
                <i class="bi bi-x-circle me-1"></i>@L["TransactionEdit_Cancel"]
            </a>

            <div class="ms-auto">
                <button class="btn btn-outline-info" type="button" @onclick="ConvertToMultiSplit">
                    <i class="bi bi-distribute-vertical me-1"></i>@L["TransactionEdit_AddAnotherSplit"]
                </button>
            </div>
        </div>
    </EditForm>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private IReadOnlyList<AccountDto> _accounts = Array.Empty<AccountDto>();
    private IReadOnlyList<PayeeDto> _payees = Array.Empty<PayeeDto>();

    private TransactionDto? _originalTransaction;
    private bool _isMultiSplit;
    private bool _loading = true;

    private EditTransactionModel? _twoSplitModel;

    private List<MultiSplitTransactionEditor.SplitModel> _multiSplitModel = new();
    private MultiSplitTransactionEditor.TransactionEditorModel? _multiSplitEditorModel;
    private bool _canSaveMultiSplit;

    private string? _error;
    private bool _saving;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _error = null;
        _loading = true;

        try
        {
            await ExecuteApiAsync(async ct =>
            {
                _accounts = await AccountsApi.ListAsync(ct);
                _payees = await PayeesApi.ListAsync(ct);

                var tx = await TransactionsApi.GetByIdAsync(Id, ct);
                _originalTransaction = tx;

                _isMultiSplit = tx.Splits.Count > 2;

                if (_isMultiSplit)
                {
                    _multiSplitModel = tx.Splits.Select(s => new MultiSplitTransactionEditor.SplitModel
                    {
                        AccountId = s.AccountId,
                        Amount = s.Amount,
                        AmountText = s.Amount.ToString("F2"),
                        Memo = s.Memo
                    }).ToList();
                }
                else
                {
                    var from = tx.Splits.Single(s => s.Amount < 0);
                    var to = tx.Splits.Single(s => s.Amount > 0);

                    _twoSplitModel = new EditTransactionModel
                    {
                        Id = tx.Id,
                        BookedOn = tx.BookedOn,
                        Description = tx.Description,
                        PayeeId = tx.PayeeId,
                        FromAccountId = from.AccountId,
                        ToAccountId = to.AccountId,
                        Amount = Math.Abs(from.Amount)
                    };
                }
            });
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private void OnMultiSplitEditorStateChanged(MultiSplitTransactionEditor.TransactionEditorModel? model)
    {
        _multiSplitEditorModel = model;
        _canSaveMultiSplit = model != null;
        StateHasChanged();
    }

    private void ConvertToMultiSplit()
    {
        if (_twoSplitModel == null)
            return;

        _multiSplitModel =
        [
            new MultiSplitTransactionEditor.SplitModel
            {
                AccountId = _twoSplitModel.FromAccountId,
                Amount = -_twoSplitModel.Amount,
                AmountText = (-_twoSplitModel.Amount).ToString("F2"),
                Memo = null
            },
            new MultiSplitTransactionEditor.SplitModel
            {
                AccountId = _twoSplitModel.ToAccountId,
                Amount = _twoSplitModel.Amount,
                AmountText = _twoSplitModel.Amount.ToString("F2"),
                Memo = null
            },
            new MultiSplitTransactionEditor.SplitModel()
        ];

        _isMultiSplit = true;
        StateHasChanged();
    }

    private async Task SaveTwoSplitAsync()
    {
        if (_twoSplitModel is null)
            return;

        _error = null;
        _saving = true;

        try
        {
            await ExecuteApiAsync(async ct =>
            {
                var req = new UpdateTransactionRequest(
                    _twoSplitModel.Id,
                    _twoSplitModel.BookedOn,
                    _twoSplitModel.Description,
                    _twoSplitModel.PayeeId,
                    _twoSplitModel.FromAccountId,
                    _twoSplitModel.ToAccountId,
                    _twoSplitModel.Amount);

                await TransactionsApi.UpdateAsync(Id, req, ct);
            });

            NavigationManager.NavigateTo($"/transactions/{Id}?result=updated", replace: true);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task SaveMultiSplitAsync()
    {
        if (_multiSplitEditorModel is null || _saving)
            return;

        _error = null;
        _saving = true;

        try
        {
            await ExecuteApiAsync(async ct =>
            {
                var splits = _multiSplitEditorModel.Splits.Select(s => new TransactionSplitInput(
                    s.AccountId,
                    ToCents(s.Amount),
                    s.Memo
                )).ToList();

                var req = new UpdateMultiSplitTransactionRequest(
                    Id,
                    _multiSplitEditorModel.BookedOn,
                    _multiSplitEditorModel.Description,
                    _multiSplitEditorModel.PayeeId,
                    splits);

                await TransactionsApi.UpdateMultiSplitAsync(Id, req, ct);
            });

            NavigationManager.NavigateTo($"/transactions/{Id}?result=updated", replace: true);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private static long ToCents(decimal amount)
        => (long)Math.Round(amount * 100m, MidpointRounding.AwayFromZero);

    private sealed class EditTransactionModel
    {
        [Required]
        public Guid Id { get; set; }

        [Required]
        public DateOnly BookedOn { get; set; } = DateOnly.FromDateTime(DateTime.Today);

        [Required]
        [StringLength(200)]
        public string Description { get; set; } = "";

        public Guid? PayeeId { get; set; }

        [Required]
        public Guid FromAccountId { get; set; }

        [Required]
        public Guid ToAccountId { get; set; }

        [Range(0.01d, 999999999d)]
        public decimal Amount { get; set; }
    }
}
