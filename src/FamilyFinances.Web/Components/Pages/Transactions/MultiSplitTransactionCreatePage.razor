@page "/transactions/new-multi"
@inherits ApiPageBase
@using FamilyFinances.Application.Ledger.Accounts.Dtos
@using FamilyFinances.Application.Ledger.Payees.Dtos
@using FamilyFinances.Application.Ledger.Transactions.Requests
@using FamilyFinances.Web
@using FamilyFinances.Web.Api
@using FamilyFinances.Web.Components.Base
@using FamilyFinances.Web.Components.Shared
@using Microsoft.Extensions.Localization
@inject TransactionsApi TransactionsApi
@inject IAccountsApi AccountsApi
@inject PayeesApi PayeesApi
@inject IStringLocalizer<SharedResource> L

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h3 class="mb-1">
            <i class="bi bi-distribute-vertical me-2"></i>@L["MultiSplitCreate_Title"]
        </h3>
        <p class="text-muted mb-0">@L["MultiSplitCreate_Subtitle"]</p>
    </div>
    <a class="btn btn-sm btn-outline-secondary" href="/transactions">
        <i class="bi bi-arrow-left me-1"></i>@L["Common_Back"]
    </a>
</div>

<div class="mb-4">
    <div class="btn-group" role="group">
        <input type="radio" class="btn-check" name="presetMode" id="presetManual"
               checked="@(!_useMortgagePreset)" @onchange="@(() => SetPresetMode(false))">
        <label class="btn btn-outline-primary" for="presetManual">
            <i class="bi bi-pencil me-1"></i>@L["MultiSplitCreate_ModeManual"]
        </label>

        <input type="radio" class="btn-check" name="presetMode" id="presetMortgage"
               checked="@_useMortgagePreset" @onchange="@(() => SetPresetMode(true))">
        <label class="btn btn-outline-primary" for="presetMortgage">
            <i class="bi bi-house me-1"></i>@L["MultiSplitCreate_ModeMortgage"]
        </label>
    </div>
</div>

@if (_useMortgagePreset)
{
    <MortgagePaymentPreset Accounts="_accounts" OnPresetApplied="ApplyMortgagePreset" />

    @if (_mortgagePresetApplied)
    {
        <div class="alert alert-success mt-3" role="alert">
            <i class="bi bi-check-circle me-2"></i>
            @L["MultiSplitCreate_MortgagePresetApplied"]
        </div>
    }
}

@if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="alert alert-danger" role="alert">
        <i class="bi bi-exclamation-triangle me-2"></i>@_error
    </div>
}

@if (_loading)
{
    <div class="text-center py-5">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">@L["Common_Loading"]</span>
        </div>
    </div>
}
else
{
    <MultiSplitTransactionEditor @key="_editorKey"
                                 Accounts="_accounts"
                                 Payees="_payees"
                                 InitialSplits="@GetInitialSplits()"
                                 InitialDescription="@GetInitialDescription()"
                                 OnValidStateChanged="OnEditorStateChanged" />

    <div class="mt-4 d-flex gap-2">
        <button class="btn btn-primary"
                @onclick="CreateAsync"
                disabled="@(!_canSave || _isSaving)">
            @if (_isSaving)
            {
                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
            }
            else
            {
                <i class="bi bi-check-circle me-1"></i>
            }
            @L["MultiSplitCreate_CreateTransaction"]
        </button>

        <a class="btn btn-secondary" href="/transactions">
            <i class="bi bi-x-circle me-1"></i>@L["MultiSplitCreate_Cancel"]
        </a>
    </div>
}

@code {
    private bool _loading = true;
    private bool _isSaving;
    private bool _canSave;
    private string? _error;

    private bool _useMortgagePreset;
    private bool _mortgagePresetApplied;
    private MortgagePaymentPreset.MortgagePresetModel? _appliedPreset;
    private int _editorKey;

    private IReadOnlyList<AccountDto> _accounts = Array.Empty<AccountDto>();
    private IReadOnlyList<PayeeDto> _payees = Array.Empty<PayeeDto>();

    private MultiSplitTransactionEditor.TransactionEditorModel? _editorModel;

    protected override async Task OnInitializedAsync()
    {
        await ExecuteApiAsync(async ct =>
        {
            _accounts = await AccountsApi.ListAsync(ct);
            _payees = await PayeesApi.ListAsync(ct);
        });

        _loading = false;
    }

    private void SetPresetMode(bool useMortgage)
    {
        _useMortgagePreset = useMortgage;
        _mortgagePresetApplied = false;
        _appliedPreset = null;
    }

    private void ApplyMortgagePreset(MortgagePaymentPreset.MortgagePresetModel preset)
    {
        _appliedPreset = preset;
        _mortgagePresetApplied = true;
        _editorKey++;
        StateHasChanged();
    }

    private void OnEditorStateChanged(MultiSplitTransactionEditor.TransactionEditorModel? model)
    {
        _editorModel = model;
        _canSave = model is not null;
        StateHasChanged();
    }

    private async Task CreateAsync()
    {
        if (_editorModel == null || _isSaving)
            return;

        _isSaving = true;
        _error = null;
        StateHasChanged();

        try
        {
            await ExecuteApiAsync(async ct =>
            {
                var splits = _editorModel.Splits.Select(s => new TransactionSplitInput(
                    s.AccountId,
                    ToCents(s.Amount),
                    s.Memo
                )).ToList();

                var request = new CreateTransactionRequest(
                    _editorModel.BookedOn,
                    _editorModel.Description,
                    splits,
                    _editorModel.PayeeId,
                    null
                );

                await TransactionsApi.CreateAsync(request, ct);
            });

            Nav.NavigateTo("/transactions");
        }
        catch (Exception ex)
        {
            _error = L["MultiSplitCreate_Error_CreateFailed", ex.Message];
        }
        finally
        {
            _isSaving = false;
            StateHasChanged();
        }
    }

    private static long ToCents(decimal amount)
        => (long)Math.Round(amount * 100m, MidpointRounding.AwayFromZero);

    private List<MultiSplitTransactionEditor.SplitModel>? GetInitialSplits()
    {
        if (!_mortgagePresetApplied || _appliedPreset == null)
            return null;

        var totalPayment = _appliedPreset.PrincipalAmount + _appliedPreset.InterestAmount;

        return
        [
            new MultiSplitTransactionEditor.SplitModel
            {
                AccountId = _appliedPreset.PaymentAccountId,
                Amount = -totalPayment,
                AmountText = (-totalPayment).ToString("F2"),
                Memo = L["MultiSplitCreate_SplitMemo_Payment"]
            },
            new MultiSplitTransactionEditor.SplitModel
            {
                AccountId = _appliedPreset.MortgagePrincipalAccountId,
                Amount = _appliedPreset.PrincipalAmount,
                AmountText = _appliedPreset.PrincipalAmount.ToString("F2"),
                Memo = L["MultiSplitCreate_SplitMemo_Principal"]
            },
            new MultiSplitTransactionEditor.SplitModel
            {
                AccountId = _appliedPreset.InterestExpenseAccountId,
                Amount = _appliedPreset.InterestAmount,
                AmountText = _appliedPreset.InterestAmount.ToString("F2"),
                Memo = L["MultiSplitCreate_SplitMemo_Interest"]
            }
        ];
    }

    private string GetInitialDescription()
    {
        if (_mortgagePresetApplied)
            return L["MultiSplitCreate_DefaultDescription", DateOnly.FromDateTime(DateTime.Today).ToString("MMM yyyy")];

        return string.Empty;
    }
}
