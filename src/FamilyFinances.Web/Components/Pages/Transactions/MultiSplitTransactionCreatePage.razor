@page "/transactions/new-multi"
@inherits ApiPageBase
@using FamilyFinances.Application.Ledger.Accounts.Dtos
@using FamilyFinances.Application.Ledger.Payees.Dtos
@using FamilyFinances.Application.Ledger.Transactions.Requests
@using FamilyFinances.Web.Api
@using FamilyFinances.Web.Components.Base
@using FamilyFinances.Web.Components.Shared
@inject TransactionsApi TransactionsApi
@inject IAccountsApi AccountsApi
@inject PayeesApi PayeesApi
@inject NavigationManager Nav

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h3 class="mb-1">
            <i class="bi bi-distribute-vertical me-2"></i>New Multi-Split Transaction
        </h3>
        <p class="text-muted mb-0">Create a transaction with multiple splits (3 or more)</p>
    </div>
    <a class="btn btn-sm btn-outline-secondary" href="/transactions">
        <i class="bi bi-arrow-left me-1"></i>Back
    </a>
</div>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="alert alert-danger" role="alert">
        <i class="bi bi-exclamation-triangle me-2"></i>@_error
    </div>
}

@if (_loading)
{
    <div class="text-center py-5">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else
{
    <MultiSplitTransactionEditor Accounts="_accounts"
                                 Payees="_payees"
                                 OnValidStateChanged="OnEditorStateChanged" />

    <div class="mt-4 d-flex gap-2">
        <button class="btn btn-primary" 
                @onclick="CreateAsync" 
                disabled="@(!_canSave || _isSaving)">
            @if (_isSaving)
            {
                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
            }
            else
            {
                <i class="bi bi-check-circle me-1"></i>
            }
            Create Transaction
        </button>
        
        <a class="btn btn-secondary" href="/transactions">
            <i class="bi bi-x-circle me-1"></i>Cancel
        </a>
    </div>
}

@code {
    private bool _loading = true;
    private bool _isSaving;
    private bool _canSave;
    private string? _error;
    
    private IReadOnlyList<AccountDto> _accounts = Array.Empty<AccountDto>();
    private IReadOnlyList<PayeeDto> _payees = Array.Empty<PayeeDto>();
    
    private MultiSplitTransactionEditor.TransactionEditorModel? _editorModel;
    
    protected override async Task OnInitializedAsync()
    {
        await ExecuteApiAsync(async ct =>
        {
            _accounts = await AccountsApi.ListAsync(ct);
            _payees = await PayeesApi.ListAsync(ct);
        });
        
        _loading = false;
    }
    
    private void OnEditorStateChanged(MultiSplitTransactionEditor.TransactionEditorModel? model)
    {
        _editorModel = model;
        _canSave = model != null;
        StateHasChanged();
    }
    
    private async Task CreateAsync()
    {
        if (_editorModel == null || _isSaving)
            return;
        
        _isSaving = true;
        _error = null;
        StateHasChanged();
        
        try
        {
            await ExecuteApiAsync(async ct =>
            {
                var splits = _editorModel.Splits.Select(s => new TransactionSplitInput(
                    s.AccountId,
                    ToCents(s.Amount),
                    s.Memo
                )).ToList();
                
                var request = new CreateTransactionRequest(
                    _editorModel.BookedOn,
                    _editorModel.Description,
                    splits,
                    _editorModel.PayeeId,
                    null // No related transaction for multi-split
                );
                
                await TransactionsApi.CreateAsync(request, ct);
            });
            
            // Success - navigate to transactions list
            Nav.NavigateTo("/transactions");
        }
        catch (Exception ex)
        {
            _error = $"Failed to create transaction: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
            StateHasChanged();
        }
    }
    
    private static long ToCents(decimal amount)
        => (long)Math.Round(amount * 100m, MidpointRounding.AwayFromZero);
}
