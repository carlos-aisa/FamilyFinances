@page "/transactions/new"
@inherits ApiPageBase
@using System.ComponentModel.DataAnnotations
@using FamilyFinances.Web.Api
@using FamilyFinances.Web.Components.Base
@inject TransactionsApi TransactionsApi
@inject AccountsApi AccountsApi
@inject PayeesApi PayeesApi
@inject NavigationManager Nav

<h3>New transaction</h3>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="alert alert-danger" role="alert">@_error</div>
}

<EditForm Model="_model" OnValidSubmit="CreateAsync">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="row g-3">
        <div class="col-md-3">
            <label class="form-label">Date</label>
            <InputDate class="form-control" @bind-Value="_model.BookedOn" />
        </div>

        <div class="col-md-9">
            <label class="form-label">Description</label>
            <InputText class="form-control" @bind-Value="_model.Description" />
        </div>

        <div class="col-md-4">
            <label class="form-label">Amount</label>
            <InputNumber class="form-control" @bind-Value="_model.Amount" />
        </div>

        <div class="col-md-4">
            <label class="form-label">From account</label>
            <InputSelect class="form-select" @bind-Value="_model.FromAccountId">
                <option value="">-- select --</option>
                @foreach (var a in _accounts)
                {
                    <option value="@a.Id">@a.Name</option>
                }
            </InputSelect>
        </div>

        <div class="col-md-4">
            <label class="form-label">To account</label>
            <InputSelect class="form-select" @bind-Value="_model.ToAccountId">
                <option value="">-- select --</option>
                @foreach (var a in _accounts)
                {
                    <option value="@a.Id">@a.Name</option>
                }
            </InputSelect>
        </div>

        <div class="col-md-6">
            <label class="form-label">Payee (optional)</label>
            <InputSelect class="form-select" @bind-Value="_model.PayeeId">
                <option value="">-- none --</option>
                @foreach (var p in _payees)
                {
                    <option value="@p.Id">@p.Name</option>
                }
            </InputSelect>
        </div>

        <div class="col-md-6">
            <label class="form-label">Memo (optional)</label>
            <InputText class="form-control" @bind-Value="_model.Memo" />
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_formError))
    {
        <div class="alert alert-warning mt-3" role="alert">@_formError</div>
    }

    <div class="mt-3 d-flex gap-2">
        <button class="btn btn-primary" disabled="@(!_canSubmit || _isBusy)">Create</button>
        <button type="button" class="btn btn-secondary" @onclick="Cancel" disabled="@_isBusy">Cancel</button>
    </div>
</EditForm>

@code {
    private bool _isBusy;
    private string? _error;
    private string? _formError;
    private bool _canSubmit;

    private List<FamilyFinances.Application.Ledger.Accounts.Dtos.AccountDto> _accounts = new();
    private List<FamilyFinances.Application.Ledger.Payees.Dtos.PayeeDto> _payees = new();

    private CreateTransactionFormModel _model = new()
    {
        BookedOn = DateOnly.FromDateTime(DateTime.Today)
    };

    protected override async Task OnInitializedAsync()
    {
        await ExecuteApiAsync(async ct =>
        {
            _accounts = (await AccountsApi.ListAsync(ct)).ToList();
            _payees = (await PayeesApi.ListAsync(ct)).ToList();
        });

        ValidateForm();
    }

    private void ValidateForm()
    {
        _formError = null;

        if (_model.Amount <= 0)
            _formError = "Amount must be greater than zero.";

        if (_model.FromAccountId is null)
            _formError = "From account is required.";

        if (_model.ToAccountId is null)
            _formError = "To account is required.";

        if (_model.FromAccountId is not null && _model.ToAccountId is not null && _model.FromAccountId == _model.ToAccountId)
            _formError = "From and To accounts must be different.";

        if (string.IsNullOrWhiteSpace(_model.Description))
            _formError = "Description is required.";

        _canSubmit = string.IsNullOrWhiteSpace(_formError);
    }

    private async Task CreateAsync()
    {
        ValidateForm();
        if (!_canSubmit || _isBusy)
            return;

        _isBusy = true;
        _error = null;

        await ExecuteApiAsync(async ct =>
        {
            var cents = Money.ToCents(_model.Amount);

            var request = new FamilyFinances.Application.Ledger.Transactions.Requests.CreateTransactionRequest(
                _model.BookedOn,
                _model.Description.Trim(),
                new[]
                {
                    new FamilyFinances.Application.Ledger.Transactions.Requests.TransactionSplitInput(
                        _model.FromAccountId!.Value, -cents, null),

                    new FamilyFinances.Application.Ledger.Transactions.Requests.TransactionSplitInput(
                        _model.ToAccountId!.Value, +cents, string.IsNullOrWhiteSpace(_model.Memo) ? null : _model.Memo.Trim())
                },
                _model.PayeeId
            );

            await TransactionsApi.CreateAsync(request, ct);
        });

        _isBusy = false;

        if (string.IsNullOrWhiteSpace(_error))
            Nav.NavigateTo("/transactions");
    }

    private void Cancel() => Nav.NavigateTo("/transactions");

    private static class Money
    {
        public static long ToCents(decimal amount)
            => (long)Math.Round(amount * 100m, MidpointRounding.AwayFromZero);
    }

    private sealed class CreateTransactionFormModel
    {
        [Required]
        public DateOnly BookedOn { get; set; }

        [Required, StringLength(200)]
        public string Description { get; set; } = "";

        [Range(typeof(decimal), "0.01", "999999999")]
        public decimal Amount { get; set; }

        public Guid? PayeeId { get; set; }

        [Required]
        public Guid? FromAccountId { get; set; }

        [Required]
        public Guid? ToAccountId { get; set; }

        public string? Memo { get; set; }
    }
}
