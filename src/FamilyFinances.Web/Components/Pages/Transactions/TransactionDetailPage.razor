@page "/transactions/{Id:guid}"
@inherits ApiPageBase
@using System.Globalization
@using FamilyFinances.Application.Ledger.Accounts.Dtos
@using FamilyFinances.Application.Ledger.Transactions.Dtos
@using FamilyFinances.Domain.Common
@using FamilyFinances.Web.Api
@using FamilyFinances.Web.Components.Base
@inject TransactionsApi TransactionsApi
@inject IAccountsApi AccountsApi

@if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="alert alert-danger" role="alert">@_error</div>
}

@if (_result == "updated")
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2"></i>Transaction updated successfully.
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (_tx is null)
{
    <div class="d-flex justify-content-center align-items-center" style="min-height: 300px;">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else
{
    <!-- Header -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    @if (IsReadOnlyHistory)
                    {
                        <li class="breadcrumb-item"><a href="/history">History</a></li>
                    }
                    else
                    {
                        <li class="breadcrumb-item"><a href="/transactions">Transactions</a></li>
                    }
                    <li class="breadcrumb-item active" aria-current="page">Details</li>
                </ol>
            </nav>
            <h3 class="mb-0">Transaction Details</h3>
        </div>

        <div class="d-flex gap-2">
            @if (IsReadOnlyHistory)
            {
                <button class="btn btn-outline-secondary" type="button" @onclick="NavigateBackToHistory">
                    <i class="bi bi-arrow-left me-1"></i>Back to History
                </button>
            }
            else if (!_confirmDelete)
            {
                <a class="btn btn-outline-secondary" href="/transactions">
                    <i class="bi bi-arrow-left me-1"></i>Back
                </a>
                <a class="btn btn-primary" href="@($"/transactions/{Id}/edit")">
                    <i class="bi bi-pencil me-1"></i>Edit
                </a>
                <button class="btn btn-outline-danger" type="button"
                        @onclick="() => _confirmDelete = true">
                    <i class="bi bi-trash me-1"></i>Delete
                </button>
            }
            else
            {
                <button class="btn btn-secondary" type="button"
                        @onclick="() => _confirmDelete = false"
                        disabled="@_isDeleting">
                    Cancel
                </button>

                <button class="btn btn-danger" type="button"
                        @onclick="DeleteAsync"
                        disabled="@_isDeleting">
                    @if (_isDeleting)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                    }
                    Confirm Delete
                </button>
            }
        </div>
    </div>

    <!-- Main Content -->
    <div class="row g-4">
        <!-- Left Column: Transaction Info -->
        <div class="col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-info-circle me-2"></i>Information
                    </h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label text-muted small mb-1">Date</label>
                        <div class="fw-semibold">@_tx.BookedOn.ToString("dddd, dd MMMM yyyy", new CultureInfo("es-ES"))</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted small mb-1">Description</label>
                        <div class="fw-semibold">@_tx.Description</div>
                    </div>

                    <div>
                        <label class="form-label text-muted small mb-1">Payee</label>
                        <div class="fw-semibold">
                            @if (string.IsNullOrWhiteSpace(_tx.PayeeName))
                            {
                                <span class="text-muted fst-italic">No payee</span>
                            }
                            else
                            {
                                <i class="bi bi-person me-1"></i>@_tx.PayeeName
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column: Splits -->
        <div class="col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header bg-success text-white">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-arrow-left-right me-2"></i>Splits
                    </h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="border-0">Account</th>
                                    <th class="border-0 text-end" style="width: 160px;">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var s in _tx.Splits)
                                {
                                    <tr>
                                        <td class="align-middle">
                                            <div class="d-flex align-items-center">
                                                <i class="bi bi-wallet2 text-muted me-2"></i>
                                                <span>@GetAccountName(s.AccountId)</span>
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(s.Memo))
                                            {
                                                <small class="text-muted d-block ms-4">@s.Memo</small>
                                            }
                                        </td>
                                        <td class="text-end align-middle">
                                            <span class="badge @GetAmountBadgeClass(s.Amount) fs-6">
                                                @FormatMoney(s.Amount)
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="table-light">
                                <tr>
                                    <td class="fw-bold">Total</td>
                                    <td class="text-end fw-bold">
                                        @FormatMoney(_tx.Splits.Sum(s => s.Amount))
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Transaction ID (for technical reference) -->
    <div class="mt-4">
        <small class="text-muted">
            <i class="bi bi-key me-1"></i>ID: <code>@Id</code>
        </small>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }
    [SupplyParameterFromQuery(Name = "readonly")] public bool ReadOnly { get; set; }
    [SupplyParameterFromQuery(Name = "returnTo")] public string? ReturnTo { get; set; }

    private TransactionDto? _tx;
    private string? _error;

    private IReadOnlyList<AccountDto> _accounts = Array.Empty<AccountDto>();
    private Dictionary<Guid, string> _accountNames = new();

    private bool _confirmDelete;
    private bool _isDeleting;
    private string? _result;

    protected override async Task OnInitializedAsync()
    {
        _result = GetQueryParam("result");
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _error = null;

        try
        {
            await ExecuteApiAsync(async ct =>
            {
                // Load accounts first (for mapping split.AccountId -> name)
                _accounts = await AccountsApi.ListAsync(ct);
                _accountNames = _accounts.ToDictionary(a => a.Id, a => a.Name);

                _tx = await TransactionsApi.GetByIdAsync(Id, ct);
            });
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private string? GetQueryParam(string key)
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        if (Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query)
            .TryGetValue(key, out var value))
        {
            return value.ToString();
        }

        return null;
    }

    private string GetAccountName(Guid accountId)
        => _accountNames.TryGetValue(accountId, out var name) ? name : "(unknown account)";

    private string GetAmountBadgeClass(decimal amount)
        => amount < 0 ? "bg-danger-subtle text-danger" : "bg-success-subtle text-success";

    private static string FormatMoney(decimal amount)
        => amount.ToString("C", CultureInfo.CurrentCulture);

    private bool IsReadOnlyHistory => ReadOnly;

    private void NavigateBackToHistory()
    {
        var destination = string.Equals(ReturnTo, "history-movements", StringComparison.OrdinalIgnoreCase)
            ? "/history/movements"
            : "/history/transactions";
        Nav.NavigateTo(destination);
    }

    private async Task DeleteAsync()
    {
        _error = null;
        _isDeleting = true;

        try
        {
            await ExecuteApiAsync(async ct =>
            {
                await TransactionsApi.DeleteAsync(Id, ct);
            });

            Nav.NavigateTo("/transactions?result=deleted", replace: true);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _confirmDelete = false;
        }
        finally
        {
            _isDeleting = false;
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender)
            return;

        if (!string.IsNullOrWhiteSpace(_result))
        {
            var cleanUrl = Nav.Uri.Split('?')[0];
            Nav.NavigateTo(cleanUrl, replace: true);
        }
    }
}
