@page "/login"
@attribute [AllowAnonymous]
@using FamilyFinances.Web.Auth
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@using Microsoft.Extensions.Localization
@using FamilyFinances.Web
@inject JwtAuthStateProvider JwtAuthStateProvider
@inject NavigationManager Nav
@inject IApiTokenStore TokenStore
@inject ILogger<LoginPage> Logger
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResource> L

<div class="container">
    <div class="row justify-content-center mt-5">
        <div class="col-md-6 col-lg-4">
            <div class="card shadow">
                <div class="card-body p-4">
                    <h3 class="card-title text-center mb-4">
                        <i class="bi bi-lock-fill me-2"></i>Family Finances
                    </h3>

                    @if (!string.IsNullOrWhiteSpace(_error))
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-triangle me-2"></i>@_error
                            <button type="button" class="btn-close" @onclick="() => _error = null"></button>
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label">@L["Login_EmailLabel"]</label>
                        <input type="email" class="form-control" @bind="_email" placeholder="@L["Login_EmailPlaceholder"]" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">@L["Login_PasswordLabel"]</label>
                        <input type="password" class="form-control" @bind="_password" @onkeypress="HandleKeyPress" placeholder="@L["Login_PasswordPlaceholder"]" />
                    </div>

                    <button type="button" class="btn btn-primary w-100" @onclick="OnLoginAsync" disabled="@(_isBusy || !_jsLoaded)">
                        @if (_isBusy)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        <i class="bi bi-box-arrow-in-right me-2"></i>@L["Login_Submit"]
                    </button>

                    <div class="text-center mt-3">
                        <small class="text-muted">
                            @L["Login_DefaultCredentials"]
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string _email = "";
    private string _password = "";
    private bool _isBusy;
    private bool _jsLoaded;
    private string? _error;

    protected override void OnInitialized()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("reason", out var reason) && reason == "expired")
        {
            _error = L["Login_Error_SessionExpired"];
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var lastUsername = await JS.InvokeAsync<string?>("loginHelper.getLastUsername");
                if (!string.IsNullOrWhiteSpace(lastUsername))
                    _email = lastUsername.Trim();
            }
            catch (JSException jsEx)
            {
                Logger.LogDebug(jsEx, "Unable to read last username from local storage");
            }
            finally
            {
                _jsLoaded = true;
                StateHasChanged();
            }
        }
    }

    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !_isBusy && _jsLoaded)
        {
            await OnLoginAsync();
        }
    }

    private async Task OnLoginAsync()
    {
        if (!_jsLoaded)
        {
            _error = L["Login_Error_Loading"];
            return;
        }

        _error = null;
        _isBusy = true;

        try
        {
            var result = await JS.InvokeAsync<LoginResult>("loginHelper.executeLogin", _email, _password);

            if (!result.Success)
            {
                _error = string.IsNullOrWhiteSpace(result.Error) || string.Equals(result.Error, "Login failed", StringComparison.OrdinalIgnoreCase)
                    ? L["Login_Error_InvalidCredentials"]
                    : result.Error;
                return;
            }

            if (string.IsNullOrWhiteSpace(result.AccessToken))
            {
                _error = L["Login_Error_MissingAccessToken"];
                return;
            }

            TokenStore.SetAccessToken(result.AccessToken);
            await JS.InvokeVoidAsync("loginHelper.setLastUsername", _email);
            
            // Mark session as active in sessionStorage to allow F5 session recovery
            await JS.InvokeVoidAsync("sessionHelper.markSessionActive");
            
            await JwtAuthStateProvider.RefreshAsync();

            Nav.NavigateTo("/", forceLoad: false);
        }
        catch (JSException jsEx)
        {
            Logger.LogError(jsEx, "JavaScript error during login");
            _error = L["Login_Error_System"];
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Login exception");
            _error = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private sealed class LoginResult
    {
        public bool Success { get; set; }
        public string? AccessToken { get; set; }
        public string? Error { get; set; }
    }
}
