@page "/login"
@using FamilyFinances.Web.Auth
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.AspNetCore.Components.Authorization
@inject JwtAuthStateProvider JwtAuthStateProvider
@inject NavigationManager Nav
@inject IHttpClientFactory HttpClientFactory
@inject IApiTokenStore TokenStore

<h3>Login</h3>

<div>
    <label>Email</label><br />
    <input @bind="_email" />
</div>

<div style="margin-top:8px">
    <label>Password</label><br />
    <input type="password" @bind="_password" />
</div>

<div style="margin-top:12px">
    <button @onclick="OnLoginAsync" disabled="@_isBusy">Login</button>
</div>
@if (!string.IsNullOrWhiteSpace(_error))
{
    <div style="border:1px solid red; padding:8px; margin:8px 0;">
        <strong>Error:</strong> @_error
    </div>
}

@code {

#if DEBUG
    private string _email = "admin@familyfinances.local";
    private string _password = "Admin123!";
#else
    private string _email = "";
    private string _password = "";
#endif
    private bool _isBusy;
    private string? _error;

    protected override void OnInitialized()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("reason", out var reason) && reason == "expired")
        {
            _error = "Your session has expired. Please log in again.";
        }
    }
    private async Task OnLoginAsync()
    {
        _error = null;
        _isBusy = true;

        try
        {
            var http = HttpClientFactory.CreateClient();

            var url = new Uri(new Uri(Nav.BaseUri), "auth/session");
            var response = await http.PostAsJsonAsync(url, new { Email = _email, Password = _password });
            var payload = await response.Content.ReadFromJsonAsync<SessionResponse>();
            if (payload is null || string.IsNullOrWhiteSpace(payload.AccessToken))
            {
                _error = "Missing access token.";
                return;
            }

            TokenStore.SetAccessToken(payload.AccessToken);
            await JwtAuthStateProvider.RefreshAsync();
            Nav.NavigateTo("/");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private record SessionResponse(string AccessToken);
}
