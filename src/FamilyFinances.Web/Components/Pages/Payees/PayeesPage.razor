@page "/payees"
@inherits ApiPageBase
@using System.ComponentModel.DataAnnotations
@using FamilyFinances.Application.Ledger.Payees.Dtos
@using FamilyFinances.Application.Ledger.Payees.Requests
@using FamilyFinances.Web
@using FamilyFinances.Web.Api
@using FamilyFinances.Web.Components.Base
@using Microsoft.Extensions.Localization
@using Microsoft.JSInterop
@inject PayeesApi PayeesApi
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResource> L

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h3 class="mb-1">@L["Payees_Title"]</h3>
        <p class="text-muted mb-0">
            @if (_items is not null)
            {
                var filtered = GetFilteredPayees();
                <i class="bi bi-person me-1"></i>
                <span>@(filtered.Count == 1 ? L["Payees_Count_Singular", filtered.Count] : L["Payees_Count_Plural", filtered.Count])</span>
                @if (!string.IsNullOrWhiteSpace(_search))
                {
                    <span class="text-muted"> @L["Payees_FilteredFromTotal", _items.Count]</span>
                }
            }
        </p>
    </div>

    <button class="btn @(_showCreateForm ? "btn-outline-secondary" : "btn-primary")" @onclick="ToggleCreateForm">
        <i class="bi @(_showCreateForm ? "bi-x-circle" : "bi-plus-circle") me-1"></i>
        @(_showCreateForm ? L["Payees_Cancel"] : L["Payees_NewPayee"])
    </button>
</div>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-2"></i>@_error
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@L["Common_Close"]"></button>
    </div>
}

@if (!string.IsNullOrWhiteSpace(_info))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2"></i>@_info
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@L["Common_Close"]"></button>
    </div>
}

@if (_showCreateForm)
{
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="card-title mb-0">
                <i class="bi bi-person-plus me-2"></i>@L["Payees_NewPayee"]
            </h5>
        </div>
        <div class="card-body">
            <EditForm Model="_createModel" OnValidSubmit="CreateAsync">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger" />

                <div class="d-flex gap-2 align-items-end">
                    <div class="flex-grow-1">
                        <label class="form-label">
                            <i class="bi bi-pencil me-1"></i>@L["Payees_Field_Name"]
                        </label>
                        <InputText class="form-control" @bind-Value="_createModel.Name" placeholder="@L["Payees_Field_Name_Placeholder"]" />
                    </div>

                    <button class="btn btn-success" type="submit" disabled="@_isBusy">
                        @if (_isBusy)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                        }
                        <i class="bi bi-check-circle me-1"></i>@L["Payees_Create"]
                    </button>

                    <button class="btn btn-outline-secondary" type="button" @onclick="ToggleCreateForm" disabled="@_isBusy">
                        <i class="bi bi-x-circle me-1"></i>@L["Payees_Cancel"]
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <div class="input-group">
            <span class="input-group-text bg-white">
                <i class="bi bi-search"></i>
            </span>
            <input type="text" class="form-control border-start-0" placeholder="@L["Payees_Search_Placeholder"]" @bind="_search" @bind:event="oninput" />
            @if (!string.IsNullOrWhiteSpace(_search))
            {
                <button class="btn btn-outline-secondary" type="button" @onclick="ClearSearch">
                    <i class="bi bi-x"></i>
                </button>
            }
        </div>
    </div>
</div>

@if (_items is null)
{
    <div class="d-flex justify-content-center align-items-center ff-loading-shell">
        <div class="text-center">
            <div class="spinner-border text-primary mb-3 ff-spinner-lg" role="status">
                <span class="visually-hidden">@L["Common_Loading"]</span>
            </div>
            <p class="text-muted">@L["Payees_Loading"]</p>
        </div>
    </div>
}
else if (_items.Count == 0)
{
    <div class="card shadow-sm">
        <div class="card-body text-center py-5">
            <i class="bi bi-person display-1 text-muted mb-3"></i>
            <h5 class="text-muted">@L["Payees_Empty_Title"]</h5>
            <p class="text-muted">@L["Payees_Empty_Description"]</p>
            <button class="btn btn-primary mt-3" @onclick="ToggleCreateForm">
                <i class="bi bi-person-plus me-1"></i>@L["Payees_CreateFirst"]
            </button>
        </div>
    </div>
}
else
{
    var filtered = GetFilteredPayees();

    @if (filtered.Count == 0)
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <i class="bi bi-search display-1 text-muted mb-3"></i>
                <h5 class="text-muted">@L["Payees_NoResults_Title"]</h5>
                <p class="text-muted">@L["Payees_NoResults_Description"]</p>
                <button class="btn btn-outline-secondary mt-3" @onclick="ClearSearch">
                    <i class="bi bi-x-circle me-1"></i>@L["Payees_ClearSearch"]
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="payees-grid">
            @foreach (var p in filtered)
            {
                <article class="card shadow-sm payee-card">
                    <div class="card-body">
                        @if (_editingPayeeId == p.Id)
                        {
                            <EditForm Model="_renameModel" OnValidSubmit="@(() => SaveRenameAsync(p.Id))">
                                <DataAnnotationsValidator />

                                <div class="d-flex flex-column gap-2">
                                    <label class="form-label mb-0">@L["Payees_Field_Name"]</label>
                                    <InputText class="form-control form-control-sm" @bind-Value="_renameModel.Name" />
                                    <div class="d-flex gap-2">
                                        <button class="btn btn-sm btn-success" type="submit" disabled="@_isBusy">
                                            <i class="bi bi-check me-1"></i>@L["Payees_Save"]
                                        </button>
                                        <button class="btn btn-sm btn-outline-secondary" type="button" @onclick="CancelRename" disabled="@_isBusy">
                                            <i class="bi bi-x me-1"></i>@L["Payees_Cancel"]
                                        </button>
                                    </div>
                                </div>
                            </EditForm>
                        }
                        else
                        {
                            <div class="d-flex align-items-center justify-content-between gap-2">
                                <div class="d-flex align-items-center min-w-0">
                                    <i class="bi bi-person-circle text-primary me-2 fs-5"></i>
                                    <span class="fw-semibold text-truncate" title="@p.Name">@p.Name</span>
                                </div>
                                <div class="d-flex gap-1">
                                    <button class="btn btn-sm btn-outline-primary"
                                            type="button"
                                            @onclick="@(() => StartRename(p))"
                                            disabled="@_isBusy"
                                            title="@L["Payees_Action_Rename"]">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger"
                                            type="button"
                                            @onclick="@(() => DeleteAsync(p))"
                                            disabled="@_isBusy"
                                            title="@L["Payees_Action_Delete"]">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                </article>
            }
        </div>

        <div class="card shadow-sm mt-3">
            <div class="card-footer bg-light">
                <div class="d-flex justify-content-between align-items-center">
                    <small class="text-muted">
                        @(filtered.Count == 1 ? L["Payees_Count_Singular", filtered.Count] : L["Payees_Count_Plural", filtered.Count])
                    </small>
                    <small class="text-muted">
                        <i class="bi bi-info-circle me-1"></i>@L["Payees_Footer_Hint"]
                    </small>
                </div>
            </div>
        </div>
    }
}

<style>
    .payee-row {
        transition: all 0.2s ease-in-out;
    }

    .payee-row:hover {
        background-color: rgba(13, 110, 253, 0.05) !important;
    }
</style>

@code {
    private IReadOnlyList<PayeeDto>? _items;
    private bool _isBusy;
    private string? _error;
    private string? _info;

    private string _search = string.Empty;
    private bool _showCreateForm;

    private Guid? _editingPayeeId;
    private readonly RenamePayeeFormModel _renameModel = new();
    private CreatePayeeFormModel _createModel = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _error = null;
        _items = null;

        await ExecuteApiAsync(async ct =>
        {
            _items = await PayeesApi.ListAsync(ct);
        });
    }

    private void ToggleCreateForm()
    {
        _showCreateForm = !_showCreateForm;
        _error = null;
        _info = null;

        if (_showCreateForm)
            _createModel = new();
    }

    private async Task CreateAsync()
    {
        if (_isBusy)
            return;

        _isBusy = true;
        _error = null;
        _info = null;

        try
        {
            await ExecuteApiAsync(async ct =>
            {
                await PayeesApi.CreateAsync(new CreatePayeeRequest(_createModel.Name.Trim()), ct);
                _createModel = new();
                _showCreateForm = false;
                _info = L["Payees_Message_Created"];
                _items = await PayeesApi.ListAsync(ct);
            });
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private void StartRename(PayeeDto payee)
    {
        _error = null;
        _info = null;

        _editingPayeeId = payee.Id;
        _renameModel.Name = payee.Name;
    }

    private void CancelRename()
    {
        _editingPayeeId = null;
        _renameModel.Name = string.Empty;
    }

    private async Task SaveRenameAsync(Guid payeeId)
    {
        if (_isBusy)
            return;

        _isBusy = true;
        _error = null;
        _info = null;

        try
        {
            await ExecuteApiAsync(async ct =>
            {
                await PayeesApi.RenameAsync(payeeId, _renameModel.Name.Trim(), ct);
                _editingPayeeId = null;
                _info = L["Payees_Message_Renamed"];
                _items = await PayeesApi.ListAsync(ct);
            });
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task DeleteAsync(PayeeDto payee)
    {
        if (_isBusy)
            return;

        var confirmed = await JS.InvokeAsync<bool>("confirm", L["Payees_Confirm_Delete", payee.Name]);
        if (!confirmed)
            return;

        _isBusy = true;
        _error = null;
        _info = null;

        try
        {
            await ExecuteApiAsync(async ct =>
            {
                await PayeesApi.DeleteAsync(payee.Id, ct);
                _info = L["Payees_Message_Deleted"];
                _items = await PayeesApi.ListAsync(ct);
            });
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private List<PayeeDto> GetFilteredPayees()
    {
        if (_items is null)
            return [];

        return _items
            .Where(p => string.IsNullOrWhiteSpace(_search) || p.Name.Contains(_search, StringComparison.OrdinalIgnoreCase))
            .OrderBy(p => p.Name, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private void ClearSearch()
    {
        _search = string.Empty;
    }

    private sealed class CreatePayeeFormModel
    {
        [Required]
        [StringLength(100, MinimumLength = 1)]
        public string Name { get; set; } = string.Empty;
    }

    private sealed class RenamePayeeFormModel
    {
        [Required]
        [StringLength(100, MinimumLength = 1)]
        public string Name { get; set; } = string.Empty;
    }
}

