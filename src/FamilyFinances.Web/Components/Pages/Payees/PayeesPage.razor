@page "/payees"
@inherits ApiPageBase
@using System.ComponentModel.DataAnnotations
@using FamilyFinances.Application.Ledger.Payees.Dtos
@using FamilyFinances.Application.Ledger.Payees.Requests
@using FamilyFinances.Web.Api
@using FamilyFinances.Web.Components.Base
@using Microsoft.JSInterop
@inject PayeesApi PayeesApi
@inject IJSRuntime JS

<!-- Header -->
<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h3 class="mb-1">Payees</h3>
        <p class="text-muted mb-0">
            @if (_items is not null)
            {
                var filtered = GetFilteredPayees();
                <i class="bi bi-person me-1"></i>
                <span>@filtered.Count payee@(filtered.Count != 1 ? "s" : "")</span>
                @if (!string.IsNullOrWhiteSpace(_search))
                {
                    <span class="text-muted"> (filtered from @_items.Count total)</span>
                }
            }
        </p>
    </div>

    <button class="btn @(_showCreateForm ? "btn-outline-secondary" : "btn-primary")" @onclick="ToggleCreateForm">
        <i class="bi @(_showCreateForm ? "bi-x-circle" : "bi-plus-circle") me-1"></i>
        @(_showCreateForm ? "Cancel" : "New Payee")
    </button>
</div>

<!-- Alerts -->
@if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-2"></i>@_error
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!string.IsNullOrWhiteSpace(_info))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2"></i>@_info
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Create Form -->
@if (_showCreateForm)
{
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="card-title mb-0">
                <i class="bi bi-person-plus me-2"></i>New Payee
            </h5>
        </div>
        <div class="card-body">
            <EditForm Model="_createModel" OnValidSubmit="CreateAsync">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger" />

                <div class="d-flex gap-2 align-items-end">
                    <div class="flex-grow-1">
                        <label class="form-label">
                            <i class="bi bi-pencil me-1"></i>Name
                        </label>
                        <InputText class="form-control" @bind-Value="_createModel.Name" placeholder="Enter payee name" />
                    </div>

                    <button class="btn btn-success" type="submit" disabled="@_isBusy">
                        @if (_isBusy)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                        }
                        <i class="bi bi-check-circle me-1"></i>Create
                    </button>

                    <button class="btn btn-outline-secondary" type="button" @onclick="ToggleCreateForm" disabled="@_isBusy">
                        <i class="bi bi-x-circle me-1"></i>Cancel
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

<!-- Search Bar -->
<div class="card shadow-sm mb-4">
    <div class="card-body">
        <div class="input-group">
            <span class="input-group-text bg-white">
                <i class="bi bi-search"></i>
            </span>
            <input type="text" class="form-control border-start-0" placeholder="Search payees..." @bind="_search" @bind:event="oninput" />
            @if (!string.IsNullOrWhiteSpace(_search))
            {
                <button class="btn btn-outline-secondary" type="button" @onclick="ClearSearch">
                    <i class="bi bi-x"></i>
                </button>
            }
        </div>
    </div>
</div>

<!-- Content -->
@if (_items is null)
{
    <div class="d-flex justify-content-center align-items-center" style="min-height: 400px;">
        <div class="text-center">
            <div class="spinner-border text-primary mb-3" role="status" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="text-muted">Loading payees...</p>
        </div>
    </div>
}
else if (_items.Count == 0)
{
    <div class="card shadow-sm">
        <div class="card-body text-center py-5">
            <i class="bi bi-person display-1 text-muted mb-3"></i>
            <h5 class="text-muted">No payees yet</h5>
            <p class="text-muted">Create your first payee to track who you pay or receive money from.</p>
            <button class="btn btn-primary mt-3" @onclick="ToggleCreateForm">
                <i class="bi bi-person-plus me-1"></i>Create Payee
            </button>
        </div>
    </div>
}
else
{
    var filtered = GetFilteredPayees();

    @if (filtered.Count == 0)
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <i class="bi bi-search display-1 text-muted mb-3"></i>
                <h5 class="text-muted">No results found</h5>
                <p class="text-muted">Try adjusting your search criteria.</p>
                <button class="btn btn-outline-secondary mt-3" @onclick="ClearSearch">
                    <i class="bi bi-x-circle me-1"></i>Clear Search
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="border-0 ps-3">
                                    <i class="bi bi-person me-1"></i>Name
                                </th>
                                <th class="border-0 text-end pe-3" style="width: 200px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in filtered)
                            {
                                <tr class="payee-row">
                                    <td class="ps-3">
                                        @if (_editingPayeeId == p.Id)
                                        {
                                            <EditForm Model="_renameModel" OnValidSubmit="@(() => SaveRenameAsync(p.Id))">
                                                <DataAnnotationsValidator />

                                                <div class="d-flex gap-2 align-items-center">
                                                    <i class="bi bi-pencil text-muted"></i>
                                                    <InputText class="form-control form-control-sm" @bind-Value="_renameModel.Name" style="max-width: 400px;" />
                                                    <button class="btn btn-sm btn-success" type="submit" disabled="@_isBusy">
                                                        <i class="bi bi-check me-1"></i>Save
                                                    </button>
                                                    <button class="btn btn-sm btn-outline-secondary" type="button" @onclick="CancelRename" disabled="@_isBusy">
                                                        <i class="bi bi-x me-1"></i>Cancel
                                                    </button>
                                                </div>
                                            </EditForm>
                                        }
                                        else
                                        {
                                            <div class="d-flex align-items-center">
                                                <i class="bi bi-person-circle text-primary me-2 fs-5"></i>
                                                <span class="fw-semibold">@p.Name</span>
                                            </div>
                                        }
                                    </td>
                                    <td class="text-end pe-3">
                                        @if (_editingPayeeId != p.Id)
                                        {
                                            <div class="d-flex justify-content-end gap-1">
                                                <button class="btn btn-sm btn-outline-primary" type="button" @onclick="@(() => StartRename(p))" disabled="@_isBusy" title="Rename">
                                                    <i class="bi bi-pencil"></i>
                                                </button>
                                                <button class="btn btn-sm btn-outline-danger" type="button" @onclick="@(() => DeleteAsync(p))" disabled="@_isBusy" title="Delete">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </div>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Footer -->
            <div class="card-footer bg-light">
                <div class="d-flex justify-content-between align-items-center">
                    <small class="text-muted">
                        Showing @filtered.Count payee@(filtered.Count != 1 ? "s" : "")
                    </small>
                    <small class="text-muted">
                        <i class="bi bi-info-circle me-1"></i>Use the search bar to filter payees
                    </small>
                </div>
            </div>
        </div>
    }
}

<style>
    .payee-row {
        transition: all 0.2s ease-in-out;
    }

    .payee-row:hover {
        background-color: rgba(13, 110, 253, 0.05) !important;
    }
</style>

@code {
    private IReadOnlyList<PayeeDto>? _items;
    private bool _isBusy;
    private string? _error;
    private string? _info;

    private string _search = "";
    private bool _showCreateForm;

    private Guid? _editingPayeeId;
    private readonly RenamePayeeFormModel _renameModel = new();
    private CreatePayeeFormModel _createModel = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _error = null;
        _items = null; // Show loading state

        await ExecuteApiAsync(async ct =>
        {
            _items = await PayeesApi.ListAsync(ct);
        });
    }

    private void ToggleCreateForm()
    {
        _showCreateForm = !_showCreateForm;
        _error = null;
        _info = null;

        if (_showCreateForm)
            _createModel = new();
    }

    private async Task CreateAsync()
    {
        if (_isBusy)
            return;

        _isBusy = true;
        _error = null;
        _info = null;

        try
        {
            await ExecuteApiAsync(async ct =>
            {
                await PayeesApi.CreateAsync(new CreatePayeeRequest(_createModel.Name.Trim()), ct);
                _createModel = new();
                _showCreateForm = false;
                _info = "Payee created successfully.";
                _items = await PayeesApi.ListAsync(ct);
            });
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private void StartRename(PayeeDto payee)
    {
        _error = null;
        _info = null;

        _editingPayeeId = payee.Id;
        _renameModel.Name = payee.Name;
    }

    private void CancelRename()
    {
        _editingPayeeId = null;
        _renameModel.Name = "";
    }

    private async Task SaveRenameAsync(Guid payeeId)
    {
        if (_isBusy)
            return;

        _isBusy = true;
        _error = null;
        _info = null;

        try
        {
            await ExecuteApiAsync(async ct =>
            {
                await PayeesApi.RenameAsync(payeeId, _renameModel.Name.Trim(), ct);
                _editingPayeeId = null;
                _info = "Payee renamed successfully.";
                _items = await PayeesApi.ListAsync(ct);
            });
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task DeleteAsync(PayeeDto payee)
    {
        if (_isBusy)
            return;

        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Delete payee '{payee.Name}'? This action cannot be undone.");
        if (!confirmed)
            return;

        _isBusy = true;
        _error = null;
        _info = null;

        try
        {
            await ExecuteApiAsync(async ct =>
            {
                await PayeesApi.DeleteAsync(payee.Id, ct);
                _info = "Payee deleted successfully.";
                _items = await PayeesApi.ListAsync(ct);
            });
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private List<PayeeDto> GetFilteredPayees()
    {
        if (_items is null)
            return new List<PayeeDto>();

        return _items
            .Where(p => string.IsNullOrWhiteSpace(_search) || p.Name.Contains(_search, StringComparison.OrdinalIgnoreCase))
            .OrderBy(p => p.Name, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private void ClearSearch()
    {
        _search = "";
    }

    private sealed class CreatePayeeFormModel
    {
        [Required]
        [StringLength(100, MinimumLength = 1)]
        public string Name { get; set; } = "";
    }

    private sealed class RenamePayeeFormModel
    {
        [Required]
        [StringLength(100, MinimumLength = 1)]
        public string Name { get; set; } = "";
    }
}
