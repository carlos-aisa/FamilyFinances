    private void OnAccountClicked(AccountDto account)
    {
        switch (_activeEntry)
        {
            case QuickEntryType.Expense:
                HandleExpenseSelection(account);
                break;
            case QuickEntryType.Income:
                HandleIncomeSelection(account);
                break;
            case QuickEntryType.Transfer:
                HandleTransferSelection(account);
                break;
        }
    }

    private void HandleExpenseSelection(AccountDto account)
    {
        if (account.Nature is AccountNature.Asset or AccountNature.Liability)
        {
            _expenseFromAssetId = account.Id;
            _selectedFromAccountId = account.Id;  //remove in the future
            return;
        }

        if (account.Nature == AccountNature.Expense)
        {
            _expenseToCategoryId = account.Id;
            _selectedToAccountId = account.Id;   //remove in the future
            return;
        }
    }

    private void HandleIncomeSelection(AccountDto account)
    {
        if (account.Nature == AccountNature.Income)
        {
            _incomeFromSourceId = account.Id;
            _selectedFromAccountId = account.Id;  //remove in the future
            return;
        }

        if (account.Nature == AccountNature.Asset)
        {
            _incomeToAssetId = account.Id;
            _selectedToAccountId = account.Id;  //remove in the future
            return;
        }
    }

    private void HandleTransferSelection(AccountDto account)
    {
        if (account.Nature != AccountNature.Asset)
            return;

        if (_transferFromAssetId is null)
        {
            _transferFromAssetId = account.Id; 
            _selectedFromAccountId = account.Id;  //remove in the future
            return;
        }

        if (_transferToAssetId is null)
        {
            _transferToAssetId = account.Id; 
            _selectedToAccountId = account.Id;  //remove in the future
            return;
        }

        // Both set: replace To 
        _transferToAssetId = account.Id;
        _selectedToAccountId = account.Id;   //remove in the future
    }


    private Task OnTransactionCreatedAsync()
    {
        // After creating a transaction, keep "Paid from" selected (typical behavior for repetitive expenses),
        // but clear the category to avoid accidental repeats.
        _selectedToAccountId = null;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private void ClearSelection()
    {
        _selectedFromAccountId = null;
        _selectedToAccountId = null;
    }

    private void SetActive(QuickEntryType type)
    {
        _activeEntry = type;
        SyncSelectionForActiveEntry();
    }

    private void SyncSelectionForActiveEntry()
    {
        switch (_activeEntry)
        {
            case QuickEntryType.Expense:
                _selectedFromAccountId = _expenseFromAssetId;
                _selectedToAccountId = _expenseToCategoryId;
                break;

            case QuickEntryType.Income:
                _selectedFromAccountId = _incomeFromSourceId;
                _selectedToAccountId = _incomeToAssetId;
                break;

            case QuickEntryType.Transfer:
                _selectedFromAccountId = _transferFromAssetId;
                _selectedToAccountId = _transferToAssetId;
                break;
        }
    }

    private void SwapTransferAccounts()
    {
        (_transferFromAssetId, _transferToAssetId) = (_transferToAssetId, _transferFromAssetId);
        (_selectedFromAccountId, _selectedToAccountId) = (_selectedToAccountId, _selectedFromAccountId);  //remove

    }

    private string GetAccountName(Guid? accountId)
    {
        if (accountId is null)
            return "—";

        var account = _accounts?.FirstOrDefault(a => a.Id == accountId.Value);
        return account?.Name ?? "—";
    }

    private string GetExpenseSubtitle()
       // => $"{GetAccountName(_expenseFromAssetId)} → {GetAccountName(_expenseToCategoryId)}";
       => "";
    private string GetIncomeSubtitle()
        //=> $"{GetAccountName(_incomeFromSourceId)} → {GetAccountName(_incomeToAssetId)}";
       => "";

    private string GetTransferSubtitle()
        //=> $"{GetAccountName(_transferFromAssetId)} → {GetAccountName(_transferToAssetId)}";
       => "";

    private IReadOnlyList<AccountDto> GetAccounts(AccountNature nature)
    {
        if (_accounts is null) return Array.Empty<AccountDto>();

        return _accounts
            .Where(a => a.Nature == nature && !a.IsClosed)
            .OrderBy(a => a.Name)
            .ToList();
    }
}
