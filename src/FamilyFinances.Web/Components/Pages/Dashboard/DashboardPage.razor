@page "/"
@rendermode InteractiveServer
@using FamilyFinances.Application.Reporting.Dtos
@using FamilyFinances.Application.Ledger.Transactions.Dtos
@using FamilyFinances.Web.Api
@using FamilyFinances.Web.Components.Base
@using FamilyFinances.Web.Components.Shared
@using FamilyFinances.Web.Components.Pages.Reports.Charts
@using FamilyFinances.Web.Features.Reports
@using FamilyFinances.Web.Features.Reports.Charts
@using FamilyFinances.Web.Features.Reports.Export
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Localization
@using Microsoft.JSInterop
@using FamilyFinances.Web
@using System.Globalization
@inherits ApiPageBase

@inject ReportsApi ReportsApi
@inject TransactionsApi TransactionsApi
@inject IStringLocalizer<SharedResource> L
@inject IJSRuntime JS

<AuthorizeView>
    <Authorized>
        <div class="d-flex align-items-center justify-content-between mb-4 ff-page-header">
            <div>
                <h3 class="mb-1 ff-page-title">
                    <i class="bi bi-speedometer2 me-2"></i>@L["Dashboard_Title"]
                </h3>
                <p class="text-muted mb-0 ff-page-subtitle">@L["Dashboard_Analytics_Subtitle"]</p>
            </div>
            <a class="btn btn-outline-secondary" href="/quick-entry" data-testid="dashboard-open-quick-entry">
                <i class="bi bi-lightning-charge me-1"></i>@L["Nav_QuickEntry"]
            </a>
        </div>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle me-2"></i>@_error
                <button type="button" class="btn-close" @onclick="@(() => _error = null)"></button>
            </div>
        }

        @if (_isLoading)
        {
            <div class="card shadow-sm ff-panel">
                <div class="card-body text-center py-5">
                    <div class="spinner-border text-primary mb-3 ff-spinner-lg" role="status">
                        <span class="visually-hidden">@L["Common_Loading"]</span>
                    </div>
                    <p class="text-muted">@L["Dashboard_LoadingAnalytics"]</p>
                </div>
            </div>
        }
        else if (_overview is not null)
        {
            @if (_overview.DataSufficiencyState != DashboardDataSufficiencyState.Complete)
            {
                <div class="alert alert-info mb-3 ff-info-note" role="alert" data-testid="dashboard-data-sufficiency-state">
                    <i class="bi bi-info-circle me-2"></i>
                    @GetDataSufficiencyMessage(_overview.DataSufficiencyState)
                </div>
            }

            <div class="row g-3 mb-3" data-testid="dashboard-kpi-strip">
                <div class="col-12 col-md-6 col-xl">
                    <div class="card shadow-sm border-start border-success border-4 h-100 ff-kpi-card ff-panel">
                        <div class="card-body">
                            <h6 class="text-muted text-uppercase mb-2 ff-kpi-label">@L["Dashboard_Kpi_Income"]</h6>
                            <h4 class="mb-1 text-success">@MoneyFormatter.FormatCentsWithSign(_overview.Income.ValueCents)</h4>
                            <small class="@MoneyFormatter.GetColorClass(_overview.Income.DeltaVsPreviousMonthCents)">
                                @L["Dashboard_DeltaVsPreviousMonth"] @MoneyFormatter.FormatCentsWithSign(_overview.Income.DeltaVsPreviousMonthCents)
                            </small>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-6 col-xl">
                    <div class="card shadow-sm border-start border-danger border-4 h-100 ff-kpi-card ff-panel">
                        <div class="card-body">
                            <h6 class="text-muted text-uppercase mb-2 ff-kpi-label">@L["Dashboard_Kpi_Expense"]</h6>
                            <h4 class="mb-1 text-danger">@MoneyFormatter.FormatCentsWithSign(-Math.Abs(_overview.Expense.ValueCents))</h4>
                            <small class="@MoneyFormatter.GetColorClass(_overview.Expense.DeltaVsPreviousMonthCents)">
                                @L["Dashboard_DeltaVsPreviousMonth"] @MoneyFormatter.FormatCentsWithSign(_overview.Expense.DeltaVsPreviousMonthCents)
                            </small>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-6 col-xl">
                    <div class="card shadow-sm border-start border-info border-4 h-100 ff-kpi-card ff-panel">
                        <div class="card-body">
                            <h6 class="text-muted text-uppercase mb-2 ff-kpi-label">@L["Dashboard_Kpi_NetResult"]</h6>
                            <h4 class="mb-1 @MoneyFormatter.GetColorClass(_overview.NetResult.ValueCents)">
                                @MoneyFormatter.FormatCentsWithSign(_overview.NetResult.ValueCents)
                            </h4>
                            <small class="@MoneyFormatter.GetColorClass(_overview.NetResult.DeltaVsPreviousMonthCents)">
                                @L["Dashboard_DeltaVsPreviousMonth"] @MoneyFormatter.FormatCentsWithSign(_overview.NetResult.DeltaVsPreviousMonthCents)
                            </small>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-6 col-xl">
                    <div class="card shadow-sm border-start border-primary border-4 h-100 ff-kpi-card ff-panel">
                        <div class="card-body">
                            <h6 class="text-muted text-uppercase mb-2 ff-kpi-label">@L["Dashboard_Kpi_NetWorth"]</h6>
                            <h4 class="mb-1 @MoneyFormatter.GetColorClass(_overview.NetWorth.ValueCents)">
                                @MoneyFormatter.FormatCentsWithSign(_overview.NetWorth.ValueCents)
                            </h4>
                            <small class="@MoneyFormatter.GetColorClass(_overview.NetWorth.DeltaVsPreviousMonthCents)">
                                @L["Dashboard_DeltaVsPreviousMonth"] @MoneyFormatter.FormatCentsWithSign(_overview.NetWorth.DeltaVsPreviousMonthCents)
                            </small>
                        </div>
                    </div>
                </div>
                @if (_overview.AssetTotal is not null)
                {
                    <div class="col-12 col-md-6 col-xl">
                        <div class="card shadow-sm border-start border-warning border-4 h-100 ff-kpi-card ff-panel">
                            <div class="card-body">
                                <h6 class="text-muted text-uppercase mb-2 ff-kpi-label">@L["Dashboard_Kpi_YtdNet"]</h6>
                                <h4 class="mb-1 @MoneyFormatter.GetColorClass(_ytdNetValue)">
                                    @MoneyFormatter.FormatCentsWithSign(_ytdNetValue)
                                </h4>
                                <small class="@MoneyFormatter.GetColorClass(_ytdNetDelta)">
                                    @L["Dashboard_DeltaVsPreviousMonth"] @MoneyFormatter.FormatCentsWithSign(_ytdNetDelta)
                                </small>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="ff-dashboard-cockpit">
                <div class="row g-3 mb-3 ff-dashboard-analytics-row ff-dashboard-analytics-row-2">
                    <div class="col-12 col-xxl-4">
                        @if (_monthlyIncomeVsExpenseSeries.Count == 0)
                        {
                            <ReportingChartEmptyState
                                Title="@L["Dashboard_MonthlyIncomeExpense_Title"]"
                                Description="@L["Reports_NoDailyPointsForMonth"]" />
                        }
                        else
                        {
                            <EvolutionChart
                                Mode="EvolutionChartMode.DailyInMonth"
                                Title="@L["Dashboard_MonthlyIncomeExpense_Title"]"
                                Subtitle="@L["Dashboard_MonthlyIncomeExpense_Subtitle", DateHelper.GetMonthName(_overview.AsOf.Month), _overview.AsOf.Year, _overview.AsOf.Day]"
                                Year="@_overview.AsOf.Year"
                                Month="@_overview.AsOf.Month"
                                YTickMaxTicks="5"
                                ShowFullRange="true"
                                DailySeries="@_monthlyIncomeVsExpenseSeries"
                                TestId="dashboard-monthly-income-expense-chart" />
                        }
                    </div>
                    <div class="col-12 col-xxl-4">
                        @if (_annualIncomeVsExpenseSeries.Count == 0)
                        {
                            <ReportingChartEmptyState
                                Title="@L["Dashboard_AnnualIncomeExpense_Title"]"
                                Description="@L["ReportingChart_Empty_NoPointsForFilters"]" />
                        }
                        else
                        {
                            <AnnualBarChart
                                Title="@L["Dashboard_AnnualIncomeExpense_Title"]"
                                Subtitle="@L["Dashboard_AnnualIncomeExpense_Subtitle"]"
                                Year="@_overview.AsOf.Year"
                                Series="@_annualIncomeVsExpenseSeries"
                                DataUntilMonth="@_overview.AsOf.Month"
                                LineSeriesKey="result"
                                TestId="dashboard-annual-income-expense-chart" />
                        }
                    </div>
                    <div class="col-12 col-xxl-4">
                        @if (_assetAnnualEvolutionSeries.Count == 0)
                        {
                            <ReportingChartEmptyState
                                Title="@L["Dashboard_AssetEvolution_Title"]"
                                Description="@L["ReportingChart_Empty_NoPointsForFilters"]" />
                        }
                        else
                        {
                            <EvolutionChart
                                Mode="EvolutionChartMode.MonthlyInYear"
                                Title="@L["Dashboard_AssetEvolution_Title"]"
                                Subtitle="@L["Dashboard_AssetEvolution_Subtitle"]"
                                Year="@_overview.AsOf.Year"
                                AnnualSeries="@_assetAnnualEvolutionSeries"
                                DataUntilMonth="@_overview.AsOf.Month"
                                TestId="dashboard-asset-evolution-chart" />
                        }
                    </div>
                </div>

                <div class="row g-3 ff-dashboard-analytics-row ff-dashboard-analytics-row-3">
                    <div class="col-12 col-xxl-4">
                        <div class="card shadow-sm h-100 ff-panel" data-testid="dashboard-pinned-groups">
                            <div class="card-header bg-transparent ff-panel-header d-flex flex-column flex-md-row justify-content-between align-items-md-start gap-2">
                                <div>
                                    <h6 class="mb-1">@L["Dashboard_PinnedGroups_Title"]</h6>
                                    <small class="text-muted">@L["Dashboard_PinnedGroups_Subtitle"]</small>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <button type="button" class="btn btn-sm btn-outline-secondary report-export-button ff-chart-export-button" @onclick="ExportPinnedGroupsCsvAsync" data-testid="dashboard-pinned-groups-export-csv" aria-label="@L["Reports_AriaExportCsv"]"><i class="bi bi-download me-1"></i>@L["Reports_AriaExportCsv"]</button>
                                    <span class="badge bg-secondary-subtle text-secondary">@GetSelectedPeriodBadge()</span>
                                </div>
                            </div>
                            <div class="card-body p-0">
                                @if (!string.IsNullOrWhiteSpace(_pinnedGroupsExportError))
                                {
                                    <div class="text-danger small p-3 pb-0">@_pinnedGroupsExportError</div>
                                }
                                @if (_overview.PinnedGroups is null || _overview.PinnedGroups.Count == 0)
                                {
                                    <div class="p-3 text-muted"><p class="mb-2">@L["Dashboard_PinnedGroups_Empty"]</p><a href="/account-groups">@L["Nav_AccountGroups"]</a></div>
                                }
                                else
                                {
                                    <div class="table-responsive">
                                        <table class="table table-sm align-middle mb-0 ff-data-table">
                                            <thead class="table-light">
                                                <tr>
                                                    <th class="ps-3">@L["AccountGroups_Title"]</th>
                                                    <th class="text-end">@L["Dashboard_PinnedGroups_Month"]</th>
                                                    <th class="text-end pe-3">@L["Dashboard_PinnedGroups_Ytd"]</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var group in _overview.PinnedGroups)
                                                {
                                                    <tr>
                                                        <td class="ps-3">@group.GroupName</td>
                                                        @if (group.MetricKind == DashboardPinnedGroupMetricKind.Expense)
                                                        {
                                                            <td class="text-end">@MoneyFormatter.FormatCents(Math.Abs(group.MonthOperationalResultCents))</td>
                                                            <td class="text-end pe-3">@MoneyFormatter.FormatCents(Math.Abs(group.YtdOperationalResultCents))</td>
                                                        }
                                                        else
                                                        {
                                                            <td class="text-end @MoneyFormatter.GetColorClass(group.MonthOperationalResultCents)">@MoneyFormatter.FormatCentsWithSign(group.MonthOperationalResultCents)</td>
                                                            <td class="text-end pe-3 @MoneyFormatter.GetColorClass(group.YtdOperationalResultCents)">@MoneyFormatter.FormatCentsWithSign(group.YtdOperationalResultCents)</td>
                                                        }
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-xxl-4">
                        <div class="card shadow-sm h-100 ff-panel" data-testid="dashboard-expense-kind-ranking">
                            <div class="card-header bg-transparent ff-panel-header d-flex flex-column flex-md-row justify-content-between align-items-md-start gap-2">
                                <div>
                                    <h6 class="mb-1">@L["Dashboard_ExpenseKindRanking_Title"]</h6>
                                    <small class="text-muted">@L["Dashboard_ExpenseKindRanking_Subtitle", DateHelper.GetMonthName(_overview.AsOf.Month)]</small>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <button type="button" class="btn btn-sm btn-outline-secondary report-export-button ff-chart-export-button" @onclick="ExportExpenseKindRankingCsvAsync" data-testid="dashboard-expense-kind-ranking-export-csv" aria-label="@L["Reports_AriaExportCsv"]"><i class="bi bi-download me-1"></i>@L["Reports_AriaExportCsv"]</button>
                                    <span class="badge bg-secondary-subtle text-secondary">@GetSelectedPeriodBadge()</span>
                                </div>
                            </div>
                            <div class="card-body">
                                @if (!string.IsNullOrWhiteSpace(_expenseKindExportError))
                                {
                                    <div class="text-danger small mb-2">@_expenseKindExportError</div>
                                }
                                @if (_overview.ExpenseKindRanking is null || _overview.ExpenseKindRanking.Count == 0)
                                {
                                    <p class="text-muted mb-0">@L["Reports_NoDataForPeriod"]</p>
                                }
                                else
                                {
                                    var maximum = _overview.ExpenseKindRanking.Max(row => row.AmountCents);
                                    <div class="ff-dashboard-rank-list">
                                        @foreach (var row in _overview.ExpenseKindRanking)
                                        {
                                            var label = row.IsOthers
                                            ? L["Dashboard_ExpenseComposition_Others"].Value
                                            : row.Label;

                                            <div class="ff-dashboard-rank-row small"
                                                 data-testid="dashboard-expense-kind-row">

                                                <span class="ff-dashboard-rank-label"
                                                      title="@label">
                                                    @label
                                                </span>

                                                <div class="progress ff-dashboard-rank-progress">
                                                    <div class="progress-bar bg-primary ff-dashboard-rank-bar"
                                                         role="progressbar"
                                                         style="--ff-progress-width:@GetPercentageWidth(row.AmountCents, maximum)">
                                                    </div>
                                                </div>

                                                <strong class="ff-dashboard-rank-amount">
                                                    @MoneyFormatter.FormatCents(row.AmountCents)
                                                </strong>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-xxl-4">
                        <div class="card shadow-sm h-100 ff-panel" data-testid="dashboard-latest-expenses">
                            <div class="card-header bg-transparent ff-panel-header d-flex flex-column flex-md-row justify-content-between align-items-md-start gap-2">
                                <div>
                                    <h6 class="mb-1">@L["Dashboard_LatestExpenses_Title"]</h6>
                                    <small class="text-muted">@L["Dashboard_LatestExpenses_Subtitle"]</small>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <button type="button" class="btn btn-sm btn-outline-secondary report-export-button ff-chart-export-button" @onclick="ExportLatestExpensesCsvAsync" data-testid="dashboard-latest-expenses-export-csv" aria-label="@L["Reports_AriaExportCsv"]"><i class="bi bi-download me-1"></i>@L["Reports_AriaExportCsv"]</button>
                                    <span class="badge bg-secondary-subtle text-secondary">@GetSelectedPeriodBadge()</span>
                                </div>
                            </div>
                            <div class="card-body p-0">
                                @if (!string.IsNullOrWhiteSpace(_latestExpensesExportError))
                                {
                                    <div class="text-danger small p-3 pb-0">@_latestExpensesExportError</div>
                                }
                                <MovementList Items="@_latestExpenses" EmptyMessage="@L["Dashboard_LatestExpenses_Empty"]" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </Authorized>

    <NotAuthorized>
        <div class="card shadow-sm ff-panel">
            <div class="card-body text-center py-5">
                <i class="bi bi-shield-lock display-1 text-muted mb-3"></i>
                <h5 class="text-muted">@L["Dashboard_AuthenticationRequired"]</h5>
                <p class="text-muted">@L["Dashboard_MustLogin"]</p>
                <a class="btn btn-primary mt-3" href="/login">
                    <i class="bi bi-box-arrow-in-right me-1"></i>@L["Common_Login"]
                </a>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private DashboardOverviewDto? _overview;
    private string? _error;
    private bool _isLoading = true;
    private long _ytdNetValue;
    private long _ytdNetDelta;
    private IReadOnlyList<MonthlyChartSeries> _monthlyIncomeVsExpenseSeries = Array.Empty<MonthlyChartSeries>();
    private IReadOnlyList<AnnualChartSeries> _annualIncomeVsExpenseSeries = Array.Empty<AnnualChartSeries>();
    private IReadOnlyList<AnnualChartSeries> _assetAnnualEvolutionSeries = Array.Empty<AnnualChartSeries>();
    private IReadOnlyList<MovementListItem> _latestExpenses = Array.Empty<MovementListItem>();
    private string? _expenseKindExportError;
    private string? _pinnedGroupsExportError;
    private string? _latestExpensesExportError;

    protected override async Task OnInitializedAsync()
    {
        await LoadOverviewAsync();
    }

    private async Task LoadOverviewAsync()
    {
        _isLoading = true;
        _error = null;
        _overview = null;
        _monthlyIncomeVsExpenseSeries = Array.Empty<MonthlyChartSeries>();
        _annualIncomeVsExpenseSeries = Array.Empty<AnnualChartSeries>();
        _assetAnnualEvolutionSeries = Array.Empty<AnnualChartSeries>();
        _latestExpenses = Array.Empty<MovementListItem>();
        _expenseKindExportError = null;
        _pinnedGroupsExportError = null;
        _latestExpensesExportError = null;
        StateHasChanged();

        try
        {
            _overview = await ExecuteApiAsync(ct => ReportsApi.GetDashboardOverviewAsync(ct: ct));
            if (_overview is null)
                return;

            _monthlyIncomeVsExpenseSeries = BuildMonthlyIncomeExpenseSeries(_overview);
            _annualIncomeVsExpenseSeries = BuildAnnualIncomeExpenseSeries(_overview);
            _latestExpenses = (await ExecuteApiAsync(ct => TransactionsApi.GetLatestExpensesAsync(ct)) ?? [])
                .Select(movement => new MovementListItem(
                    movement.BookedOn,
                    movement.Description,
                    movement.AmountCents))
                .ToList();
            await LoadAnnualEvolutionSeriesAsync(_overview.AsOf.Year);
            await CalculateYtdKpiAsync();
        }
        catch (Exception ex)
        {
            _error = L["Reports_Error_LoadFailed", ex.Message];
        }
        finally
        {
            _isLoading = false;
        }
    }

    private IReadOnlyList<MonthlyChartSeries> BuildMonthlyIncomeExpenseSeries(DashboardOverviewDto overview)
    {
        var orderedPoints = overview.DailyIncomeVsExpense
            .OrderBy(point => point.Day)
            .ToList();

        if (orderedPoints.Count == 0)
            return Array.Empty<MonthlyChartSeries>();

        return
        [
            new MonthlyChartSeries(
                Key: "income",
                Label: L["Dashboard_Kpi_Income"],
                ColorHex: ChartSemanticPalette.ResolveSemantic(ChartSemanticPalette.Income),
                Points: orderedPoints.Select(point => new MonthlyChartPoint(point.Day, point.IncomeCents)).ToList(),
                BaselineValue: 0m),
            new MonthlyChartSeries(
                Key: "expense",
                Label: L["Dashboard_Kpi_Expense"],
                ColorHex: ChartSemanticPalette.ResolveSemantic(ChartSemanticPalette.Expense),
                Points: orderedPoints.Select(point => new MonthlyChartPoint(point.Day, point.ExpenseCents)).ToList(),
                BaselineValue: 0m)
        ];
    }

    private IReadOnlyList<AnnualChartSeries> BuildAnnualIncomeExpenseSeries(DashboardOverviewDto overview)
    {
        var pointsByMonth = overview.YtdSummary.MonthlyNetPoints
            .ToDictionary(point => point.Month, point => point);

        var incomePoints = new List<AnnualChartPoint>(12);
        var expensePoints = new List<AnnualChartPoint>(12);
        var resultPoints = new List<AnnualChartPoint>(12);
        for (var month = 1; month <= 12; month++)
        {
            var point = pointsByMonth.GetValueOrDefault(month);
            incomePoints.Add(new AnnualChartPoint(month, point?.IncomeCents ?? 0L));
            expensePoints.Add(new AnnualChartPoint(month, point?.ExpenseCents ?? 0L));
            resultPoints.Add(new AnnualChartPoint(month, point?.NetCents ?? 0L));
        }

        return
        [
            new AnnualChartSeries(
                Key: "income",
                Label: L["Dashboard_Kpi_Income"],
                ColorHex: ChartSemanticPalette.ResolveSemantic(ChartSemanticPalette.Income),
                Points: incomePoints),
            new AnnualChartSeries(
                Key: "expense",
                Label: L["Dashboard_Kpi_Expense"],
                ColorHex: ChartSemanticPalette.ResolveSemantic(ChartSemanticPalette.Expense),
                Points: expensePoints),
            new AnnualChartSeries(
                Key: "result",
                Label: L["Dashboard_Kpi_NetResult"],
                ColorHex: ChartSemanticPalette.ResolveSemantic(ChartSemanticPalette.Balance),
                Points: resultPoints)
        ];
    }

    private async Task LoadAnnualEvolutionSeriesAsync(int year)
    {
        var assetEvolution = await ExecuteApiAsync(
            ct => ReportsApi.GetStateEvolutionAsync(year, MonthlyEvolutionScope.AssetTotal, ct));
        if (assetEvolution is null)
            return;

        _assetAnnualEvolutionSeries = AnnualChartDatasetAdapter.BuildEndBalanceSeries(
            assetEvolution,
            key: "asset-total",
            label: L["Dashboard_AssetEvolution_Legend"],
            colorHex: ChartSemanticPalette.ResolveSemantic(ChartSemanticPalette.Neutral));

    }

    private static string GetPercentageWidth(long value, long maximum)
    {
        if (maximum <= 0L || value <= 0L)
            return "0%";

        var percentage = Math.Clamp(
            value * 100m / maximum,
            0m,
            100m);

        return $"{percentage.ToString("0.##", CultureInfo.InvariantCulture)}%";
    }

    private string GetDataSufficiencyMessage(DashboardDataSufficiencyState state)
    {
        return state switch
        {
            DashboardDataSufficiencyState.Complete => L["Dashboard_DataState_Complete"],
            DashboardDataSufficiencyState.Partial => L["Dashboard_DataState_Partial"],
            _ => L["Dashboard_DataState_InsufficientHistory"]
        };
    }

    private string GetSelectedPeriodBadge()
        => L["Reports_BadgePeriod", $"{_overview!.AsOf.Month:00}-{_overview.AsOf.Year:D4}"];

    private async Task ExportExpenseKindRankingCsvAsync()
    {
        _expenseKindExportError = null;
        var title = L["Dashboard_ExpenseKindRanking_Title"].Value;
        var rows = (_overview?.ExpenseKindRanking ?? [])
            .Select(row => (IReadOnlyList<string?>)[row.Label, MoneyFormatter.FormatCents(row.AmountCents)])
            .ToList();

        await DownloadDashboardCsvAsync(
            title,
            "dashboard-expense-kind-ranking",
            [L["Transactions_TableDescription"], L["Transactions_TableAmount"]],
            rows,
            error => _expenseKindExportError = error);
    }

    private async Task ExportPinnedGroupsCsvAsync()
    {
        _pinnedGroupsExportError = null;
        var title = L["Dashboard_PinnedGroups_Title"].Value;
        var rows = (_overview?.PinnedGroups ?? [])
            .Select(group => (IReadOnlyList<string?>)
            [
                group.GroupName,
                FormatPinnedGroupAmount(group.MonthOperationalResultCents, group.MetricKind),
                FormatPinnedGroupAmount(group.YtdOperationalResultCents, group.MetricKind)
            ])
            .ToList();

        await DownloadDashboardCsvAsync(
            title,
            "dashboard-pinned-groups",
            [L["AccountGroups_Title"], L["Dashboard_PinnedGroups_Month"], L["Dashboard_PinnedGroups_Ytd"]],
            rows,
            error => _pinnedGroupsExportError = error);
    }

    private async Task ExportLatestExpensesCsvAsync()
    {
        _latestExpensesExportError = null;
        var title = L["Dashboard_LatestExpenses_Title"].Value;
        var rows = _latestExpenses
            .Select(item => (IReadOnlyList<string?>)
            [
                item.BookedOn.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture),
                item.Description,
                MoneyFormatter.FormatCents(Math.Abs(item.AmountCents))
            ])
            .ToList();

        await DownloadDashboardCsvAsync(
            title,
            "dashboard-latest-expenses",
            [L["Transactions_TableDate"], L["Transactions_TableDescription"], L["Transactions_TableAmount"]],
            rows,
            error => _latestExpensesExportError = error);
    }

    private async Task DownloadDashboardCsvAsync(
        string title,
        string filePrefix,
        IReadOnlyList<string> headers,
        IReadOnlyList<IReadOnlyList<string?>> rows,
        Action<string> setError)
    {
        var csv = ReportCsvBuilder.Build(
            reportName: title,
            context: new Dictionary<string, string?> { [L["Reports_SelectedPeriod"]] = GetSelectedPeriodBadge() },
            headers: headers,
            rows: rows);

        try
        {
            var fileName = $"{ReportExportInterop.BuildFileName(filePrefix, _overview!.AsOf.Year, _overview.AsOf.Month.ToString("00", CultureInfo.InvariantCulture))}.csv";
            await JS.DownloadCsvAsync(fileName, csv);
        }
        catch (Exception ex)
        {
            setError(L["Reports_Error_ExportCsvFailed", ex.Message]);
        }
    }

    private static string FormatPinnedGroupAmount(long amountCents, DashboardPinnedGroupMetricKind metricKind)
        => metricKind == DashboardPinnedGroupMetricKind.Expense
            ? MoneyFormatter.FormatCents(Math.Abs(amountCents))
            : MoneyFormatter.FormatCentsWithSign(amountCents);

    private async Task CalculateYtdKpiAsync()
    {
        if (_overview is null || _overview.AssetTotal is null)
            return;

        var previousYearEnd = new DateOnly(_overview.AsOf.Year - 1, 12, 31);
        var previousYearAssetTotal = await ExecuteApiAsync(
            ct => ReportsApi.GetAssetTotalBalanceAsync(previousYearEnd, ct));

        if (previousYearAssetTotal is null)
            return;

        // YTD KPI: current assets minus asset balance at previous year-end (31/12).
        _ytdNetValue = _overview.AssetTotal.ValueCents - previousYearAssetTotal.TotalCents;
        _ytdNetDelta = _overview.AssetTotal.DeltaVsPreviousMonthCents;
    }
}

