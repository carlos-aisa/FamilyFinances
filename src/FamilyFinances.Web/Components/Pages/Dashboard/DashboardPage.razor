@page "/"
@rendermode InteractiveServer
@using System.Globalization
@using FamilyFinances.Application.Ledger.Accounts.Dtos
@using FamilyFinances.Application.Ledger.Payees.Dtos
@using FamilyFinances.Domain.Ledger.Accounts
@using FamilyFinances.Web.Components.Dashboard
@using FamilyFinances.Web.Components.QuickEntry
@using FamilyFinances.Web
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Localization
@inherits FamilyFinances.Web.Components.Base.ApiPageBase

@inject FamilyFinances.Web.Api.IAccountsApi AccountsApi
@inject FamilyFinances.Web.Api.PayeesApi PayeesApi
@inject FamilyFinances.Web.Api.TransactionsApi TransactionsApi
@inject IStringLocalizer<SharedResource> L

<AuthorizeView>
    <Authorized Context="auth">
        <div class="d-flex align-items-center justify-content-between mb-4 ff-page-header">
            <div>
                <h3 class="mb-1 ff-page-title">
                    <i class="bi bi-speedometer2 me-2"></i>@L["Dashboard_Title"]
                </h3>
                <p class="text-muted mb-0 ff-page-subtitle">@L["Dashboard_Subtitle"]</p>
            </div>
        </div>

        @if (_accounts is null)
        {
            <div class="d-flex justify-content-center align-items-center" style="min-height: 400px;">
                <div class="text-center">
                    <div class="spinner-border text-primary mb-3" role="status" style="width: 3rem; height: 3rem;">
                        <span class="visually-hidden">@L["Common_Loading"]</span>
                    </div>
                    <p class="text-muted">@L["Dashboard_LoadingAccounts"]</p>
                </div>
            </div>
        }
        else if (_hasAnyTransactions == false)
        {
            <div class="d-flex justify-content-center align-items-center" style="min-height: 400px;">
                <div class="text-center">
                    <i class="bi bi-rocket-takeoff display-1 text-primary mb-3"></i>
                    <h4 class="mb-3">@L["Dashboard_GetStarted_Title"]</h4>
                    <p class="text-muted mb-4">@L["Dashboard_GetStarted_Description"]</p>
                    <button class="btn btn-success btn-lg" @onclick="GoToOpeningBalance">
                        <i class="bi bi-play-circle me-2"></i>@L["Dashboard_GetStarted_Action"]
                    </button>
                </div>
            </div>
        }
        else
        {
            <div class="row g-4 ff-dashboard-grid">
                <div class="col-12 col-lg-7 ff-dashboard-primary">
                    <QuickEntryCard Title="@Specs[QuickEntryType.Expense].Title"
                                    Subtitle="@Specs[QuickEntryType.Expense].Hint"
                                    Type="@QuickEntryType.Expense"
                                    IsActive="@(_activeEntry == QuickEntryType.Expense)"
                                    OnHeaderClick="@(() => SetActive(QuickEntryType.Expense))">
                        <QuickEntryDrawer Mode="@(_activeEntry ?? QuickEntryType.Expense)"
                                          Specs="Specs"
                                          Accounts="_accounts"
                                          Payees="_payees"
                                          SelectedFromAccountId="_selectedFromAccountId"
                                          SelectedToAccountId="_selectedToAccountId"
                                          OnTransactionCreated="OnTransactionCreatedAsync"
                                          OnClearSelection="ClearSelection"
                                          OnSwapAccounts="SwapTransferAccounts" />

                        <div class="mt-3">
                            <small class="text-muted">
                                <i class="bi bi-info-circle me-1"></i>
                                @L["Dashboard_QuickEntryHint_Expense"]
                            </small>
                        </div>
                    </QuickEntryCard>

                    <QuickEntryCard Title="@Specs[QuickEntryType.Income].Title"
                                    Subtitle="@Specs[QuickEntryType.Income].Hint"
                                    Type="@QuickEntryType.Income"
                                    IsActive="@(_activeEntry == QuickEntryType.Income)"
                                    OnHeaderClick="@(() => SetActive(QuickEntryType.Income))">
                        <QuickEntryDrawer Mode="@(_activeEntry ?? QuickEntryType.Income)"
                                          Specs="Specs"
                                          Accounts="_accounts"
                                          Payees="_payees"
                                          SelectedFromAccountId="_incomeFromSourceId"
                                          SelectedToAccountId="_incomeToAssetId"
                                          OnTransactionCreated="OnTransactionCreatedAsync"
                                          OnClearSelection="ClearSelection"
                                          OnSwapAccounts="SwapTransferAccounts" />
                    </QuickEntryCard>

                    <QuickEntryCard Title="@Specs[QuickEntryType.Transfer].Title"
                                    Subtitle="@Specs[QuickEntryType.Transfer].Hint"
                                    Type="@QuickEntryType.Transfer"
                                    IsActive="@(_activeEntry == QuickEntryType.Transfer)"
                                    OnHeaderClick="@(() => SetActive(QuickEntryType.Transfer))">
                        <QuickEntryDrawer Mode="@(_activeEntry ?? QuickEntryType.Transfer)"
                                          Specs="Specs"
                                          Accounts="_accounts"
                                          Payees="_payees"
                                          SelectedFromAccountId="_transferFromAssetId"
                                          SelectedToAccountId="_transferToAssetId"
                                          OnTransactionCreated="OnTransactionCreatedAsync"
                                          OnClearSelection="ClearSelection"
                                          OnSwapAccounts="SwapTransferAccounts" />
                    </QuickEntryCard>

                    <QuickEntryCard Title="@Specs[QuickEntryType.Refund].Title"
                                    Subtitle="@Specs[QuickEntryType.Refund].Hint"
                                    Type="@QuickEntryType.Refund"
                                    IsActive="@(_activeEntry == QuickEntryType.Refund)"
                                    OnHeaderClick="@(() => SetActive(QuickEntryType.Refund))">
                        <QuickEntryDrawer Mode="@(_activeEntry ?? QuickEntryType.Refund)"
                                          Specs="Specs"
                                          Accounts="_accounts"
                                          Payees="_payees"
                                          SelectedFromAccountId="_refundFromExpenseId"
                                          SelectedToAccountId="_refundToAssetId"
                                          OnTransactionCreated="OnTransactionCreatedAsync"
                                          OnClearSelection="ClearSelection"
                                          OnSwapAccounts="SwapTransferAccounts" />
                    </QuickEntryCard>

                    <MortgagePaymentWidget Accounts="_accounts"
                                           IsExpanded="@(_expandedWidget == "mortgage")"
                                           OnToggle="OnWidgetToggle"
                                           OnTransactionCreated="OnWidgetTransactionCreatedAsync" />

                    <MultiSplitWidget Accounts="_accounts"
                                      Payees="_payees"
                                      IsExpanded="@(_expandedWidget == "multisplit")"
                                      OnToggle="OnWidgetToggle"
                                      OnTransactionCreated="OnWidgetTransactionCreatedAsync" />
                </div>

                <div class="col-12 col-lg-5 ff-dashboard-secondary">
                    @foreach (var nature in _natureOrder)
                    {
                        var items = GetAccounts(nature);

                        if (items.Count == 0)
                            continue;

                        <div class="card shadow-sm mb-3 border-start border-4 ff-panel ff-dashboard-nature-card @GetNatureBorderClass(nature)">
                            <div class="card-header ff-panel-header @GetNatureHeaderClass(nature)">
                                <div class="d-flex justify-content-between align-items-center">
                                    <h6 class="mb-0 @GetNatureTextClass(nature)">
                                        <i class="@GetNatureIcon(nature) me-2"></i>@GetNatureLabel(nature)
                                    </h6>
                                    <span class="badge @GetNatureCountBadgeClass(nature)">@items.Count</span>
                                </div>
                            </div>

                            <div class="card-body p-0">
                                @if (items.Count > 8)
                                {
                                    <div class="p-2 border-bottom">
                                        <input type="text"
                                               class="form-control form-control-sm"
                                               placeholder="@L["Dashboard_SearchAccountsPlaceholder", GetNatureLabel(nature).ToLower(CultureInfo.CurrentCulture)]"
                                               @bind="_accountSearchQueries[nature]"
                                               @bind:event="oninput" />
                                    </div>
                                }
                                <div class="list-group list-group-flush">
                                    @foreach (var a in GetFilteredAccounts(nature, items))
                                    {
                                        var isSelectedFrom = _selectedFromAccountId == a.Id;
                                        var isSelectedTo = _selectedToAccountId == a.Id;
                                        var isSelected = isSelectedFrom || isSelectedTo;

                                        <button type="button"
                                                class="list-group-item list-group-item-action ff-dashboard-account-item d-flex justify-content-between align-items-center @(isSelected ? "active" : "")"
                                                @onclick="@(() => OnAccountClicked(a))">
                                            <span>
                                                <i class="bi bi-wallet2 me-2"></i>@a.Name
                                            </span>
                                            @if (isSelectedFrom)
                                            {
                                                <span class="badge bg-warning text-dark">
                                                    <i class="bi bi-arrow-up-right me-1"></i>@L["Dashboard_FromBadge"]
                                                </span>
                                            }
                                            else if (isSelectedTo)
                                            {
                                                <span class="badge bg-success">
                                                    <i class="bi bi-arrow-down-left me-1"></i>@L["Dashboard_ToBadge"]
                                                </span>
                                            }
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </Authorized>

    <NotAuthorized>
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <i class="bi bi-shield-lock display-1 text-muted mb-3"></i>
                <h5 class="text-muted">@L["Dashboard_AuthenticationRequired"]</h5>
                <p class="text-muted">@L["Dashboard_MustLogin"]</p>
                <a class="btn btn-primary mt-3" href="/login">
                    <i class="bi bi-box-arrow-in-right me-1"></i>@L["Common_Login"]
                </a>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private IReadOnlyList<AccountDto>? _accounts;
    private IReadOnlyList<PayeeDto> _payees = Array.Empty<PayeeDto>();
    private bool? _hasAnyTransactions;

    private Guid? _selectedFromAccountId;
    private Guid? _selectedToAccountId;

    private QuickEntryType? _activeEntry = QuickEntryType.Expense;

    private Guid? _expenseFromAssetId;
    private Guid? _expenseToCategoryId;

    private Guid? _incomeFromSourceId;
    private Guid? _incomeToAssetId;

    private Guid? _transferFromAssetId;
    private Guid? _transferToAssetId;

    private Guid? _refundFromExpenseId;
    private Guid? _refundToAssetId;

    private readonly Dictionary<AccountNature, string> _accountSearchQueries = new()
    {
        { AccountNature.Asset, "" },
        { AccountNature.Liability, "" },
        { AccountNature.Expense, "" },
        { AccountNature.Income, "" }
    };

    private string? _expandedWidget;

    private Dictionary<QuickEntryType, QuickEntrySpec> _specs = new();
    private Dictionary<QuickEntryType, QuickEntrySpec> Specs => _specs;

    private void GoToOpeningBalance() => Nav.NavigateTo("/opening-balance");

    private static readonly AccountNature[] _natureOrder =
    [
        AccountNature.Asset,
        AccountNature.Liability,
        AccountNature.Expense,
        AccountNature.Income
    ];

    protected override async Task OnInitializedAsync()
    {
        _specs = BuildSpecs();

        await ExecuteApiAsync(async ct =>
        {
            var allAccounts = await AccountsApi.ListAsync(ct);
            _accounts = allAccounts
                .Where(a => !a.IsClosed)
                .ToList();

            _payees = await PayeesApi.ListAsync(ct);

            _hasAnyTransactions = await TransactionsApi.HasAnyAsync(ct);
        });
    }

    private Dictionary<QuickEntryType, QuickEntrySpec> BuildSpecs()
    {
        return new Dictionary<QuickEntryType, QuickEntrySpec>
        {
            [QuickEntryType.Expense] = new(
                Title: L["QuickEntry_Expense_Title"],
                Hint: L["QuickEntry_Expense_Hint"],
                FromAllowed: new() { AccountNature.Asset, AccountNature.Liability },
                ToAllowed: new() { AccountNature.Expense },
                ReplaceToWhenBothSelected: false),

            [QuickEntryType.Income] = new(
                Title: L["QuickEntry_Income_Title"],
                Hint: L["QuickEntry_Income_Hint"],
                FromAllowed: new() { AccountNature.Income },
                ToAllowed: new() { AccountNature.Asset },
                ReplaceToWhenBothSelected: false),

            [QuickEntryType.Transfer] = new(
                Title: L["QuickEntry_Transfer_Title"],
                Hint: L["QuickEntry_Transfer_Hint"],
                FromAllowed: new() { AccountNature.Asset, AccountNature.Liability },
                ToAllowed: new() { AccountNature.Asset, AccountNature.Liability },
                ReplaceToWhenBothSelected: true),

            [QuickEntryType.Refund] = new(
                Title: L["QuickEntry_Refund_Title"],
                Hint: L["QuickEntry_Refund_Hint"],
                FromAllowed: new() { AccountNature.Expense },
                ToAllowed: new() { AccountNature.Asset, AccountNature.Liability },
                ReplaceToWhenBothSelected: false),
        };
    }

    private string GetNatureLabel(AccountNature nature)
    {
        return nature switch
        {
            AccountNature.Asset => L["Dashboard_Nature_Asset"].Value,
            AccountNature.Liability => L["Dashboard_Nature_Liability"].Value,
            AccountNature.Expense => L["Dashboard_Nature_Expense"].Value,
            AccountNature.Income => L["Dashboard_Nature_Income"].Value,
            AccountNature.Equity => L["Accounts_Nature_Equity"].Value,
            _ => nature.ToString()
        };
    }

    private void OnAccountClicked(AccountDto account)
    {
        if (!_activeEntry.HasValue)
            return;

        var spec = Specs[_activeEntry.Value];

        var canBeFrom = spec.FromAllowed.Contains(account.Nature);
        var canBeTo = spec.ToAllowed.Contains(account.Nature);

        if (!canBeFrom && !canBeTo)
            return;

        if (canBeFrom && canBeTo)
        {
            if (ShouldAssignToInActiveEntry())
                SetToForActiveEntry(account.Id, spec.ReplaceToWhenBothSelected);
            else
                SetFromForActiveEntry(account.Id);

            return;
        }

        if (canBeFrom)
        {
            SetFromForActiveEntry(account.Id);
            return;
        }

        SetToForActiveEntry(account.Id, spec.ReplaceToWhenBothSelected);
    }

    private void SetFromForActiveEntry(Guid accountId)
    {
        if (!_activeEntry.HasValue)
            return;

        switch (_activeEntry.Value)
        {
            case QuickEntryType.Expense:
                _expenseFromAssetId = accountId;
                _selectedFromAccountId = accountId;
                break;

            case QuickEntryType.Income:
                _incomeFromSourceId = accountId;
                _selectedFromAccountId = accountId;
                break;

            case QuickEntryType.Transfer:
                _transferFromAssetId = accountId;
                _selectedFromAccountId = accountId;
                break;

            case QuickEntryType.Refund:
                _refundFromExpenseId = accountId;
                _selectedFromAccountId = accountId;
                break;
        }
    }

    private void SetToForActiveEntry(Guid accountId, bool replaceWhenBothSelected)
    {
        if (!_activeEntry.HasValue)
            return;

        switch (_activeEntry.Value)
        {
            case QuickEntryType.Expense:
                _expenseToCategoryId = accountId;
                _selectedToAccountId = accountId;
                break;

            case QuickEntryType.Income:
                _incomeToAssetId = accountId;
                _selectedToAccountId = accountId;
                break;

            case QuickEntryType.Transfer:
                if (_transferFromAssetId is null)
                {
                    _transferFromAssetId = accountId;
                    _selectedFromAccountId = accountId;
                    return;
                }

                if (_transferToAssetId is null)
                {
                    _transferToAssetId = accountId;
                    _selectedToAccountId = accountId;
                    return;
                }

                if (replaceWhenBothSelected)
                {
                    _transferToAssetId = accountId;
                    _selectedToAccountId = accountId;
                }

                break;

            case QuickEntryType.Refund:
                _refundToAssetId = accountId;
                _selectedToAccountId = accountId;
                break;
        }
    }

    private Task OnTransactionCreatedAsync()
    {
        if (!_activeEntry.HasValue)
            return Task.CompletedTask;

        switch (_activeEntry.Value)
        {
            case QuickEntryType.Expense:
                _expenseToCategoryId = null;
                break;

            case QuickEntryType.Income:
                _incomeToAssetId = null;
                break;

            case QuickEntryType.Transfer:
                _transferToAssetId = null;
                break;
            case QuickEntryType.Refund:
                _refundToAssetId = null;
                break;
        }

        _selectedToAccountId = null;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task OnWidgetTransactionCreatedAsync()
    {
        StateHasChanged();
        return Task.CompletedTask;
    }

    private void OnWidgetToggle(string widgetName)
    {
        if (_expandedWidget != widgetName)
        {
            _activeEntry = null;
        }

        _expandedWidget = _expandedWidget == widgetName ? null : widgetName;
        StateHasChanged();
    }

    private void ClearSelection()
    {
        switch (_activeEntry)
        {
            case QuickEntryType.Expense:
                _expenseFromAssetId = null;
                _expenseToCategoryId = null;
                break;

            case QuickEntryType.Income:
                _incomeFromSourceId = null;
                _incomeToAssetId = null;
                break;

            case QuickEntryType.Transfer:
                _transferFromAssetId = null;
                _transferToAssetId = null;
                break;
            case QuickEntryType.Refund:
                _refundFromExpenseId = null;
                _refundToAssetId = null;
                break;
        }

        _selectedFromAccountId = null;
        _selectedToAccountId = null;
    }

    private void SetActive(QuickEntryType type)
    {
        _activeEntry = type;
        _expandedWidget = null;
        SyncSelectionForActiveEntry();
    }

    private void SyncSelectionForActiveEntry()
    {
        if (!_activeEntry.HasValue)
            return;

        switch (_activeEntry.Value)
        {
            case QuickEntryType.Expense:
                _selectedFromAccountId = _expenseFromAssetId;
                _selectedToAccountId = _expenseToCategoryId;
                break;

            case QuickEntryType.Income:
                _selectedFromAccountId = _incomeFromSourceId;
                _selectedToAccountId = _incomeToAssetId;
                break;

            case QuickEntryType.Transfer:
                _selectedFromAccountId = _transferFromAssetId;
                _selectedToAccountId = _transferToAssetId;
                break;
            case QuickEntryType.Refund:
                _selectedFromAccountId = _refundFromExpenseId;
                _selectedToAccountId = _refundToAssetId;
                break;
        }
    }

    private void SwapTransferAccounts()
    {
        (_transferFromAssetId, _transferToAssetId) = (_transferToAssetId, _transferFromAssetId);
        (_selectedFromAccountId, _selectedToAccountId) = (_selectedToAccountId, _selectedFromAccountId);
    }

    private IReadOnlyList<AccountDto> GetAccounts(AccountNature nature)
    {
        if (_accounts is null) return Array.Empty<AccountDto>();

        return _accounts
            .Where(a => a.Nature == nature && !a.IsClosed)
            .OrderBy(a => a.Name)
            .ToList();
    }

    private IReadOnlyList<AccountDto> GetFilteredAccounts(AccountNature nature, IReadOnlyList<AccountDto> accounts)
    {
        var searchQuery = _accountSearchQueries[nature];

        if (string.IsNullOrWhiteSpace(searchQuery))
            return accounts;

        return accounts
            .Where(a => a.Name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase))
            .ToList();
    }

    private bool ShouldAssignToInActiveEntry()
    {
        return _activeEntry switch
        {
            QuickEntryType.Transfer => _transferFromAssetId is not null && _transferToAssetId is null,
            _ => _selectedFromAccountId is not null && _selectedToAccountId is null
        };
    }

    private static string GetNatureBorderClass(AccountNature nature) => nature switch
    {
        AccountNature.Asset => "border-primary",
        AccountNature.Liability => "border-warning",
        AccountNature.Expense => "border-danger",
        AccountNature.Income => "border-success",
        _ => "border-secondary"
    };

    private static string GetNatureHeaderClass(AccountNature nature) => nature switch
    {
        AccountNature.Asset => "bg-primary-subtle",
        AccountNature.Liability => "bg-warning-subtle",
        AccountNature.Expense => "bg-danger-subtle",
        AccountNature.Income => "bg-success-subtle",
        _ => "bg-secondary-subtle"
    };

    private static string GetNatureTextClass(AccountNature nature) => nature switch
    {
        AccountNature.Asset => "text-primary-emphasis",
        AccountNature.Liability => "text-warning-emphasis",
        AccountNature.Expense => "text-danger-emphasis",
        AccountNature.Income => "text-success-emphasis",
        _ => "text-secondary-emphasis"
    };

    private static string GetNatureCountBadgeClass(AccountNature nature) => nature switch
    {
        AccountNature.Asset => "bg-primary text-white",
        AccountNature.Liability => "bg-warning text-dark",
        AccountNature.Expense => "bg-danger text-white",
        AccountNature.Income => "bg-success text-white",
        _ => "bg-secondary text-white"
    };

    private static string GetNatureIcon(AccountNature nature) => nature switch
    {
        AccountNature.Asset => "bi-bank",
        AccountNature.Liability => "bi-credit-card",
        AccountNature.Expense => "bi-arrow-up-circle",
        AccountNature.Income => "bi-arrow-down-circle",
        _ => "bi-wallet2"
    };
}
