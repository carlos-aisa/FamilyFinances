@page "/"
@rendermode InteractiveServer
@using FamilyFinances.Application.Reporting.Dtos
@using FamilyFinances.Web.Api
@using FamilyFinances.Web.Components.Base
@using FamilyFinances.Web.Components.Pages.Reports.Charts
@using FamilyFinances.Web.Features.Reports
@using FamilyFinances.Web.Features.Reports.Charts
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Localization
@using FamilyFinances.Web
@inherits ApiPageBase

@inject ReportsApi ReportsApi
@inject IStringLocalizer<SharedResource> L

<AuthorizeView>
    <Authorized>
        <div class="d-flex align-items-center justify-content-between mb-4 ff-page-header">
            <div>
                <h3 class="mb-1 ff-page-title">
                    <i class="bi bi-speedometer2 me-2"></i>@L["Dashboard_Title"]
                </h3>
                <p class="text-muted mb-0 ff-page-subtitle">@L["Dashboard_Analytics_Subtitle"]</p>
            </div>
            <a class="btn btn-outline-secondary" href="/quick-entry" data-testid="dashboard-open-quick-entry">
                <i class="bi bi-lightning-charge me-1"></i>@L["Nav_QuickEntry"]
            </a>
        </div>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle me-2"></i>@_error
                <button type="button" class="btn-close" @onclick="@(() => _error = null)"></button>
            </div>
        }

        @if (_isLoading)
        {
            <div class="card shadow-sm ff-panel">
                <div class="card-body text-center py-5">
                    <div class="spinner-border text-primary mb-3" role="status" style="width: 3rem; height: 3rem;">
                        <span class="visually-hidden">@L["Common_Loading"]</span>
                    </div>
                    <p class="text-muted">@L["Dashboard_LoadingAnalytics"]</p>
                </div>
            </div>
        }
        else if (_overview is not null)
        {
            @if (_overview.DataSufficiencyState != DashboardDataSufficiencyState.Complete)
            {
                <div class="alert alert-info mb-3 ff-info-note" role="alert" data-testid="dashboard-data-sufficiency-state">
                    <i class="bi bi-info-circle me-2"></i>
                    @GetDataSufficiencyMessage(_overview.DataSufficiencyState)
                </div>
            }

            <div class="row g-3 mb-3" data-testid="dashboard-kpi-strip">
                <div class="col-12 col-md-6 col-xl-3">
                    <div class="card shadow-sm border-start border-success border-4 h-100 ff-kpi-card ff-panel">
                        <div class="card-body">
                            <h6 class="text-muted text-uppercase mb-2 ff-kpi-label">@L["Dashboard_Kpi_Income"]</h6>
                            <h4 class="mb-1 text-success">@MoneyFormatter.FormatCentsWithSign(_overview.Income.ValueCents)</h4>
                            <small class="@MoneyFormatter.GetColorClass(_overview.Income.DeltaVsPreviousMonthCents)">
                                @L["Dashboard_DeltaVsPreviousMonth"] @MoneyFormatter.FormatCentsWithSign(_overview.Income.DeltaVsPreviousMonthCents)
                            </small>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-6 col-xl-3">
                    <div class="card shadow-sm border-start border-danger border-4 h-100 ff-kpi-card ff-panel">
                        <div class="card-body">
                            <h6 class="text-muted text-uppercase mb-2 ff-kpi-label">@L["Dashboard_Kpi_Expense"]</h6>
                            <h4 class="mb-1 text-danger">@MoneyFormatter.FormatCentsWithSign(-Math.Abs(_overview.Expense.ValueCents))</h4>
                            <small class="@MoneyFormatter.GetColorClass(_overview.Expense.DeltaVsPreviousMonthCents)">
                                @L["Dashboard_DeltaVsPreviousMonth"] @MoneyFormatter.FormatCentsWithSign(_overview.Expense.DeltaVsPreviousMonthCents)
                            </small>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-6 col-xl-3">
                    <div class="card shadow-sm border-start border-info border-4 h-100 ff-kpi-card ff-panel">
                        <div class="card-body">
                            <h6 class="text-muted text-uppercase mb-2 ff-kpi-label">@L["Dashboard_Kpi_NetResult"]</h6>
                            <h4 class="mb-1 @MoneyFormatter.GetColorClass(_overview.NetResult.ValueCents)">
                                @MoneyFormatter.FormatCentsWithSign(_overview.NetResult.ValueCents)
                            </h4>
                            <small class="@MoneyFormatter.GetColorClass(_overview.NetResult.DeltaVsPreviousMonthCents)">
                                @L["Dashboard_DeltaVsPreviousMonth"] @MoneyFormatter.FormatCentsWithSign(_overview.NetResult.DeltaVsPreviousMonthCents)
                            </small>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-6 col-xl-3">
                    <div class="card shadow-sm border-start border-primary border-4 h-100 ff-kpi-card ff-panel">
                        <div class="card-body">
                            <h6 class="text-muted text-uppercase mb-2 ff-kpi-label">@L["Dashboard_Kpi_NetWorth"]</h6>
                            <h4 class="mb-1 @MoneyFormatter.GetColorClass(_overview.NetWorth.ValueCents)">
                                @MoneyFormatter.FormatCentsWithSign(_overview.NetWorth.ValueCents)
                            </h4>
                            <small class="@MoneyFormatter.GetColorClass(_overview.NetWorth.DeltaVsPreviousMonthCents)">
                                @L["Dashboard_DeltaVsPreviousMonth"] @MoneyFormatter.FormatCentsWithSign(_overview.NetWorth.DeltaVsPreviousMonthCents)
                            </small>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row g-3 mb-3 ff-dashboard-analytics-row ff-dashboard-analytics-row-2">
                <div class="col-12 col-xl-8">
                    @if (_monthlyIncomeVsExpenseSeries.Count == 0)
                    {
                        <ReportingChartEmptyState
                            Title="@L["Dashboard_MonthlyIncomeExpense_Title"]"
                            Description="@L["Reports_NoDailyPointsForMonth"]" />
                    }
                    else
                    {
                        <MonthlyLineChart
                            Title="@L["Dashboard_MonthlyIncomeExpense_Title"]"
                            Subtitle="@L["Dashboard_MonthlyIncomeExpense_Subtitle", DateHelper.GetMonthName(_overview.AsOf.Month), _overview.AsOf.Year, _overview.AsOf.Day]"
                            Year="@_overview.AsOf.Year"
                            Month="@_overview.AsOf.Month"
                            YTickMaxTicks="5"
                            Series="@_monthlyIncomeVsExpenseSeries"
                            TestId="dashboard-monthly-income-expense-chart" />
                    }
                </div>
                <div class="col-12 col-xl-4">
                    <div class="card shadow-sm h-100 ff-panel" data-testid="dashboard-ytd-summary">
                        <div class="card-header bg-transparent ff-panel-header">
                            <h6 class="mb-1">@L["Dashboard_Ytd_Title"]</h6>
                            <small class="text-muted">@L["Dashboard_Ytd_Subtitle"]</small>
                        </div>
                        <div class="card-body d-flex flex-column">
                            <div class="mb-3">
                                <h4 class="mb-0 @MoneyFormatter.GetColorClass(_overview.YtdSummary.AccumulatedNetCents)">
                                    @MoneyFormatter.FormatCentsWithSign(_overview.YtdSummary.AccumulatedNetCents)
                                </h4>
                                <small class="text-muted">@L["Dashboard_Ytd_AccumulatedNet"]</small>
                            </div>
                            <div class="ff-dashboard-mini-trend flex-grow-1">
                                @foreach (var point in _overview.YtdSummary.MonthlyNetPoints.OrderBy(x => x.Month))
                                {
                                    <div class="ff-dashboard-mini-trend-row">
                                        <span class="ff-dashboard-mini-label">@DateHelper.GetMonthName(point.Month)</span>
                                        <span class="@MoneyFormatter.GetColorClass(point.NetCents)">@MoneyFormatter.FormatCentsWithSign(point.NetCents)</span>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row g-3 ff-dashboard-analytics-row ff-dashboard-analytics-row-3">
                <div class="col-12 col-xl-8">
                    <div class="card shadow-sm h-100 ff-panel" data-testid="dashboard-group-state-chart">
                        <div class="card-header bg-transparent ff-panel-header">
                            <h6 class="mb-1">@L["Dashboard_GroupState_Title"]</h6>
                            <small class="text-muted">@L["Dashboard_GroupState_Subtitle"]</small>
                        </div>
                        <div class="card-body">
                            @if (_overview.GroupStates.Count == 0)
                            {
                                <p class="text-muted mb-0">@L["Dashboard_GroupState_Empty"]</p>
                            }
                            else
                            {
                                var maxAbs = Math.Max(1L, _overview.GroupStates.Max(x => Math.Abs(x.SelectedMonthBalanceCents)));
                                @foreach (var group in _overview.GroupStates.Take(8))
                                {
                                    var fillPercent = (double)Math.Abs(group.SelectedMonthBalanceCents) * 100d / maxAbs;
                                    var fillClass = group.SelectedMonthBalanceCents >= 0 ? "is-positive" : "is-negative";
                                    <div class="ff-dashboard-group-bar-row">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <span class="text-truncate pe-2">@group.DisplayName</span>
                                            <span class="fw-semibold @MoneyFormatter.GetColorClass(group.SelectedMonthBalanceCents)">
                                                @MoneyFormatter.FormatCentsWithSign(group.SelectedMonthBalanceCents)
                                            </span>
                                        </div>
                                        <div class="ff-dashboard-group-bar-track">
                                            <div class="ff-dashboard-group-bar-fill @fillClass" style="@($"width: {fillPercent:0.##}%;")"></div>
                                        </div>
                                        <small class="text-muted">
                                            @L["Dashboard_DeltaVsPreviousMonth"] @MoneyFormatter.FormatCentsWithSign(group.DeltaVsPreviousMonthCents)
                                        </small>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>

                <div class="col-12 col-xl-4">
                    <div class="card shadow-sm h-100 ff-panel" data-testid="dashboard-compact-insights">
                        <div class="card-header bg-transparent ff-panel-header">
                            <h6 class="mb-1">@L["Dashboard_CompactInsights_Title"]</h6>
                            <small class="text-muted">@L["Dashboard_CompactInsights_Subtitle"]</small>
                        </div>
                        <div class="card-body p-0">
                            @if (_overview.CompactInsights.Count == 0)
                            {
                                <div class="p-3 text-muted">@L["Dashboard_CompactInsights_Empty"]</div>
                            }
                            else
                            {
                                <div class="table-responsive">
                                    <table class="table table-sm table-hover align-middle mb-0 ff-data-table">
                                        <thead class="table-light">
                                            <tr>
                                                <th class="border-0 ps-3">@L["Dashboard_CompactInsights_Column_Label"]</th>
                                                <th class="border-0 text-end">@L["Dashboard_CompactInsights_Column_Amount"]</th>
                                                <th class="border-0 text-end pe-3">@L["Dashboard_CompactInsights_Column_Status"]</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var row in _overview.CompactInsights.Take(8))
                                            {
                                                <tr>
                                                    <td class="ps-3 text-truncate" style="max-width: 220px;">@row.Label</td>
                                                    <td class="text-end @MoneyFormatter.GetColorClass(-Math.Abs(row.AmountCents))">
                                                        @MoneyFormatter.FormatCents(Math.Abs(row.AmountCents))
                                                    </td>
                                                    <td class="text-end pe-3">
                                                        <span class="@GetInsightBadgeClass(row)">
                                                            @GetInsightStatus(row)
                                                        </span>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </Authorized>

    <NotAuthorized>
        <div class="card shadow-sm ff-panel">
            <div class="card-body text-center py-5">
                <i class="bi bi-shield-lock display-1 text-muted mb-3"></i>
                <h5 class="text-muted">@L["Dashboard_AuthenticationRequired"]</h5>
                <p class="text-muted">@L["Dashboard_MustLogin"]</p>
                <a class="btn btn-primary mt-3" href="/login">
                    <i class="bi bi-box-arrow-in-right me-1"></i>@L["Common_Login"]
                </a>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private DashboardOverviewDto? _overview;
    private string? _error;
    private bool _isLoading = true;
    private IReadOnlyList<MonthlyChartSeries> _monthlyIncomeVsExpenseSeries = Array.Empty<MonthlyChartSeries>();

    protected override async Task OnInitializedAsync()
    {
        await LoadOverviewAsync();
    }

    private async Task LoadOverviewAsync()
    {
        _isLoading = true;
        _error = null;
        _overview = null;
        _monthlyIncomeVsExpenseSeries = Array.Empty<MonthlyChartSeries>();
        StateHasChanged();

        try
        {
            _overview = await ReportsApi.GetDashboardOverviewAsync();
            _monthlyIncomeVsExpenseSeries = BuildMonthlyIncomeExpenseSeries(_overview);
        }
        catch (UnauthorizedAccessException)
        {
            _error = L["Reports_Error_Unauthorized"];
        }
        catch (Exception ex)
        {
            _error = L["Reports_Error_LoadFailed", ex.Message];
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static IReadOnlyList<MonthlyChartSeries> BuildMonthlyIncomeExpenseSeries(DashboardOverviewDto overview)
    {
        var orderedPoints = overview.DailyIncomeVsExpense
            .OrderBy(point => point.Day)
            .ToList();

        if (orderedPoints.Count == 0)
            return Array.Empty<MonthlyChartSeries>();

        return
        [
            new MonthlyChartSeries(
                Key: "income",
                Label: "Income",
                ColorHex: "#2dd67d",
                Points: orderedPoints.Select(point => new MonthlyChartPoint(point.Day, point.IncomeCents)).ToList()),
            new MonthlyChartSeries(
                Key: "expense",
                Label: "Expense",
                ColorHex: "#ff5f75",
                Points: orderedPoints.Select(point => new MonthlyChartPoint(point.Day, point.ExpenseCents)).ToList())
        ];
    }

    private string GetDataSufficiencyMessage(DashboardDataSufficiencyState state)
    {
        return state switch
        {
            DashboardDataSufficiencyState.Complete => L["Dashboard_DataState_Complete"],
            DashboardDataSufficiencyState.Partial => L["Dashboard_DataState_Partial"],
            _ => L["Dashboard_DataState_InsufficientHistory"]
        };
    }

    private string GetInsightStatus(DashboardCompactInsightRowDto row)
    {
        if (string.Equals(row.StatusCode, "anomaly", StringComparison.OrdinalIgnoreCase))
            return L["Dashboard_CompactInsights_Status_Anomaly"];

        if (string.Equals(row.StatusCode, "insufficient-history", StringComparison.OrdinalIgnoreCase))
            return L["Dashboard_CompactInsights_Status_InsufficientHistory"];

        if (row.Percentage is decimal percentage)
            return $"{percentage:0.##}%";

        return L["Dashboard_CompactInsights_Status_TopContributor"];
    }

    private static string GetInsightBadgeClass(DashboardCompactInsightRowDto row)
    {
        if (string.Equals(row.StatusCode, "anomaly", StringComparison.OrdinalIgnoreCase))
            return "badge bg-danger-subtle text-danger";

        if (string.Equals(row.StatusCode, "insufficient-history", StringComparison.OrdinalIgnoreCase))
            return "badge bg-secondary-subtle text-secondary";

        return "badge bg-info-subtle text-info";
    }
}
