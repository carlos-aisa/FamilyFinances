@using System.Globalization
@using FamilyFinances.Application.Ledger.Accounts.Dtos
@using FamilyFinances.Application.Ledger.Transactions.Requests
@using FamilyFinances.Web.Api
@using FamilyFinances.Web.Components.Shared
@using FamilyFinances.Web
@using Microsoft.Extensions.Localization
@inject TransactionsApi TransactionsApi
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResource> L

<div class="card shadow-sm mb-3 border-start border-4 border-info">
    <div class="card-header bg-info-subtle cursor-pointer" @onclick="ToggleExpanded">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h6 class="mb-0 text-info-emphasis">
                    <i class="bi bi-house me-2"></i>@L["MortgageWidget_Title"]
                </h6>
                <small class="text-muted">@L["MortgageWidget_Subtitle"]</small>
            </div>
            <i class="bi @(_isExpanded ? "bi-chevron-up" : "bi-chevron-down") text-info-emphasis"></i>
        </div>
    </div>

    @if (_isExpanded)
    {
        <div class="card-body">
            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <div class="alert alert-danger alert-sm" role="alert">
                    <i class="bi bi-exclamation-triangle me-2"></i>@_error
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(_success))
            {
                <div class="alert alert-success alert-sm" role="alert">
                    <i class="bi bi-check-circle me-2"></i>@_success
                </div>
            }

            <MortgagePaymentPreset Accounts="Accounts" OnPresetApplied="CreateTransactionAsync" />
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<AccountDto> Accounts { get; set; } = Array.Empty<AccountDto>();
    [Parameter] public EventCallback OnTransactionCreated { get; set; }
    [Parameter] public bool IsExpanded { get; set; }
    [Parameter] public EventCallback<string> OnToggle { get; set; }

    private bool _isSaving;
    private string? _error;
    private string? _success;

    private bool _isExpanded => IsExpanded;

    private async Task ToggleExpanded()
    {
        _error = null;
        _success = null;
        await OnToggle.InvokeAsync("mortgage");
    }

    private async Task CreateTransactionAsync(MortgagePaymentPreset.MortgagePresetModel preset)
    {
        if (_isSaving)
            return;

        _isSaving = true;
        _error = null;
        _success = null;
        StateHasChanged();

        try
        {
            var totalPayment = preset.PrincipalAmount + preset.InterestAmount;

            var splits = new List<TransactionSplitInput>
            {
                new(preset.PaymentAccountId, ToCents(-totalPayment), L["MortgageWidget_SplitPayment"]),
                new(preset.MortgagePrincipalAccountId, ToCents(preset.PrincipalAmount), L["MortgageWidget_SplitPrincipal"]),
                new(preset.InterestExpenseAccountId, ToCents(preset.InterestAmount), L["MortgageWidget_SplitInterest"])
            };

            var mortgageAccount = Accounts.FirstOrDefault(a => a.Id == preset.MortgagePrincipalAccountId);
            var descriptionMonth = preset.BookedOn.ToString("MMM yyyy", CultureInfo.CurrentCulture);
            var description = mortgageAccount != null
                ? L["MortgageWidget_DescriptionWithAccount", mortgageAccount.Name, descriptionMonth]
                : L["MortgageWidget_DescriptionFallback", descriptionMonth];

            var request = new CreateTransactionRequest(
                preset.BookedOn,
                description,
                splits,
                null,
                null
            );

            await TransactionsApi.CreateAsync(request, CancellationToken.None);

            _success = L["MortgageWidget_Success"];
            StateHasChanged();
            await Task.Delay(3000);
            await OnTransactionCreated.InvokeAsync();
        }
        catch (Exception ex)
        {
            _error = L["MortgageWidget_Error", ex.Message];
        }
        finally
        {
            _isSaving = false;
            StateHasChanged();
        }
    }

    private static long ToCents(decimal amount)
        => (long)Math.Round(amount * 100m, MidpointRounding.AwayFromZero);
}

<style>
    .cursor-pointer {
        cursor: pointer;
    }

    .cursor-pointer:hover {
        opacity: 0.9;
    }
</style>
