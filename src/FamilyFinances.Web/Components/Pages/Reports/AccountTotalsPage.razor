@page "/reports/account-totals"
@rendermode InteractiveServer
@using FamilyFinances.Application.Reporting.Dtos
@using FamilyFinances.Domain.Ledger.Accounts
@using FamilyFinances.Web
@using FamilyFinances.Web.Api
@using FamilyFinances.Web.Components.Base
@using FamilyFinances.Web.Components.Shared
@using FamilyFinances.Web.Features.Reports
@using FamilyFinances.Web.Features.Reports.Export
@using Microsoft.Extensions.Localization
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components.Authorization
@inherits ApiPageBase

@inject ReportsApi ReportsApi
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResource> L

<AuthorizeView>
    <Authorized>
        <div class="d-flex align-items-center justify-content-between mb-4 ff-page-header">
            <div>
                <h3 class="mb-1 ff-page-title">
                    <i class="bi bi-wallet2 me-2"></i>@L["AccountTotals_Title"]
                </h3>
                <p class="text-muted mb-0 ff-page-subtitle">@L["AccountTotals_Subtitle"]</p>
            </div>
            <a class="btn btn-outline-secondary" href="/reports">
                <i class="bi bi-arrow-left me-1"></i>@L["Reports_BackToReports"]
            </a>
        </div>

        <ul class="nav nav-tabs mb-4 ff-premium-tabs">
            <li class="nav-item">
                <button type="button"
                        class="nav-link @GetTabClass(AccountTotalsReportTab.PeriodTotals)"
                        @onclick="() => SetActiveTab(AccountTotalsReportTab.PeriodTotals)"
                        disabled="@_isLoading">
                    @L["AccountTotals_Tab_PeriodTotals"]
                </button>
            </li>
            <li class="nav-item">
                <button type="button"
                        class="nav-link @GetTabClass(AccountTotalsReportTab.StateEvolution)"
                        @onclick="() => SetActiveTab(AccountTotalsReportTab.StateEvolution)"
                        disabled="@_isLoading">
                    @L["AccountTotals_Tab_StateEvolution"]
                </button>
            </li>
        </ul>

        @if (_activeTab == AccountTotalsReportTab.PeriodTotals)
        {
            <!-- Filters Card -->
            <div class="card shadow-sm mb-4 ff-panel ff-report-filter-panel">
                <div class="card-body">
                    <div class="row g-3">
                        <!-- Quick Date Presets -->
                        <div class="col-12">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-calendar-range me-1"></i>@L["Reports_QuickSelect"]
                        </label>
                            <div>
                                <DateRangePresets OnPresetSelected="HandlePresetSelected" ActivePreset="@_activePreset" />
                            </div>
                        </div>

                        <!-- Date Range -->
                        <div class="col-12 col-md-4">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-calendar3 me-1"></i>@L["Reports_FromDate"]
                        </label>
                            <input type="date" class="form-control" aria-label="@L["Reports_FromDate"]" @bind="_fromDate" @bind:event="oninput" @bind:after="OnDateChanged" />
                        </div>

                        <div class="col-12 col-md-4">
                            <label class="form-label fw-semibold">
                                <i class="bi bi-calendar3 me-1"></i>@L["Reports_ToDateExclusive"]
                            </label>
                            <input type="date" class="form-control" aria-label="@L["Reports_ToDateExclusive"]" @bind="_toDate" @bind:event="oninput" @bind:after="OnDateChanged" />
                        </div>

                        <!-- Include Zero Accounts -->
                        <div class="col-12 col-md-4">
                            <label class="form-label fw-semibold">
                                <i class="bi bi-filter me-1"></i>@L["AccountTotals_DisplayOptions"]
                            </label>
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" id="includeZero" @bind="_includeZeroAccounts" />
                                <label class="form-check-label" for="includeZero">
                                    @L["AccountTotals_IncludeNoActivity"]
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="mt-3">
                        <button class="btn btn-primary" @onclick="LoadReportAsync" disabled="@_isLoading">
                            @if (_isLoading)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            }
                            else
                            {
                                <i class="bi bi-search me-1"></i>
                            }
                            @L["Reports_LoadReport"]
                        </button>
                        <button class="btn btn-outline-secondary ms-2" @onclick="ResetFilters">
                            <i class="bi bi-x-circle me-1"></i>@L["Reports_ResetToCurrentMonth"]
                        </button>
                    </div>
                </div>
            </div>

            <!-- Error Display -->
            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle me-2"></i>@_error
                    <button type="button" class="btn-close" @onclick="@(() => _error = null)"></button>
                </div>
            }

            <!-- Loading State -->
            @if (_isLoading)
            {
                <div class="card shadow-sm ff-panel">
                    <div class="card-body text-center py-5">
                        <div class="spinner-border text-primary mb-3" role="status" style="width: 3rem; height: 3rem;">
                            <span class="visually-hidden">@L["Common_Loading"]</span>
                        </div>
                        <p class="text-muted">@L["Reports_LoadingData"]</p>
                    </div>
                </div>
            }
            else if (_report is not null)
            {
                <!-- Report Results -->
                @if (_report.Items.Count == 0)
                {
                    <div class="card shadow-sm ff-panel">
                        <div class="card-body text-center py-5">
                            <i class="bi bi-inbox display-4 text-muted mb-3"></i>
                            <h5 class="text-muted">@L["Reports_NoDataForPeriod"]</h5>
                            <p class="text-muted">@L["AccountTotals_NoDataHint"]</p>
                        </div>
                    </div>
                }
                else
                {
                    <div class="d-flex justify-content-end mb-3">
                        <button type="button"
                                class="btn btn-sm btn-outline-secondary report-export-button"
                                @onclick="ExportCsvAsync"
                                data-testid="account-totals-export-csv"
                                aria-label="@L["Reports_AriaExportCsv"]">
                            <i class="bi bi-download me-1"></i>@L["Reports_Export"]
                        </button>
                    </div>

                    @foreach (var natureGroup in _report.Items.GroupBy(i => i.AccountNature).OrderBy(g => g.Key))
                    {
                        var items = natureGroup.ToList();
                        var total = items.Sum(i => i.NetChange);

                        <div class="card shadow-sm mb-4 ff-panel">
                            <div class="card-header bg-transparent">
                                <div class="d-flex justify-content-between align-items-center">
                                    <h5 class="mb-0">
                                        <i class="bi @GetNatureIcon(natureGroup.Key) me-2"></i>
                                        @L["AccountTotals_NatureAccounts", GetNatureLabel(natureGroup.Key)]
                                    </h5>
                                    <span class="badge @GetNatureBadgeClass(natureGroup.Key) fs-6">
                                        @MoneyFormatter.FormatCentsWithSign(total)
                                    </span>
                                </div>
                            </div>
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0 ff-data-table">
                                        <thead class="table-light">
                                            <tr>
                                                <th class="border-0 ps-3" style="width: 40%;">
                                                    <i class="bi bi-tag me-1"></i>@L["AccountTotals_Table_AccountName"]
                                                </th>
                                                <th class="border-0" style="width: 20%;">
                                                    <i class="bi bi-folder me-1"></i>@L["AccountTotals_Table_Kind"]
                                                </th>
                                                <th class="border-0 text-end" style="width: 25%;">
                                                    <i class="bi bi-currency-euro me-1"></i>@L["AccountTotals_Table_NetChange"]
                                                </th>
                                                <th class="border-0 text-end pe-3" style="width: 15%;">
                                                    <i class="bi bi-receipt me-1"></i>@L["AccountTotals_Table_Transactions"]
                                                </th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in items.OrderBy(i => i.AccountName))
                                            {
                                                <tr>
                                                    <td class="ps-3">
                                                        <span class="fw-semibold">@item.AccountName</span>
                                                    </td>
                                                    <td>
                                                        <!-- Use same badge classes as Accounts list to match contrast behavior -->
                                                        <span class="badge bg-secondary-subtle text-secondary">
                                                            @GetKindLabel(item.AccountKind)
                                                        </span>
                                                    </td>
                                                    <td class="text-end">
                                                        <span class="@MoneyFormatter.GetColorClass(item.NetChange) fw-semibold">
                                                            @MoneyFormatter.FormatCentsWithSign(item.NetChange)
                                                        </span>
                                                    </td>
                                                    <td class="text-end pe-3">
                                                        <span class="text-muted">@item.TransactionsCount</span>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- Summary Card -->
                    <div class="card shadow-sm border-primary ff-panel">
                        <div class="card-body">
                            <div class="row text-center">
                                <div class="col-12 col-md-4">
                                    <h6 class="text-muted text-uppercase mb-2" style="font-size: 0.75rem;">@L["AccountTotals_Summary_Period"]</h6>
                                    <p class="mb-0 fw-semibold">
                                        @DateHelper.FormatShortDate(_report.FromInclusive) - @DateHelper.FormatShortDate(_report.ToExclusive)
                                    </p>
                                </div>
                                <div class="col-12 col-md-4">
                                    <h6 class="text-muted text-uppercase mb-2" style="font-size: 0.75rem;">@L["AccountTotals_Summary_TotalAccounts"]</h6>
                                    <p class="mb-0 fw-semibold">@_report.Items.Count</p>
                                </div>
                                <div class="col-12 col-md-4">
                                    <h6 class="text-muted text-uppercase mb-2" style="font-size: 0.75rem;">@L["AccountTotals_Summary_TotalTransactions"]</h6>
                                    <p class="mb-0 fw-semibold">@_report.Items.Sum(i => i.TransactionsCount)</p>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else if (!_isLoading && _report is null)
            {
                <!-- No Report Loaded Yet -->
                <div class="card shadow-sm ff-panel">
                    <div class="card-body text-center py-5">
                        <i class="bi bi-wallet2 display-1 text-muted mb-3"></i>
                        <h5 class="text-muted">@L["Reports_ReadyToGenerate"]</h5>
                        <p class="text-muted">@L["AccountTotals_ReadyHint"]</p>
                    </div>
                </div>
            }
        }
        else
        {
            <AccountStateEvolutionPanel />
        }

    </Authorized>
    <NotAuthorized>
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle me-2"></i>
            @L["Reports_LoginRequired"]
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private AccountTotalsDto? _report;
    private string? _error;
    private bool _isLoading;

    private DateOnly _fromDate = DateHelper.GetCurrentMonthStart();
    private DateOnly _toDate = DateHelper.GetCurrentMonthEnd();
    private bool _includeZeroAccounts = false;
    private string? _activePreset = "this-month";
    private AccountTotalsReportTab _activeTab = AccountTotalsReportTab.PeriodTotals;

    private async Task HandlePresetSelected(DateRangePresets.DateRangePreset preset)
    {
        var (from, to) = preset.GetDateRange();
        _fromDate = from;
        _toDate = to;
        _activePreset = preset.Type.ToString().ToLowerInvariant().Replace("_", "-");
        
        // Auto-load report when preset selected
        await LoadReportAsync();
    }

    private void OnDateChanged()
    {
        _activePreset = null; // Clear preset when manually changing dates
    }

    private async Task LoadReportAsync()
    {
        // Validate date range
        if (_fromDate >= _toDate)
        {
            _error = L["Reports_Error_FromBeforeTo"];
            return;
        }

        _isLoading = true;
        _error = null;
        _report = null;
        StateHasChanged();

        try
        {
            _report = await ReportsApi.GetAccountTotalsAsync(_fromDate, _toDate, _includeZeroAccounts);
        }
        catch (UnauthorizedAccessException)
        {
            _error = L["Reports_Error_Unauthorized"];
        }
        catch (Exception ex)
        {
            _error = L["Reports_Error_LoadFailed", ex.Message];
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void ResetFilters()
    {
        _fromDate = DateHelper.GetCurrentMonthStart();
        _toDate = DateHelper.GetCurrentMonthEnd();
        _includeZeroAccounts = false;
        _activePreset = "this-month";
        _report = null;
        _error = null;
    }

    private string GetNatureIcon(AccountNature nature)
    {
        return nature switch
        {
            AccountNature.Asset => "bi-piggy-bank",
            AccountNature.Liability => "bi-credit-card",
            AccountNature.Equity => "bi-bank",
            AccountNature.Income => "bi-arrow-down-circle",
            AccountNature.Expense => "bi-arrow-up-circle",
            _ => "bi-question-circle"
        };
    }

    private string GetNatureBadgeClass(AccountNature nature)
    {
        return nature switch
        {
            AccountNature.Asset => "bg-primary bg-opacity-10 text-primary",
            AccountNature.Liability => "bg-danger bg-opacity-10 text-danger",
            AccountNature.Equity => "bg-info bg-opacity-10 text-info",
            AccountNature.Income => "bg-success bg-opacity-10 text-success",
            AccountNature.Expense => "bg-warning bg-opacity-10 text-warning",
            _ => "bg-secondary bg-opacity-10 text-secondary"
        };
    }

    private string GetNatureLabel(AccountNature nature)
    {
        return nature switch
        {
            AccountNature.Asset => L["Dashboard_Nature_Asset"],
            AccountNature.Liability => L["Dashboard_Nature_Liability"],
            AccountNature.Expense => L["Dashboard_Nature_Expense"],
            AccountNature.Income => L["Dashboard_Nature_Income"],
            AccountNature.Equity => L["Accounts_Nature_Equity"],
            _ => nature.ToString()
        };
    }

    private string GetKindLabel(AccountKind kind)
    {
        return kind switch
        {
            AccountKind.Cash => L["Accounts_Kind_Cash"],
            AccountKind.Checking => L["Accounts_Kind_Checking"],
            AccountKind.Savings => L["Accounts_Kind_Savings"],
            AccountKind.Investment => L["Accounts_Kind_Investment"],
            AccountKind.CreditCard => L["Accounts_Kind_CreditCard"],
            AccountKind.Loan => L["Accounts_Kind_Loan"],
            AccountKind.Mortgage => L["Accounts_Kind_Mortgage"],
            AccountKind.ExpenseCategory => L["Accounts_Kind_ExpenseCategory"],
            AccountKind.IncomeSource => L["Accounts_Kind_IncomeSource"],
            AccountKind.Other => L["Accounts_Kind_Other"],
            _ => kind.ToString()
        };
    }

    private void SetActiveTab(AccountTotalsReportTab tab)
    {
        _activeTab = tab;
    }

    private string GetTabClass(AccountTotalsReportTab tab)
    {
        return _activeTab == tab ? "active" : string.Empty;
    }

    private enum AccountTotalsReportTab
    {
        PeriodTotals,
        StateEvolution
    }

    private async Task ExportCsvAsync()
    {
        if (_report is null)
            return;

        var rows = _report.Items
            .OrderBy(item => item.AccountNature)
            .ThenBy(item => item.AccountName, StringComparer.OrdinalIgnoreCase)
            .Select(item => (IReadOnlyList<string?>)
            [
                GetNatureLabel(item.AccountNature),
                item.AccountName,
                GetKindLabel(item.AccountKind),
                MoneyFormatter.FormatCentsWithSign(item.NetChange),
                item.TransactionsCount.ToString()
            ])
            .ToList();

        rows.Add(
        [
            L["CategoryTotals_Total"],
            null,
            null,
            MoneyFormatter.FormatCentsWithSign(_report.Items.Sum(i => i.NetChange)),
            _report.Items.Sum(i => i.TransactionsCount).ToString()
        ]);

        var csv = ReportCsvBuilder.Build(
            reportName: L["AccountTotals_Title"],
            context: new Dictionary<string, string?>
            {
                [L["Reports_FromDate"]] = _fromDate.ToString("yyyy-MM-dd"),
                [L["Reports_ToDateExclusive"]] = _toDate.ToString("yyyy-MM-dd"),
                [L["AccountTotals_IncludeNoActivity"]] = _includeZeroAccounts ? "Yes" : "No"
            },
            headers: [L["Reports_Nature"], L["AccountTotals_Table_AccountName"], L["AccountTotals_Table_Kind"], L["AccountTotals_Table_NetChange"], L["AccountTotals_Table_Transactions"]],
            rows: rows);

        try
        {
            var fileName = ReportExportInterop.BuildFileName(
                "account-totals",
                _fromDate.ToString("yyyy-MM-dd"),
                _toDate.ToString("yyyy-MM-dd")) + ".csv";
            await JS.DownloadCsvAsync(fileName, csv);
        }
        catch (Exception ex)
        {
            _error = L["Reports_Error_ExportCsvFailed", ex.Message];
        }
    }
}
