@using FamilyFinances.Application.Reporting.Dtos
@using FamilyFinances.Domain.Ledger.Accounts
@using FamilyFinances.Web.Api
@using FamilyFinances.Web.Components.Base
@using FamilyFinances.Web.Components.Pages.Reports.Charts
@using FamilyFinances.Web.Features.Reports
@using FamilyFinances.Web.Features.Reports.Export
@using FamilyFinances.Web.Features.Reports.Charts
@using Microsoft.Extensions.Localization
@using FamilyFinances.Web
@using Microsoft.JSInterop
@inherits ApiPageBase

@inject ReportsApi ReportsApi
@inject AccountGroupsApi AccountGroupsApi
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResource> L

<div class="card shadow-sm mb-4 ff-panel ff-report-filter-panel">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-12 col-md-4">
                <label class="form-label fw-semibold">
                    <i class="bi bi-calendar3 me-1"></i>@L["Reports_Year"]
                </label>
                <select class="form-select" aria-label="@L["Reports_Year"]" value="@_selectedYear" @onchange="OnYearChangedAsync" disabled="@_isLoading">
                    @foreach (var year in _yearOptions)
                    {
                        <option value="@year">@year</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label fw-semibold">
                    <i class="bi bi-calendar-month me-1"></i>@L["Reports_FocusedMonth"]
                </label>
                <select class="form-select month-focus-select"
                        aria-label="@L["Reports_FocusedMonth"]"
                        data-testid="account-group-focused-month"
                        value="@_focusedMonth"
                        @onchange="OnFocusedMonthChanged"
                        disabled="@(_isLoading || _isMonthlyChartLoading || GetAvailableMonthsForFocusedSelection().Count == 0)">
                    @foreach (var month in GetAvailableMonthsForFocusedSelection())
                    {
                        <option value="@month">@DateHelper.GetMonthName(month)</option>
                    }
                </select>
            </div>
        </div>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-2"></i>@_error
        <button type="button" class="btn-close" @onclick="@(() => _error = null)"></button>
    </div>
}

@if (_isLoading)
{
    <ReportingChartLoadingState
        Title="@L["AccountGroupState_LoadingTitle"]"
        Description="@L["Reports_LoadingData"]" />
}
else if (_report is not null && _report.Series.Count == 0)
{
    <ReportingChartEmptyState
        Title="@L["AccountGroupState_Title"]"
        Description="@L["Reports_NoEvolutionDataForYear"]" />
}
else if (_report is not null)
{
    var (latestEndBalance, latestDeltaPrev, latestDeltaYearStart) = GetLatestSummary();
    var charts = BuildChartsViewModel();
    var dataUntilMonth = GetDataUntilMonthForSelectedYear();
    var summaryMonth = _focusedMonth;
    var compositionMonth = _focusedMonth ?? summaryMonth;
    var compositionMonthLabel = compositionMonth is not null
        ? DateHelper.GetMonthName(compositionMonth.Value)
        : L["Reports_NotAvailable"];
    var compositionBadgeText = compositionMonth is not null
        ? $"{_selectedYear:D4}-{compositionMonth.Value:D2}"
        : $"{_selectedYear:D4}";
    var monthlyComparisonSeries = BuildMonthlyComparisonChartSeries();

    <div class="row g-3 mb-4">
        <div class="col-12 col-md-4">
            <div class="card shadow-sm h-100 border-start border-primary border-4 ff-kpi-card ff-panel">
                <div class="card-body">
                    <h6 class="text-muted text-uppercase mb-2 ff-kpi-label">@L["Reports_LatestEndBalance"]</h6>
                    <h4 class="mb-0 @MoneyFormatter.GetColorClass(latestEndBalance)">
                        @MoneyFormatter.FormatCentsWithSign(latestEndBalance)
                    </h4>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card shadow-sm h-100 ff-kpi-card ff-panel">
                <div class="card-body">
                    <h6 class="text-muted text-uppercase mb-2 ff-kpi-label">@L["Reports_LatestMetric", L["Reports_DeltaPrevMonth"]]</h6>
                    <h4 class="mb-0 @MoneyFormatter.GetColorClass(latestDeltaPrev)">
                        @MoneyFormatter.FormatCentsWithSign(latestDeltaPrev)
                    </h4>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card shadow-sm h-100 ff-kpi-card ff-panel">
                <div class="card-body">
                    <h6 class="text-muted text-uppercase mb-2 ff-kpi-label">@L["Reports_LatestMetric", L["Reports_DeltaYearStart"]]</h6>
                    <h4 class="mb-0 @MoneyFormatter.GetColorClass(latestDeltaYearStart)">
                        @MoneyFormatter.FormatCentsWithSign(latestDeltaYearStart)
                    </h4>
                </div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(charts.Error))
    {
        <ReportingChartErrorState Message="@charts.Error" />
    }
    else
    {
        <div class="row g-3 mb-4 account-groups-overview-grid">
            <div class="col-12 col-xxl-7">
                <div class="card shadow-sm h-100 ff-panel">
                    <div class="card-header bg-transparent">
                        <div class="d-flex justify-content-between align-items-start gap-3">
                            <div>
                                <h5 class="mb-1">
                                    <i class="bi bi-table me-2"></i>@L["AccountGroupState_Title"]
                                </h5>
                                <p class="text-muted mb-0">@L["AccountGroupState_Subtitle"]</p>
                            </div>
                            <button type="button"
                                    class="btn btn-sm btn-outline-secondary report-export-button"
                                    @onclick="ExportOverviewCsvAsync"
                                    data-testid="account-group-state-overview-export-csv"
                                    aria-label="@L["Reports_AriaExportCsv"]">
                                <i class="bi bi-download me-1"></i>@L["Reports_Export"]
                            </button>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-sm table-hover align-middle mb-0 ff-data-table" data-testid="account-group-state-summary-table">
                                <thead class="table-light">
                                    <tr>
                                        <th class="border-0 ps-3">@L["Reports_SeriesName"]</th>
                                        <th class="border-0 text-end">@L["Reports_EndBalance"]</th>
                                        <th class="border-0 text-end">@L["Reports_MonthBalance"]</th>
                                        <th class="border-0 text-end pe-3">@L["Reports_Details"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var series in _report.Series.OrderBy(s => s.DisplayName).ThenBy(s => s.SeriesKey))
                                    {
                                        var point = summaryMonth is not null
                                            ? GetPointAtMonth(series, summaryMonth.Value)
                                            : null;
                                        var isExpanded = _expandedSeriesKey == series.SeriesKey;

                                        <tr class="series-summary-row">
                                            <td class="ps-3 fw-semibold">@series.DisplayName</td>
                                            <td class="text-end @GetValueColorClass(point?.EndBalanceCents ?? 0, point is not null)">
                                                @(point is not null ? MoneyFormatter.FormatCentsWithSign(point.EndBalanceCents) : "-")
                                            </td>
                                            <td class="text-end @GetValueColorClass(point?.DeltaVsPreviousMonthCents ?? 0, point is not null)">
                                                @(point is not null ? MoneyFormatter.FormatCentsWithSign(point.DeltaVsPreviousMonthCents) : "-")
                                            </td>
                                            <td class="text-end pe-3">
                                                <button type="button"
                                                        class="btn btn-sm btn-outline-secondary"
                                                        @onclick="() => ToggleSeriesDetails(series.SeriesKey)">
                                                    @(isExpanded ? L["Reports_HideMonths"] : L["Reports_ViewMonths"])
                                                </button>
                                            </td>
                                        </tr>

                                        if (isExpanded)
                                        {
                                            <tr class="series-detail-row">
                                                <td colspan="4" class="bg-body-tertiary px-3 py-3">
                                                    <div class="table-responsive">
                                                        <table class="table table-sm mb-0 ff-data-table">
                                                            <thead>
                                                                <tr>
                                                                    <th>@L["Reports_Month"]</th>
                                                                    <th class="text-end">@L["Reports_EndBalance"]</th>
                                                                    <th class="text-end">@L["Reports_MonthBalance"]</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                @foreach (var monthPoint in GetSeriesPointsForDetails(series, dataUntilMonth))
                                                                {
                                                                    <tr>
                                                                        <td>@DateHelper.GetMonthName(monthPoint.Month)</td>
                                                                        <td class="text-end @MoneyFormatter.GetColorClass(monthPoint.EndBalanceCents)">
                                                                            @MoneyFormatter.FormatCentsWithSign(monthPoint.EndBalanceCents)
                                                                        </td>
                                                                        <td class="text-end @MoneyFormatter.GetColorClass(monthPoint.DeltaVsPreviousMonthCents)">
                                                                            @MoneyFormatter.FormatCentsWithSign(monthPoint.DeltaVsPreviousMonthCents)
                                                                        </td>
                                                                    </tr>
                                                                }
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-xxl-5 account-groups-chart-panel">
                <div class="d-flex justify-content-end mb-2">
                    <div class="btn-group btn-group-sm" role="group" aria-label="@L["AccountGroupState_ChartMode"]">
                        <button type="button"
                                class="btn @GetChartModeButtonClass(ChartMode.Evolution)"
                                @onclick="() => SetChartMode(ChartMode.Evolution)">
                            @L["Reports_ChartMode_Evolution"]
                        </button>
                        <button type="button"
                                class="btn @GetChartModeButtonClass(ChartMode.Composition)"
                                @onclick="() => SetChartMode(ChartMode.Composition)">
                            @L["Reports_ChartMode_Composition"]
                        </button>
                    </div>
                </div>

                @if (_chartMode == ChartMode.Evolution)
                {
                    <AnnualBarChart
                        Title="@L["AccountGroupState_AnnualEvolutionTitle"]"
                        Subtitle="@L["AccountGroupState_AnnualEvolutionMonthResultSubtitle"]"
                        Year="@_selectedYear"
                        Series="@charts.AccountGroupEvolution"
                        DataUntilMonth="@dataUntilMonth"
                        TestId="account-group-totals-stock-evolution-chart" />
                }
                else
                {
                    <AnnualCompositionChart
                        Title="@L["AccountGroupState_CompositionTitle"]"
                        Subtitle="@L["AccountGroupState_CompositionSubtitle", compositionMonthLabel]"
                        Year="@_selectedYear"
                        BadgeText="@compositionBadgeText"
                        Slices="@charts.AccountGroupExpenseComposition"
                        UseSideLegend="true"
                        LegendMaxItems="10"
                        TestId="account-group-totals-stock-composition-chart" />
                }
            </div>
        </div>

        @if (_isMonthlyChartLoading)
        {
            <ReportingChartLoadingState
                Title="@L["AccountGroupState_LoadingMonthFocused"]"
                Description="@L["Reports_LoadingDailyPoints"]" />
        }
        else if (!string.IsNullOrWhiteSpace(_monthlyChartError))
        {
            <ReportingChartErrorState Message="@_monthlyChartError" />
        }
        else if (_monthlyBalanceVsGroupsChart is null || monthlyComparisonSeries.Count == 0)
        {
            <ReportingChartEmptyState
                Title="@L["AccountGroupState_MonthFocusedTitle"]"
                Description="@L["Reports_NoDailyPointsForMonth"]" />
        }
        else
        {
            <MonthlyLineChart
                Title="@L["AccountGroupState_MonthFocusedTitle"]"
                Subtitle="@L["AccountGroupState_MonthFocusedSubtitle", compositionMonthLabel, _selectedYear]"
                Year="@_selectedYear"
                Month="@(_focusedMonth ?? 1)"
                Series="@monthlyComparisonSeries"
                TestId="account-group-totals-monthly-comparison-chart" />
        }
    }
}
else
{
    <div class="card shadow-sm">
        <div class="card-body text-center py-5">
            <i class="bi bi-graph-up display-4 text-muted mb-3"></i>
            <h5 class="text-muted">@L["AccountGroupState_SelectYearHint"]</h5>
        </div>
    </div>
}

@code {
    private MonthlyEvolutionReportDto? _report;
    private MonthlyBalanceVsGroupsChartDto? _monthlyBalanceVsGroupsChart;
    private string? _error;
    private string? _monthlyChartError;
    private bool _isLoading;
    private bool _isMonthlyChartLoading;

    private int _selectedYear = DateHelper.GetCurrentYear();
    private IReadOnlyList<int> _yearOptions = Array.Empty<int>();
    private int? _focusedMonth;
    private string? _expandedSeriesKey;
    private ChartMode _chartMode = ChartMode.Evolution;
    private const int CompositionMaxSlices = 10;
    private IReadOnlyDictionary<Guid, IReadOnlySet<AccountNature>> _accountGroupNaturesById =
        new Dictionary<Guid, IReadOnlySet<AccountNature>>();

    protected override async Task OnInitializedAsync()
    {
        _yearOptions = Enumerable
            .Range(2000, DateHelper.GetCurrentYear() - 2000 + 1)
            .OrderByDescending(x => x)
            .ToList();

        await LoadReportAsync();
    }

    private async Task OnYearChangedAsync(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var year))
            return;

        _selectedYear = year;
        await LoadReportAsync();
    }

    private async Task LoadReportAsync()
    {
        _isLoading = true;
        _error = null;
        _report = null;
        _monthlyBalanceVsGroupsChart = null;
        _monthlyChartError = null;
        StateHasChanged();

        try
        {
            _report = await ReportsApi.GetStateEvolutionAsync(_selectedYear, MonthlyEvolutionScope.AccountGroups);
            await LoadAccountGroupNatureLookupBestEffortAsync();
            SyncFocusedMonth();
            _expandedSeriesKey = null;
            await LoadMonthlyChartAsync();
        }
        catch (UnauthorizedAccessException)
        {
            _error = L["Reports_Error_Unauthorized"];
        }
        catch (Exception ex)
        {
            _error = L["Reports_Error_LoadFailed", ex.Message];
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadAccountGroupNatureLookupBestEffortAsync()
    {
        try
        {
            var groups = await AccountGroupsApi.ListAsync(default);
            var detailTasks = groups.Select(async group => new
            {
                group.Id,
                Details = await AccountGroupsApi.GetByIdAsync(group.Id, default)
            });

            var details = await Task.WhenAll(detailTasks);
            _accountGroupNaturesById = details.ToDictionary(
                x => x.Id,
                x => (IReadOnlySet<AccountNature>)x.Details.Accounts
                    .Select(a => a.Nature)
                    .Where(n => n != AccountNature.Liability)
                    .Distinct()
                    .ToHashSet());
        }
        catch
        {
            _accountGroupNaturesById = new Dictionary<Guid, IReadOnlySet<AccountNature>>();
        }
    }

    private void SetChartMode(ChartMode mode)
    {
        _chartMode = mode;
    }

    private string GetChartModeButtonClass(ChartMode mode)
    {
        return _chartMode == mode ? "btn-primary" : "btn-outline-primary";
    }

    private Task OnFocusedMonthChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var month))
            _focusedMonth = month;

        _expandedSeriesKey = null;
        return LoadMonthlyChartAsync();
    }

    private void ToggleSeriesDetails(string seriesKey)
    {
        _expandedSeriesKey = _expandedSeriesKey == seriesKey ? null : seriesKey;
    }

    private static string GetValueColorClass(long cents, bool hasData)
    {
        return hasData ? MoneyFormatter.GetColorClass(cents) : "text-muted";
    }

    private IReadOnlyList<int> GetAvailableMonths()
    {
        if (_report is null || _report.Series.Count == 0)
            return Array.Empty<int>();

        return _report.Series
            .SelectMany(s => s.Points.Select(p => p.Month))
            .Distinct()
            .OrderBy(m => m)
            .ToList();
    }

    private IReadOnlyList<int> GetAvailableMonthsForFocusedSelection()
    {
        var months = GetAvailableMonths();
        var dataUntilMonth = GetDataUntilMonthForSelectedYear();
        return dataUntilMonth is null
            ? months
            : months.Where(m => m <= dataUntilMonth.Value).ToList();
    }

    private int? GetDataUntilMonthForSelectedYear()
    {
        return _selectedYear == DateHelper.GetCurrentYear()
            ? DateHelper.GetCurrentMonth()
            : null;
    }

    private int? GetReferenceMonthForSelectedYear()
    {
        var months = GetAvailableMonthsForFocusedSelection();
        if (months.Count == 0)
            return null;

        var preferredMonth = _selectedYear == DateHelper.GetCurrentYear()
            ? DateHelper.GetCurrentMonth()
            : months.Max();

        if (months.Contains(preferredMonth))
            return preferredMonth;

        return months
            .Where(m => m <= preferredMonth)
            .DefaultIfEmpty(months.Max())
            .Max();
    }

    private int? GetFocusedCompositionMonth()
    {
        var months = GetAvailableMonthsForFocusedSelection();
        if (months.Count == 0)
            return null;

        if (_focusedMonth is not null && months.Contains(_focusedMonth.Value))
            return _focusedMonth.Value;

        return GetReferenceMonthForSelectedYear();
    }

    private void SyncFocusedMonth()
    {
        var availableMonths = GetAvailableMonthsForFocusedSelection();
        if (availableMonths.Count == 0)
        {
            _focusedMonth = null;
            return;
        }

        var preferredMonth = GetReferenceMonthForSelectedYear() ?? availableMonths.Max();
        if (_focusedMonth is null || !availableMonths.Contains(_focusedMonth.Value))
            _focusedMonth = availableMonths.Contains(preferredMonth)
                ? preferredMonth
                : availableMonths.Max();
    }

    private async Task LoadMonthlyChartAsync()
    {
        if (_focusedMonth is null)
        {
            _monthlyBalanceVsGroupsChart = null;
            return;
        }

        _isMonthlyChartLoading = true;
        _monthlyChartError = null;
        _monthlyBalanceVsGroupsChart = null;
        StateHasChanged();

        try
        {
            _monthlyBalanceVsGroupsChart = await ReportsApi.GetMonthlyChartGroupEvolutionAsync(_selectedYear, _focusedMonth.Value);
        }
        catch (UnauthorizedAccessException)
        {
            _monthlyChartError = L["Reports_Error_Unauthorized"];
        }
        catch (Exception ex)
        {
            _monthlyChartError = L["Reports_Error_LoadMonthFocusedChart", ex.Message];
        }
        finally
        {
            _isMonthlyChartLoading = false;
        }
    }

    private static MonthlyEvolutionPointDto? GetPointAtOrBeforeMonth(MonthlyEvolutionSeriesDto series, int month)
    {
        return series.Points
            .Where(p => p.Month <= month)
            .OrderByDescending(p => p.Month)
            .FirstOrDefault();
    }

    private static MonthlyEvolutionPointDto? GetPointAtMonth(MonthlyEvolutionSeriesDto series, int month)
    {
        return series.Points
            .FirstOrDefault(p => p.Month == month);
    }

    private static IReadOnlyList<MonthlyEvolutionPointDto> GetSeriesPointsForDetails(
        MonthlyEvolutionSeriesDto series,
        int? dataUntilMonth)
    {
        return series.Points
            .Where(p => dataUntilMonth is null || p.Month <= dataUntilMonth.Value)
            .OrderBy(p => p.Month)
            .ToList();
    }

    private bool IsExpenseOrientedGroup(MonthlyEvolutionSeriesDto series)
    {
        if (series.EntityId is null)
            return false;

        if (!_accountGroupNaturesById.TryGetValue(series.EntityId.Value, out var natures))
            return true;

        return natures.Contains(AccountNature.Expense);
    }

    private (long EndBalance, long DeltaPrev, long DeltaYearStart) GetLatestSummary()
    {
        if (_report is null || _report.Series.Count == 0)
            return (0L, 0L, 0L);

        var referenceMonth = GetReferenceMonthForSelectedYear();
        var latestPoints = _report.Series
            .Select(s => referenceMonth is not null
                ? GetPointAtOrBeforeMonth(s, referenceMonth.Value)
                : s.Points.OrderByDescending(p => p.Month).FirstOrDefault())
            .Where(p => p is not null)
            .Select(p => p!)
            .ToList();

        if (latestPoints.Count == 0)
            return (0L, 0L, 0L);

        return (
            EndBalance: latestPoints.Sum(p => p.EndBalanceCents),
            DeltaPrev: latestPoints.Sum(p => p.DeltaVsPreviousMonthCents),
            DeltaYearStart: latestPoints.Sum(p => p.DeltaVsYearStartCents)
        );
    }

    private ChartsViewModel BuildChartsViewModel()
    {
        if (_report is null || _report.Series.Count == 0)
            return ChartsViewModel.Empty;

        try
        {
            var focusedCompositionMonth = GetFocusedCompositionMonth();
            var accountGroupEvolution = AnnualChartDatasetAdapter.BuildSeriesMonthlyDelta(_report, maxSeries: 12);
            var rawAccountGroupExpenseComposition = focusedCompositionMonth is not null
                ? AnnualChartDatasetAdapter.BuildCompositionFromSeriesAtMonth(
                    _report,
                    IsExpenseOrientedGroup,
                    focusedCompositionMonth.Value)
                : Array.Empty<AnnualCompositionSlice>();
            var accountGroupExpenseComposition = BuildDashboardStyleComposition(rawAccountGroupExpenseComposition);

            return new ChartsViewModel(
                AccountGroupEvolution: accountGroupEvolution,
                AccountGroupExpenseComposition: accountGroupExpenseComposition,
                Error: null);
        }
        catch (Exception ex)
        {
            return new ChartsViewModel(
                AccountGroupEvolution: Array.Empty<AnnualChartSeries>(),
                AccountGroupExpenseComposition: Array.Empty<AnnualCompositionSlice>(),
                Error: L["Reports_Error_BuildChartDataset", ex.Message]);
        }
    }

    private IReadOnlyList<AnnualCompositionSlice> BuildDashboardStyleComposition(
        IReadOnlyList<AnnualCompositionSlice> slices)
    {
        if (slices.Count == 0)
            return Array.Empty<AnnualCompositionSlice>();

        var maxSlices = Math.Max(2, CompositionMaxSlices);
        var ordered = slices
            .OrderByDescending(slice => slice.RawValueCents)
            .ThenBy(slice => slice.Label, StringComparer.OrdinalIgnoreCase)
            .ToList();

        var limited = ordered.Count > maxSlices
            ? ordered.Take(maxSlices - 1).ToList()
            : ordered;

        if (ordered.Count > maxSlices)
        {
            var othersRawValueCents = ordered.Skip(maxSlices - 1).Sum(slice => slice.RawValueCents);
            if (othersRawValueCents > 0)
            {
                limited.Add(new AnnualCompositionSlice(
                    Key: "others",
                    Label: L["Dashboard_ExpenseComposition_Others"],
                    RawValueCents: othersRawValueCents,
                    Percentage: 0m,
                    ColorHex: AnnualChartPalette.Resolve(limited.Count)));
            }
        }

        var total = limited.Sum(slice => slice.RawValueCents);
        if (total <= 0)
            return Array.Empty<AnnualCompositionSlice>();

        return limited
            .Select((slice, idx) => new AnnualCompositionSlice(
                Key: slice.Key,
                Label: slice.Label,
                RawValueCents: slice.RawValueCents,
                Percentage: (slice.RawValueCents * 100m) / total,
                ColorHex: AnnualChartPalette.Resolve(idx)))
            .ToList();
    }

    private IReadOnlyList<MonthlyChartSeries> BuildMonthlyComparisonChartSeries()
    {
        if (_monthlyBalanceVsGroupsChart is null)
            return Array.Empty<MonthlyChartSeries>();

        return MonthlyChartDatasetAdapter
            .BuildSeries(_monthlyBalanceVsGroupsChart, maxSeries: 13)
            .Where(series => !string.Equals(series.Key, "asset-total", StringComparison.OrdinalIgnoreCase))
            .Take(12)
            .ToList();
    }

    private async Task ExportOverviewCsvAsync()
    {
        if (_report is null || _report.Series.Count == 0)
            return;

        var summaryMonth = _focusedMonth;
        var rows = _report.Series
            .OrderBy(series => series.DisplayName, StringComparer.OrdinalIgnoreCase)
            .ThenBy(series => series.SeriesKey, StringComparer.Ordinal)
            .Select(series =>
            {
                var point = summaryMonth is not null
                    ? GetPointAtMonth(series, summaryMonth.Value)
                    : null;

                return (IReadOnlyList<string?>)
                [
                    series.DisplayName,
                    point is not null ? MoneyFormatter.FormatCentsWithSign(point.EndBalanceCents) : "-",
                    point is not null ? MoneyFormatter.FormatCentsWithSign(point.DeltaVsPreviousMonthCents) : "-"
                ];
            })
            .ToList();

        var csv = ReportCsvBuilder.Build(
            reportName: L["AccountGroupState_AnnualEvolutionTitle"],
            context: new Dictionary<string, string?>
            {
                [L["Reports_Year"]] = _selectedYear.ToString(),
                [L["Reports_FocusedMonth"]] = _focusedMonth is not null ? DateHelper.GetMonthName(_focusedMonth.Value) : null
            },
            headers: [L["Reports_SeriesName"], L["Reports_EndBalance"], L["Reports_MonthBalance"]],
            rows: rows);

        try
        {
            var fileName = $"{ReportExportInterop.BuildFileName("account-group-state-evolution", _selectedYear, _focusedMonth)}.csv";
            await JS.DownloadCsvAsync(fileName, csv);
        }
        catch (Exception ex)
        {
            _error = L["Reports_Error_ExportCsvFailed", ex.Message];
        }
    }

    private enum ChartMode
    {
        Evolution,
        Composition
    }

    private sealed record ChartsViewModel(
        IReadOnlyList<AnnualChartSeries> AccountGroupEvolution,
        IReadOnlyList<AnnualCompositionSlice> AccountGroupExpenseComposition,
        string? Error)
    {
        public static ChartsViewModel Empty => new(
            AccountGroupEvolution: Array.Empty<AnnualChartSeries>(),
            AccountGroupExpenseComposition: Array.Empty<AnnualCompositionSlice>(),
            Error: null);
    }
}
