@using FamilyFinances.Application.Reporting.Dtos
@using FamilyFinances.Application.Reporting.Semantics
@using FamilyFinances.Domain.Ledger.Accounts
@using FamilyFinances.Web.Api
@using FamilyFinances.Web.Components.Base
@using FamilyFinances.Web.Components.Pages.Reports.Charts
@using FamilyFinances.Web.Features.Reports
@using FamilyFinances.Web.Features.Reports.Export
@using FamilyFinances.Web.Features.Reports.Charts
@using Microsoft.Extensions.Localization
@using FamilyFinances.Web
@using Microsoft.JSInterop
@inherits ApiPageBase

@inject ReportsApi ReportsApi
@inject IAccountsApi AccountsApi
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResource> L

@if (!UseExternalFilters)
{
    <div class="card shadow-sm mb-4 ff-panel ff-report-filter-panel">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-12 col-md-4">
                    <label class="form-label fw-semibold">
                        <i class="bi bi-calendar3 me-1"></i>@L["Reports_Year"]
                    </label>
                    <select class="form-select" aria-label="@L["Reports_Year"]" value="@_selectedYear" @onchange="OnYearChangedAsync" disabled="@_isLoading">
                        @foreach (var year in _yearOptions)
                        {
                            <option value="@year">@year</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-4">
                    <label class="form-label fw-semibold">
                        <i class="bi bi-calendar-month me-1"></i>@L["Reports_FocusedMonth"]
                    </label>
                    <select class="form-select asset-focused-month-select"
                            aria-label="@L["Reports_FocusedMonth"]"
                            data-testid="economic-state-income-focused-month"
                            value="@_focusedMonth"
                            @onchange="OnFocusedMonthChangedAsync"
                            disabled="@(_isLoading || _isMonthlyChartLoading || _focusedMonthOptions.Count == 0)">
                        @foreach (var month in _focusedMonthOptions)
                        {
                            <option value="@month">@DateHelper.GetMonthName(month)</option>
                        }
                    </select>
                </div>
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-2"></i>@_error
        <button type="button" class="btn-close" @onclick="@(() => _error = null)"></button>
    </div>
}

@if (_isLoading)
{
    <ReportingChartLoadingState
        Title="@L["IncomeEvolution_LoadingTitle"]"
        Description="@L["Reports_LoadingData"]" />
}
else if (_report is not null && _report.Series.Count == 0)
{
    <ReportingChartEmptyState
        Title="@L["EconomicState_Tab_IncomeEvolution"]"
        Description="@L["Reports_NoEvolutionDataForYear"]" />
}
else if (_report is not null)
{
    var (latestEndBalance, latestDeltaPrev, latestDeltaYearStart) = GetLatestSummary();
    var charts = BuildChartsViewModel();
    var dataUntilMonth = GetDataUntilMonthForSelectedYear();
    var series = _report.Series.First();
    var monthlyChartSeries = BuildMonthlyChartSeries();
    var focusedMonthLabel = DateHelper.GetMonthName(_focusedMonth);

    <div class="row g-3 mb-4">
        <div class="col-12 col-md-4">
            <div class="card shadow-sm h-100 border-start border-primary border-4 ff-kpi-card ff-panel">
                <div class="card-body">
                    <h6 class="text-muted text-uppercase mb-2 ff-kpi-label">@L["IncomeEvolution_LatestIncomeBalance"]</h6>
                    <h4 class="mb-0 @MoneyFormatter.GetColorClass(latestEndBalance)">
                        @MoneyFormatter.FormatCentsWithSign(latestEndBalance)
                    </h4>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card shadow-sm h-100 ff-kpi-card ff-panel">
                <div class="card-body">
                    <h6 class="text-muted text-uppercase mb-2 ff-kpi-label">@L["Reports_LatestMetric", $"{L["IncomeEvolution_IncomeBalance"]} {ReportingMetricLocalizer.GetLabel(L, _deltaPrevMetric)}"]</h6>
                    <h4 class="mb-0 @MoneyFormatter.GetColorClass(latestDeltaPrev)">
                        @MoneyFormatter.FormatCentsWithSign(latestDeltaPrev)
                    </h4>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card shadow-sm h-100 ff-kpi-card ff-panel">
                <div class="card-body">
                    <h6 class="text-muted text-uppercase mb-2 ff-kpi-label">@L["Reports_LatestMetric", $"{L["IncomeEvolution_IncomeBalance"]} {ReportingMetricLocalizer.GetLabel(L, _deltaYearStartMetric)}"]</h6>
                    <h4 class="mb-0 @MoneyFormatter.GetColorClass(latestDeltaYearStart)">
                        @MoneyFormatter.FormatCentsWithSign(latestDeltaYearStart)
                    </h4>
                </div>
            </div>
        </div>
    </div>

    <div class="alert alert-info mb-4 ff-info-note" role="alert">
        <i class="bi bi-info-circle me-2"></i>
        @L["IncomeEvolution_StockMetricsHint"]
    </div>

    var visibleMonths = GetVisibleMonths();
    var compositionMonth = GetCompositionMonth();
    var compositionMonthLabel = compositionMonth is not null
        ? DateHelper.GetMonthName(compositionMonth.Value)
        : L["Reports_NotAvailable"];
    var compositionSubtitle = $"{L["Reports_FocusedMonth"]}: {compositionMonthLabel}";
    var compositionBadgeText = compositionMonth is not null
        ? L["Reports_BadgePeriod", $"{_selectedYear:D4}-{compositionMonth.Value:D2}"]
        : L["Reports_BadgeYear", _selectedYear.ToString()];
    var compositionSlices = BuildCompositionSlices();

    <div class="ff-report-three-column mb-4">
        <div class="ff-report-column">
            <div class="card shadow-sm h-100 ff-panel">
                <div class="card-header bg-transparent ff-panel-header">
                    <div class="d-flex justify-content-between align-items-center gap-3">
                        <h5 class="mb-0">
                            <i class="bi bi-list-ul me-2"></i>@L["IncomeEvolution_MonthlyOverview"]
                        </h5>
                        <div class="d-flex align-items-center gap-2">
                            <button type="button"
                                    class="btn btn-sm btn-outline-secondary report-export-button"
                                    @onclick="ExportMonthlyOverviewCsvAsync"
                                    data-testid="economic-state-income-overview-export-csv"
                                    aria-label="@L["Reports_AriaExportCsv"]">
                                <i class="bi bi-download me-1"></i>@L["Reports_Export"]
                            </button>
                            @if (dataUntilMonth is not null)
                            {
                                <span class="badge text-bg-secondary">
                                    @L["Reports_CurrentMonth", DateHelper.GetMonthName(dataUntilMonth.Value)]
                                </span>
                            }
                        </div>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle mb-0 ff-data-table">
                            <thead class="table-light">
                                <tr>
                                    <th class="border-0 ps-3">@L["Reports_Month"]</th>
                                    <th class="border-0 text-end">@L["Reports_Balance"]</th>
                                    <th class="border-0 text-end">@L["Reports_EndBalance"]</th>
                                    <th class="border-0 text-end pe-3">@L["Reports_DeltaYearStart"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var month in visibleMonths)
                                {
                                    var point = series.Points.FirstOrDefault(p => p.Month == month);
                                    var isCurrentMonth = dataUntilMonth is not null && month == dataUntilMonth.Value;

                                    <tr class="series-summary-row @(isCurrentMonth ? "table-active" : string.Empty)">
                                        <td class="ps-3">
                                            @DateHelper.GetMonthName(month)
                                            @if (isCurrentMonth)
                                            {
                                                <span class="badge rounded-pill text-bg-primary ms-2">@L["Reports_Current"]</span>
                                            }
                                        </td>
                                        <td class="text-end @MoneyFormatter.GetColorClass(point?.DeltaVsPreviousMonthCents ?? 0)">
                                            @(point is not null ? MoneyFormatter.FormatCentsWithSign(point.DeltaVsPreviousMonthCents) : "-")
                                        </td>
                                        <td class="text-end @MoneyFormatter.GetColorClass(point?.EndBalanceCents ?? 0)">
                                            @(point is not null ? MoneyFormatter.FormatCentsWithSign(point.EndBalanceCents) : "-")
                                        </td>
                                        <td class="text-end pe-3 @MoneyFormatter.GetColorClass(point?.DeltaVsYearStartCents ?? 0)">
                                            @(point is not null ? MoneyFormatter.FormatCentsWithSign(point.DeltaVsYearStartCents) : "-")
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <div class="ff-report-column">
            @if (compositionSlices.Count == 0)
            {
                <ReportingChartEmptyState
                    Title="@L["Reports_ChartMode_Composition"]"
                    Description="@L["Reports_NoChartPointsForFilters"]" />
            }
            else
            {
                <AnnualCompositionChart
                    Title="@L["Reports_ChartMode_Composition"]"
                    Subtitle="@compositionSubtitle"
                    Year="@_selectedYear"
                    BadgeText="@compositionBadgeText"
                    Slices="@compositionSlices"
                    UseSideLegend="true"
                    LegendMaxItems="10"
                    TestId="economic-state-income-composition-chart" />
            }
        </div>
        <div class="ff-report-column">
            <div class="economic-state-stacked-charts">
                <div class="asset-total-chart-panel economic-state-chart-item">
                    @if (_isMonthlyChartLoading)
                    {
                        <ReportingChartLoadingState
                            Title="@L["IncomeEvolution_LoadingMonthFocusedIncome"]"
                            Description="@L["Reports_LoadingDailyPoints"]" />
                    }
                    else if (!string.IsNullOrWhiteSpace(_monthlyChartError))
                    {
                        <ReportingChartErrorState Message="@_monthlyChartError" />
                    }
                    else if (_monthlyBalanceChart is null || _monthlyBalanceChart.Points.Count == 0 || monthlyChartSeries.Count == 0)
                    {
                        <ReportingChartEmptyState
                            Title="@L["IncomeEvolution_MonthFocusedTitle"]"
                            Description="@L["Reports_NoDailyPointsForMonth"]" />
                    }
                    else
                    {
                        <EvolutionChart
                            Mode="EvolutionChartMode.DailyInMonth"
                            Title="@L["IncomeEvolution_MonthFocusedTitle"]"
                            Subtitle="@L["IncomeEvolution_MonthFocusedSubtitle", focusedMonthLabel, _selectedYear]"
                            Year="@_selectedYear"
                            Month="@_focusedMonth"
                            YTickMaxTicks="5"
                            ShowFullRange="true"
                            DailySeries="@monthlyChartSeries"
                            TestId="economic-state-income-monthly-chart" />
                    }
                </div>
                <div class="asset-total-chart-panel economic-state-chart-item">
                    @if (!string.IsNullOrWhiteSpace(charts.Error))
                    {
                        <ReportingChartErrorState Message="@charts.Error" />
                    }
                    else if (charts.IncomeEndBalanceEvolution.Count == 0)
                    {
                        <ReportingChartEmptyState
                            Title="@L["IncomeEvolution_AnnualTitle"]"
                            Description="@L["Reports_NoChartPointsForFilters"]" />
                    }
                    else
                    {
                        <EvolutionChart
                            Mode="EvolutionChartMode.MonthlyInYear"
                            Title="@L["IncomeEvolution_AnnualTitle"]"
                            Subtitle="@L["IncomeEvolution_AnnualSubtitle"]"
                            Year="@_selectedYear"
                            AnnualSeries="@charts.IncomeEndBalanceEvolution"
                            DataUntilMonth="@dataUntilMonth"
                            YTickMaxTicks="5"
                            CarryForwardAfterMarker="true"
                            TestId="economic-state-income-evolution-chart" />
                    }
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="card shadow-sm ff-panel">
        <div class="card-body text-center py-5">
            <i class="bi bi-graph-up display-4 text-muted mb-3"></i>
            <h5 class="text-muted">@L["IncomeEvolution_SelectYearHint"]</h5>
        </div>
    </div>
}

@code {
    [Parameter] public bool UseExternalFilters { get; set; }
    [Parameter] public int? SelectedYear { get; set; }
    [Parameter] public int? FocusedMonth { get; set; }

    private MonthlyEvolutionReportDto? _report;
    private MonthlyEvolutionReportDto? _accountsEvolutionReport;
    private MonthlyBalanceChartDto? _monthlyBalanceChart;
    private string? _error;
    private string? _monthlyChartError;
    private bool _isLoading;
    private bool _isMonthlyChartLoading;
    private int _selectedYear = DateHelper.GetCurrentYear();
    private IReadOnlyList<int> _yearOptions = Array.Empty<int>();
    private IReadOnlyList<int> _focusedMonthOptions = Array.Empty<int>();
    private int _focusedMonth = DateHelper.GetCurrentMonth();
    private int? _lastExternalYear;
    private int? _lastExternalMonth;
    private IReadOnlyDictionary<Guid, AccountNature> _accountNatureById =
        new Dictionary<Guid, AccountNature>();
    private const int CompositionMaxSlices = 10;

    private static readonly ReportingMetricDefinition _deltaPrevMetric =
        ReportingMetricSemantics.Get(ReportingMetricKey.DeltaVsPreviousMonth);
    private static readonly ReportingMetricDefinition _deltaYearStartMetric =
        ReportingMetricSemantics.Get(ReportingMetricKey.DeltaVsYearStart);

    protected override async Task OnInitializedAsync()
    {
        _yearOptions = Enumerable
            .Range(2000, DateHelper.GetCurrentYear() - 2000 + 1)
            .OrderByDescending(x => x)
            .ToList();

        if (!UseExternalFilters)
            await LoadReportAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!UseExternalFilters)
            return;

        _selectedYear = SelectedYear ?? DateHelper.GetCurrentYear();
        SyncFocusedMonth();

        if (_report is not null && _lastExternalYear == _selectedYear && _lastExternalMonth == _focusedMonth)
            return;

        _lastExternalYear = _selectedYear;
        _lastExternalMonth = _focusedMonth;
        await LoadReportAsync();
    }

    private async Task OnYearChangedAsync(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var year))
            return;

        _selectedYear = year;
        await LoadReportAsync();
    }

    private async Task OnFocusedMonthChangedAsync(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var month))
            return;

        _focusedMonth = month;
        await LoadMonthlyChartAsync();
    }

    private async Task LoadReportAsync()
    {
        _isLoading = true;
        _error = null;
        _monthlyChartError = null;
        _report = null;
        _accountsEvolutionReport = null;
        _monthlyBalanceChart = null;
        _accountNatureById = new Dictionary<Guid, AccountNature>();
        StateHasChanged();

        try
        {
            _report = await ReportsApi.GetStateEvolutionAsync(_selectedYear, MonthlyEvolutionScope.IncomeTotal);
            _accountsEvolutionReport = await ReportsApi.GetStateEvolutionAsync(_selectedYear, MonthlyEvolutionScope.Accounts);
            await LoadAccountNatureLookupBestEffortAsync();
            SyncFocusedMonth();
            await LoadMonthlyChartAsync();
        }
        catch (UnauthorizedAccessException)
        {
            _error = L["Reports_Error_Unauthorized"];
        }
        catch (Exception ex)
        {
            _error = L["Reports_Error_LoadFailed", ex.Message];
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadMonthlyChartAsync()
    {
        _isMonthlyChartLoading = true;
        _monthlyChartError = null;
        _monthlyBalanceChart = null;
        StateHasChanged();

        try
        {
            _monthlyBalanceChart = await ReportsApi.GetMonthlyChartBalanceAsync(
                _selectedYear,
                _focusedMonth,
                nature: AccountNature.Income);
        }
        catch (UnauthorizedAccessException)
        {
            _monthlyChartError = L["Reports_Error_Unauthorized"];
        }
        catch (Exception ex)
        {
            _monthlyChartError = L["Reports_Error_LoadMonthFocusedChart", ex.Message];
        }
        finally
        {
            _isMonthlyChartLoading = false;
        }
    }

    private int? GetDataUntilMonthForSelectedYear()
    {
        return _selectedYear == DateHelper.GetCurrentYear()
            ? DateHelper.GetCurrentMonth()
            : null;
    }

    private void SyncFocusedMonth()
    {
        var maxMonth = GetDataUntilMonthForSelectedYear() ?? 12;
        _focusedMonthOptions = Enumerable.Range(1, maxMonth).ToList();

        if (_focusedMonthOptions.Count == 0)
        {
            _focusedMonth = 1;
            return;
        }

        if (UseExternalFilters)
        {
            var externalFocusedMonth = FocusedMonth ?? _focusedMonthOptions.Max();
            _focusedMonth = Math.Clamp(externalFocusedMonth, 1, _focusedMonthOptions.Max());
            return;
        }

        var preferred = GetReferenceMonthForSelectedYear() ?? _focusedMonthOptions.Max();
        if (!_focusedMonthOptions.Contains(_focusedMonth))
            _focusedMonth = _focusedMonthOptions.Contains(preferred)
                ? preferred
                : _focusedMonthOptions.Max();
    }

    private int? GetReferenceMonthForSelectedYear()
    {
        var months = GetVisibleMonths();

        if (months.Count == 0)
            return null;

        var preferredMonth = _selectedYear == DateHelper.GetCurrentYear()
            ? DateHelper.GetCurrentMonth()
            : months.Max();

        if (months.Contains(preferredMonth))
            return preferredMonth;

        return months
            .Where(m => m <= preferredMonth)
            .DefaultIfEmpty(months.Max())
            .Max();
    }

    private static MonthlyEvolutionPointDto? GetPointAtOrBeforeMonth(MonthlyEvolutionSeriesDto series, int month)
    {
        return series.Points
            .Where(p => p.Month <= month)
            .OrderByDescending(p => p.Month)
            .FirstOrDefault();
    }

    private (long EndBalance, long DeltaPrev, long DeltaYearStart) GetLatestSummary()
    {
        if (_report is null || _report.Series.Count == 0)
            return (0L, 0L, 0L);

        var referenceMonth = GetReferenceMonthForSelectedYear();
        var latestPoints = _report.Series
            .Select(s => referenceMonth is not null
                ? GetPointAtOrBeforeMonth(s, referenceMonth.Value)
                : s.Points.OrderByDescending(p => p.Month).FirstOrDefault())
            .Where(p => p is not null)
            .Select(p => p!)
            .ToList();

        if (latestPoints.Count == 0)
            return (0L, 0L, 0L);

        return (
            EndBalance: latestPoints.Sum(p => p.EndBalanceCents),
            DeltaPrev: latestPoints.Sum(p => p.DeltaVsPreviousMonthCents),
            DeltaYearStart: latestPoints.Sum(p => p.DeltaVsYearStartCents)
        );
    }

    private ChartsViewModel BuildChartsViewModel()
    {
        if (_report is null || _report.Series.Count == 0)
            return ChartsViewModel.Empty;

        try
        {
            var incomeEndBalanceEvolution = AnnualChartDatasetAdapter.BuildEndBalanceSeries(_report, key: "end-balance", label: L["Reports_EndBalance"]);
            return new ChartsViewModel(incomeEndBalanceEvolution, null);
        }
        catch (Exception ex)
        {
            return new ChartsViewModel(Array.Empty<AnnualChartSeries>(), L["Reports_Error_BuildChartDataset", ex.Message]);
        }
    }

    private IReadOnlyList<MonthlyChartSeries> BuildMonthlyChartSeries()
    {
        if (_monthlyBalanceChart is null)
            return Array.Empty<MonthlyChartSeries>();

        var series = MonthlyChartDatasetAdapter.BuildSingleSeries(
            _monthlyBalanceChart,
            key: "income-total-monthly",
            label: L["Reports_EndBalance"]);

        if (_selectedYear != DateHelper.GetCurrentYear() || _focusedMonth != DateHelper.GetCurrentMonth())
            return series;

        var cutoffDay = DateTime.Today.Day;
        return series
            .Select(item => item with
            {
                Points = item.Points
                    .Where(point => point.Day <= cutoffDay)
                    .ToList()
            })
            .ToList();
    }

    private IReadOnlyList<int> GetVisibleMonths()
    {
        var maxMonth = GetDataUntilMonthForSelectedYear() ?? 12;
        return Enumerable.Range(1, maxMonth).ToList();
    }

    private int? GetCompositionMonth()
    {
        var visibleMonths = GetVisibleMonths();
        if (visibleMonths.Count == 0)
            return null;

        if (visibleMonths.Contains(_focusedMonth))
            return _focusedMonth;

        return GetReferenceMonthForSelectedYear();
    }

    private IReadOnlyList<AnnualCompositionSlice> BuildCompositionSlices()
    {
        if (_accountsEvolutionReport is null || _accountsEvolutionReport.Series.Count == 0 || _accountNatureById.Count == 0)
            return Array.Empty<AnnualCompositionSlice>();

        var month = GetCompositionMonth();
        if (month is null)
            return Array.Empty<AnnualCompositionSlice>();

        var raw = AnnualChartDatasetAdapter.BuildCompositionByNatureAtMonth(
            _accountsEvolutionReport,
            _accountNatureById,
            AccountNature.Income,
            month.Value);

        return BuildTopSlices(raw);
    }

    private IReadOnlyList<AnnualCompositionSlice> BuildTopSlices(IReadOnlyList<AnnualCompositionSlice> slices)
    {
        if (slices.Count == 0)
            return Array.Empty<AnnualCompositionSlice>();

        var ordered = slices
            .OrderByDescending(slice => Math.Abs(slice.RawValueCents))
            .ThenBy(slice => slice.Label, StringComparer.OrdinalIgnoreCase)
            .ToList();

        var maxSlices = Math.Max(2, CompositionMaxSlices);
        var head = ordered.Take(Math.Min(maxSlices, ordered.Count)).ToList();
        if (ordered.Count > maxSlices)
        {
            var othersRawValue = ordered.Skip(maxSlices).Sum(slice => Math.Abs(slice.RawValueCents));
            if (othersRawValue > 0)
            {
                head.Add(new AnnualCompositionSlice(
                    Key: "others",
                    Label: L["Dashboard_ExpenseComposition_Others"],
                    RawValueCents: othersRawValue,
                    Percentage: 0m,
                    ColorHex: AnnualChartPalette.Resolve(head.Count)));
            }
        }

        var total = head.Sum(slice => Math.Abs(slice.RawValueCents));
        if (total <= 0)
            return Array.Empty<AnnualCompositionSlice>();

        return head
            .Select((slice, idx) => new AnnualCompositionSlice(
                Key: slice.Key,
                Label: slice.Label,
                RawValueCents: Math.Abs(slice.RawValueCents),
                Percentage: (Math.Abs(slice.RawValueCents) * 100m) / total,
                ColorHex: AnnualChartPalette.Resolve(idx)))
            .ToList();
    }

    private async Task LoadAccountNatureLookupBestEffortAsync()
    {
        try
        {
            var accounts = await AccountsApi.ListAsync(default);
            _accountNatureById = accounts.ToDictionary(account => account.Id, account => account.Nature);
        }
        catch
        {
            _accountNatureById = new Dictionary<Guid, AccountNature>();
        }
    }

    private async Task ExportMonthlyOverviewCsvAsync()
    {
        if (_report is null || _report.Series.Count == 0)
            return;

        var pointsByMonth = _report.Series.First().Points.ToDictionary(point => point.Month, point => point);
        var rows = GetVisibleMonths()
            .Select(month =>
            {
                var point = pointsByMonth.GetValueOrDefault(month);
                return (IReadOnlyList<string?>)
                [
                    DateHelper.GetMonthName(month),
                    point is not null ? MoneyFormatter.FormatCentsWithSign(point.DeltaVsPreviousMonthCents) : "-",
                    point is not null ? MoneyFormatter.FormatCentsWithSign(point.EndBalanceCents) : "-",
                    point is not null ? MoneyFormatter.FormatCentsWithSign(point.DeltaVsYearStartCents) : "-"
                ];
            })
            .ToList();

        var csv = ReportCsvBuilder.Build(
            reportName: L["IncomeEvolution_AnnualTitle"],
            context: new Dictionary<string, string?>
            {
                [L["Reports_Year"]] = _selectedYear.ToString(),
                [L["Reports_FocusedMonth"]] = DateHelper.GetMonthName(_focusedMonth)
            },
            headers: [L["Reports_Month"], L["Reports_Balance"], L["Reports_EndBalance"], L["Reports_DeltaYearStart"]],
            rows: rows);

        try
        {
            var fileName = $"{ReportExportInterop.BuildFileName("income-total-evolution", _selectedYear)}.csv";
            await JS.DownloadCsvAsync(fileName, csv);
        }
        catch (Exception ex)
        {
            _error = L["Reports_Error_ExportCsvFailed", ex.Message];
        }
    }

    private sealed record ChartsViewModel(
        IReadOnlyList<AnnualChartSeries> IncomeEndBalanceEvolution,
        string? Error)
    {
        public static ChartsViewModel Empty => new(
            IncomeEndBalanceEvolution: Array.Empty<AnnualChartSeries>(),
            Error: null);
    }
}
