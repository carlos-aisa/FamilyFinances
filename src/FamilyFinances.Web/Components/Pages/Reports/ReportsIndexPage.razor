@page "/reports"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Authorization
@using FamilyFinances.Web.Components.Base
@inherits ApiPageBase

<AuthorizeView>
    <Authorized>
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <h3 class="mb-1">
                    <i class="bi bi-graph-up me-2"></i>Reports
                </h3>
                <p class="text-muted mb-0">Financial reports and insights</p>
            </div>
        </div>

        <div class="row g-4">
            <!-- Monthly Summary Card -->
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card shadow-sm h-100 report-card" style="cursor: pointer;" @onclick="@(() => NavigateToReport("monthly-summary"))">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-3">
                            <div class="report-icon bg-primary bg-opacity-10 text-primary rounded-3 p-3 me-3">
                                <i class="bi bi-calendar-month fs-4"></i>
                            </div>
                            <div>
                                <h5 class="card-title mb-0">Monthly Summary</h5>
                            </div>
                        </div>
                        <p class="card-text text-muted">
                            View income, expenses, and net balance for any month. Filter by account or payee.
                        </p>
                        <div class="mt-3">
                            <span class="badge bg-primary bg-opacity-10 text-primary">
                                <i class="bi bi-calendar3 me-1"></i>Monthly
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Category Totals Card -->
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card shadow-sm h-100 report-card" style="cursor: pointer;" @onclick="@(() => NavigateToReport("category-totals"))">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-3">
                            <div class="report-icon bg-success bg-opacity-10 text-success rounded-3 p-3 me-3">
                                <i class="bi bi-pie-chart fs-4"></i>
                            </div>
                            <div>
                                <h5 class="card-title mb-0">Category Totals</h5>
                            </div>
                        </div>
                        <p class="card-text text-muted">
                            Analyze spending or income by category for any date range. See where your money goes.
                        </p>
                        <div class="mt-3">
                            <span class="badge bg-success bg-opacity-10 text-success">
                                <i class="bi bi-calendar-range me-1"></i>Date Range
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Account Totals Card -->
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card shadow-sm h-100 report-card" style="cursor: pointer;" @onclick="@(() => NavigateToReport("account-totals"))">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-3">
                            <div class="report-icon bg-info bg-opacity-10 text-info rounded-3 p-3 me-3">
                                <i class="bi bi-wallet2 fs-4"></i>
                            </div>
                            <div>
                                <h5 class="card-title mb-0">Account Totals</h5>
                            </div>
                        </div>
                        <p class="card-text text-muted">
                            See net changes for all accounts across any period. Track asset, liability, and equity movements.
                        </p>
                        <div class="mt-3">
                            <span class="badge bg-info bg-opacity-10 text-info">
                                <i class="bi bi-calendar-range me-1"></i>Date Range
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Account Groups Card -->
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card shadow-sm h-100 report-card" style="cursor: pointer;" @onclick="@(() => NavigateToReport("account-group-totals"))">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-3">
                            <div class="report-icon bg-warning bg-opacity-10 text-warning rounded-3 p-3 me-3">
                                <i class="bi bi-collection fs-4"></i>
                            </div>
                            <div>
                                <h5 class="card-title mb-0">Account Group Totals</h5>
                            </div>
                        </div>
                        <p class="card-text text-muted">
                            View totals grouped by account groups. Compare expenses or income across different categories.
                        </p>
                        <div class="mt-3">
                            <span class="badge bg-warning bg-opacity-10 text-warning">
                                <i class="bi bi-calendar-range me-1"></i>Date Range
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Info Section -->
        <div class="card shadow-sm mt-4">
            <div class="card-body">
                <h6 class="card-title">
                    <i class="bi bi-info-circle me-2"></i>About Reports
                </h6>
                <p class="card-text text-muted mb-0">
                    All reports support filters and date ranges. Data is based on your transaction history and account balances.
                    Charts and visualizations coming soon!
                </p>
            </div>
        </div>

    </Authorized>
    <NotAuthorized>
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle me-2"></i>
            Please log in to view reports.
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    private void NavigateToReport(string reportName)
    {
        Navigation.NavigateTo($"/reports/{reportName}");
    }

    protected override Task OnInitializedAsync()
    {
        // No data loading needed for index page
        return Task.CompletedTask;
    }
}
