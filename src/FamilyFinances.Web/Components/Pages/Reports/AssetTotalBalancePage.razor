@page "/reports/asset-total-balance"
@rendermode InteractiveServer
@using FamilyFinances.Application.Reporting.Dtos
@using FamilyFinances.Web
@using FamilyFinances.Web.Api
@using FamilyFinances.Web.Components.Base
@using FamilyFinances.Web.Features.Reports
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Localization
@inherits ApiPageBase

@inject ReportsApi ReportsApi
@inject IStringLocalizer<SharedResource> L

<AuthorizeView>
    <Authorized>
        <div class="d-flex align-items-center justify-content-between mb-4 ff-page-header">
            <div>
                <h3 class="mb-1 ff-page-title">
                    <i class="bi bi-cash-coin me-2"></i>@L["AssetTotalBalance_Title"]
                </h3>
                <p class="text-muted mb-0 ff-page-subtitle">@L["AssetTotalBalance_Subtitle"]</p>
            </div>
            <a class="btn btn-outline-secondary" href="/reports">
                <i class="bi bi-arrow-left me-1"></i>@L["Reports_BackToReports"]
            </a>
        </div>

        <div class="card shadow-sm mb-4 ff-panel ff-report-filter-panel">
            <div class="card-body">
                <div class="row g-3 align-items-end">
                    <div class="col-12 col-md-4">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-calendar3 me-1"></i>@L["AssetTotalBalance_AsOfDate"]
                        </label>
                        <input type="date" class="form-control" aria-label="@L["AssetTotalBalance_AsOfDate"]" @bind="_asOfDate" />
                    </div>
                    <div class="col-12 col-md-auto">
                        <button class="btn btn-primary" @onclick="LoadReportAsync" disabled="@_isLoading">
                            @if (_isLoading)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            }
                            else
                            {
                                <i class="bi bi-search me-1"></i>
                            }
                            @L["Reports_LoadReport"]
                        </button>
                    </div>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle me-2"></i>@_error
                <button type="button" class="btn-close" @onclick="@(() => _error = null)"></button>
            </div>
        }

        @if (_isLoading)
        {
            <div class="card shadow-sm ff-panel">
                    <div class="card-body text-center py-5">
                        <div class="spinner-border text-primary mb-3 ff-spinner-lg" role="status">
                            <span class="visually-hidden">@L["Common_Loading"]</span>
                        </div>
                        <p class="text-muted mb-0">@L["Reports_LoadingData"]</p>
                    </div>
                </div>
            }
        else if (_report is not null)
        {
            <div class="row g-4">
                <div class="col-12 col-lg-8">
                    <div class="card shadow-sm border-start border-primary border-4 ff-kpi-card ff-panel">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <h6 class="text-muted text-uppercase mb-2 ff-kpi-label">@L["AssetTotalBalance_TotalLabel"]</h6>
                                    <h2 class="mb-1 @MoneyFormatter.GetColorClass(_report.TotalCents)">
                                        @MoneyFormatter.FormatCentsWithSign(_report.TotalCents)
                                    </h2>
                                    <p class="text-muted mb-0">
                                        @L["AssetTotalBalance_AsOfValue", _report.AsOf.ToString("yyyy-MM-dd")]
                                    </p>
                                </div>
                                <i class="bi bi-wallet2 text-primary fs-1 opacity-50"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-lg-4">
                        <div class="card shadow-sm h-100 ff-kpi-card ff-panel">
                            <div class="card-body d-flex flex-column justify-content-center">
                                <h6 class="text-muted text-uppercase mb-2 ff-kpi-label">@L["AssetTotalBalance_AccountsIncluded"]</h6>
                                <h3 class="mb-0 text-info">@_report.AssetAccountsCount</h3>
                            </div>
                        </div>
                </div>
            </div>
        }

    </Authorized>
    <NotAuthorized>
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle me-2"></i>
            @L["Reports_LoginRequired"]
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private AssetTotalBalanceDto? _report;
    private string? _error;
    private bool _isLoading;
    private DateOnly _asOfDate = DateOnly.FromDateTime(DateTime.UtcNow.Date);

    private async Task LoadReportAsync()
    {
        _isLoading = true;
        _error = null;
        _report = null;
        StateHasChanged();

        try
        {
            _report = await ReportsApi.GetAssetTotalBalanceAsync(_asOfDate);
        }
        catch (UnauthorizedAccessException)
        {
            _error = L["Reports_Error_Unauthorized"];
        }
        catch (Exception ex)
        {
            _error = L["Reports_Error_LoadFailed", ex.Message];
        }
        finally
        {
            _isLoading = false;
        }
    }
}

