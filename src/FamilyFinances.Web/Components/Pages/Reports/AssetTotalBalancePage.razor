@page "/reports/asset-total-balance"
@rendermode InteractiveServer
@using FamilyFinances.Application.Reporting.Dtos
@using FamilyFinances.Web.Api
@using FamilyFinances.Web.Components.Base
@using FamilyFinances.Web.Features.Reports
@using Microsoft.AspNetCore.Components.Authorization
@inherits ApiPageBase

@inject ReportsApi ReportsApi

<AuthorizeView>
    <Authorized>
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <h3 class="mb-1">
                    <i class="bi bi-cash-coin me-2"></i>Asset Total Balance
                </h3>
                <p class="text-muted mb-0">Aggregated balance of all asset accounts as-of a selected date</p>
            </div>
            <a class="btn btn-outline-secondary" href="/reports">
                <i class="bi bi-arrow-left me-1"></i>Back to Reports
            </a>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <div class="row g-3 align-items-end">
                    <div class="col-12 col-md-4">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-calendar3 me-1"></i>As-of Date
                        </label>
                        <input type="date" class="form-control" aria-label="As-of Date" @bind="_asOfDate" />
                    </div>
                    <div class="col-12 col-md-auto">
                        <button class="btn btn-primary" @onclick="LoadReportAsync" disabled="@_isLoading">
                            @if (_isLoading)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            }
                            else
                            {
                                <i class="bi bi-search me-1"></i>
                            }
                            Load Report
                        </button>
                    </div>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle me-2"></i>@_error
                <button type="button" class="btn-close" @onclick="@(() => _error = null)"></button>
            </div>
        }

        @if (_isLoading)
        {
            <div class="card shadow-sm">
                <div class="card-body text-center py-5">
                    <div class="spinner-border text-primary mb-3" role="status" style="width: 3rem; height: 3rem;">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="text-muted mb-0">Loading report data...</p>
                </div>
            </div>
        }
        else if (_report is not null)
        {
            <div class="row g-4">
                <div class="col-12 col-lg-8">
                    <div class="card shadow-sm border-start border-primary border-4">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <h6 class="text-muted text-uppercase mb-2" style="font-size: 0.75rem;">Total Asset Balance</h6>
                                    <h2 class="mb-1 @MoneyFormatter.GetColorClass(_report.TotalCents)">
                                        @MoneyFormatter.FormatCentsWithSign(_report.TotalCents)
                                    </h2>
                                    <p class="text-muted mb-0">
                                        As of @_report.AsOf.ToString("yyyy-MM-dd")
                                    </p>
                                </div>
                                <i class="bi bi-wallet2 text-primary fs-1 opacity-50"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-lg-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-body d-flex flex-column justify-content-center">
                            <h6 class="text-muted text-uppercase mb-2" style="font-size: 0.75rem;">Asset Accounts Included</h6>
                            <h3 class="mb-0 text-info">@_report.AssetAccountsCount</h3>
                        </div>
                    </div>
                </div>
            </div>
        }

    </Authorized>
    <NotAuthorized>
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle me-2"></i>
            Please log in to view reports.
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private AssetTotalBalanceDto? _report;
    private string? _error;
    private bool _isLoading;
    private DateOnly _asOfDate = DateOnly.FromDateTime(DateTime.UtcNow.Date);

    private async Task LoadReportAsync()
    {
        _isLoading = true;
        _error = null;
        _report = null;
        StateHasChanged();

        try
        {
            _report = await ReportsApi.GetAssetTotalBalanceAsync(_asOfDate);
        }
        catch (UnauthorizedAccessException)
        {
            _error = "You are not authorized to view this report. Please log in again.";
        }
        catch (Exception ex)
        {
            _error = $"Failed to load report: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }
}
