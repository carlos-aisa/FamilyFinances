@using FamilyFinances.Application.Reporting.Dtos
@using FamilyFinances.Application.Reporting.Semantics
@using FamilyFinances.Web.Api
@using FamilyFinances.Web.Components.Base
@using FamilyFinances.Web.Components.Pages.Reports.Charts
@using FamilyFinances.Web.Features.Reports
@using FamilyFinances.Web.Features.Reports.Export
@using FamilyFinances.Web.Features.Reports.Charts
@using Microsoft.Extensions.Localization
@using FamilyFinances.Web
@using Microsoft.JSInterop
@inherits ApiPageBase

@inject ReportsApi ReportsApi
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResource> L

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-12 col-md-4">
                <label class="form-label fw-semibold">
                    <i class="bi bi-calendar3 me-1"></i>@L["Reports_Year"]
                </label>
                <select class="form-select" aria-label="@L["Reports_Year"]" value="@_selectedYear" @onchange="OnYearChangedAsync" disabled="@_isLoading">
                    @foreach (var year in _yearOptions)
                    {
                        <option value="@year">@year</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label fw-semibold">
                    <i class="bi bi-calendar-month me-1"></i>@L["Reports_FocusedMonth"]
                </label>
                <select class="form-select asset-focused-month-select"
                        aria-label="@L["Reports_FocusedMonth"]"
                        data-testid="economic-state-asset-focused-month"
                        value="@_focusedMonth"
                        @onchange="OnFocusedMonthChangedAsync"
                        disabled="@(_isLoading || _isMonthlyChartLoading || _focusedMonthOptions.Count == 0)">
                    @foreach (var month in _focusedMonthOptions)
                    {
                        <option value="@month">@DateHelper.GetMonthName(month)</option>
                    }
                </select>
            </div>
        </div>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-2"></i>@_error
        <button type="button" class="btn-close" @onclick="@(() => _error = null)"></button>
    </div>
}

@if (_isLoading)
{
    <ReportingChartLoadingState
        Title="@L["AssetEvolution_LoadingTitle"]"
        Description="@L["Reports_LoadingData"]" />
}
else if (_report is not null && _report.Series.Count == 0)
{
    <ReportingChartEmptyState
        Title="@L["EconomicState_Tab_AssetEvolution"]"
        Description="@L["Reports_NoEvolutionDataForYear"]" />
}
else if (_report is not null)
{
    var (latestEndBalance, latestDeltaPrev, latestDeltaYearStart) = GetLatestSummary();
    var charts = BuildChartsViewModel();
    var dataUntilMonth = GetDataUntilMonthForSelectedYear();
    var series = _report.Series.First();
    var monthlyChartSeries = BuildMonthlyChartSeries();
    var focusedMonthLabel = DateHelper.GetMonthName(_focusedMonth);

    <div class="row g-3 mb-4">
        <div class="col-12 col-md-4">
            <div class="card shadow-sm h-100 border-start border-primary border-4">
                <div class="card-body">
                    <h6 class="text-muted text-uppercase mb-2" style="font-size: 0.75rem;">@L["Reports_LatestMetric", ReportingMetricLocalizer.GetLabel(L, _assetBalanceMetric)]</h6>
                    <h4 class="mb-0 @MoneyFormatter.GetColorClass(latestEndBalance)">
                        @MoneyFormatter.FormatCentsWithSign(latestEndBalance)
                    </h4>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted text-uppercase mb-2" style="font-size: 0.75rem;">@L["Reports_LatestMetric", $"{ReportingMetricLocalizer.GetLabel(L, _assetBalanceMetric)} {ReportingMetricLocalizer.GetLabel(L, _deltaPrevMetric)}"]</h6>
                    <h4 class="mb-0 @MoneyFormatter.GetColorClass(latestDeltaPrev)">
                        @MoneyFormatter.FormatCentsWithSign(latestDeltaPrev)
                    </h4>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted text-uppercase mb-2" style="font-size: 0.75rem;">@L["Reports_LatestMetric", $"{ReportingMetricLocalizer.GetLabel(L, _assetBalanceMetric)} {ReportingMetricLocalizer.GetLabel(L, _deltaYearStartMetric)}"]</h6>
                    <h4 class="mb-0 @MoneyFormatter.GetColorClass(latestDeltaYearStart)">
                        @MoneyFormatter.FormatCentsWithSign(latestDeltaYearStart)
                    </h4>
                </div>
            </div>
        </div>
    </div>

    <div class="alert alert-info mb-4" role="alert">
        <i class="bi bi-info-circle me-2"></i>
        @L["AssetEvolution_StockMetricsHint"]
    </div>

    <div class="row g-3 mb-4 asset-total-overview-grid economic-state-two-col-grid">
        <div class="col-12 col-xl-7 economic-state-overview-col">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-transparent">
                    <div class="d-flex justify-content-between align-items-center gap-3">
                        <h5 class="mb-0">
                            <i class="bi bi-list-ul me-2"></i>@L["AssetEvolution_MonthlyOverview"]
                        </h5>
                        <div class="d-flex align-items-center gap-2">
                            <button type="button"
                                    class="btn btn-sm btn-outline-secondary report-export-button"
                                    @onclick="ExportMonthlyOverviewCsvAsync"
                                    data-testid="economic-state-asset-overview-export-csv"
                                    aria-label="@L["Reports_AriaExportCsv"]">
                                <i class="bi bi-download me-1"></i>@L["Reports_Export"]
                            </button>
                            @if (dataUntilMonth is not null)
                            {
                                <span class="badge text-bg-secondary">
                                    @L["Reports_CurrentMonth", DateHelper.GetMonthName(dataUntilMonth.Value)]
                                </span>
                            }
                        </div>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="border-0 ps-3">@L["Reports_Month"]</th>
                                    <th class="border-0 text-end">@L["Reports_EndBalance"]</th>
                                    <th class="border-0 text-end">@L["Reports_DeltaPrevMonth"]</th>
                                    <th class="border-0 text-end pe-3">@L["Reports_DeltaYearStart"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var point in series.Points.OrderBy(p => p.Month))
                                {
                                    var hasData = dataUntilMonth is null || point.Month <= dataUntilMonth.Value;
                                    var isCurrentMonth = dataUntilMonth is not null && point.Month == dataUntilMonth.Value;

                                    <tr class="series-summary-row @(isCurrentMonth ? "table-active" : string.Empty)">
                                        <td class="ps-3">
                                            @DateHelper.GetMonthName(point.Month)
                                            @if (isCurrentMonth)
                                            {
                                                <span class="badge rounded-pill text-bg-primary ms-2">@L["Reports_Current"]</span>
                                            }
                                        </td>
                                        <td class="text-end @MoneyFormatter.GetColorClass(point.EndBalanceCents)">
                                            @(hasData ? MoneyFormatter.FormatCentsWithSign(point.EndBalanceCents) : "-")
                                        </td>
                                        <td class="text-end @MoneyFormatter.GetColorClass(point.DeltaVsPreviousMonthCents)">
                                            @(hasData ? MoneyFormatter.FormatCentsWithSign(point.DeltaVsPreviousMonthCents) : "-")
                                        </td>
                                        <td class="text-end pe-3 @MoneyFormatter.GetColorClass(point.DeltaVsYearStartCents)">
                                            @(hasData ? MoneyFormatter.FormatCentsWithSign(point.DeltaVsYearStartCents) : "-")
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-xl-5 economic-state-stacked-col">
            <div class="economic-state-stacked-charts">
                <div class="asset-total-chart-panel economic-state-chart-item">
                    @if (_isMonthlyChartLoading)
                    {
                        <ReportingChartLoadingState
                            Title="@L["AssetEvolution_LoadingMonthFocusedAsset"]"
                            Description="@L["Reports_LoadingDailyPoints"]" />
                    }
                    else if (!string.IsNullOrWhiteSpace(_monthlyChartError))
                    {
                        <ReportingChartErrorState Message="@_monthlyChartError" />
                    }
                    else if (_monthlyBalanceChart is null || _monthlyBalanceChart.Points.Count == 0 || monthlyChartSeries.Count == 0)
                    {
                        <ReportingChartEmptyState
                            Title="@L["AssetEvolution_MonthFocusedTitle"]"
                            Description="@L["Reports_NoDailyPointsForMonth"]" />
                    }
                    else
                    {
                        <MonthlyLineChart
                            Title="@L["AssetEvolution_MonthFocusedTitle"]"
                            Subtitle="@L["AssetEvolution_MonthFocusedSubtitle", focusedMonthLabel, _selectedYear]"
                            Year="@_selectedYear"
                            Month="@_focusedMonth"
                            YTickMaxTicks="5"
                            Series="@monthlyChartSeries"
                            TestId="economic-state-asset-monthly-chart" />
                    }
                </div>
                <div class="asset-total-chart-panel economic-state-chart-item">
                    @if (!string.IsNullOrWhiteSpace(charts.Error))
                    {
                        <ReportingChartErrorState Message="@charts.Error" />
                    }
                    else if (charts.AssetEndBalanceEvolution.Count == 0)
                    {
                        <ReportingChartEmptyState
                            Title="@L["AssetEvolution_AnnualTitle"]"
                            Description="@L["Reports_NoChartPointsForFilters"]" />
                    }
                    else
                    {
                        <AnnualLineChart
                            Title="@L["AssetEvolution_AnnualTitle"]"
                            Subtitle="@L["AssetEvolution_AnnualSubtitle"]"
                            Year="@_selectedYear"
                            Series="@charts.AssetEndBalanceEvolution"
                            DataUntilMonth="@dataUntilMonth"
                            YTickMaxTicks="5"
                            TestId="economic-state-asset-evolution-chart" />
                    }
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-body text-center py-5">
            <i class="bi bi-graph-up display-4 text-muted mb-3"></i>
            <h5 class="text-muted">@L["AssetEvolution_SelectYearHint"]</h5>
        </div>
    </div>
}

@code {
    private MonthlyEvolutionReportDto? _report;
    private MonthlyBalanceChartDto? _monthlyBalanceChart;
    private string? _error;
    private string? _monthlyChartError;
    private bool _isLoading;
    private bool _isMonthlyChartLoading;
    private int _selectedYear = DateHelper.GetCurrentYear();
    private IReadOnlyList<int> _yearOptions = Array.Empty<int>();
    private IReadOnlyList<int> _focusedMonthOptions = Array.Empty<int>();
    private int _focusedMonth = DateHelper.GetCurrentMonth();

    private static readonly ReportingMetricDefinition _assetBalanceMetric =
        ReportingMetricSemantics.ResolveMetric("monthly-evolution-latest-asset-end-balance");
    private static readonly ReportingMetricDefinition _deltaPrevMetric =
        ReportingMetricSemantics.ResolveMetric("monthly-evolution-latest-asset-delta-prev-month");
    private static readonly ReportingMetricDefinition _deltaYearStartMetric =
        ReportingMetricSemantics.ResolveMetric("monthly-evolution-latest-asset-delta-year-start");

    protected override async Task OnInitializedAsync()
    {
        _yearOptions = Enumerable
            .Range(2000, DateHelper.GetCurrentYear() - 2000 + 1)
            .OrderByDescending(x => x)
            .ToList();

        await LoadReportAsync();
    }

    private async Task OnYearChangedAsync(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var year))
            return;

        _selectedYear = year;
        await LoadReportAsync();
    }

    private async Task OnFocusedMonthChangedAsync(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var month))
            return;

        _focusedMonth = month;
        await LoadMonthlyChartAsync();
    }

    private async Task LoadReportAsync()
    {
        _isLoading = true;
        _error = null;
        _monthlyChartError = null;
        _report = null;
        _monthlyBalanceChart = null;
        StateHasChanged();

        try
        {
            _report = await ReportsApi.GetStateEvolutionAsync(_selectedYear, MonthlyEvolutionScope.AssetTotal);
            SyncFocusedMonth();
            await LoadMonthlyChartAsync();
        }
        catch (UnauthorizedAccessException)
        {
            _error = L["Reports_Error_Unauthorized"];
        }
        catch (Exception ex)
        {
            _error = L["Reports_Error_LoadFailed", ex.Message];
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadMonthlyChartAsync()
    {
        _isMonthlyChartLoading = true;
        _monthlyChartError = null;
        _monthlyBalanceChart = null;
        StateHasChanged();

        try
        {
            _monthlyBalanceChart = await ReportsApi.GetMonthlyChartBalanceAsync(_selectedYear, _focusedMonth);
        }
        catch (UnauthorizedAccessException)
        {
            _monthlyChartError = L["Reports_Error_Unauthorized"];
        }
        catch (Exception ex)
        {
            _monthlyChartError = L["Reports_Error_LoadMonthFocusedChart", ex.Message];
        }
        finally
        {
            _isMonthlyChartLoading = false;
        }
    }

    private int? GetDataUntilMonthForSelectedYear()
    {
        return _selectedYear == DateHelper.GetCurrentYear()
            ? DateHelper.GetCurrentMonth()
            : null;
    }

    private void SyncFocusedMonth()
    {
        var maxMonth = GetDataUntilMonthForSelectedYear() ?? 12;
        _focusedMonthOptions = Enumerable.Range(1, maxMonth).ToList();

        if (_focusedMonthOptions.Count == 0)
        {
            _focusedMonth = 1;
            return;
        }

        var preferred = GetReferenceMonthForSelectedYear() ?? _focusedMonthOptions.Max();
        if (!_focusedMonthOptions.Contains(_focusedMonth))
            _focusedMonth = _focusedMonthOptions.Contains(preferred)
                ? preferred
                : _focusedMonthOptions.Max();
    }

    private int? GetReferenceMonthForSelectedYear()
    {
        if (_report is null || _report.Series.Count == 0)
            return null;

        var months = _report.Series
            .SelectMany(s => s.Points.Select(p => p.Month))
            .Distinct()
            .OrderBy(m => m)
            .ToList();

        if (months.Count == 0)
            return null;

        var dataUntilMonth = GetDataUntilMonthForSelectedYear();
        var visibleMonths = dataUntilMonth is null
            ? months
            : months.Where(m => m <= dataUntilMonth.Value).ToList();

        if (visibleMonths.Count == 0)
            return null;

        var preferredMonth = _selectedYear == DateHelper.GetCurrentYear()
            ? DateHelper.GetCurrentMonth()
            : visibleMonths.Max();

        if (visibleMonths.Contains(preferredMonth))
            return preferredMonth;

        return visibleMonths
            .Where(m => m <= preferredMonth)
            .DefaultIfEmpty(visibleMonths.Max())
            .Max();
    }

    private static MonthlyEvolutionPointDto? GetPointAtOrBeforeMonth(MonthlyEvolutionSeriesDto series, int month)
    {
        return series.Points
            .Where(p => p.Month <= month)
            .OrderByDescending(p => p.Month)
            .FirstOrDefault();
    }

    private (long EndBalance, long DeltaPrev, long DeltaYearStart) GetLatestSummary()
    {
        if (_report is null || _report.Series.Count == 0)
            return (0L, 0L, 0L);

        var referenceMonth = GetReferenceMonthForSelectedYear();
        var latestPoints = _report.Series
            .Select(s => referenceMonth is not null
                ? GetPointAtOrBeforeMonth(s, referenceMonth.Value)
                : s.Points.OrderByDescending(p => p.Month).FirstOrDefault())
            .Where(p => p is not null)
            .Select(p => p!)
            .ToList();

        if (latestPoints.Count == 0)
            return (0L, 0L, 0L);

        return (
            EndBalance: latestPoints.Sum(p => p.EndBalanceCents),
            DeltaPrev: latestPoints.Sum(p => p.DeltaVsPreviousMonthCents),
            DeltaYearStart: latestPoints.Sum(p => p.DeltaVsYearStartCents)
        );
    }

    private ChartsViewModel BuildChartsViewModel()
    {
        if (_report is null || _report.Series.Count == 0)
            return ChartsViewModel.Empty;

        try
        {
            var assetEndBalanceEvolution = AnnualChartDatasetAdapter.BuildEndBalanceSeries(_report, key: "end-balance", label: L["Reports_EndBalance"]);
            return new ChartsViewModel(assetEndBalanceEvolution, null);
        }
        catch (Exception ex)
        {
            return new ChartsViewModel(Array.Empty<AnnualChartSeries>(), L["Reports_Error_BuildChartDataset", ex.Message]);
        }
    }

    private IReadOnlyList<MonthlyChartSeries> BuildMonthlyChartSeries()
    {
        if (_monthlyBalanceChart is null)
            return Array.Empty<MonthlyChartSeries>();

        return MonthlyChartDatasetAdapter.BuildSingleSeries(
            _monthlyBalanceChart,
            key: "asset-total-monthly",
            label: L["Reports_EndBalance"]);
    }

    private async Task ExportMonthlyOverviewCsvAsync()
    {
        if (_report is null || _report.Series.Count == 0)
            return;

        var dataUntilMonth = GetDataUntilMonthForSelectedYear();
        var rows = _report.Series.First().Points
            .OrderBy(point => point.Month)
            .Select(point =>
            {
                var hasData = dataUntilMonth is null || point.Month <= dataUntilMonth.Value;
                return (IReadOnlyList<string?>)
                [
                    DateHelper.GetMonthName(point.Month),
                    hasData ? MoneyFormatter.FormatCentsWithSign(point.EndBalanceCents) : "-",
                    hasData ? MoneyFormatter.FormatCentsWithSign(point.DeltaVsPreviousMonthCents) : "-",
                    hasData ? MoneyFormatter.FormatCentsWithSign(point.DeltaVsYearStartCents) : "-"
                ];
            })
            .ToList();

        var csv = ReportCsvBuilder.Build(
            reportName: L["AssetEvolution_AnnualTitle"],
            context: new Dictionary<string, string?>
            {
                [L["Reports_Year"]] = _selectedYear.ToString(),
                [L["Reports_FocusedMonth"]] = DateHelper.GetMonthName(_focusedMonth)
            },
            headers: [L["Reports_Month"], L["Reports_EndBalance"], L["Reports_DeltaPrevMonth"], L["Reports_DeltaYearStart"]],
            rows: rows);

        try
        {
            var fileName = $"{ReportExportInterop.BuildFileName("asset-total-evolution", _selectedYear)}.csv";
            await JS.DownloadCsvAsync(fileName, csv);
        }
        catch (Exception ex)
        {
            _error = L["Reports_Error_ExportCsvFailed", ex.Message];
        }
    }

    private sealed record ChartsViewModel(
        IReadOnlyList<AnnualChartSeries> AssetEndBalanceEvolution,
        string? Error)
    {
        public static ChartsViewModel Empty => new(
            AssetEndBalanceEvolution: Array.Empty<AnnualChartSeries>(),
            Error: null);
    }
}
