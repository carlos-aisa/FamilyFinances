@page "/reports/economic-state"
@rendermode InteractiveServer
@using FamilyFinances.Application.Reporting.Dtos
@using FamilyFinances.Application.Reporting.Semantics
@using FamilyFinances.Domain.Ledger.Accounts
@using FamilyFinances.Web.Api
@using FamilyFinances.Web.Components.Base
@using FamilyFinances.Web.Components.Pages.Reports.Charts
@using FamilyFinances.Web.Features.Reports
@using FamilyFinances.Web.Features.Reports.Charts
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Localization
@using FamilyFinances.Web
@inherits ApiPageBase

@inject ReportsApi ReportsApi
@inject IStringLocalizer<SharedResource> L

<AuthorizeView>
    <Authorized>
        <div class="d-flex align-items-center justify-content-between mb-4 ff-page-header">
            <div>
                <h3 class="mb-1 ff-page-title">
                    <i class="bi bi-piggy-bank me-2"></i>@L["EconomicState_Title"]
                </h3>
                <p class="text-muted mb-0 ff-page-subtitle">@L["EconomicState_Subtitle"]</p>
            </div>
            <a class="btn btn-outline-secondary" href="/reports">
                <i class="bi bi-arrow-left me-1"></i>@L["Reports_BackToReports"]
            </a>
        </div>

        <div class="card shadow-sm mb-4 ff-panel ff-report-filter-panel" data-testid="economic-state-global-filters">
            <div class="card-body">
                <div class="row g-3 align-items-end">
                    <div class="col-12 col-md-4">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-calendar3 me-1"></i>@L["Reports_Year"]
                        </label>
                        <select class="form-select"
                                data-testid="economic-state-global-year"
                                value="@_filterYear"
                                @onchange="OnGlobalYearChangedAsync"
                                disabled="@_isLoading">
                            @foreach (var year in _yearOptions)
                            {
                                <option value="@year">@year</option>
                            }
                        </select>
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-calendar-month me-1"></i>@L["Reports_FocusedMonth"]
                        </label>
                        <select class="form-select"
                                data-testid="economic-state-global-focused-month"
                                value="@_filterFocusedMonth"
                                @onchange="OnGlobalFocusedMonthChangedAsync"
                                disabled="@(_isLoading || _focusedMonthOptions.Count == 0)">
                            @foreach (var month in _focusedMonthOptions)
                            {
                                <option value="@month">@DateHelper.GetMonthName(month)</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <ul class="nav nav-tabs mb-4 ff-premium-tabs">
            <li class="nav-item">
                <button type="button"
                        class="nav-link @GetTabClass(EconomicStateTab.Snapshot)"
                        @onclick="() => SetActiveTab(EconomicStateTab.Snapshot)"
                        disabled="@_isLoading">
                    @L["EconomicState_Tab_Snapshot"]
                </button>
            </li>
            <li class="nav-item">
                <button type="button"
                        class="nav-link @GetTabClass(EconomicStateTab.AssetEvolution)"
                        @onclick="() => SetActiveTab(EconomicStateTab.AssetEvolution)"
                        disabled="@_isLoading">
                    @L["EconomicState_Tab_AssetEvolution"]
                </button>
            </li>
            <li class="nav-item">
                <button type="button"
                        class="nav-link @GetTabClass(EconomicStateTab.IncomeEvolution)"
                        @onclick="() => SetActiveTab(EconomicStateTab.IncomeEvolution)"
                        disabled="@_isLoading">
                    @L["EconomicState_Tab_IncomeEvolution"]
                </button>
            </li>
            <li class="nav-item">
                <button type="button"
                        class="nav-link @GetTabClass(EconomicStateTab.ExpenseEvolution)"
                        @onclick="() => SetActiveTab(EconomicStateTab.ExpenseEvolution)"
                        disabled="@_isLoading">
                    @L["EconomicState_Tab_ExpenseEvolution"]
                </button>
            </li>
        </ul>

        @if (_activeTab == EconomicStateTab.Snapshot)
        {
            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle me-2"></i>@_error
                    <button type="button" class="btn-close" @onclick="@(() => _error = null)"></button>
                </div>
            }

            @if (_isLoading)
            {
                <div class="card shadow-sm">
                    <div class="card-body text-center py-5">
                        <div class="spinner-border text-primary mb-3" role="status" style="width: 3rem; height: 3rem;">
                            <span class="visually-hidden">@L["Common_Loading"]</span>
                        </div>
                        <p class="text-muted mb-0">@L["Reports_LoadingData"]</p>
                    </div>
                </div>
            }
            else if (_report is not null)
            {
                var flowFrom = new DateOnly(_report.AsOf.Year, _report.AsOf.Month, 1);
                var flowTo = _report.AsOf;

                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-3 gap-2">
                    <div class="badge bg-primary bg-opacity-10 text-primary px-3 py-2">
                        <i class="bi bi-clock-history me-1"></i>@L["EconomicState_StockSnapshotAsOf", _report.AsOf.ToString("yyyy-MM-dd")]
                    </div>
                    <div class="badge bg-success bg-opacity-10 text-success px-3 py-2">
                        <i class="bi bi-calendar-range me-1"></i>@L["EconomicState_FlowPeriod", flowFrom.ToString("yyyy-MM-dd"), flowTo.ToString("yyyy-MM-dd")]
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-12 col-md-6 col-xl-4">
                        <div class="card shadow-sm border-start border-primary border-4 h-100 ff-kpi-card ff-panel">
                            <div class="card-body">
                                <h6 class="text-muted text-uppercase mb-2 ff-kpi-label">@ReportingMetricLocalizer.GetLabel(L, _assetMetric)</h6>
                                <h4 class="mb-0 @MoneyFormatter.GetColorClass(_report.AssetsTotalCents)">
                                    @MoneyFormatter.FormatCentsWithSign(_report.AssetsTotalCents)
                                </h4>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6 col-xl-4">
                        <div class="card shadow-sm border-start border-warning border-4 h-100 ff-kpi-card ff-panel">
                            <div class="card-body">
                                <h6 class="text-muted text-uppercase mb-2 ff-kpi-label">@ReportingMetricLocalizer.GetLabel(L, _liabilityMetric)</h6>
                                <h4 class="mb-0 text-danger">
                                    @MoneyFormatter.FormatCents(_report.LiabilitiesTotalCents)
                                </h4>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6 col-xl-4">
                        <div class="card shadow-sm border-start border-info border-4 h-100 ff-kpi-card ff-panel">
                            <div class="card-body">
                                <h6 class="text-muted text-uppercase mb-2 ff-kpi-label">@ReportingMetricLocalizer.GetLabel(L, _netWorthMetric)</h6>
                                <h4 class="mb-0 @MoneyFormatter.GetColorClass(_report.NetWorthCents)">
                                    @MoneyFormatter.FormatCentsWithSign(_report.NetWorthCents)
                                </h4>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-12 col-md-6 col-xl-4">
                        <div class="card shadow-sm border-start border-success border-4 h-100 ff-kpi-card ff-panel">
                            <div class="card-body">
                                <h6 class="text-muted text-uppercase mb-2 ff-kpi-label">@ReportingMetricLocalizer.GetLabel(L, _incomeMetric)</h6>
                                <h4 class="mb-0 text-success">
                                    @MoneyFormatter.FormatCentsWithSign(_report.IncomeTotalCents)
                                </h4>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6 col-xl-4">
                        <div class="card shadow-sm border-start border-danger border-4 h-100 ff-kpi-card ff-panel">
                            <div class="card-body">
                                <h6 class="text-muted text-uppercase mb-2 ff-kpi-label">@ReportingMetricLocalizer.GetLabel(L, _expenseMetric)</h6>
                                <h4 class="mb-0 text-danger">
                                    @MoneyFormatter.FormatCentsWithSign(_report.ExpenseTotalCents)
                                </h4>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6 col-xl-4">
                        <div class="card shadow-sm border-start border-secondary border-4 h-100 ff-kpi-card ff-panel">
                            <div class="card-body">
                                <h6 class="text-muted text-uppercase mb-2 ff-kpi-label">@ReportingMetricLocalizer.GetLabel(L, _periodNetMetric)</h6>
                                <h4 class="mb-0 @MoneyFormatter.GetColorClass(_report.PeriodNetResultCents)">
                                    @MoneyFormatter.FormatCentsWithSign(_report.PeriodNetResultCents)
                                </h4>
                            </div>
                        </div>
                    </div>
                </div>

                var snapshotSeries = BuildSnapshotIncomeVsExpenseSeries();
                var snapshotMonthLabel = DateHelper.GetMonthName(_report.AsOf.Month);
                var monthlyNetRows = BuildSnapshotMonthlyNetRows();
                var annualIncomeVsExpenseSeries = BuildSnapshotAnnualIncomeExpenseBarSeries();

                <div class="row g-3 mt-1 period-summary-detail-grid">
                    <div class="col-12 col-xl-4">
                        <div class="card shadow-sm h-100 ff-panel" data-testid="economic-state-monthly-net-list">
                            <div class="card-header bg-transparent ff-panel-header">
                                <h6 class="mb-1">@L["EconomicState_MonthlyNetList_Title"]</h6>
                                <small class="text-muted">@L["EconomicState_MonthlyNetList_Subtitle"]</small>
                            </div>
                            <div class="card-body p-0">
                                @if (monthlyNetRows.Count == 0)
                                {
                                    <div class="p-3 text-muted">@L["Reports_NoDataForPeriod"]</div>
                                }
                                else
                                {
                                    <div class="table-responsive">
                                        <table class="table table-sm table-hover align-middle mb-0 ff-data-table">
                                            <thead class="table-light">
                                                <tr>
                                                    <th class="border-0 ps-3">@L["Reports_Month"]</th>
                                                    <th class="border-0 text-end">@L["Dashboard_Kpi_Income"]</th>
                                                    <th class="border-0 text-end">@L["Dashboard_Kpi_Expense"]</th>
                                                    <th class="border-0 text-end pe-3">@L["EconomicState_MonthlyNetList_Net"]</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var row in monthlyNetRows)
                                                {
                                                    <tr>
                                                        <td class="ps-3">@DateHelper.GetMonthName(row.Month)</td>
                                                        <td class="text-end text-success">@MoneyFormatter.FormatCents(row.IncomeCents)</td>
                                                        <td class="text-end text-danger">@MoneyFormatter.FormatCents(row.ExpenseCents)</td>
                                                        <td class="text-end pe-3 @MoneyFormatter.GetColorClass(row.NetCents)">
                                                            @MoneyFormatter.FormatCentsWithSign(row.NetCents)
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-xl-4 economic-state-snapshot-chart">
                        @if (_isSnapshotChartLoading)
                        {
                            <ReportingChartLoadingState
                                Title="@L["EconomicState_LoadingMonthFocusedChart"]"
                                Description="@L["Reports_LoadingDailyPoints"]" />
                        }
                        else if (!string.IsNullOrWhiteSpace(_snapshotChartError))
                        {
                            <ReportingChartErrorState Message="@_snapshotChartError" />
                        }
                        else if (snapshotSeries.Count == 0)
                        {
                            <ReportingChartEmptyState
                                Title="@L["EconomicState_MonthFocusedChartTitle"]"
                                Description="@L["EconomicState_NoDailyPoints"]" />
                        }
                        else
                        {
                            <MonthlyLineChart
                                Title="@L["EconomicState_MonthFocusedChartTitle"]"
                                Subtitle="@L["EconomicState_MonthFocusedSubtitle", snapshotMonthLabel, _report.AsOf.Year, _report.AsOf.Day]"
                                Year="@_report.AsOf.Year"
                                Month="@_report.AsOf.Month"
                                YTickMaxTicks="5"
                                ShowFullMonthRange="true"
                                Series="@snapshotSeries"
                                TestId="economic-state-snapshot-income-expense-chart" />
                        }
                    </div>

                    <div class="col-12 col-xl-4">
                        @if (annualIncomeVsExpenseSeries.Count == 0)
                        {
                            <ReportingChartEmptyState
                                Title="@L["EconomicState_AnnualIncomeExpense_Title"]"
                                Description="@L["Reports_NoChartPointsForFilters"]" />
                        }
                        else
                        {
                            <AnnualBarChart
                                Title="@L["EconomicState_AnnualIncomeExpense_Title"]"
                                Subtitle="@L["EconomicState_AnnualIncomeExpense_Subtitle"]"
                                Year="@_report.AsOf.Year"
                                Series="@annualIncomeVsExpenseSeries"
                                DataUntilMonth="@_report.AsOf.Month"
                                YTickMaxTicks="5"
                                TestId="economic-state-annual-income-expense-bars" />
                        }
                    </div>
                </div>
            }
        }
        else if (_activeTab == EconomicStateTab.AssetEvolution)
        {
            <AssetTotalEvolutionPanel
                UseExternalFilters="true"
                SelectedYear="@_appliedYear"
                FocusedMonth="@_appliedFocusedMonth" />
        }
        else if (_activeTab == EconomicStateTab.IncomeEvolution)
        {
            <IncomeEvolutionPanel
                UseExternalFilters="true"
                SelectedYear="@_appliedYear"
                FocusedMonth="@_appliedFocusedMonth" />
        }
        else
        {
            <ExpenseEvolutionPanel
                UseExternalFilters="true"
                SelectedYear="@_appliedYear"
                FocusedMonth="@_appliedFocusedMonth" />
        }
    </Authorized>
    <NotAuthorized>
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle me-2"></i>
            @L["Reports_LoginRequired"]
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private EconomicStateDto? _report;
    private MonthlyBalanceChartDto? _snapshotIncomeMonthlyChart;
    private MonthlyBalanceChartDto? _snapshotExpenseMonthlyChart;
    private MonthlyEvolutionReportDto? _snapshotIncomeEvolution;
    private MonthlyEvolutionReportDto? _snapshotExpenseEvolution;
    private string? _error;
    private string? _snapshotChartError;
    private bool _isLoading;
    private bool _isSnapshotChartLoading;
    private int _filterYear = DateHelper.GetCurrentYear();
    private int _filterFocusedMonth = DateHelper.GetCurrentMonth();
    private int _appliedYear = DateHelper.GetCurrentYear();
    private int _appliedFocusedMonth = DateHelper.GetCurrentMonth();
    private IReadOnlyList<int> _yearOptions = Array.Empty<int>();
    private IReadOnlyList<int> _focusedMonthOptions = Array.Empty<int>();
    private EconomicStateTab _activeTab = EconomicStateTab.Snapshot;

    private static readonly ReportingMetricDefinition _assetMetric = ReportingMetricSemantics.Get(ReportingMetricKey.AssetBalance);
    private static readonly ReportingMetricDefinition _liabilityMetric = ReportingMetricSemantics.Get(ReportingMetricKey.LiabilityBalance);
    private static readonly ReportingMetricDefinition _netWorthMetric = ReportingMetricSemantics.Get(ReportingMetricKey.NetWorth);
    private static readonly ReportingMetricDefinition _incomeMetric = ReportingMetricSemantics.Get(ReportingMetricKey.Income);
    private static readonly ReportingMetricDefinition _expenseMetric = ReportingMetricSemantics.Get(ReportingMetricKey.Expense);
    private static readonly ReportingMetricDefinition _periodNetMetric = ReportingMetricSemantics.Get(ReportingMetricKey.PeriodNetResult);

    protected override async Task OnInitializedAsync()
    {
        _yearOptions = Enumerable
            .Range(2000, DateHelper.GetCurrentYear() - 2000 + 1)
            .OrderByDescending(x => x)
            .ToList();
        SyncGlobalFocusedMonthOptions();
        await LoadReportAsync();
    }

    private void SetActiveTab(EconomicStateTab tab)
    {
        _activeTab = tab;
    }

    private string GetTabClass(EconomicStateTab tab)
    {
        return _activeTab == tab ? "active" : string.Empty;
    }

    private async Task OnGlobalYearChangedAsync(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var year))
            return;

        if (year == _filterYear)
            return;

        _filterYear = year;
        SyncGlobalFocusedMonthOptions();
        await LoadReportAsync();
    }

    private async Task OnGlobalFocusedMonthChangedAsync(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var month))
            return;

        if (month == _filterFocusedMonth)
            return;

        _filterFocusedMonth = month;
        await LoadReportAsync();
    }

    private void SyncGlobalFocusedMonthOptions()
    {
        var maxMonth = _filterYear == DateHelper.GetCurrentYear()
            ? DateHelper.GetCurrentMonth()
            : 12;

        _focusedMonthOptions = Enumerable.Range(1, maxMonth).ToList();
        if (_focusedMonthOptions.Count == 0)
        {
            _filterFocusedMonth = 1;
            return;
        }

        if (!_focusedMonthOptions.Contains(_filterFocusedMonth))
            _filterFocusedMonth = _focusedMonthOptions.Max();
    }

    private DateOnly ResolveAppliedAsOfDate()
    {
        if (_appliedYear == DateHelper.GetCurrentYear() && _appliedFocusedMonth == DateHelper.GetCurrentMonth())
            return DateOnly.FromDateTime(DateTime.Today);

        var day = DateTime.DaysInMonth(_appliedYear, _appliedFocusedMonth);
        return new DateOnly(_appliedYear, _appliedFocusedMonth, day);
    }

    private async Task LoadReportAsync()
    {
        _isLoading = true;
        _error = null;
        _snapshotChartError = null;
        _report = null;
        _snapshotIncomeMonthlyChart = null;
        _snapshotExpenseMonthlyChart = null;
        _snapshotIncomeEvolution = null;
        _snapshotExpenseEvolution = null;
        StateHasChanged();

        try
        {
            _appliedYear = _filterYear;
            _appliedFocusedMonth = _filterFocusedMonth;
            var asOf = ResolveAppliedAsOfDate();
            _report = await ReportsApi.GetEconomicStateAsync(asOf);
            await LoadSnapshotMonthlyComparisonChartAsync();
        }
        catch (UnauthorizedAccessException)
        {
            _error = L["Reports_Error_Unauthorized"];
        }
        catch (Exception ex)
        {
            _error = L["Reports_Error_LoadFailed", ex.Message];
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadSnapshotMonthlyComparisonChartAsync()
    {
        if (_report is null)
            return;

        _isSnapshotChartLoading = true;
        _snapshotChartError = null;
        _snapshotIncomeMonthlyChart = null;
        _snapshotExpenseMonthlyChart = null;
        _snapshotIncomeEvolution = null;
        _snapshotExpenseEvolution = null;
        StateHasChanged();

        try
        {
            _snapshotIncomeMonthlyChart = await ReportsApi.GetMonthlyChartBalanceAsync(
                _report.AsOf.Year,
                _report.AsOf.Month,
                nature: AccountNature.Income);

            _snapshotExpenseMonthlyChart = await ReportsApi.GetMonthlyChartBalanceAsync(
                _report.AsOf.Year,
                _report.AsOf.Month,
                nature: AccountNature.Expense);

            _snapshotIncomeEvolution = await ReportsApi.GetStateEvolutionAsync(
                _report.AsOf.Year,
                MonthlyEvolutionScope.IncomeTotal);

            _snapshotExpenseEvolution = await ReportsApi.GetStateEvolutionAsync(
                _report.AsOf.Year,
                MonthlyEvolutionScope.ExpenseTotal);

        }
        catch (UnauthorizedAccessException)
        {
            _snapshotChartError = L["Reports_Error_Unauthorized"];
        }
        catch (Exception ex)
        {
            _snapshotChartError = L["Reports_Error_LoadMonthFocusedChart", ex.Message];
        }
        finally
        {
            _isSnapshotChartLoading = false;
        }
    }

    private IReadOnlyList<MonthlyChartSeries> BuildSnapshotIncomeVsExpenseSeries()
    {
        if (_report is null || _snapshotIncomeMonthlyChart is null || _snapshotExpenseMonthlyChart is null)
            return Array.Empty<MonthlyChartSeries>();

        var dayLimit = _report.AsOf.Day;
        var series = new List<MonthlyChartSeries>(2);

        var incomeSeries = BuildSnapshotSeries(
            _snapshotIncomeMonthlyChart,
            "snapshot-income",
            L["Dashboard_Nature_Income"],
            "#198754",
            dayLimit,
            absoluteValues: true);
        if (incomeSeries is not null)
            series.Add(incomeSeries);

        var expenseSeries = BuildSnapshotSeries(
            _snapshotExpenseMonthlyChart,
            "snapshot-expense",
            L["Dashboard_Nature_Expense"],
            "#dc3545",
            dayLimit);
        if (expenseSeries is not null)
            series.Add(expenseSeries);

        return series;
    }

    private static MonthlyChartSeries? BuildSnapshotSeries(
        MonthlyBalanceChartDto chart,
        string key,
        string label,
        string colorHex,
        int dayLimit,
        bool absoluteValues = true)
    {
        var points = chart.Points
            .Where(point => point.Day <= dayLimit)
            .OrderBy(point => point.Day)
            .Select(point => new MonthlyChartPoint(
                point.Day,
                absoluteValues ? Math.Abs(point.EndBalanceCents) : point.EndBalanceCents))
            .ToList();

        return points.Count == 0
            ? null
            : new MonthlyChartSeries(key, label, colorHex, points);
    }

    private IReadOnlyList<SnapshotMonthlyNetRow> BuildSnapshotMonthlyNetRows()
    {
        if (_report is null || _snapshotIncomeEvolution is null || _snapshotExpenseEvolution is null)
            return Array.Empty<SnapshotMonthlyNetRow>();

        var incomeSeries = _snapshotIncomeEvolution.Series.FirstOrDefault();
        var expenseSeries = _snapshotExpenseEvolution.Series.FirstOrDefault();
        if (incomeSeries is null || expenseSeries is null)
            return Array.Empty<SnapshotMonthlyNetRow>();

        var maxMonth = Math.Clamp(_report.AsOf.Month, 1, 12);
        var rows = new List<SnapshotMonthlyNetRow>(maxMonth);
        for (var month = 1; month <= maxMonth; month++)
        {
            var income = incomeSeries.Points.FirstOrDefault(p => p.Month == month)?.DeltaVsPreviousMonthCents ?? 0L;
            var expenseRaw = expenseSeries.Points.FirstOrDefault(p => p.Month == month)?.DeltaVsPreviousMonthCents ?? 0L;
            var expense = Math.Abs(expenseRaw);
            rows.Add(new SnapshotMonthlyNetRow(
                Month: month,
                IncomeCents: income,
                ExpenseCents: expense,
                NetCents: income - expense));
        }

        return rows;
    }

    private IReadOnlyList<AnnualChartSeries> BuildSnapshotAnnualIncomeExpenseBarSeries()
    {
        if (_report is null || _snapshotIncomeEvolution is null || _snapshotExpenseEvolution is null)
            return Array.Empty<AnnualChartSeries>();

        var incomeSeries = _snapshotIncomeEvolution.Series.FirstOrDefault();
        var expenseSeries = _snapshotExpenseEvolution.Series.FirstOrDefault();
        if (incomeSeries is null || expenseSeries is null)
            return Array.Empty<AnnualChartSeries>();

        var points = Enumerable.Range(1, 12).ToList();
        var income = new AnnualChartSeries(
            Key: "income-month-result",
            Label: L["Dashboard_Kpi_Income"],
            ColorHex: "#2dd67d",
            Points: points.Select(month => new AnnualChartPoint(
                month,
                Math.Abs(incomeSeries.Points.FirstOrDefault(point => point.Month == month)?.DeltaVsPreviousMonthCents ?? 0L))).ToList());

        var expense = new AnnualChartSeries(
            Key: "expense-month-result",
            Label: L["Dashboard_Kpi_Expense"],
            ColorHex: "#ff5f75",
            Points: points.Select(month => new AnnualChartPoint(
                month,
                Math.Abs(expenseSeries.Points.FirstOrDefault(point => point.Month == month)?.DeltaVsPreviousMonthCents ?? 0L))).ToList());

        return [income, expense];
    }

    private enum EconomicStateTab
    {
        Snapshot,
        AssetEvolution,
        IncomeEvolution,
        ExpenseEvolution
    }

    private sealed record SnapshotMonthlyNetRow(
        int Month,
        long IncomeCents,
        long ExpenseCents,
        long NetCents
    );
}
