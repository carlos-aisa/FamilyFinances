@page "/reports/economic-state"
@rendermode InteractiveServer
@using FamilyFinances.Application.Reporting.Dtos
@using FamilyFinances.Application.Reporting.Semantics
@using FamilyFinances.Domain.Ledger.Accounts
@using FamilyFinances.Web.Api
@using FamilyFinances.Web.Components.Base
@using FamilyFinances.Web.Components.Pages.Reports.Charts
@using FamilyFinances.Web.Features.Reports
@using FamilyFinances.Web.Features.Reports.Charts
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Localization
@using FamilyFinances.Web
@inherits ApiPageBase

@inject ReportsApi ReportsApi
@inject IStringLocalizer<SharedResource> L

<AuthorizeView>
    <Authorized>
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <h3 class="mb-1">
                    <i class="bi bi-piggy-bank me-2"></i>@L["EconomicState_Title"]
                </h3>
                <p class="text-muted mb-0">@L["EconomicState_Subtitle"]</p>
            </div>
            <a class="btn btn-outline-secondary" href="/reports">
                <i class="bi bi-arrow-left me-1"></i>@L["Reports_BackToReports"]
            </a>
        </div>

        <ul class="nav nav-tabs mb-4">
            <li class="nav-item">
                <button type="button"
                        class="nav-link @GetTabClass(EconomicStateTab.Snapshot)"
                        @onclick="() => SetActiveTab(EconomicStateTab.Snapshot)"
                        disabled="@_isLoading">
                    @L["EconomicState_Tab_Snapshot"]
                </button>
            </li>
            <li class="nav-item">
                <button type="button"
                        class="nav-link @GetTabClass(EconomicStateTab.AssetEvolution)"
                        @onclick="() => SetActiveTab(EconomicStateTab.AssetEvolution)"
                        disabled="@_isLoading">
                    @L["EconomicState_Tab_AssetEvolution"]
                </button>
            </li>
            <li class="nav-item">
                <button type="button"
                        class="nav-link @GetTabClass(EconomicStateTab.IncomeEvolution)"
                        @onclick="() => SetActiveTab(EconomicStateTab.IncomeEvolution)"
                        disabled="@_isLoading">
                    @L["EconomicState_Tab_IncomeEvolution"]
                </button>
            </li>
        </ul>

        @if (_activeTab == EconomicStateTab.Snapshot)
        {
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <div class="row g-3 align-items-end">
                        <div class="col-12 col-md-4">
                                <label class="form-label fw-semibold">
                                <i class="bi bi-calendar3 me-1"></i>@L["EconomicState_AsOfDate"]
                            </label>
                            <input type="date" class="form-control" aria-label="@L["EconomicState_AsOfDate"]" @bind="_asOfDate" />
                        </div>
                        <div class="col-12 col-md-auto">
                            <button class="btn btn-primary" @onclick="LoadReportAsync" disabled="@_isLoading">
                                @if (_isLoading)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                }
                                else
                                {
                                    <i class="bi bi-search me-1"></i>
                                }
                                @L["Reports_LoadReport"]
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle me-2"></i>@_error
                    <button type="button" class="btn-close" @onclick="@(() => _error = null)"></button>
                </div>
            }

            @if (_isLoading)
            {
                <div class="card shadow-sm">
                    <div class="card-body text-center py-5">
                        <div class="spinner-border text-primary mb-3" role="status" style="width: 3rem; height: 3rem;">
                            <span class="visually-hidden">@L["Common_Loading"]</span>
                        </div>
                        <p class="text-muted mb-0">@L["Reports_LoadingData"]</p>
                    </div>
                </div>
            }
            else if (_report is not null)
            {
                var flowFrom = new DateOnly(_report.AsOf.Year, _report.AsOf.Month, 1);
                var flowTo = _report.AsOf;

                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-3 gap-2">
                    <div class="badge bg-primary bg-opacity-10 text-primary px-3 py-2">
                        <i class="bi bi-clock-history me-1"></i>@L["EconomicState_StockSnapshotAsOf", _report.AsOf.ToString("yyyy-MM-dd")]
                    </div>
                    <div class="badge bg-success bg-opacity-10 text-success px-3 py-2">
                        <i class="bi bi-calendar-range me-1"></i>@L["EconomicState_FlowPeriod", flowFrom.ToString("yyyy-MM-dd"), flowTo.ToString("yyyy-MM-dd")]
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-12 col-md-6 col-xl-4">
                        <div class="card shadow-sm border-start border-primary border-4 h-100">
                            <div class="card-body">
                                <h6 class="text-muted text-uppercase mb-2" style="font-size: 0.75rem;">@ReportingMetricLocalizer.GetLabel(L, _assetMetric)</h6>
                                <h4 class="mb-0 @MoneyFormatter.GetColorClass(_report.AssetsTotalCents)">
                                    @MoneyFormatter.FormatCentsWithSign(_report.AssetsTotalCents)
                                </h4>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6 col-xl-4">
                        <div class="card shadow-sm border-start border-warning border-4 h-100">
                            <div class="card-body">
                                <h6 class="text-muted text-uppercase mb-2" style="font-size: 0.75rem;">@ReportingMetricLocalizer.GetLabel(L, _liabilityMetric)</h6>
                                <h4 class="mb-0 text-danger">
                                    @MoneyFormatter.FormatCents(_report.LiabilitiesTotalCents)
                                </h4>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6 col-xl-4">
                        <div class="card shadow-sm border-start border-info border-4 h-100">
                            <div class="card-body">
                                <h6 class="text-muted text-uppercase mb-2" style="font-size: 0.75rem;">@ReportingMetricLocalizer.GetLabel(L, _netWorthMetric)</h6>
                                <h4 class="mb-0 @MoneyFormatter.GetColorClass(_report.NetWorthCents)">
                                    @MoneyFormatter.FormatCentsWithSign(_report.NetWorthCents)
                                </h4>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-12 col-md-6 col-xl-4">
                        <div class="card shadow-sm border-start border-success border-4 h-100">
                            <div class="card-body">
                                <h6 class="text-muted text-uppercase mb-2" style="font-size: 0.75rem;">@ReportingMetricLocalizer.GetLabel(L, _incomeMetric)</h6>
                                <h4 class="mb-0 text-success">
                                    @MoneyFormatter.FormatCentsWithSign(_report.IncomeTotalCents)
                                </h4>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6 col-xl-4">
                        <div class="card shadow-sm border-start border-danger border-4 h-100">
                            <div class="card-body">
                                <h6 class="text-muted text-uppercase mb-2" style="font-size: 0.75rem;">@ReportingMetricLocalizer.GetLabel(L, _expenseMetric)</h6>
                                <h4 class="mb-0 text-danger">
                                    @MoneyFormatter.FormatCentsWithSign(_report.ExpenseTotalCents)
                                </h4>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6 col-xl-4">
                        <div class="card shadow-sm border-start border-secondary border-4 h-100">
                            <div class="card-body">
                                <h6 class="text-muted text-uppercase mb-2" style="font-size: 0.75rem;">@ReportingMetricLocalizer.GetLabel(L, _periodNetMetric)</h6>
                                <h4 class="mb-0 @MoneyFormatter.GetColorClass(_report.PeriodNetResultCents)">
                                    @MoneyFormatter.FormatCentsWithSign(_report.PeriodNetResultCents)
                                </h4>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="alert alert-info mb-0" role="alert">
                    <i class="bi bi-info-circle me-2"></i>
                    <span>
                        <strong>@L["Reports_StockMetrics"]</strong> (@ReportingMetricLocalizer.GetLabel(L, _assetMetric), @ReportingMetricLocalizer.GetLabel(L, _liabilityMetric), @ReportingMetricLocalizer.GetLabel(L, _netWorthMetric))
                        @L["EconomicState_StockMetricsInfo"]
                    </span>
                    <br />
                    <span>
                        <strong>@L["Reports_FlowMetrics"]</strong> (@ReportingMetricLocalizer.GetLabel(L, _incomeMetric), @ReportingMetricLocalizer.GetLabel(L, _expenseMetric), @ReportingMetricLocalizer.GetLabel(L, _periodNetMetric))
                        @L["EconomicState_FlowMetricsInfo"]
                    </span>
                </div>

                var snapshotSeries = BuildSnapshotIncomeVsExpenseSeries();
                var snapshotMonthLabel = DateHelper.GetMonthName(_report.AsOf.Month);

                @if (_isSnapshotChartLoading)
                {
                    <div class="mt-4 economic-state-snapshot-chart">
                        <ReportingChartLoadingState
                            Title="@L["EconomicState_LoadingMonthFocusedChart"]"
                            Description="@L["Reports_LoadingDailyPoints"]" />
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(_snapshotChartError))
                {
                    <div class="mt-4 economic-state-snapshot-chart">
                        <ReportingChartErrorState Message="@_snapshotChartError" />
                    </div>
                }
                else if (snapshotSeries.Count == 0)
                {
                    <div class="mt-4 economic-state-snapshot-chart">
                        <ReportingChartEmptyState
                            Title="@L["EconomicState_MonthFocusedChartTitle"]"
                            Description="@L["EconomicState_NoDailyPoints"]" />
                    </div>
                }
                else
                {
                    <div class="mt-4 economic-state-snapshot-chart">
                        <MonthlyLineChart
                            Title="@L["EconomicState_MonthFocusedChartTitle"]"
                            Subtitle="@L["EconomicState_MonthFocusedSubtitle", snapshotMonthLabel, _report.AsOf.Year, _report.AsOf.Day]"
                            Year="@_report.AsOf.Year"
                            Month="@_report.AsOf.Month"
                            YTickMaxTicks="5"
                            Series="@snapshotSeries"
                            TestId="economic-state-snapshot-income-expense-chart" />
                    </div>
                }
            }
        }
        else if (_activeTab == EconomicStateTab.AssetEvolution)
        {
            <AssetTotalEvolutionPanel />
        }
        else
        {
            <IncomeEvolutionPanel />
        }
    </Authorized>
    <NotAuthorized>
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle me-2"></i>
            @L["Reports_LoginRequired"]
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private EconomicStateDto? _report;
    private MonthlyBalanceChartDto? _snapshotIncomeMonthlyChart;
    private MonthlyBalanceChartDto? _snapshotExpenseMonthlyChart;
    private string? _error;
    private string? _snapshotChartError;
    private bool _isLoading;
    private bool _isSnapshotChartLoading;
    private DateOnly _asOfDate = DateOnly.FromDateTime(DateTime.Today);
    private EconomicStateTab _activeTab = EconomicStateTab.Snapshot;

    private static readonly ReportingMetricDefinition _assetMetric = ReportingMetricSemantics.Get(ReportingMetricKey.AssetBalance);
    private static readonly ReportingMetricDefinition _liabilityMetric = ReportingMetricSemantics.Get(ReportingMetricKey.LiabilityBalance);
    private static readonly ReportingMetricDefinition _netWorthMetric = ReportingMetricSemantics.Get(ReportingMetricKey.NetWorth);
    private static readonly ReportingMetricDefinition _incomeMetric = ReportingMetricSemantics.Get(ReportingMetricKey.Income);
    private static readonly ReportingMetricDefinition _expenseMetric = ReportingMetricSemantics.Get(ReportingMetricKey.Expense);
    private static readonly ReportingMetricDefinition _periodNetMetric = ReportingMetricSemantics.Get(ReportingMetricKey.PeriodNetResult);

    protected override async Task OnInitializedAsync()
    {
        await LoadReportAsync();
    }

    private void SetActiveTab(EconomicStateTab tab)
    {
        _activeTab = tab;
    }

    private string GetTabClass(EconomicStateTab tab)
    {
        return _activeTab == tab ? "active" : string.Empty;
    }

    private async Task LoadReportAsync()
    {
        _isLoading = true;
        _error = null;
        _snapshotChartError = null;
        _report = null;
        _snapshotIncomeMonthlyChart = null;
        _snapshotExpenseMonthlyChart = null;
        StateHasChanged();

        try
        {
            _report = await ReportsApi.GetEconomicStateAsync(_asOfDate);
            await LoadSnapshotMonthlyComparisonChartAsync();
        }
        catch (UnauthorizedAccessException)
        {
            _error = L["Reports_Error_Unauthorized"];
        }
        catch (Exception ex)
        {
            _error = L["Reports_Error_LoadFailed", ex.Message];
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadSnapshotMonthlyComparisonChartAsync()
    {
        if (_report is null)
            return;

        _isSnapshotChartLoading = true;
        _snapshotChartError = null;
        _snapshotIncomeMonthlyChart = null;
        _snapshotExpenseMonthlyChart = null;
        StateHasChanged();

        try
        {
            _snapshotIncomeMonthlyChart = await ReportsApi.GetMonthlyChartBalanceAsync(
                _report.AsOf.Year,
                _report.AsOf.Month,
                nature: AccountNature.Income);

            _snapshotExpenseMonthlyChart = await ReportsApi.GetMonthlyChartBalanceAsync(
                _report.AsOf.Year,
                _report.AsOf.Month,
                nature: AccountNature.Expense);
        }
        catch (UnauthorizedAccessException)
        {
            _snapshotChartError = L["Reports_Error_Unauthorized"];
        }
        catch (Exception ex)
        {
            _snapshotChartError = L["Reports_Error_LoadMonthFocusedChart", ex.Message];
        }
        finally
        {
            _isSnapshotChartLoading = false;
        }
    }

    private IReadOnlyList<MonthlyChartSeries> BuildSnapshotIncomeVsExpenseSeries()
    {
        if (_report is null || _snapshotIncomeMonthlyChart is null || _snapshotExpenseMonthlyChart is null)
            return Array.Empty<MonthlyChartSeries>();

        var dayLimit = _report.AsOf.Day;
        var series = new List<MonthlyChartSeries>(2);

        var incomeSeries = BuildSnapshotSeries(
            _snapshotIncomeMonthlyChart,
            "snapshot-income",
            L["Dashboard_Nature_Income"],
            "#198754",
            dayLimit,
            absoluteValues: true);
        if (incomeSeries is not null)
            series.Add(incomeSeries);

        var expenseSeries = BuildSnapshotSeries(
            _snapshotExpenseMonthlyChart,
            "snapshot-expense",
            L["Dashboard_Nature_Expense"],
            "#dc3545",
            dayLimit);
        if (expenseSeries is not null)
            series.Add(expenseSeries);

        return series;
    }

    private static MonthlyChartSeries? BuildSnapshotSeries(
        MonthlyBalanceChartDto chart,
        string key,
        string label,
        string colorHex,
        int dayLimit,
        bool absoluteValues = true)
    {
        var points = chart.Points
            .Where(point => point.Day <= dayLimit)
            .OrderBy(point => point.Day)
            .Select(point => new MonthlyChartPoint(
                point.Day,
                absoluteValues ? Math.Abs(point.EndBalanceCents) : point.EndBalanceCents))
            .ToList();

        return points.Count == 0
            ? null
            : new MonthlyChartSeries(key, label, colorHex, points);
    }

    private enum EconomicStateTab
    {
        Snapshot,
        AssetEvolution,
        IncomeEvolution
    }
}
