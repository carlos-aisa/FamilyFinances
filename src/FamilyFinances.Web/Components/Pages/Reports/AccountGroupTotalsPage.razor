    private async Task ExportCsvAsync()
    {
        if (_report is null)
            return;

        var rows = _report.Items
            .OrderByDescending(item => Math.Abs(item.TotalCents))
            .Select(item =>
            {
                var percentage = _report.TotalCents != 0
                    ? (Math.Abs(item.TotalCents) / (double)Math.Abs(_report.TotalCents)) * 100d
                    : 0d;

                return (IReadOnlyList<string?>)
                [
                    item.AccountName,
                    MoneyFormatter.FormatCents(item.TotalCents),
                    item.TransactionsCount.ToString(),
                    $"{percentage:F1}%"
                ];
            })
            .ToList();

        rows.Add(
        [
            "Total",
            MoneyFormatter.FormatCents(_report.TotalCents),
            _report.TransactionsCount.ToString(),
            "100.0%"
        ]);

        var csv = ReportCsvBuilder.Build(
            reportName: L["AccountGroupTotals_Title"],
            context: new Dictionary<string, string?>
            {
                [L["AccountGroupTotals_AccountGroup"]] = _report.GroupName,
                [L["Reports_FromDate"]] = _fromDate.ToString("yyyy-MM-dd"),
                [L["Reports_ToDateExclusive"]] = _toDate.ToString("yyyy-MM-dd"),
                [L["Reports_Nature"]] = string.IsNullOrWhiteSpace(_nature)
                    ? "-"
                    : GetNatureLabel(Enum.Parse<AccountNature>(_nature))
            },
            headers: [L["AccountGroupTotals_Table_Account"], L["AccountGroupTotals_Table_Amount"], L["AccountGroupTotals_Table_Transactions"], L["Reports_Share"]],
            rows: rows);

        try
        {
            var fileName = ReportExportInterop.BuildFileName(
                "account-group-totals",
                _report.GroupName,
                _fromDate.ToString("yyyy-MM-dd"),
                _toDate.ToString("yyyy-MM-dd")) + ".csv";
            await JS.DownloadCsvAsync(fileName, csv);
        }
        catch (Exception ex)
        {
            _error = L["Reports_Error_ExportCsvFailed", ex.Message];
        }
    }

