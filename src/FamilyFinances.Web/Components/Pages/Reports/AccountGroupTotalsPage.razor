@page "/reports/account-group-totals"
@inherits ApiPageBase
@rendermode InteractiveServer
@using FamilyFinances.Application.Ledger.AccountGroups.Dtos
@using FamilyFinances.Application.Reporting.Dtos
@using FamilyFinances.Domain.Ledger.Accounts
@using FamilyFinances.Web
@using FamilyFinances.Web.Api
@using FamilyFinances.Web.Components.Base
@using FamilyFinances.Web.Components.Pages.Reports.Charts
@using FamilyFinances.Web.Components.Shared
@using FamilyFinances.Web.Features.Reports
@using FamilyFinances.Web.Features.Reports.Charts
@using FamilyFinances.Web.Features.Reports.Export
@using Microsoft.Extensions.Localization
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components.Authorization
@inject AccountGroupsApi AccountGroupsApi
@inject ReportsApi ReportsApi
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResource> L

<AuthorizeView>
    <Authorized>
        <!-- Header -->
        <div class="d-flex align-items-center justify-content-between mb-4 ff-page-header">
            <div>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-2">
                        <li class="breadcrumb-item"><a href="/reports">@L["ReportsIndex_Title"]</a></li>
                        <li class="breadcrumb-item active" aria-current="page">@L["AccountGroupTotals_Title"]</li>
                    </ol>
                </nav>
                <h3 class="mb-0 ff-page-title">
                    <i class="bi bi-collection me-2 text-warning"></i>@L["AccountGroupTotals_Title"]
                </h3>
            </div>

            <button class="btn btn-outline-secondary" @onclick="GoBack">
                <i class="bi bi-arrow-left me-1"></i>@L["Reports_BackToReports"]
            </button>
        </div>

        <ul class="nav nav-tabs mb-4 ff-premium-tabs">
            <li class="nav-item">
                <button type="button"
                        class="nav-link @GetTabClass(AccountGroupReportTab.PeriodTotals)"
                        @onclick="() => SetActiveTabAsync(AccountGroupReportTab.PeriodTotals)"
                        disabled="@(_isBusy)">
                    @L["AccountGroupTotals_Tab_PeriodTotals"]
                </button>
            </li>
            <li class="nav-item">
                <button type="button"
                        class="nav-link @GetTabClass(AccountGroupReportTab.StateEvolution)"
                        @onclick="() => SetActiveTabAsync(AccountGroupReportTab.StateEvolution)"
                        disabled="@(_isBusy)">
                    @L["AccountGroupTotals_Tab_StateEvolution"]
                </button>
            </li>
        </ul>

        @if (_activeTab == AccountGroupReportTab.PeriodTotals)
        {
        <!-- Filters Card -->
        <div class="card shadow-sm mb-4 ff-panel ff-report-filter-panel">
            <div class="card-header bg-light ff-panel-header">
                    <h5 class="card-title mb-0">
                    <i class="bi bi-funnel me-2"></i>@L["Reports_Filters"]
                </h5>
            </div>
            <div class="card-body">
                <div class="row g-3 align-items-end">
                    <!-- Quick Date Presets -->
                    <div class="col-12">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-calendar-range me-1"></i>@L["Reports_QuickSelect"]
                        </label>
                        <div>
                            <DateRangePresets OnPresetSelected="HandlePresetSelected" ActivePreset="@_activePreset" />
                        </div>
                    </div>

                    <div class="col-12 col-md-3">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-collection me-1"></i>@L["AccountGroupTotals_AccountGroup"]
                        </label>
                        <select class="form-select" aria-label="@L["AccountGroupTotals_AccountGroup"]" @bind="_selectedGroupId">
                            <option value="">@L["AccountGroupTotals_SelectGroupOption"]</option>
                            @if (_groups is not null)
                            {
                                @foreach (var group in _groups)
                                {
                                    <option value="@group.Id">@group.Name</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col-12 col-md-2">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-calendar3 me-1"></i>@L["Reports_FromDate"]
                        </label>
                        <input type="date" class="form-control" aria-label="@L["Reports_FromDate"]" @bind="_fromDate" @bind:event="oninput" @bind:after="OnDateChanged" />
                    </div>

                    <div class="col-12 col-md-2">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-calendar3 me-1"></i>@L["Reports_ToDateExclusive"]
                        </label>
                        <input type="date" class="form-control" aria-label="@L["Reports_ToDateExclusive"]" @bind="_toDate" @bind:event="oninput" @bind:after="OnDateChanged" />
                    </div>

                    <div class="col-12 col-md-2">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-tag me-1"></i>@L["AccountGroupTotals_Nature"]
                        </label>
                        <select class="form-select" aria-label="@L["AccountGroupTotals_Nature"]" @bind="_nature">
                            <option value="">@L["AccountGroupTotals_Nature_All"]</option>
                            <option value="@AccountNature.Expense">@L["Dashboard_Nature_Expense"]</option>
                            <option value="@AccountNature.Income">@L["Dashboard_Nature_Income"]</option>
                        </select>
                    </div>

                    <div class="col-12 col-md-3">
                        <div class="d-grid">
                            <button class="btn btn-primary"
                                    data-testid="account-group-totals-generate-report"
                                    @onclick="LoadReportAsync"
                                    disabled="@(_isBusy || string.IsNullOrEmpty(_selectedGroupId))">
                                @if (_isBusy)
                                {
                                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                }
                                else
                                {
                                    <i class="bi bi-bar-chart me-1"></i>
                                }
                                @L["Reports_GenerateReport"]
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Alerts -->
        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle me-2"></i>@_error
                <button type="button" class="btn-close" @onclick="@(() => _error = null)"></button>
            </div>
        }

        <!-- Report Results -->
        @if (_report is not null)
        {
            <div class="card shadow-sm ff-panel">
                <div class="card-header bg-light ff-panel-header">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="card-title mb-0">
                            <i class="bi bi-collection me-2"></i>@_report.GroupName
                        </h5>
                        <div class="d-flex align-items-center gap-2">
                            <button type="button"
                                    class="btn btn-sm btn-outline-secondary report-export-button"
                                    @onclick="ExportCsvAsync"
                                    data-testid="account-group-totals-export-csv"
                                    aria-label="@L["Reports_AriaExportCsv"]">
                                <i class="bi bi-download me-1"></i>@L["Reports_Export"]
                            </button>
                            <span class="badge bg-secondary">
                                @DateHelper.FormatShortDate(_report.FromInclusive) - @DateHelper.FormatShortDate(_report.ToExclusive.AddDays(-1))
                            </span>
                            @if (_report.Nature != 0)
                            {
                                <span class="badge @(_report.Nature == AccountNature.Expense ? "bg-danger" : "bg-success")">
                                    @GetNatureLabel(_report.Nature)
                                </span>
                            }
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <!-- Summary -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <div class="card bg-light h-100 ff-panel">
                                <div class="card-body">
                                    <h6 class="text-muted mb-2">@L["AccountGroupTotals_TotalAmount"]</h6>
                                    <h4 class="mb-0 @(_report.TotalCents < 0 ? "text-danger" : "text-success")">
                                        @MoneyFormatter.FormatCents(_report.TotalCents)
                                    </h4>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="card bg-light h-100 ff-panel">
                                <div class="card-body">
                                    <h6 class="text-muted mb-2">@L["AccountGroupTotals_Transactions"]</h6>
                                    <h4 class="mb-0">@_report.TransactionsCount</h4>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="card bg-light h-100 ff-panel">
                                <div class="card-body">
                                    <h6 class="text-muted mb-2">@L["AccountGroupTotals_Accounts"]</h6>
                                    <h4 class="mb-0">@_report.AccountsCount</h4>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Account Breakdown -->
                    @if (_report.Items.Count > 0)
                    {
                        var orderedItems = _report.Items.OrderByDescending(i => Math.Abs(i.TotalCents)).ToList();
                        var groupMonthlySeries = BuildGroupMonthlySeries();
                        var groupChartYear = _groupChartYear;
                        var groupChartMonth = _groupChartMonth;
                        var groupChartMonthLabel = DateHelper.GetMonthName(groupChartMonth);
                        int? annualDataUntilMonth = groupChartYear == DateHelper.GetCurrentYear()
                            ? DateHelper.GetCurrentMonth()
                            : null;

                        <div class="row g-3 account-group-period-details-grid">
                            <div class="col-12 col-xxl-6">
                                <h6 class="mb-3">
                                    <i class="bi bi-wallet2 me-2"></i>@L["AccountGroupTotals_AccountBreakdown"]
                                </h6>

                                <div class="table-responsive">
                                    <table class="table table-hover ff-data-table" data-testid="account-group-totals-period-account-breakdown">
                                        <thead>
                                            <tr>
                                                <th>@L["AccountGroupTotals_Table_Account"]</th>
                                                <th class="text-end">@L["AccountGroupTotals_Table_Amount"]</th>
                                                <th class="text-center">@L["AccountGroupTotals_Table_Transactions"]</th>
                                                <th class="text-end">@L["AccountGroupTotals_Table_Percentage"]</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in orderedItems)
                                            {
                                                var percentage = _report.TotalCents != 0 ? (Math.Abs(item.TotalCents) / (double)Math.Abs(_report.TotalCents)) * 100 : 0;

                                                <tr data-testid="account-group-totals-period-account-row">
                                                    <td>
                                                        <i class="bi bi-wallet2 me-2 text-muted"></i>
                                                        <strong>@item.AccountName</strong>
                                                    </td>
                                                    <td class="text-end">
                                                        <span class="@(item.TotalCents < 0 ? "text-danger" : "text-success")">
                                                            @MoneyFormatter.FormatCents(item.TotalCents)
                                                        </span>
                                                    </td>
                                                    <td class="text-center">
                                                        <span class="badge bg-secondary">@item.TransactionsCount</span>
                                                    </td>
                                                    <td class="text-end">
                                                        <div class="d-flex align-items-center justify-content-end">
                                                            <div class="progress me-2" style="width: 100px; height: 8px;">
                                                                <div class="progress-bar" role="progressbar" style="width: @(percentage)%"></div>
                                                            </div>
                                                            <span class="text-muted small">@percentage.ToString("F1")%</span>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <div class="col-12 col-xxl-6">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <h6 class="mb-0">
                                        <i class="bi bi-graph-up-arrow me-2"></i>@L["AccountGroupState_Title"]
                                    </h6>
                                    @if (!string.IsNullOrWhiteSpace(_report.GroupName))
                                    {
                                        <span class="badge text-bg-secondary">@_report.GroupName</span>
                                    }
                                </div>

                                <div class="economic-state-stacked-charts account-group-period-stacked-charts">
                                    @if (_isGroupChartsLoading)
                                    {
                                        <ReportingChartLoadingState
                                            Title="@L["AccountGroupState_LoadingMonthFocused"]"
                                            Description="@L["Reports_LoadingDailyPoints"]" />
                                        <ReportingChartLoadingState
                                            Title="@L["AccountGroupState_AnnualEvolutionTitle"]"
                                            Description="@L["Reports_LoadingData"]" />
                                    }
                                    else if (!string.IsNullOrWhiteSpace(_groupChartsError))
                                    {
                                        <ReportingChartErrorState Message="@_groupChartsError" />
                                        <ReportingChartErrorState Message="@_groupChartsError" />
                                    }
                                    else
                                    {
                                        @if (groupMonthlySeries.Count == 0)
                                        {
                                            <ReportingChartEmptyState
                                                Title="@L["MonthlySummary_MonthFocusedEvolution"]"
                                                Description="@L["Reports_NoDailyPointsForMonth"]" />
                                        }
                                        else
                                        {
                                            <MonthlyLineChart
                                                Title="@L["MonthlySummary_MonthFocusedEvolution"]"
                                                Subtitle="@L["AccountGroupState_MonthFocusedSubtitle", groupChartMonthLabel, groupChartYear]"
                                                Year="@groupChartYear"
                                                Month="@groupChartMonth"
                                                YTickMaxTicks="5"
                                                Series="@groupMonthlySeries"
                                                TestId="account-group-totals-period-group-monthly-chart" />
                                        }

                                        @if (_groupAnnualSeries.Count == 0)
                                        {
                                            <ReportingChartEmptyState
                                                Title="@L["AccountGroupState_AnnualEvolutionTitle"]"
                                                Description="@L["Reports_NoChartPointsForFilters"]" />
                                        }
                                        else
                                        {
                                            <AnnualBarChart
                                                Title="@L["AccountGroupState_AnnualEvolutionTitle"]"
                                                Subtitle="@L["AccountGroupState_AnnualEvolutionMonthResultSubtitle"]"
                                                Year="@groupChartYear"
                                                Series="@_groupAnnualSeries"
                                                DataUntilMonth="@annualDataUntilMonth"
                                                YTickMaxTicks="5"
                                                TestId="account-group-totals-period-group-annual-chart" />
                                        }
                                    }
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="bi bi-inbox display-4 text-muted"></i>
                            <p class="text-muted mt-2 mb-0">@L["AccountGroupTotals_NoTransactionsForPeriod"]</p>
                        </div>
                    }
                </div>
            </div>
        }
        else if (!_isBusy)
        {
            <div class="card shadow-sm ff-panel">
                <div class="card-body text-center py-5">
                    <i class="bi bi-bar-chart display-1 text-muted mb-3"></i>
                    <h5 class="text-muted">@L["AccountGroupTotals_Ready_Title"]</h5>
                    <p class="text-muted">@L["AccountGroupTotals_Ready_Hint"]</p>
                </div>
            </div>
        }
        }
        else
        {
            <AccountGroupStateEvolutionPanel />
        }

    </Authorized>

    <NotAuthorized>
        <div class="card shadow-sm ff-panel">
            <div class="card-body text-center py-5">
                <i class="bi bi-shield-lock display-1 text-muted mb-3"></i>
                <h5 class="text-muted">@L["AccountGroups_AuthRequired_Title"]</h5>
                <p class="text-muted">@L["Reports_LoginRequired"]</p>
                <a class="btn btn-primary mt-3" href="/login">
                    <i class="bi bi-box-arrow-in-right me-1"></i>@L["Common_Login"]
                </a>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private IReadOnlyList<AccountGroupDto>? _groups;
    private AccountGroupTotalsDto? _report;

    private string _selectedGroupId = string.Empty;
    private DateOnly _fromDate = DateHelper.GetCurrentMonthStart();
    private DateOnly _toDate = DateHelper.GetCurrentMonthEnd();
    private string _nature = string.Empty;
    private string? _activePreset = "this-month";

    private string? _error;
    private bool _isBusy;
    private AccountGroupReportTab _activeTab = AccountGroupReportTab.PeriodTotals;
    private IReadOnlyList<MonthlyChartSeries> _groupMonthlySeries = Array.Empty<MonthlyChartSeries>();
    private IReadOnlyList<AnnualChartSeries> _groupAnnualSeries = Array.Empty<AnnualChartSeries>();
    private string? _groupChartsError;
    private bool _isGroupChartsLoading;
    private int _groupChartYear = DateHelper.GetCurrentYear();
    private int _groupChartMonth = DateHelper.GetCurrentMonth();

    protected override async Task OnInitializedAsync()
    {
        await LoadGroupsAsync();
    }

    private Task HandlePresetSelected(DateRangePresets.DateRangePreset preset)
    {
        var (from, to) = preset.GetDateRange();
        _fromDate = from;
        _toDate = to;
        _activePreset = preset.Type.ToString().ToLowerInvariant().Replace("_", "-");
        ResetGroupCharts();
        return Task.CompletedTask;
    }

    private Task SetActiveTabAsync(AccountGroupReportTab tab)
    {
        _activeTab = tab;
        return Task.CompletedTask;
    }

    private string GetTabClass(AccountGroupReportTab tab)
    {
        return _activeTab == tab ? "active" : string.Empty;
    }

    private void OnDateChanged()
    {
        _activePreset = null; // Clear preset when manually changing dates
        ResetGroupCharts();
    }

    private async Task LoadGroupsAsync()
    {
        _error = null;

        await ExecuteApiAsync(async ct =>
        {
            _groups = await AccountGroupsApi.ListAsync(ct);
        });
    }

    private async Task LoadReportAsync()
    {
        if (string.IsNullOrEmpty(_selectedGroupId))
            return;

        _isBusy = true;
        _error = null;
        _report = null;
        ResetGroupCharts();

        try
        {
            await ExecuteApiAsync(async ct =>
            {
                var groupId = Guid.Parse(_selectedGroupId);
                AccountNature? nature = string.IsNullOrEmpty(_nature) ? null : Enum.Parse<AccountNature>(_nature);

                _report = await ReportsApi.GetAccountGroupTotalsAsync(
                    groupId,
                    _fromDate,
                    _toDate,
                    nature,
                    ct);
            });
            await LoadGroupChartsAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task LoadGroupChartsAsync()
    {
        if (_report is null)
            return;

        _isGroupChartsLoading = true;
        _groupChartsError = null;
        _groupMonthlySeries = Array.Empty<MonthlyChartSeries>();
        _groupAnnualSeries = Array.Empty<AnnualChartSeries>();
        StateHasChanged();

        try
        {
            var (chartYear, requestedMonth) = GetGroupChartReferencePeriod();
            var selectedGroupId = _report.GroupId;

            var groupEvolution = await ReportsApi.GetStateEvolutionAsync(chartYear, MonthlyEvolutionScope.AccountGroups);
            var selectedGroupSeries = groupEvolution.Series.FirstOrDefault(s => s.EntityId == selectedGroupId);
            _groupAnnualSeries = BuildGroupAnnualSeries(selectedGroupSeries, _report.GroupName);

            var focusedMonth = ResolveGroupFocusedMonth(chartYear, requestedMonth, selectedGroupSeries);
            _groupChartYear = chartYear;
            _groupChartMonth = focusedMonth;

            var groupEvolutionMonthly = await ReportsApi.GetMonthlyChartGroupEvolutionAsync(
                chartYear,
                focusedMonth);

            _groupMonthlySeries = BuildGroupMonthlySeries(groupEvolutionMonthly, selectedGroupId, _report.GroupName);
        }
        catch (UnauthorizedAccessException)
        {
            _groupChartsError = L["Reports_Error_Unauthorized"];
        }
        catch (Exception ex)
        {
            _groupChartsError = L["Reports_Error_LoadFailed", ex.Message];
        }
        finally
        {
            _isGroupChartsLoading = false;
        }
    }

    private void ResetGroupCharts()
    {
        _groupMonthlySeries = Array.Empty<MonthlyChartSeries>();
        _groupAnnualSeries = Array.Empty<AnnualChartSeries>();
        _groupChartsError = null;
        _isGroupChartsLoading = false;

        var (defaultYear, defaultMonth) = GetGroupChartReferencePeriod();
        _groupChartYear = defaultYear;
        _groupChartMonth = defaultMonth;
    }

    private IReadOnlyList<MonthlyChartSeries> BuildGroupMonthlySeries()
    {
        return _groupMonthlySeries;
    }

    private static IReadOnlyList<MonthlyChartSeries> BuildGroupMonthlySeries(
        MonthlyBalanceVsGroupsChartDto chart,
        Guid selectedGroupId,
        string groupName)
    {
        var selectedSeries = chart.Series.FirstOrDefault(series => series.EntityId == selectedGroupId);
        if (selectedSeries is null || selectedSeries.Points.Count == 0)
            return Array.Empty<MonthlyChartSeries>();

        var mapped = new MonthlyBalanceVsGroupsChartDto(
            chart.Year,
            chart.Month,
            [selectedSeries]);

        var label = string.IsNullOrWhiteSpace(groupName) ? selectedSeries.DisplayName : groupName;
        return MonthlyChartDatasetAdapter.BuildSeries(mapped, maxSeries: 1)
            .Select(series => series with { Label = label })
            .ToList();
    }

    private static IReadOnlyList<AnnualChartSeries> BuildGroupAnnualSeries(
        MonthlyEvolutionSeriesDto? selectedGroupSeries,
        string label)
    {
        if (selectedGroupSeries is null)
            return Array.Empty<AnnualChartSeries>();

        var points = Enumerable.Range(1, 12)
            .Select(month =>
            {
                var value = selectedGroupSeries.Points
                    .FirstOrDefault(point => point.Month == month)?
                    .DeltaVsPreviousMonthCents ?? 0L;
                return new AnnualChartPoint(month, value);
            })
            .ToList();

        if (points.All(point => point.Value == 0))
            return Array.Empty<AnnualChartSeries>();

        return
        [
            new AnnualChartSeries(
                Key: "account-group-month-result",
                Label: label,
                ColorHex: "#4fa4ff",
                Points: points)
        ];
    }

    private (int Year, int Month) GetGroupChartReferencePeriod()
    {
        var referenceDate = _report is not null
            ? _report.ToExclusive.AddDays(-1)
            : DateOnly.FromDateTime(DateTime.Today);

        return (referenceDate.Year, referenceDate.Month);
    }

    private static int ResolveGroupFocusedMonth(
        int year,
        int preferredMonth,
        MonthlyEvolutionSeriesDto? selectedGroupSeries)
    {
        var maxMonth = year == DateHelper.GetCurrentYear()
            ? DateHelper.GetCurrentMonth()
            : 12;

        preferredMonth = Math.Clamp(preferredMonth, 1, maxMonth);
        if (selectedGroupSeries is null || selectedGroupSeries.Points.Count == 0)
            return preferredMonth;

        var availableMonths = selectedGroupSeries.Points
            .Select(point => point.Month)
            .Where(month => month is >= 1 and <= 12 && month <= maxMonth)
            .Distinct()
            .OrderBy(month => month)
            .ToList();

        if (availableMonths.Count == 0)
            return preferredMonth;

        if (availableMonths.Contains(preferredMonth))
            return preferredMonth;

        return availableMonths
            .Where(month => month <= preferredMonth)
            .DefaultIfEmpty(availableMonths.Max())
            .Max();
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/reports");
    }

    private async Task ExportCsvAsync()
    {
        if (_report is null)
            return;

        var rows = _report.Items
            .OrderByDescending(item => Math.Abs(item.TotalCents))
            .Select(item =>
            {
                var percentage = _report.TotalCents != 0
                    ? (Math.Abs(item.TotalCents) / (double)Math.Abs(_report.TotalCents)) * 100d
                    : 0d;

                return (IReadOnlyList<string?>)
                [
                    item.AccountName,
                    MoneyFormatter.FormatCents(item.TotalCents),
                    item.TransactionsCount.ToString(),
                    $"{percentage:F1}%"
                ];
            })
            .ToList();

        rows.Add(
        [
            "Total",
            MoneyFormatter.FormatCents(_report.TotalCents),
            _report.TransactionsCount.ToString(),
            "100.0%"
        ]);

        var csv = ReportCsvBuilder.Build(
            reportName: L["AccountGroupTotals_Title"],
            context: new Dictionary<string, string?>
            {
                [L["AccountGroupTotals_AccountGroup"]] = _report.GroupName,
                [L["Reports_FromDate"]] = _fromDate.ToString("yyyy-MM-dd"),
                [L["Reports_ToDateExclusive"]] = _toDate.ToString("yyyy-MM-dd"),
                [L["Reports_Nature"]] = string.IsNullOrWhiteSpace(_nature)
                    ? "-"
                    : GetNatureLabel(Enum.Parse<AccountNature>(_nature))
            },
            headers: [L["AccountGroupTotals_Table_Account"], L["AccountGroupTotals_Table_Amount"], L["AccountGroupTotals_Table_Transactions"], L["Reports_Share"]],
            rows: rows);

        try
        {
            var fileName = ReportExportInterop.BuildFileName(
                "account-group-totals",
                _report.GroupName,
                _fromDate.ToString("yyyy-MM-dd"),
                _toDate.ToString("yyyy-MM-dd")) + ".csv";
            await JS.DownloadCsvAsync(fileName, csv);
        }
        catch (Exception ex)
        {
            _error = L["Reports_Error_ExportCsvFailed", ex.Message];
        }
    }

    private enum AccountGroupReportTab
    {
        PeriodTotals,
        StateEvolution
    }

    private string GetNatureLabel(AccountNature nature)
    {
        return nature switch
        {
            AccountNature.Asset => L["Dashboard_Nature_Asset"],
            AccountNature.Liability => L["Dashboard_Nature_Liability"],
            AccountNature.Expense => L["Dashboard_Nature_Expense"],
            AccountNature.Income => L["Dashboard_Nature_Income"],
            AccountNature.Equity => L["Accounts_Nature_Equity"],
            _ => nature.ToString()
        };
    }

}
