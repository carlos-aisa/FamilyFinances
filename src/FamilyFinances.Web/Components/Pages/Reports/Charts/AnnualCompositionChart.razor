@using System.Globalization
@using System.Text.Json
@using FamilyFinances.Web
@using FamilyFinances.Web.Features.Reports
@using FamilyFinances.Web.Features.Reports.Export
@using FamilyFinances.Web.Features.Reports.Charts
@using Microsoft.Extensions.Localization
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResource> L

@if (_displaySlices.Count == 0)
{
    <ReportingChartEmptyState
        Title="@Title"
        Description="@L["ReportingChart_Empty_NoCompositionForFilters"]" />
}
else
{
    <div class="card shadow-sm annual-composition-chart ff-panel ff-chart-panel @(UseSideLegend ? "is-side-legend" : string.Empty)"
         data-testid="@TestId"
         data-year="@Year"
         data-total-percentage="@TotalPercentage.ToString("0.####", CultureInfo.InvariantCulture)">
        <div class="card-body">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-start gap-2 mb-3">
                <div>
                    <h6 class="mb-1">@Title</h6>
                    @if (!string.IsNullOrWhiteSpace(Subtitle))
                    {
                        <small class="text-muted">@Subtitle</small>
                    }
                </div>
                <div class="d-flex align-items-center gap-2">
                    @if (EnableImageExport)
                    {
                        <button type="button"
                                class="btn btn-sm btn-outline-secondary report-export-button ff-chart-export-button"
                                @onclick="ExportChartAsync"
                                data-testid="@($"{TestId}-export-image")"
                                aria-label="@L["ReportingChart_AriaExportPng", Title]">
                            <i class="bi bi-download me-1"></i>@L["Reports_Export"]
                        </button>
                    }
                    <span class="badge bg-secondary-subtle text-secondary">@GetBadgeText()</span>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(_exportError))
            {
                <div class="text-danger small mb-2">@_exportError</div>
            }

            <div class="annual-composition-layout @(UseSideLegend ? "is-side-legend" : string.Empty)">
                <div class="annual-composition-canvas-wrap">
                    <canvas id="@_canvasId" class="annual-composition-canvas" role="img" tabindex="0" aria-label="@Title"></canvas>
                </div>

                @if (UseSideLegend)
                {
                    <div class="composition-legend composition-legend-side" data-testid="@($"{TestId}-legend")">
                        @foreach (var slice in _displaySlices.Take(Math.Max(1, LegendMaxItems)))
                        {
                            <div class="composition-slice-row">
                                <span class="composition-dot" style="@($"--ff-slice-color:{slice.ColorHex};")"></span>
                                <span class="composition-label" title="@slice.Label">@slice.Label</span>
                                <span class="composition-percentage">@slice.Percentage.ToString("0.##", CultureInfo.InvariantCulture)%</span>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Subtitle { get; set; }
    [Parameter, EditorRequired] public int Year { get; set; }
    [Parameter] public string? BadgeText { get; set; }
    [Parameter, EditorRequired] public IReadOnlyList<AnnualCompositionSlice> Slices { get; set; } = Array.Empty<AnnualCompositionSlice>();
    [Parameter] public string TestId { get; set; } = "annual-composition-chart";
    [Parameter] public bool EnableImageExport { get; set; } = true;
    [Parameter] public bool UseSideLegend { get; set; }
    [Parameter] public int LegendMaxItems { get; set; } = 10;
    [Parameter] public int MaxSlices { get; set; } = 10;

    private readonly string _canvasId = $"annual-composition-{Guid.NewGuid():N}";
    private string? _lastRenderedSignature;
    private string? _exportError;
    private IReadOnlyList<AnnualCompositionSlice> _displaySlices = Array.Empty<AnnualCompositionSlice>();

    private decimal TotalPercentage => _displaySlices.Sum(x => x.Percentage);

    private string GetBadgeText()
    {
        if (!string.IsNullOrWhiteSpace(BadgeText))
            return BadgeText;

        return L["Reports_BadgeYear", Year.ToString(CultureInfo.InvariantCulture)];
    }

    protected override void OnParametersSet()
    {
        _displaySlices = BuildDisplaySlices();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_displaySlices.Count == 0)
            return;

        var payload = new
        {
            labels = _displaySlices.Select(x => x.Label).ToList(),
            values = _displaySlices.Select(x => Convert.ToDouble(x.Percentage, CultureInfo.InvariantCulture)).ToList(),
            colors = _displaySlices.Select(x => x.ColorHex).ToList()
        };

        var signature = JsonSerializer.Serialize(payload);
        if (string.Equals(_lastRenderedSignature, signature, StringComparison.Ordinal))
            return;

        try
        {
            await JS.InvokeVoidAsync(
                "familyFinancesCharts.renderAnnualCompositionChart",
                _canvasId,
                payload);
            _lastRenderedSignature = signature;
        }
        catch
        {
            // Ignore JS errors on non-interactive renderers.
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("familyFinancesCharts.disposeAnnualCompositionChart", _canvasId);
            _lastRenderedSignature = null;
        }
        catch
        {
            // Ignore dispose failures for disconnected/non-interactive renderers.
        }
    }

    private async Task ExportChartAsync()
    {
        _exportError = null;

        try
        {
            var fileName = $"{ReportExportInterop.BuildFileName("report-chart", Title, Year)}.png";
            await JS.DownloadChartImageAsync(_canvasId, fileName);
        }
        catch (Exception ex)
        {
            _exportError = L["ReportingChart_Error_ExportFailed", ex.Message];
        }
    }

    private IReadOnlyList<AnnualCompositionSlice> BuildDisplaySlices()
    {
        if (Slices.Count == 0)
            return Array.Empty<AnnualCompositionSlice>();

        var othersLabel = L["Dashboard_ExpenseComposition_Others"];
        var normalized = Slices
            .Select(slice => slice with { RawValueCents = Math.Abs(slice.RawValueCents) })
            .Where(slice => slice.RawValueCents > 0)
            .ToList();

        if (normalized.Count == 0)
            return Array.Empty<AnnualCompositionSlice>();

        var normalizedMaxSlices = Math.Max(2, MaxSlices);
        var explicitOthersTotal = normalized
            .Where(slice => IsOthersSlice(slice, othersLabel))
            .Sum(slice => slice.RawValueCents);

        var ordered = normalized
            .Where(slice => !IsOthersSlice(slice, othersLabel))
            .OrderByDescending(slice => slice.RawValueCents)
            .ThenBy(slice => slice.Label, StringComparer.OrdinalIgnoreCase)
            .ToList();

        var collapsed = new List<AnnualCompositionSlice>(ordered.Count);
        if (ordered.Count + (explicitOthersTotal > 0 ? 1 : 0) > normalizedMaxSlices)
        {
            var keepCount = normalizedMaxSlices - 1;
            collapsed.AddRange(ordered.Take(keepCount));

            var othersTotal = ordered.Skip(keepCount).Sum(slice => slice.RawValueCents) + explicitOthersTotal;
            if (othersTotal > 0)
            {
                collapsed.Add(new AnnualCompositionSlice(
                    Key: "others",
                    Label: othersLabel,
                    RawValueCents: othersTotal,
                    Percentage: 0m,
                    ColorHex: AnnualChartPalette.Resolve(collapsed.Count)));
            }
        }
        else
        {
            collapsed.AddRange(ordered);
            if (explicitOthersTotal > 0)
            {
                collapsed.Add(new AnnualCompositionSlice(
                    Key: "others",
                    Label: othersLabel,
                    RawValueCents: explicitOthersTotal,
                    Percentage: 0m,
                    ColorHex: AnnualChartPalette.Resolve(collapsed.Count)));
            }
        }

        var total = collapsed.Sum(slice => slice.RawValueCents);
        if (total <= 0)
            return Array.Empty<AnnualCompositionSlice>();

        return collapsed
            .Select((slice, idx) => new AnnualCompositionSlice(
                Key: IsOthersSlice(slice, othersLabel) ? "others" : slice.Key,
                Label: IsOthersSlice(slice, othersLabel) ? othersLabel : slice.Label,
                RawValueCents: slice.RawValueCents,
                Percentage: (slice.RawValueCents * 100m) / total,
                ColorHex: AnnualChartPalette.Resolve(idx)))
            .ToList();
    }

    private static bool IsOthersSlice(AnnualCompositionSlice slice, string othersLabel)
    {
        return string.Equals(slice.Key, "others", StringComparison.OrdinalIgnoreCase)
            || slice.Key.Contains("others", StringComparison.OrdinalIgnoreCase)
            || string.Equals(slice.Label, othersLabel, StringComparison.OrdinalIgnoreCase);
    }
}
