@using System.Globalization
@using System.Text.Json
@using FamilyFinances.Web
@using FamilyFinances.Web.Features.Reports.Export
@using FamilyFinances.Web.Features.Reports.Charts
@using Microsoft.Extensions.Localization
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResource> L

@if (Series.Count == 0 || !HasData)
{
    <ReportingChartEmptyState
        Title="@Title"
        Description="@L["ReportingChart_Empty_NoPointsForMonth"]" />
}
else
{
    <div class="card shadow-sm mb-4 annual-line-chart ff-panel ff-chart-panel" data-testid="@TestId" data-year="@Year" data-month="@Month">
        <div class="card-body">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-start gap-2 mb-3">
                <div>
                    <h6 class="mb-1">@Title</h6>
                    @if (!string.IsNullOrWhiteSpace(Subtitle))
                    {
                        <small class="text-muted">@Subtitle</small>
                    }
                </div>
                <div class="d-flex align-items-center gap-2">
                    @if (EnableImageExport)
                    {
                        <button type="button"
                                class="btn btn-sm btn-outline-secondary report-export-button ff-chart-export-button"
                                @onclick="ExportChartAsync"
                                data-testid="@($"{TestId}-export-image")"
                                aria-label="@L["ReportingChart_AriaExportPng", Title]">
                            <i class="bi bi-download me-1"></i>@L["Reports_Export"]
                        </button>
                    }
                    <span class="badge bg-secondary-subtle text-secondary">@GetBadgeText()</span>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(_exportError))
            {
                <div class="text-danger small mb-2">@_exportError</div>
            }

            <div class="annual-line-canvas-wrap">
                <canvas id="@_canvasId" class="annual-line-canvas" role="img" tabindex="0" aria-label="@Title"></canvas>
            </div>

            <div class="visually-hidden">
                @foreach (var series in Series)
                {
                    <span data-series-key="@series.Key"
                          data-points="@BuildDataPointString(series)"></span>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Subtitle { get; set; }
    [Parameter, EditorRequired] public int Year { get; set; }
    [Parameter, EditorRequired] public int Month { get; set; }
    [Parameter, EditorRequired] public IReadOnlyList<MonthlyChartSeries> Series { get; set; } = Array.Empty<MonthlyChartSeries>();
    [Parameter] public string TestId { get; set; } = "monthly-line-chart";
    [Parameter] public int? YTickMaxTicks { get; set; }
    [Parameter] public bool EnableImageExport { get; set; } = true;
    [Parameter] public bool ShowFullMonthRange { get; set; } = true;

    private readonly string _canvasId = $"monthly-line-{Guid.NewGuid():N}";
    private string? _lastRenderedSignature;
    private string? _exportError;
    private bool HasData => Series.Any(s => s.Points.Count > 0);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Series.Count == 0 || !HasData)
            return;

        var payload = BuildChartPayload();
        var signature = JsonSerializer.Serialize(payload);
        if (string.Equals(_lastRenderedSignature, signature, StringComparison.Ordinal))
            return;

        try
        {
            await JS.InvokeVoidAsync(
                "familyFinancesCharts.renderAnnualLineChart",
                _canvasId,
                payload);
            _lastRenderedSignature = signature;
        }
        catch
        {
            // Non-browser renderers (e.g. tests/prerender) may not support JS interop.
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("familyFinancesCharts.disposeAnnualLineChart", _canvasId);
            _lastRenderedSignature = null;
        }
        catch
        {
            // Ignore dispose failures for disconnected/non-interactive renderers.
        }
    }

    private object BuildChartPayload()
    {
        var daysInMonth = DateTime.DaysInMonth(Year, Month);
        var orderedDays = ShowFullMonthRange
            ? Enumerable.Range(1, daysInMonth).ToList()
            : Series
                .SelectMany(s => s.Points.Select(p => p.Day))
                .Distinct()
                .OrderBy(d => d)
                .ToList();

        var labels = orderedDays.Select(d => d.ToString(CultureInfo.InvariantCulture)).ToList();

        var dataCutoffDay = ShowFullMonthRange
            ? Series
                .SelectMany(series => series.Points.Select(point => point.Day))
                .Where(day => day >= 1 && day <= daysInMonth)
                .DefaultIfEmpty()
                .Max()
            : 0;

        var datasets = Series
            .Select(series =>
            {
                var pointsByDay = series.Points.ToDictionary(x => x.Day, x => x.Value);
                var firstDayWithData = series.Points.Count == 0
                    ? (int?)null
                    : series.Points.Min(point => point.Day);
                decimal? latestValue = null;
                var values = orderedDays
                    .Select(day =>
                    {
                        if (pointsByDay.TryGetValue(day, out var value))
                        {
                            latestValue = value;
                            return Convert.ToDouble(value / 100m, CultureInfo.InvariantCulture);
                        }

                        if (ShowFullMonthRange &&
                            firstDayWithData is not null &&
                            day >= firstDayWithData.Value &&
                            latestValue is not null)
                        {
                            return Convert.ToDouble(latestValue.Value / 100m, CultureInfo.InvariantCulture);
                        }

                        return (double?)null;
                    })
                    .ToList();

                return new
                {
                    key = series.Key,
                    label = series.Label,
                    colorHex = series.ColorHex,
                    values,
                    yAxisId = "y"
                };
            })
            .ToList();

        int? markerDay = ShowFullMonthRange && dataCutoffDay > 0
            ? dataCutoffDay
            : null;

        return new
        {
            labels,
            datasets,
            useDualAxis = false,
            xTickAutoSkip = true,
            xTickMaxTicks = 12,
            yTickMaxTicks = YTickMaxTicks,
            markerDay,
            totalDays = ShowFullMonthRange ? daysInMonth : labels.Count
        };
    }

    private static string BuildDataPointString(MonthlyChartSeries series)
    {
        return string.Join(";",
            series.Points
                .OrderBy(p => p.Day)
                .Select(p => $"{p.Day}:{p.Value.ToString(CultureInfo.InvariantCulture)}"));
    }

    private string GetBadgeText()
        => L["Reports_BadgePeriod", $"{Year:D4}-{Month:00}"];

    private async Task ExportChartAsync()
    {
        _exportError = null;

        try
        {
            var fileName = $"{ReportExportInterop.BuildFileName("report-chart", Title, Year, Month.ToString("00", CultureInfo.InvariantCulture))}.png";
            await JS.DownloadChartImageAsync(_canvasId, fileName);
        }
        catch (Exception ex)
        {
            _exportError = L["ReportingChart_Error_ExportFailed", ex.Message];
        }
    }
}
