@using FamilyFinances.Web
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> L

<div class="card shadow-sm mb-4 border-danger" data-testid="reporting-chart-error">
    <div class="card-body py-4">
        <div class="d-flex align-items-start gap-3">
            <i class="bi bi-exclamation-triangle-fill text-danger fs-4"></i>
            <div>
                <h6 class="mb-1 text-danger">@L["ReportingChart_Error_Title"]</h6>
                <p class="mb-0 text-muted">@ResolvedMessage</p>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public string Message { get; set; } = string.Empty;
    private string ResolvedMessage => string.IsNullOrWhiteSpace(Message)
        ? L["ReportingChart_Error_DefaultMessage"]
        : Message;
}
