@page "/reports/category-totals"
@rendermode InteractiveServer
@using FamilyFinances.Application.Ledger.Payees.Dtos
@using FamilyFinances.Application.Reporting.Dtos
@using FamilyFinances.Domain.Ledger.Accounts
@using FamilyFinances.Web
@using FamilyFinances.Web.Api
@using FamilyFinances.Web.Components.Base
@using FamilyFinances.Web.Components.Pages.Transactions
@using FamilyFinances.Web.Components.Shared
@using FamilyFinances.Web.Features.Reports
@using FamilyFinances.Web.Features.Reports.Export
@using Microsoft.Extensions.Localization
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components.Authorization
@inherits ApiPageBase

@inject ReportsApi ReportsApi
@inject PayeesApi PayeesApi
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResource> L

<AuthorizeView>
    <Authorized>
        <div class="d-flex align-items-center justify-content-between mb-4 ff-page-header">
            <div>
                <h3 class="mb-1 ff-page-title">
                    <i class="bi bi-pie-chart me-2"></i>@L["CategoryTotals_Title"]
                </h3>
                <p class="text-muted mb-0 ff-page-subtitle">@L["CategoryTotals_Subtitle"]</p>
            </div>
            <a class="btn btn-outline-secondary" href="/reports">
                <i class="bi bi-arrow-left me-1"></i>@L["Reports_BackToReports"]
            </a>
        </div>

        <!-- Filters Card -->
        <div class="card shadow-sm mb-4 ff-panel ff-report-filter-panel">
            <div class="card-body">
                <div class="row g-3">
                    <!-- Quick Date Presets -->
                    <div class="col-12">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-calendar-range me-1"></i>@L["Reports_QuickSelect"]
                        </label>
                        <div>
                            <DateRangePresets OnPresetSelected="HandlePresetSelected" ActivePreset="@_activePreset" />
                        </div>
                    </div>

                    <!-- Date Range -->
                    <div class="col-12 col-md-3">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-calendar3 me-1"></i>@L["Reports_FromDate"]
                        </label>
                        <input type="date" class="form-control" aria-label="@L["Reports_FromDate"]" @bind="_fromDate" />
                    </div>

                    <div class="col-12 col-md-3">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-calendar3 me-1"></i>@L["Reports_ToDateExclusive"]
                        </label>
                        <input type="date" class="form-control" aria-label="@L["Reports_ToDateExclusive"]" @bind="_toDate" />
                    </div>

                    <!-- Nature Selector -->
                    <div class="col-12 col-md-3">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-tag me-1"></i>@L["CategoryTotals_AccountNature"]
                        </label>
                        <select class="form-select" aria-label="@L["CategoryTotals_AccountNature"]" @bind="_selectedNature">
                            @foreach (var nature in Enum.GetValues<AccountNature>())
                            {
                                <option value="@nature">@GetNatureLabel(nature)</option>
                            }
                        </select>
                    </div>

                    <!-- Payee Filter -->
                    <div class="col-12 col-md-3">
                        <PayeeSelectorSimple @bind-SelectedPayeeId="_selectedPayeeId" />
                    </div>
                </div>

                <div class="mt-3">
                        <button class="btn btn-primary" @onclick="LoadReportAsync" disabled="@_isLoading">
                        @if (_isLoading)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        }
                        else
                        {
                            <i class="bi bi-search me-1"></i>
                        }
                        @L["Reports_LoadReport"]
                    </button>
                    <button class="btn btn-outline-secondary ms-2" @onclick="ResetFilters">
                        <i class="bi bi-x-circle me-1"></i>@L["Reports_ResetToCurrentMonth"]
                    </button>
                </div>
            </div>
        </div>

        <!-- Error Display -->
        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle me-2"></i>@_error
                <button type="button" class="btn-close" @onclick="@(() => _error = null)"></button>
            </div>
        }

        <!-- Loading State -->
        @if (_isLoading)
        {
            <div class="card shadow-sm ff-panel">
                    <div class="card-body text-center py-5">
                        <div class="spinner-border text-primary mb-3" role="status" style="width: 3rem; height: 3rem;">
                            <span class="visually-hidden">@L["Common_Loading"]</span>
                        </div>
                        <p class="text-muted">@L["Reports_LoadingData"]</p>
                    </div>
                </div>
            }
        else if (_report is not null)
        {
            <!-- Report Results -->
            <div class="card shadow-sm mb-4 ff-panel">
                <div class="card-header bg-transparent ff-panel-header">
                    <div class="d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">
                                <i class="bi bi-list-ul me-2"></i>
                                @L["CategoryTotals_NatureAccounts", GetNatureLabel(_report.Nature)]
                            </h5>
                        <div class="d-flex align-items-center gap-2">
                            <div class="text-muted">
                                <small>
                                    <i class="bi bi-calendar-range me-1"></i>
                                    @DateHelper.FormatShortDate(_report.FromInclusive) - @DateHelper.FormatShortDate(_report.ToExclusive)
                                </small>
                            </div>
                            <button type="button"
                                    class="btn btn-sm btn-outline-secondary report-export-button"
                                    @onclick="ExportCsvAsync"
                                    data-testid="category-totals-export-csv"
                                    aria-label="@L["Reports_AriaExportCsv"]">
                                <i class="bi bi-download me-1"></i>@L["Reports_Export"]
                            </button>
                        </div>
                    </div>
                </div>
                <div class="card-body p-0">
                    @if (_report.Items.Count == 0)
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-inbox display-4 text-muted mb-3"></i>
                            <h5 class="text-muted">@L["Reports_NoDataForPeriod"]</h5>
                            <p class="text-muted">@L["CategoryTotals_NoDataHint"]</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0 ff-data-table">
                                <thead class="table-light">
                                    <tr>
                                        <th class="border-0 ps-3" style="width: 50%;">
                                            <button type="button"
                                                    class="btn btn-link btn-sm text-decoration-none p-0 ff-sort-header"
                                                    aria-label="@L["CategoryTotals_Table_AccountName"]"
                                                    aria-sort="@GetAriaSort(SortColumn.AccountName)"
                                                    @onclick="() => ToggleSort(SortColumn.AccountName)">
                                                <i class="bi bi-tag me-1"></i>@L["CategoryTotals_Table_AccountName"]
                                                <i class="bi @GetSortIconClass(SortColumn.AccountName) ms-1" aria-hidden="true"></i>
                                            </button>
                                        </th>
                                        <th class="border-0 text-end" style="width: 30%;">
                                            <button type="button"
                                                    class="btn btn-link btn-sm text-decoration-none p-0 ff-sort-header"
                                                    aria-label="@L["CategoryTotals_Table_Total"]"
                                                    aria-sort="@GetAriaSort(SortColumn.Total)"
                                                    @onclick="() => ToggleSort(SortColumn.Total)">
                                                <i class="bi bi-currency-euro me-1"></i>@L["CategoryTotals_Table_Total"]
                                                <i class="bi @GetSortIconClass(SortColumn.Total) ms-1" aria-hidden="true"></i>
                                            </button>
                                        </th>
                                        <th class="border-0 text-end pe-3" style="width: 20%;">
                                            <button type="button"
                                                    class="btn btn-link btn-sm text-decoration-none p-0 ff-sort-header"
                                                    aria-label="@L["CategoryTotals_Table_Transactions"]"
                                                    aria-sort="@GetAriaSort(SortColumn.Transactions)"
                                                    @onclick="() => ToggleSort(SortColumn.Transactions)">
                                                <i class="bi bi-receipt me-1"></i>@L["CategoryTotals_Table_Transactions"]
                                                <i class="bi @GetSortIconClass(SortColumn.Transactions) ms-1" aria-hidden="true"></i>
                                            </button>
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in SortItems(_report.Items))
                                    {
                                        <tr class="clickable-row" style="cursor: pointer;" @onclick="() => OpenAccountMovements(item.AccountId)">
                                            <td class="ps-3">
                                                <span class="fw-semibold">@item.AccountName</span>
                                            </td>
                                            <td class="text-end">
                                                <span class="badge bg-primary bg-opacity-10 text-primary fs-6 fw-semibold">
                                                    @MoneyFormatter.FormatCentsWithSign(item.Total)
                                                </span>
                                            </td>
                                            <td class="text-end pe-3">
                                                <span class="text-muted">@item.TransactionsCount</span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot class="table-light">
                                    <tr>
                                        <th class="ps-3">@L["CategoryTotals_Total"]</th>
                                        <th class="text-end">
                                            <span class="badge bg-success bg-opacity-10 text-success fs-6 fw-bold">
                                                @MoneyFormatter.FormatCentsWithSign(_report.Items.Sum(i => i.Total))
                                            </span>
                                        </th>
                                        <th class="text-end pe-3">
                                            @_report.Items.Sum(i => i.TransactionsCount)
                                        </th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    }
                </div>
            </div>

            <!-- Chart Placeholder -->
                <div class="card shadow-sm ff-panel">
                    <div class="card-body text-center py-5">
                        <i class="bi bi-pie-chart display-4 text-muted mb-3"></i>
                        <h5 class="text-muted">@L["CategoryTotals_PieChart_Title"]</h5>
                        <p class="text-muted mb-0">@L["CategoryTotals_PieChart_ComingSoon"]</p>
                    </div>
                </div>
            }
        else if (!_isLoading && _report is null)
        {
            <!-- No Report Loaded Yet -->
            <div class="card shadow-sm ff-panel">
                <div class="card-body text-center py-5">
                    <i class="bi bi-pie-chart display-1 text-muted mb-3"></i>
                    <h5 class="text-muted">@L["Reports_ReadyToGenerate"]</h5>
                    <p class="text-muted">@L["CategoryTotals_ReadyHint"]</p>
                </div>
            </div>
        }

    </Authorized>
    <NotAuthorized>
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle me-2"></i>
            @L["Reports_LoginRequired"]
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private CategoryTotalsDto? _report;
    private string? _error;
    private bool _isLoading;

    private DateOnly _fromDate = DateHelper.GetCurrentMonthStart();
    private DateOnly _toDate = DateHelper.GetCurrentMonthEnd();
    private AccountNature _selectedNature = AccountNature.Expense;
    private Guid? _selectedPayeeId;
    private string? _activePreset = "this-month";
    private SortColumn _sortColumn = SortColumn.Total;
    private SortDirection _sortDirection = SortDirection.Descending;

    private async Task HandlePresetSelected(DateRangePresets.DateRangePreset preset)
    {
        var (from, to) = preset.GetDateRange();
        _fromDate = from;
        _toDate = to;
        _activePreset = preset.Type.ToString().ToLowerInvariant().Replace("_", "-");
        
        // Auto-load report when preset selected
        await LoadReportAsync();
    }

    private async Task LoadReportAsync()
    {
        // Validate date range
        if (_fromDate >= _toDate)
        {
            _error = L["Reports_Error_FromBeforeTo"];
            return;
        }

        _isLoading = true;
        _error = null;
        _report = null;
        StateHasChanged();

        try
        {
            _report = await ReportsApi.GetCategoryTotalsAsync(_fromDate, _toDate, _selectedNature, _selectedPayeeId);
        }
        catch (UnauthorizedAccessException)
        {
            _error = L["Reports_Error_Unauthorized"];
        }
        catch (Exception ex)
        {
            _error = L["Reports_Error_LoadFailed", ex.Message];
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void ResetFilters()
    {
        _fromDate = DateHelper.GetCurrentMonthStart();
        _toDate = DateHelper.GetCurrentMonthEnd();
        _selectedNature = AccountNature.Expense;
        _selectedPayeeId = null;
        _activePreset = "this-month";
        _report = null;
        _error = null;
    }

    private async Task ExportCsvAsync()
    {
        if (_report is null)
            return;

        var totalAmount = _report.Items.Sum(i => i.Total);
        var totalTransactions = _report.Items.Sum(i => i.TransactionsCount);

        var rows = _report.Items
            .Select(item => (IReadOnlyList<string?>)
            [
                item.AccountName,
                MoneyFormatter.FormatCentsWithSign(item.Total),
                item.TransactionsCount.ToString()
            ])
            .ToList();

        rows.Add(
        [
            L["CategoryTotals_Total"],
            MoneyFormatter.FormatCentsWithSign(totalAmount),
            totalTransactions.ToString()
        ]);

        var csv = ReportCsvBuilder.Build(
            reportName: L["CategoryTotals_Title"],
            context: new Dictionary<string, string?>
            {
                [L["Reports_FromDate"]] = _fromDate.ToString("yyyy-MM-dd"),
                [L["Reports_ToDateExclusive"]] = _toDate.ToString("yyyy-MM-dd"),
                [L["Reports_Nature"]] = GetNatureLabel(_selectedNature),
                [L["Reports_PayeeOptional"]] = _selectedPayeeId?.ToString()
            },
            headers: [L["CategoryTotals_Table_AccountName"], L["CategoryTotals_Table_Total"], L["CategoryTotals_Table_Transactions"]],
            rows: rows);

        try
        {
            var fileName = ReportExportInterop.BuildFileName(
                "category-totals",
                _fromDate.ToString("yyyy-MM-dd"),
                _toDate.ToString("yyyy-MM-dd"),
                _selectedNature) + ".csv";
            await JS.DownloadCsvAsync(fileName, csv);
        }
        catch (Exception ex)
        {
            _error = L["Reports_Error_ExportCsvFailed", ex.Message];
        }
    }

    private string GetNatureLabel(AccountNature nature)
    {
        return nature switch
        {
            AccountNature.Asset => L["Dashboard_Nature_Asset"],
            AccountNature.Liability => L["Dashboard_Nature_Liability"],
            AccountNature.Expense => L["Dashboard_Nature_Expense"],
            AccountNature.Income => L["Dashboard_Nature_Income"],
            AccountNature.Equity => L["Accounts_Nature_Equity"],
            _ => nature.ToString()
        };
    }

    private void OpenAccountMovements(Guid accountId)
    {
        var context = new TransactionOriginContext(
            Origin: TransactionOrigin.ReportCategoryTotals,
            AccountId: accountId,
            From: _fromDate,
            To: _toDate);

        Nav.NavigateTo(context.BuildUri($"/accounts/{accountId}/movements"));
    }

    private IEnumerable<CategoryTotalItemDto> SortItems(IEnumerable<CategoryTotalItemDto> items)
    {
        IOrderedEnumerable<CategoryTotalItemDto> ordered = _sortColumn switch
        {
            SortColumn.AccountName => _sortDirection == SortDirection.Ascending
                ? items.OrderBy(item => item.AccountName, StringComparer.OrdinalIgnoreCase)
                : items.OrderByDescending(item => item.AccountName, StringComparer.OrdinalIgnoreCase),
            SortColumn.Transactions => _sortDirection == SortDirection.Ascending
                ? items.OrderBy(item => item.TransactionsCount)
                : items.OrderByDescending(item => item.TransactionsCount),
            _ => _sortDirection == SortDirection.Ascending
                ? items.OrderBy(item => item.Total)
                : items.OrderByDescending(item => item.Total)
        };

        return ordered.ThenBy(item => item.AccountName, StringComparer.OrdinalIgnoreCase);
    }

    private void ToggleSort(SortColumn column)
    {
        if (_sortColumn == column)
        {
            _sortDirection = _sortDirection == SortDirection.Ascending
                ? SortDirection.Descending
                : SortDirection.Ascending;
            return;
        }

        _sortColumn = column;
        _sortDirection = column == SortColumn.AccountName
            ? SortDirection.Ascending
            : SortDirection.Descending;
    }

    private string GetSortIconClass(SortColumn column)
    {
        if (_sortColumn != column)
            return "bi-arrow-down-up";

        return _sortDirection == SortDirection.Ascending ? "bi-sort-up" : "bi-sort-down";
    }

    private string GetAriaSort(SortColumn column)
    {
        if (_sortColumn != column)
            return "none";

        return _sortDirection == SortDirection.Ascending ? "ascending" : "descending";
    }

    private enum SortColumn
    {
        AccountName,
        Total,
        Transactions
    }

    private enum SortDirection
    {
        Ascending,
        Descending
    }
}

