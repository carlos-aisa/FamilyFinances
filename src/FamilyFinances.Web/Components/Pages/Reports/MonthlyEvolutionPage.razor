@page "/reports/monthly-evolution"
@rendermode InteractiveServer
@using FamilyFinances.Application.Ledger.Accounts.Dtos
@using FamilyFinances.Application.Reporting.Dtos
@using FamilyFinances.Application.Reporting.Semantics
@using FamilyFinances.Domain.Ledger.Accounts
@using FamilyFinances.Web.Api
@using FamilyFinances.Web.Components.Base
@using FamilyFinances.Web.Components.Pages.Reports.Charts
@using FamilyFinances.Web.Features.Reports
@using FamilyFinances.Web.Features.Reports.Charts
@using Microsoft.AspNetCore.Components.Authorization
@inherits ApiPageBase

@inject ReportsApi ReportsApi
@inject IAccountsApi AccountsApi
@inject AccountGroupsApi AccountGroupsApi

<AuthorizeView>
    <Authorized>
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <h3 class="mb-1">
                    <i class="bi bi-graph-up-arrow me-2"></i>Monthly Evolution
                </h3>
                <p class="text-muted mb-0">Monthly year-to-date stock balances with deltas vs previous month and year start</p>
            </div>
            <a class="btn btn-outline-secondary" href="/reports">
                <i class="bi bi-arrow-left me-1"></i>Back to Reports
            </a>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <div class="row g-3 align-items-end">
                    <div class="col-12 col-md-4">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-calendar3 me-1"></i>Year
                        </label>
                        <select class="form-select" value="@_selectedYear" @onchange="OnYearChangedAsync" disabled="@_isLoading">
                            @foreach (var year in _yearOptions)
                            {
                                <option value="@year">@year</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <ul class="nav nav-tabs mb-4">
            <li class="nav-item">
                <button type="button"
                        class="nav-link @GetTabClass(MonthlyEvolutionScope.Accounts)"
                        @onclick="() => ChangeScopeAsync(MonthlyEvolutionScope.Accounts)"
                        disabled="@_isLoading">
                    Accounts
                </button>
            </li>
            <li class="nav-item">
                <button type="button"
                        class="nav-link @GetTabClass(MonthlyEvolutionScope.AssetTotal)"
                        @onclick="() => ChangeScopeAsync(MonthlyEvolutionScope.AssetTotal)"
                        disabled="@_isLoading">
                    Asset Total
                </button>
            </li>
            <li class="nav-item">
                <button type="button"
                        class="nav-link @GetTabClass(MonthlyEvolutionScope.AccountGroups)"
                        @onclick="() => ChangeScopeAsync(MonthlyEvolutionScope.AccountGroups)"
                        disabled="@_isLoading">
                    Account Groups
                </button>
            </li>
        </ul>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle me-2"></i>@_error
                <button type="button" class="btn-close" @onclick="@(() => _error = null)"></button>
            </div>
        }

        @if (_isLoading)
        {
            <ReportingChartLoadingState
                Title="Loading annual charts"
                Description="Loading report data..." />
        }
        else if (_report is not null && _report.Series.Count == 0)
        {
            <ReportingChartEmptyState
                Title="Annual charts"
                Description="No evolution data for selected year/scope." />
        }
        else if (_report is not null)
        {
            var (latestEndBalance, latestDeltaPrev, latestDeltaYearStart, usesAssetOnly) = GetLatestSummary();

            <div class="row g-3 mb-4">
                <div class="col-12 col-md-4">
                    <div class="card shadow-sm h-100 border-start border-primary border-4">
                        <div class="card-body">
                            <h6 class="text-muted text-uppercase mb-2" style="font-size: 0.75rem;">@GetLatestEndBalanceLabel(usesAssetOnly)</h6>
                            <h4 class="mb-0 @MoneyFormatter.GetColorClass(latestEndBalance)">
                                @MoneyFormatter.FormatCentsWithSign(latestEndBalance)
                            </h4>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-body">
                            <h6 class="text-muted text-uppercase mb-2" style="font-size: 0.75rem;">@GetLatestDeltaPrevLabel(usesAssetOnly)</h6>
                            <h4 class="mb-0 @MoneyFormatter.GetColorClass(latestDeltaPrev)">
                                @MoneyFormatter.FormatCentsWithSign(latestDeltaPrev)
                            </h4>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-body">
                            <h6 class="text-muted text-uppercase mb-2" style="font-size: 0.75rem;">@GetLatestDeltaYearStartLabel(usesAssetOnly)</h6>
                            <h4 class="mb-0 @MoneyFormatter.GetColorClass(latestDeltaYearStart)">
                                @MoneyFormatter.FormatCentsWithSign(latestDeltaYearStart)
                            </h4>
                        </div>
                    </div>
                </div>
            </div>

            @if (ShouldShowComparabilityDisclaimer(usesAssetOnly))
            {
                <div class="alert alert-info mb-4" role="alert">
                    <i class="bi bi-info-circle me-2"></i>
                    @GetComparabilityDisclaimerText(usesAssetOnly)
                </div>
            }

            var charts = BuildAnnualChartsViewModel();

            @if (!string.IsNullOrWhiteSpace(charts.Error))
            {
                <ReportingChartErrorState Message="@charts.Error" />
            }
            else
            {
                @if (_activeScope == MonthlyEvolutionScope.AssetTotal)
                {
                    <AnnualLineChart
                        Title="Asset Total Evolution"
                        Subtitle="Final balance by month (current month uses latest available data)."
                        Year="@_selectedYear"
                        Series="@charts.AssetEndBalanceEvolution"
                        TestId="annual-core-evolution-chart" />
                }
                else if (_activeScope == MonthlyEvolutionScope.Accounts)
                {
                    var selectableSeries = GetSelectableAccountSeries();

                    <div class="card shadow-sm mb-3">
                        <div class="card-body">
                            <div class="row g-3 align-items-end">
                                <div class="col-12 col-lg-6">
                                    <label class="form-label fw-semibold mb-1">Account Line Selection</label>
                                    <select class="form-select form-select-sm account-line-selector"
                                            value="@_selectedAccountSeriesKeyForChart"
                                            @onchange="OnAccountSeriesSelectionChanged">
                                        <option value="">All accounts</option>
                                        @foreach (var series in selectableSeries)
                                        {
                                            <option value="@series.SeriesKey">@series.DisplayName</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>

                    <AnnualLineChart
                        Title="Accounts Monthly Evolution"
                        Subtitle="Monthly end-balance evolution by account. Use the selector to focus one account."
                        Year="@_selectedYear"
                        Series="@charts.AccountEvolution"
                        TestId="annual-accounts-evolution-chart" />

                    <div class="row g-3 mb-4">
                        <div class="col-12 col-xl-6">
                            <AnnualCompositionChart
                                Title="Expense Composition"
                                Subtitle="Share of annual absolute balances for expense-nature accounts."
                                Year="@_selectedYear"
                                Slices="@charts.ExpenseComposition"
                                TestId="annual-expense-composition-chart" />
                        </div>
                        <div class="col-12 col-xl-6">
                            <AnnualCompositionChart
                                Title="Income Composition"
                                Subtitle="Share of annual absolute balances for income-nature accounts."
                                Year="@_selectedYear"
                                Slices="@charts.IncomeComposition"
                                TestId="annual-income-composition-chart" />
                        </div>
                    </div>
                }
                else if (_activeScope == MonthlyEvolutionScope.AccountGroups)
                {
                    <AnnualLineChart
                        Title="Account Groups Monthly Evolution"
                        Subtitle="Monthly end-balance evolution by account group (liability accounts excluded)."
                        Year="@_selectedYear"
                        Series="@charts.AccountGroupEvolution"
                        TestId="annual-account-group-evolution-chart" />
                }
            }

            @if (_activeScope == MonthlyEvolutionScope.AssetTotal)
            {
                var series = _report.Series.First();

                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-transparent">
                        <h5 class="mb-0">
                            <i class="bi bi-cash-coin me-2"></i>@series.DisplayName
                        </h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="border-0 ps-3">Month</th>
                                        <th class="border-0 text-end">End Balance</th>
                                        <th class="border-0 text-end">Delta Prev Month</th>
                                        <th class="border-0 text-end pe-3">Delta Year Start</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var point in series.Points.OrderBy(p => p.Month))
                                    {
                                        <tr class="series-summary-row">
                                            <td class="ps-3">@DateHelper.GetMonthName(point.Month)</td>
                                            <td class="text-end @MoneyFormatter.GetColorClass(point.EndBalanceCents)">
                                                @MoneyFormatter.FormatCentsWithSign(point.EndBalanceCents)
                                            </td>
                                            <td class="text-end @MoneyFormatter.GetColorClass(point.DeltaVsPreviousMonthCents)">
                                                @MoneyFormatter.FormatCentsWithSign(point.DeltaVsPreviousMonthCents)
                                            </td>
                                            <td class="text-end pe-3 @MoneyFormatter.GetColorClass(point.DeltaVsYearStartCents)">
                                                @MoneyFormatter.FormatCentsWithSign(point.DeltaVsYearStartCents)
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
            else
            {
                var availableMonths = GetAvailableMonths();

                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-transparent">
                        <div class="d-flex flex-column flex-md-row gap-3 justify-content-between align-items-md-end">
                            <div>
                                <h5 class="mb-1">
                                    <i class="bi bi-table me-2"></i>@GetScopeTitle()
                                </h5>
                                <p class="text-muted mb-0">@GetScopeDescription()</p>
                            </div>
                            @if (availableMonths.Count > 0 && _focusedMonth is not null)
                            {
                                <div class="d-flex align-items-end gap-2">
                                    <div>
                                        <label class="form-label fw-semibold mb-1">Focused Month</label>
                                        <select class="form-select form-select-sm month-focus-select"
                                                value="@_focusedMonth"
                                                @onchange="OnFocusedMonthChanged">
                                            @foreach (var month in availableMonths)
                                            {
                                                <option value="@month">@DateHelper.GetMonthName(month)</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                @if (_activeScope == MonthlyEvolutionScope.Accounts)
                {
                    var groupedSeries = GetAccountSeriesGroups();

                    @foreach (var natureGroup in groupedSeries)
                    {
                        <div class="card shadow-sm mb-4 account-nature-group">
                            <div class="card-header bg-transparent">
                                <div class="d-flex justify-content-between align-items-center">
                                    <h6 class="mb-0 account-nature-title">
                                        <i class="bi @GetNatureIcon(natureGroup.Nature) me-2"></i>@GetNatureLabel(natureGroup.Nature)
                                    </h6>
                                    <span class="badge text-bg-secondary">@natureGroup.Series.Count series</span>
                                </div>
                            </div>
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th class="border-0 ps-3">Series Name</th>
                                                <th class="border-0">Month</th>
                                                <th class="border-0 text-end">End Balance</th>
                                                <th class="border-0 text-end">Delta Prev Month</th>
                                                <th class="border-0 text-end">Delta Year Start</th>
                                                <th class="border-0 text-end pe-3">Details</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var series in natureGroup.Series)
                                            {
                                                var point = GetFocusedPoint(series);
                                                var isExpanded = _expandedSeriesKey == series.SeriesKey;

                                                <tr class="series-summary-row">
                                                    <td class="ps-3 fw-semibold">@series.DisplayName</td>
                                                    <td>@DateHelper.GetMonthName(point.Month)</td>
                                                    <td class="text-end @MoneyFormatter.GetColorClass(point.EndBalanceCents)">
                                                        @MoneyFormatter.FormatCentsWithSign(point.EndBalanceCents)
                                                    </td>
                                                    <td class="text-end @MoneyFormatter.GetColorClass(point.DeltaVsPreviousMonthCents)">
                                                        @MoneyFormatter.FormatCentsWithSign(point.DeltaVsPreviousMonthCents)
                                                    </td>
                                                    <td class="text-end @MoneyFormatter.GetColorClass(point.DeltaVsYearStartCents)">
                                                        @MoneyFormatter.FormatCentsWithSign(point.DeltaVsYearStartCents)
                                                    </td>
                                                    <td class="text-end pe-3">
                                                        <button type="button"
                                                                class="btn btn-sm btn-outline-secondary"
                                                                @onclick="() => ToggleSeriesDetails(series.SeriesKey)">
                                                            @(isExpanded ? "Hide months" : "View months")
                                                        </button>
                                                    </td>
                                                </tr>

                                                if (isExpanded)
                                                {
                                                    <tr class="series-detail-row">
                                                        <td colspan="6" class="bg-body-tertiary px-3 py-3">
                                                            <div class="table-responsive">
                                                                <table class="table table-sm mb-0">
                                                                    <thead>
                                                                        <tr>
                                                                            <th>Month</th>
                                                                            <th class="text-end">End Balance</th>
                                                                            <th class="text-end">Delta Prev Month</th>
                                                                            <th class="text-end">Delta Year Start</th>
                                                                        </tr>
                                                                    </thead>
                                                                    <tbody>
                                                                        @foreach (var monthPoint in series.Points.OrderBy(p => p.Month))
                                                                        {
                                                                            <tr>
                                                                                <td>@DateHelper.GetMonthName(monthPoint.Month)</td>
                                                                                <td class="text-end @MoneyFormatter.GetColorClass(monthPoint.EndBalanceCents)">
                                                                                    @MoneyFormatter.FormatCentsWithSign(monthPoint.EndBalanceCents)
                                                                                </td>
                                                                                <td class="text-end @MoneyFormatter.GetColorClass(monthPoint.DeltaVsPreviousMonthCents)">
                                                                                    @MoneyFormatter.FormatCentsWithSign(monthPoint.DeltaVsPreviousMonthCents)
                                                                                </td>
                                                                                <td class="text-end @MoneyFormatter.GetColorClass(monthPoint.DeltaVsYearStartCents)">
                                                                                    @MoneyFormatter.FormatCentsWithSign(monthPoint.DeltaVsYearStartCents)
                                                                                </td>
                                                                            </tr>
                                                                        }
                                                                    </tbody>
                                                                </table>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="card shadow-sm mb-4">
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="border-0 ps-3">Series Name</th>
                                            <th class="border-0">Month</th>
                                            <th class="border-0 text-end">End Balance</th>
                                            <th class="border-0 text-end">Delta Prev Month</th>
                                            <th class="border-0 text-end">Delta Year Start</th>
                                            <th class="border-0 text-end pe-3">Details</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var series in _report.Series.OrderBy(s => s.DisplayName).ThenBy(s => s.SeriesKey))
                                        {
                                            var point = GetFocusedPoint(series);
                                            var isExpanded = _expandedSeriesKey == series.SeriesKey;

                                            <tr class="series-summary-row">
                                                <td class="ps-3 fw-semibold">@series.DisplayName</td>
                                                <td>@DateHelper.GetMonthName(point.Month)</td>
                                                <td class="text-end @MoneyFormatter.GetColorClass(point.EndBalanceCents)">
                                                    @MoneyFormatter.FormatCentsWithSign(point.EndBalanceCents)
                                                </td>
                                                <td class="text-end @MoneyFormatter.GetColorClass(point.DeltaVsPreviousMonthCents)">
                                                    @MoneyFormatter.FormatCentsWithSign(point.DeltaVsPreviousMonthCents)
                                                </td>
                                                <td class="text-end @MoneyFormatter.GetColorClass(point.DeltaVsYearStartCents)">
                                                    @MoneyFormatter.FormatCentsWithSign(point.DeltaVsYearStartCents)
                                                </td>
                                                <td class="text-end pe-3">
                                                    <button type="button"
                                                            class="btn btn-sm btn-outline-secondary"
                                                            @onclick="() => ToggleSeriesDetails(series.SeriesKey)">
                                                        @(isExpanded ? "Hide months" : "View months")
                                                    </button>
                                                </td>
                                            </tr>

                                            if (isExpanded)
                                            {
                                                <tr class="series-detail-row">
                                                    <td colspan="6" class="bg-body-tertiary px-3 py-3">
                                                        <div class="table-responsive">
                                                            <table class="table table-sm mb-0">
                                                                <thead>
                                                                    <tr>
                                                                        <th>Month</th>
                                                                        <th class="text-end">End Balance</th>
                                                                        <th class="text-end">Delta Prev Month</th>
                                                                        <th class="text-end">Delta Year Start</th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    @foreach (var monthPoint in series.Points.OrderBy(p => p.Month))
                                                                    {
                                                                        <tr>
                                                                            <td>@DateHelper.GetMonthName(monthPoint.Month)</td>
                                                                            <td class="text-end @MoneyFormatter.GetColorClass(monthPoint.EndBalanceCents)">
                                                                                @MoneyFormatter.FormatCentsWithSign(monthPoint.EndBalanceCents)
                                                                            </td>
                                                                            <td class="text-end @MoneyFormatter.GetColorClass(monthPoint.DeltaVsPreviousMonthCents)">
                                                                                @MoneyFormatter.FormatCentsWithSign(monthPoint.DeltaVsPreviousMonthCents)
                                                                            </td>
                                                                            <td class="text-end @MoneyFormatter.GetColorClass(monthPoint.DeltaVsYearStartCents)">
                                                                                @MoneyFormatter.FormatCentsWithSign(monthPoint.DeltaVsYearStartCents)
                                                                            </td>
                                                                        </tr>
                                                                    }
                                                                </tbody>
                                                            </table>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    @if (_activeScope == MonthlyEvolutionScope.AccountGroups)
                    {
                        <AnnualCompositionChart
                            Title="Expense Groups Composition"
                            Subtitle="Percentage split of expense-oriented groups (quesitos)."
                            Year="@_selectedYear"
                            Slices="@charts.AccountGroupExpenseComposition"
                            TestId="annual-account-group-expense-composition-chart" />
                    }
                }
            }

        }
        else
        {
            <div class="card shadow-sm">
                <div class="card-body text-center py-5">
                    <i class="bi bi-graph-up display-4 text-muted mb-3"></i>
                    <h5 class="text-muted">Select year and scope to load monthly evolution.</h5>
                </div>
            </div>
        }
    </Authorized>
    <NotAuthorized>
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle me-2"></i>
            Please log in to view reports.
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private MonthlyEvolutionReportDto? _report;
    private string? _error;
    private bool _isLoading;

    private int _selectedYear = DateHelper.GetCurrentYear();
    private MonthlyEvolutionScope _activeScope = MonthlyEvolutionScope.AssetTotal;
    private IReadOnlyList<int> _yearOptions = Array.Empty<int>();
    private IReadOnlyDictionary<Guid, AccountNature> _accountNatureById = new Dictionary<Guid, AccountNature>();
    private IReadOnlyDictionary<Guid, IReadOnlySet<AccountNature>> _accountGroupNaturesById =
        new Dictionary<Guid, IReadOnlySet<AccountNature>>();
    private int? _focusedMonth;
    private string? _expandedSeriesKey;
    private string? _selectedAccountSeriesKeyForChart;
    private static readonly AccountNature[] _natureOrder =
    {
        AccountNature.Asset,
        AccountNature.Liability,
        AccountNature.Expense,
        AccountNature.Income,
        AccountNature.Equity
    };
    private static readonly ReportingMetricDefinition _assetBalanceMetric =
        ReportingMetricSemantics.ResolveMetric("monthly-evolution-latest-asset-end-balance");
    private static readonly ReportingMetricDefinition _deltaPrevMetric =
        ReportingMetricSemantics.ResolveMetric("monthly-evolution-latest-asset-delta-prev-month");
    private static readonly ReportingMetricDefinition _deltaYearStartMetric =
        ReportingMetricSemantics.ResolveMetric("monthly-evolution-latest-asset-delta-year-start");
    private static readonly ReportingMetricDefinition _periodNetResultMetric =
        ReportingMetricSemantics.ResolveMetric("monthly-summary-period-net-result");

    protected override async Task OnInitializedAsync()
    {
        _yearOptions = Enumerable
            .Range(2000, DateHelper.GetCurrentYear() - 2000 + 1)
            .OrderByDescending(x => x)
            .ToList();

        await LoadReportAsync();
    }

    private async Task OnYearChangedAsync(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var year))
            return;

        _selectedYear = year;
        await LoadReportAsync();
    }

    private async Task ChangeScopeAsync(MonthlyEvolutionScope scope)
    {
        if (_activeScope == scope)
            return;

        _activeScope = scope;
        _expandedSeriesKey = null;
        _selectedAccountSeriesKeyForChart = null;
        await LoadReportAsync();
    }

    private Task OnFocusedMonthChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var month))
            _focusedMonth = month;

        _expandedSeriesKey = null;
        return Task.CompletedTask;
    }

    private Task OnAccountSeriesSelectionChanged(ChangeEventArgs e)
    {
        var selected = e.Value?.ToString();
        _selectedAccountSeriesKeyForChart = string.IsNullOrWhiteSpace(selected) ? null : selected;
        return Task.CompletedTask;
    }

    private async Task LoadReportAsync()
    {
        _isLoading = true;
        _error = null;
        _report = null;
        StateHasChanged();

        try
        {
            _report = await ReportsApi.GetMonthlyEvolutionAsync(_selectedYear, _activeScope);
            if (_activeScope == MonthlyEvolutionScope.Accounts)
            {
                await LoadAccountNatureLookupBestEffortAsync();
                _accountGroupNaturesById = new Dictionary<Guid, IReadOnlySet<AccountNature>>();
            }
            else if (_activeScope == MonthlyEvolutionScope.AccountGroups)
            {
                _accountNatureById = new Dictionary<Guid, AccountNature>();
                await LoadAccountGroupNatureLookupBestEffortAsync();
            }
            else
            {
                _accountNatureById = new Dictionary<Guid, AccountNature>();
                _accountGroupNaturesById = new Dictionary<Guid, IReadOnlySet<AccountNature>>();
            }

            SyncFocusedMonth();
            SyncSelectedAccountSeries();
            _expandedSeriesKey = null;
        }
        catch (UnauthorizedAccessException)
        {
            _error = "You are not authorized to view this report. Please log in again.";
        }
        catch (Exception ex)
        {
            _error = $"Failed to load report: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private string GetTabClass(MonthlyEvolutionScope tabScope)
    {
        return _activeScope == tabScope ? "active" : string.Empty;
    }

    private string GetScopeTitle()
    {
        return _activeScope switch
        {
            MonthlyEvolutionScope.Accounts => "Accounts Evolution",
            MonthlyEvolutionScope.AccountGroups => "Account Group Evolution",
            _ => "Monthly Evolution"
        };
    }

    private string GetScopeDescription()
    {
        return _activeScope switch
        {
            MonthlyEvolutionScope.Accounts => "One row per account grouped by nature. Expand only the series you need.",
            _ => "One row per series. Expand only the series you need."
        };
    }

    private AnnualChartsViewModel BuildAnnualChartsViewModel()
    {
        if (_report is null || _report.Series.Count == 0)
            return AnnualChartsViewModel.Empty;

        try
        {
            var assetEndBalanceEvolution = _activeScope == MonthlyEvolutionScope.AssetTotal
                ? AnnualChartDatasetAdapter.BuildEndBalanceSeries(_report, key: "end-balance", label: "End Balance")
                : Array.Empty<AnnualChartSeries>();

            var selectedAccountKeys = _activeScope == MonthlyEvolutionScope.Accounts &&
                                      !string.IsNullOrWhiteSpace(_selectedAccountSeriesKeyForChart)
                ? new HashSet<string>(StringComparer.Ordinal) { _selectedAccountSeriesKeyForChart }
                : null;

            var accountEvolution = _activeScope == MonthlyEvolutionScope.Accounts
                ? AnnualChartDatasetAdapter.BuildSeriesEvolution(
                    _report,
                    maxSeries: selectedAccountKeys is null ? 12 : 1,
                    includedSeriesKeys: selectedAccountKeys)
                : Array.Empty<AnnualChartSeries>();

            var accountGroupEvolution = _activeScope == MonthlyEvolutionScope.AccountGroups
                ? AnnualChartDatasetAdapter.BuildSeriesEvolution(_report, maxSeries: 12)
                : Array.Empty<AnnualChartSeries>();

            var expenseComposition = _activeScope == MonthlyEvolutionScope.Accounts
                ? AnnualChartDatasetAdapter.BuildCompositionByNature(_report, _accountNatureById, AccountNature.Expense)
                : Array.Empty<AnnualCompositionSlice>();

            var incomeComposition = _activeScope == MonthlyEvolutionScope.Accounts
                ? AnnualChartDatasetAdapter.BuildCompositionByNature(_report, _accountNatureById, AccountNature.Income)
                : Array.Empty<AnnualCompositionSlice>();

            var accountGroupExpenseComposition = _activeScope == MonthlyEvolutionScope.AccountGroups
                ? AnnualChartDatasetAdapter.BuildCompositionFromSeries(_report, IsExpenseOrientedGroup)
                : Array.Empty<AnnualCompositionSlice>();

            return new AnnualChartsViewModel(
                AssetEndBalanceEvolution: assetEndBalanceEvolution,
                AccountEvolution: accountEvolution,
                AccountGroupEvolution: accountGroupEvolution,
                ExpenseComposition: expenseComposition,
                IncomeComposition: incomeComposition,
                AccountGroupExpenseComposition: accountGroupExpenseComposition,
                Error: null);
        }
        catch (Exception ex)
        {
            return new AnnualChartsViewModel(
                AssetEndBalanceEvolution: Array.Empty<AnnualChartSeries>(),
                AccountEvolution: Array.Empty<AnnualChartSeries>(),
                AccountGroupEvolution: Array.Empty<AnnualChartSeries>(),
                ExpenseComposition: Array.Empty<AnnualCompositionSlice>(),
                IncomeComposition: Array.Empty<AnnualCompositionSlice>(),
                AccountGroupExpenseComposition: Array.Empty<AnnualCompositionSlice>(),
                Error: $"Failed to build annual chart datasets: {ex.Message}");
        }
    }

    private bool IsExpenseOrientedGroup(MonthlyEvolutionSeriesDto series)
    {
        if (series.EntityId is null)
            return false;

        if (!_accountGroupNaturesById.TryGetValue(series.EntityId.Value, out var natures))
            return true;

        return natures.Contains(AccountNature.Expense);
    }

