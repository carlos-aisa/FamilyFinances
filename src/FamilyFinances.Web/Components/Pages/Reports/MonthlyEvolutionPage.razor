@page "/reports/monthly-evolution"
@rendermode InteractiveServer
@using FamilyFinances.Application.Ledger.Accounts.Dtos
@using FamilyFinances.Application.Reporting.Dtos
@using FamilyFinances.Application.Reporting.Semantics
@using FamilyFinances.Domain.Ledger.Accounts
@using FamilyFinances.Web.Api
@using FamilyFinances.Web.Components.Base
@using FamilyFinances.Web.Components.Pages.Reports.Charts
@using FamilyFinances.Web.Features.Reports
@using FamilyFinances.Web.Features.Reports.Charts
@using Microsoft.AspNetCore.Components.Authorization
@inherits ApiPageBase

@inject ReportsApi ReportsApi
@inject IAccountsApi AccountsApi
@inject AccountGroupsApi AccountGroupsApi

<AuthorizeView>
    <Authorized>
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <h3 class="mb-1">
                    <i class="bi bi-graph-up-arrow me-2"></i>Monthly Evolution
                </h3>
                <p class="text-muted mb-0">Monthly year-to-date stock balances with deltas vs previous month and year start</p>
            </div>
            <a class="btn btn-outline-secondary" href="/reports">
                <i class="bi bi-arrow-left me-1"></i>Back to Reports
            </a>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <div class="row g-3 align-items-end">
                    <div class="col-12 col-md-4">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-calendar3 me-1"></i>Year
                        </label>
                        <select class="form-select" value="@_selectedYear" @onchange="OnYearChangedAsync" disabled="@_isLoading">
                            @foreach (var year in _yearOptions)
                            {
                                <option value="@year">@year</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <ul class="nav nav-tabs mb-4">
            <li class="nav-item">
                <button type="button"
                        class="nav-link @GetTabClass(MonthlyEvolutionScope.Accounts)"
                        @onclick="() => ChangeScopeAsync(MonthlyEvolutionScope.Accounts)"
                        disabled="@_isLoading">
                    Accounts
                </button>
            </li>
            <li class="nav-item">
                <button type="button"
                        class="nav-link @GetTabClass(MonthlyEvolutionScope.AssetTotal)"
                        @onclick="() => ChangeScopeAsync(MonthlyEvolutionScope.AssetTotal)"
                        disabled="@_isLoading">
                    Asset Total
                </button>
            </li>
            <li class="nav-item">
                <button type="button"
                        class="nav-link @GetTabClass(MonthlyEvolutionScope.AccountGroups)"
                        @onclick="() => ChangeScopeAsync(MonthlyEvolutionScope.AccountGroups)"
                        disabled="@_isLoading">
                    Account Groups
                </button>
            </li>
        </ul>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle me-2"></i>@_error
                <button type="button" class="btn-close" @onclick="@(() => _error = null)"></button>
            </div>
        }

        @if (_isLoading)
        {
            <ReportingChartLoadingState
                Title="Loading annual charts"
                Description="Loading report data..." />
        }
        else if (_report is not null && _report.Series.Count == 0)
        {
            <ReportingChartEmptyState
                Title="Annual charts"
                Description="No evolution data for selected year/scope." />
        }
        else if (_report is not null)
        {
            var (latestEndBalance, latestDeltaPrev, latestDeltaYearStart, usesAssetOnly) = GetLatestSummary();

            <div class="row g-3 mb-4">
                <div class="col-12 col-md-4">
                    <div class="card shadow-sm h-100 border-start border-primary border-4">
                        <div class="card-body">
                            <h6 class="text-muted text-uppercase mb-2" style="font-size: 0.75rem;">@GetLatestEndBalanceLabel(usesAssetOnly)</h6>
                            <h4 class="mb-0 @MoneyFormatter.GetColorClass(latestEndBalance)">
                                @MoneyFormatter.FormatCentsWithSign(latestEndBalance)
                            </h4>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-body">
                            <h6 class="text-muted text-uppercase mb-2" style="font-size: 0.75rem;">@GetLatestDeltaPrevLabel(usesAssetOnly)</h6>
                            <h4 class="mb-0 @MoneyFormatter.GetColorClass(latestDeltaPrev)">
                                @MoneyFormatter.FormatCentsWithSign(latestDeltaPrev)
                            </h4>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-body">
                            <h6 class="text-muted text-uppercase mb-2" style="font-size: 0.75rem;">@GetLatestDeltaYearStartLabel(usesAssetOnly)</h6>
                            <h4 class="mb-0 @MoneyFormatter.GetColorClass(latestDeltaYearStart)">
                                @MoneyFormatter.FormatCentsWithSign(latestDeltaYearStart)
                            </h4>
                        </div>
                    </div>
                </div>
            </div>

            @if (ShouldShowComparabilityDisclaimer(usesAssetOnly))
            {
                <div class="alert alert-info mb-4" role="alert">
                    <i class="bi bi-info-circle me-2"></i>
                    @GetComparabilityDisclaimerText(usesAssetOnly)
                </div>
            }

            var charts = BuildAnnualChartsViewModel();

            @if (_activeScope == MonthlyEvolutionScope.AssetTotal)
            {
                var series = _report.Series.First();
                var dataUntilMonth = GetDataUntilMonthForSelectedYear();

                <div class="row g-3 mb-4 asset-total-overview-grid">
                    <div class="col-12 col-xxl-8">
                        <div class="card shadow-sm h-100">
                            <div class="card-header bg-transparent">
                                <div class="d-flex justify-content-between align-items-center gap-3">
                                    <h5 class="mb-0">
                                        <i class="bi bi-list-ul me-2"></i>Asset Total (Monthly Overview)
                                    </h5>
                                    @if (dataUntilMonth is not null)
                                    {
                                        <span class="badge text-bg-secondary">
                                            Current month: @DateHelper.GetMonthName(dataUntilMonth.Value)
                                        </span>
                                    }
                                </div>
                            </div>
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-sm table-hover align-middle mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th class="border-0 ps-3">Month</th>
                                                <th class="border-0 text-end">End Balance</th>
                                                <th class="border-0 text-end">Delta Prev Month</th>
                                                <th class="border-0 text-end pe-3">Delta Year Start</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var point in series.Points.OrderBy(p => p.Month))
                                            {
                                                var hasData = dataUntilMonth is null || point.Month <= dataUntilMonth.Value;
                                                var isCurrentMonth = dataUntilMonth is not null && point.Month == dataUntilMonth.Value;

                                                <tr class="series-summary-row @(isCurrentMonth ? "table-active" : string.Empty)">
                                                    <td class="ps-3">
                                                        @DateHelper.GetMonthName(point.Month)
                                                        @if (isCurrentMonth)
                                                        {
                                                            <span class="badge rounded-pill text-bg-primary ms-2">Current</span>
                                                        }
                                                    </td>
                                                    <td class="text-end @MoneyFormatter.GetColorClass(point.EndBalanceCents)">
                                                        @(hasData ? MoneyFormatter.FormatCentsWithSign(point.EndBalanceCents) : "-")
                                                    </td>
                                                    <td class="text-end @MoneyFormatter.GetColorClass(point.DeltaVsPreviousMonthCents)">
                                                        @(hasData ? MoneyFormatter.FormatCentsWithSign(point.DeltaVsPreviousMonthCents) : "-")
                                                    </td>
                                                    <td class="text-end pe-3 @MoneyFormatter.GetColorClass(point.DeltaVsYearStartCents)">
                                                        @(hasData ? MoneyFormatter.FormatCentsWithSign(point.DeltaVsYearStartCents) : "-")
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-xxl-4 asset-total-chart-panel">
                        @if (!string.IsNullOrWhiteSpace(charts.Error))
                        {
                            <ReportingChartErrorState Message="@charts.Error" />
                        }
                        else if (charts.AssetEndBalanceEvolution.Count == 0)
                        {
                            <ReportingChartEmptyState
                                Title="Asset Total Evolution"
                                Description="No chart points are available for the selected filters." />
                        }
                        else
                        {
                            <AnnualLineChart
                                Title="Asset Total Evolution"
                                Subtitle="Final balance by month (current month uses latest available data)."
                                Year="@_selectedYear"
                                Series="@charts.AssetEndBalanceEvolution"
                                DataUntilMonth="@dataUntilMonth"
                                TestId="annual-core-evolution-chart" />
                        }
                    </div>
                </div>
            }
            else
            {
                @if (_activeScope == MonthlyEvolutionScope.Accounts)
                {
                    var dataUntilMonth = GetDataUntilMonthForSelectedYear();
                    var summaryMonth = GetReferenceMonthForSelectedYear();
                    var groupedSeries = GetAccountSeriesGroups();
                    var selectableSeries = GetSelectableAccountSeries();
                    var compositionMonthOptions = GetAvailableMonthsForFocusedSelection();
                    var compositionMonth = GetFocusedCompositionMonth();
                    var compositionMonthLabel = compositionMonth is not null
                        ? DateHelper.GetMonthName(compositionMonth.Value)
                        : "N/A";
                    var natureIndex = 0;

                    <div class="row g-3 mb-4 accounts-overview-grid">
                        <div class="col-12 col-xxl-8">
                            <div class="card shadow-sm h-100">
                                <div class="card-header bg-transparent">
                                    <div>
                                        <h5 class="mb-1">
                                            <i class="bi bi-table me-2"></i>Accounts Overview
                                        </h5>
                                        <p class="text-muted mb-0">Current month summary grouped by nature. Expand only the accounts you need.</p>
                                    </div>
                                </div>
                                <div class="card-body p-0">
                                    <div class="accordion accordion-flush" id="accountsNatureAccordion">
                                        @foreach (var natureGroup in groupedSeries)
                                        {
                                            var groupId = $"accounts-nature-{natureIndex}";
                                            var headingId = $"{groupId}-heading";
                                            var collapseId = $"{groupId}-collapse";
                                            var isFirstGroup = natureIndex == 0;
                                            natureIndex++;

                                            <div class="accordion-item account-nature-group">
                                                <h2 class="accordion-header" id="@headingId">
                                                    <button class="accordion-button @(isFirstGroup ? string.Empty : "collapsed")"
                                                            type="button"
                                                            data-bs-toggle="collapse"
                                                            data-bs-target="#@collapseId"
                                                            aria-expanded="@isFirstGroup"
                                                            aria-controls="@collapseId">
                                                        <span class="account-nature-title">
                                                            <i class="bi @GetNatureIcon(natureGroup.Nature) me-2"></i>@GetNatureLabel(natureGroup.Nature)
                                                        </span>
                                                        <span class="badge text-bg-secondary ms-2">@natureGroup.Series.Count series</span>
                                                    </button>
                                                </h2>
                                                <div id="@collapseId"
                                                     class="accordion-collapse collapse @(isFirstGroup ? "show" : string.Empty)"
                                                     aria-labelledby="@headingId"
                                                     data-bs-parent="#accountsNatureAccordion">
                                                    <div class="accordion-body p-0">
                                                        <div class="table-responsive">
                                                            <table class="table table-sm table-hover align-middle mb-0">
                                                                <thead class="table-light">
                                                                    <tr>
                                                                        <th class="border-0 ps-3">Series Name</th>
                                                                        <th class="border-0 text-end">End Balance</th>
                                                                        <th class="border-0 text-end">Delta Prev Month</th>
                                                                        <th class="border-0 text-end">Delta Year Start</th>
                                                                        <th class="border-0 text-end pe-3">Details</th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    @foreach (var series in natureGroup.Series)
                                                                    {
                                                                        var point = summaryMonth is not null
                                                                            ? GetPointAtOrBeforeMonth(series, summaryMonth.Value)
                                                                            : null;
                                                                        var isExpanded = _expandedSeriesKey == series.SeriesKey;

                                                                        <tr class="series-summary-row">
                                                                            <td class="ps-3 fw-semibold">@series.DisplayName</td>
                                                                            <td class="text-end @GetValueColorClass(point?.EndBalanceCents ?? 0, point is not null)">
                                                                                @(point is not null ? MoneyFormatter.FormatCentsWithSign(point.EndBalanceCents) : "-")
                                                                            </td>
                                                                            <td class="text-end @GetValueColorClass(point?.DeltaVsPreviousMonthCents ?? 0, point is not null)">
                                                                                @(point is not null ? MoneyFormatter.FormatCentsWithSign(point.DeltaVsPreviousMonthCents) : "-")
                                                                            </td>
                                                                            <td class="text-end @GetValueColorClass(point?.DeltaVsYearStartCents ?? 0, point is not null)">
                                                                                @(point is not null ? MoneyFormatter.FormatCentsWithSign(point.DeltaVsYearStartCents) : "-")
                                                                            </td>
                                                                            <td class="text-end pe-3">
                                                                                <button type="button"
                                                                                        class="btn btn-sm btn-outline-secondary"
                                                                                        @onclick="() => ToggleSeriesDetails(series.SeriesKey)">
                                                                                    @(isExpanded ? "Hide months" : "View months")
                                                                                </button>
                                                                            </td>
                                                                        </tr>

                                                                        if (isExpanded)
                                                                        {
                                                                            <tr class="series-detail-row">
                                                                                <td colspan="5" class="bg-body-tertiary px-3 py-3">
                                                                                    <div class="table-responsive">
                                                                                        <table class="table table-sm mb-0">
                                                                                            <thead>
                                                                                                <tr>
                                                                                                    <th>Month</th>
                                                                                                    <th class="text-end">End Balance</th>
                                                                                                    <th class="text-end">Delta Prev Month</th>
                                                                                                    <th class="text-end">Delta Year Start</th>
                                                                                                </tr>
                                                                                            </thead>
                                                                                            <tbody>
                                                                                                @foreach (var monthPoint in GetSeriesPointsForDetails(series, dataUntilMonth))
                                                                                                {
                                                                                                    <tr>
                                                                                                        <td>@DateHelper.GetMonthName(monthPoint.Month)</td>
                                                                                                        <td class="text-end @MoneyFormatter.GetColorClass(monthPoint.EndBalanceCents)">
                                                                                                            @MoneyFormatter.FormatCentsWithSign(monthPoint.EndBalanceCents)
                                                                                                        </td>
                                                                                                        <td class="text-end @MoneyFormatter.GetColorClass(monthPoint.DeltaVsPreviousMonthCents)">
                                                                                                            @MoneyFormatter.FormatCentsWithSign(monthPoint.DeltaVsPreviousMonthCents)
                                                                                                        </td>
                                                                                                        <td class="text-end @MoneyFormatter.GetColorClass(monthPoint.DeltaVsYearStartCents)">
                                                                                                            @MoneyFormatter.FormatCentsWithSign(monthPoint.DeltaVsYearStartCents)
                                                                                                        </td>
                                                                                                    </tr>
                                                                                                }
                                                                                            </tbody>
                                                                                        </table>
                                                                                    </div>
                                                                                </td>
                                                                            </tr>
                                                                        }
                                                                    }
                                                                </tbody>
                                                            </table>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-xxl-4 accounts-chart-panel">
                            <div class="d-flex justify-content-end mb-2">
                                <div class="btn-group btn-group-sm" role="group" aria-label="Accounts chart mode">
                                    <button type="button"
                                            class="btn @GetAccountsChartModeButtonClass(AccountsChartMode.Evolution)"
                                            @onclick="() => SetAccountsChartMode(AccountsChartMode.Evolution)">
                                        Evolution
                                    </button>
                                    <button type="button"
                                            class="btn @GetAccountsChartModeButtonClass(AccountsChartMode.Composition)"
                                            @onclick="() => SetAccountsChartMode(AccountsChartMode.Composition)">
                                        Composition
                                    </button>
                                </div>
                            </div>

                            @if (_accountsChartMode == AccountsChartMode.Evolution)
                            {
                                <div class="mb-2">
                                    <label class="form-label fw-semibold mb-1">Account</label>
                                    <select class="form-select form-select-sm account-line-selector"
                                            value="@_selectedAccountSeriesKeyForChart"
                                            @onchange="OnAccountSeriesSelectionChanged">
                                        <option value="">Top accounts</option>
                                        @foreach (var series in selectableSeries)
                                        {
                                            <option value="@series.SeriesKey">@series.DisplayName</option>
                                        }
                                    </select>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(charts.Error))
                                {
                                    <ReportingChartErrorState Message="@charts.Error" />
                                }
                                else
                                {
                                    <AnnualLineChart
                                        Title="Accounts Monthly Evolution"
                                        Subtitle="Monthly end-balance evolution by account."
                                        Year="@_selectedYear"
                                        Series="@charts.AccountEvolution"
                                        DataUntilMonth="@dataUntilMonth"
                                        TestId="annual-accounts-evolution-chart" />
                                }
                            }
                            else
                            {
                                <div class="d-flex justify-content-between align-items-end gap-2 mb-2">
                                    <div class="btn-group btn-group-sm" role="group" aria-label="Accounts composition nature">
                                        <button type="button"
                                                class="btn @GetAccountsCompositionButtonClass(AccountNature.Expense)"
                                                @onclick="() => SetAccountsCompositionNature(AccountNature.Expense)">
                                            Expense
                                        </button>
                                        <button type="button"
                                                class="btn @GetAccountsCompositionButtonClass(AccountNature.Income)"
                                                @onclick="() => SetAccountsCompositionNature(AccountNature.Income)">
                                            Income
                                        </button>
                                    </div>

                                    @if (compositionMonthOptions.Count > 0 && _focusedMonth is not null)
                                    {
                                        <div>
                                            <label class="form-label fw-semibold mb-1">Focused Month</label>
                                            <select class="form-select form-select-sm month-focus-select"
                                                    value="@_focusedMonth"
                                                    @onchange="OnFocusedMonthChanged">
                                                @foreach (var month in compositionMonthOptions)
                                                {
                                                    <option value="@month">@DateHelper.GetMonthName(month)</option>
                                                }
                                            </select>
                                        </div>
                                    }
                                </div>

                                @if (!string.IsNullOrWhiteSpace(charts.Error))
                                {
                                    <ReportingChartErrorState Message="@charts.Error" />
                                }
                                else
                                {
                                    <AnnualCompositionChart
                                        Title="@GetAccountsCompositionTitle()"
                                        Subtitle="@($"Percentage split for {GetAccountsCompositionNatureLabel().ToLowerInvariant()} accounts. Focused month: {compositionMonthLabel}.")"
                                        Year="@_selectedYear"
                                        Slices="@GetAccountsCompositionSlices(charts)"
                                        TestId="annual-accounts-composition-chart" />
                                }
                            }
                        </div>
                    </div>
                }
                else if (_activeScope == MonthlyEvolutionScope.AccountGroups)
                {
                    var dataUntilMonth = GetDataUntilMonthForSelectedYear();
                    var summaryMonth = GetReferenceMonthForSelectedYear();
                    var compositionMonthOptions = GetAvailableMonthsForFocusedSelection();
                    var compositionMonth = _focusedMonth ?? summaryMonth;
                    var compositionMonthLabel = compositionMonth is not null
                        ? DateHelper.GetMonthName(compositionMonth.Value)
                        : "N/A";

                    <div class="row g-3 mb-4 account-groups-overview-grid">
                        <div class="col-12 col-xxl-8">
                            <div class="card shadow-sm h-100">
                                <div class="card-header bg-transparent">
                                    <div>
                                        <h5 class="mb-1">
                                            <i class="bi bi-table me-2"></i>Account Group Overview
                                        </h5>
                                        <p class="text-muted mb-0">Current month summary by group. Expand rows only when needed.</p>
                                    </div>
                                </div>
                                <div class="card-body p-0">
                                    <div class="table-responsive">
                                        <table class="table table-sm table-hover align-middle mb-0">
                                            <thead class="table-light">
                                                <tr>
                                                    <th class="border-0 ps-3">Series Name</th>
                                                    <th class="border-0 text-end">End Balance</th>
                                                    <th class="border-0 text-end">Delta Prev Month</th>
                                                    <th class="border-0 text-end">Delta Year Start</th>
                                                    <th class="border-0 text-end pe-3">Details</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var series in _report.Series.OrderBy(s => s.DisplayName).ThenBy(s => s.SeriesKey))
                                                {
                                                    var point = summaryMonth is not null
                                                        ? GetPointAtOrBeforeMonth(series, summaryMonth.Value)
                                                        : null;
                                                    var isExpanded = _expandedSeriesKey == series.SeriesKey;

                                                    <tr class="series-summary-row">
                                                        <td class="ps-3 fw-semibold">@series.DisplayName</td>
                                                        <td class="text-end @GetValueColorClass(point?.EndBalanceCents ?? 0, point is not null)">
                                                            @(point is not null ? MoneyFormatter.FormatCentsWithSign(point.EndBalanceCents) : "-")
                                                        </td>
                                                        <td class="text-end @GetValueColorClass(point?.DeltaVsPreviousMonthCents ?? 0, point is not null)">
                                                            @(point is not null ? MoneyFormatter.FormatCentsWithSign(point.DeltaVsPreviousMonthCents) : "-")
                                                        </td>
                                                        <td class="text-end @GetValueColorClass(point?.DeltaVsYearStartCents ?? 0, point is not null)">
                                                            @(point is not null ? MoneyFormatter.FormatCentsWithSign(point.DeltaVsYearStartCents) : "-")
                                                        </td>
                                                        <td class="text-end pe-3">
                                                            <button type="button"
                                                                    class="btn btn-sm btn-outline-secondary"
                                                                    @onclick="() => ToggleSeriesDetails(series.SeriesKey)">
                                                                @(isExpanded ? "Hide months" : "View months")
                                                            </button>
                                                        </td>
                                                    </tr>

                                                    if (isExpanded)
                                                    {
                                                        <tr class="series-detail-row">
                                                            <td colspan="5" class="bg-body-tertiary px-3 py-3">
                                                                <div class="table-responsive">
                                                                    <table class="table table-sm mb-0">
                                                                        <thead>
                                                                            <tr>
                                                                                <th>Month</th>
                                                                                <th class="text-end">End Balance</th>
                                                                                <th class="text-end">Delta Prev Month</th>
                                                                                <th class="text-end">Delta Year Start</th>
                                                                            </tr>
                                                                        </thead>
                                                                        <tbody>
                                                                            @foreach (var monthPoint in GetSeriesPointsForDetails(series, dataUntilMonth))
                                                                            {
                                                                                <tr>
                                                                                    <td>@DateHelper.GetMonthName(monthPoint.Month)</td>
                                                                                    <td class="text-end @MoneyFormatter.GetColorClass(monthPoint.EndBalanceCents)">
                                                                                        @MoneyFormatter.FormatCentsWithSign(monthPoint.EndBalanceCents)
                                                                                    </td>
                                                                                    <td class="text-end @MoneyFormatter.GetColorClass(monthPoint.DeltaVsPreviousMonthCents)">
                                                                                        @MoneyFormatter.FormatCentsWithSign(monthPoint.DeltaVsPreviousMonthCents)
                                                                                    </td>
                                                                                    <td class="text-end @MoneyFormatter.GetColorClass(monthPoint.DeltaVsYearStartCents)">
                                                                                        @MoneyFormatter.FormatCentsWithSign(monthPoint.DeltaVsYearStartCents)
                                                                                    </td>
                                                                                </tr>
                                                                            }
                                                                        </tbody>
                                                                    </table>
                                                                </div>
                                                            </td>
                                                        </tr>
                                                    }
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-xxl-4 account-groups-chart-panel">
                            <div class="d-flex justify-content-end mb-2">
                                <div class="btn-group btn-group-sm" role="group" aria-label="Account groups chart mode">
                                    <button type="button"
                                            class="btn @GetAccountGroupsChartModeButtonClass(AccountGroupsChartMode.Evolution)"
                                            @onclick="() => SetAccountGroupsChartMode(AccountGroupsChartMode.Evolution)">
                                        Evolution
                                    </button>
                                    <button type="button"
                                            class="btn @GetAccountGroupsChartModeButtonClass(AccountGroupsChartMode.Composition)"
                                            @onclick="() => SetAccountGroupsChartMode(AccountGroupsChartMode.Composition)">
                                        Composition
                                    </button>
                                </div>
                            </div>

                            @if (_accountGroupsChartMode == AccountGroupsChartMode.Evolution)
                            {
                                <AnnualLineChart
                                    Title="Account Groups Monthly Evolution"
                                    Subtitle="Monthly end-balance evolution by account group."
                                    Year="@_selectedYear"
                                    Series="@charts.AccountGroupEvolution"
                                    DataUntilMonth="@dataUntilMonth"
                                    TestId="annual-account-group-evolution-chart" />
                            }
                            else
                            {
                                @if (compositionMonthOptions.Count > 0 && _focusedMonth is not null)
                                {
                                    <div class="mb-2">
                                        <label class="form-label fw-semibold mb-1">Focused Month</label>
                                        <select class="form-select form-select-sm month-focus-select"
                                                value="@_focusedMonth"
                                                @onchange="OnFocusedMonthChanged">
                                            @foreach (var month in compositionMonthOptions)
                                            {
                                                <option value="@month">@DateHelper.GetMonthName(month)</option>
                                            }
                                        </select>
                                    </div>
                                }

                                <AnnualCompositionChart
                                    Title="Expense Groups Composition"
                                    Subtitle="@($"Percentage split of expense-oriented groups (quesitos). Focused month: {compositionMonthLabel}.")"
                                    Year="@_selectedYear"
                                    Slices="@charts.AccountGroupExpenseComposition"
                                    TestId="annual-account-group-expense-composition-chart" />
                            }
                        </div>
                    </div>
                }
            }

        }
        else
        {
            <div class="card shadow-sm">
                <div class="card-body text-center py-5">
                    <i class="bi bi-graph-up display-4 text-muted mb-3"></i>
                    <h5 class="text-muted">Select year and scope to load monthly evolution.</h5>
                </div>
            </div>
        }
    </Authorized>
    <NotAuthorized>
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle me-2"></i>
            Please log in to view reports.
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private MonthlyEvolutionReportDto? _report;
    private string? _error;
    private bool _isLoading;

    private int _selectedYear = DateHelper.GetCurrentYear();
    private MonthlyEvolutionScope _activeScope = MonthlyEvolutionScope.AssetTotal;
    private IReadOnlyList<int> _yearOptions = Array.Empty<int>();
    private IReadOnlyDictionary<Guid, AccountNature> _accountNatureById = new Dictionary<Guid, AccountNature>();
    private IReadOnlyDictionary<Guid, IReadOnlySet<AccountNature>> _accountGroupNaturesById =
        new Dictionary<Guid, IReadOnlySet<AccountNature>>();
    private int? _focusedMonth;
    private string? _expandedSeriesKey;
    private string? _selectedAccountSeriesKeyForChart;
    private AccountsChartMode _accountsChartMode = AccountsChartMode.Evolution;
    private AccountNature _accountsCompositionNature = AccountNature.Expense;
    private AccountGroupsChartMode _accountGroupsChartMode = AccountGroupsChartMode.Evolution;
    private static readonly AccountNature[] _natureOrder =
    {
        AccountNature.Asset,
        AccountNature.Liability,
        AccountNature.Expense,
        AccountNature.Income,
        AccountNature.Equity
    };
    private static readonly ReportingMetricDefinition _assetBalanceMetric =
        ReportingMetricSemantics.ResolveMetric("monthly-evolution-latest-asset-end-balance");
    private static readonly ReportingMetricDefinition _deltaPrevMetric =
        ReportingMetricSemantics.ResolveMetric("monthly-evolution-latest-asset-delta-prev-month");
    private static readonly ReportingMetricDefinition _deltaYearStartMetric =
        ReportingMetricSemantics.ResolveMetric("monthly-evolution-latest-asset-delta-year-start");
    private static readonly ReportingMetricDefinition _periodNetResultMetric =
        ReportingMetricSemantics.ResolveMetric("monthly-summary-period-net-result");

    protected override async Task OnInitializedAsync()
    {
        _yearOptions = Enumerable
            .Range(2000, DateHelper.GetCurrentYear() - 2000 + 1)
            .OrderByDescending(x => x)
            .ToList();

        await LoadReportAsync();
    }

    private async Task OnYearChangedAsync(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var year))
            return;

        _selectedYear = year;
        await LoadReportAsync();
    }

    private async Task ChangeScopeAsync(MonthlyEvolutionScope scope)
    {
        if (_activeScope == scope)
            return;

        _activeScope = scope;
        _expandedSeriesKey = null;
        _selectedAccountSeriesKeyForChart = null;
        await LoadReportAsync();
    }

    private Task OnFocusedMonthChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var month))
            _focusedMonth = month;

        _expandedSeriesKey = null;
        return Task.CompletedTask;
    }

    private Task OnAccountSeriesSelectionChanged(ChangeEventArgs e)
    {
        var selected = e.Value?.ToString();
        _selectedAccountSeriesKeyForChart = string.IsNullOrWhiteSpace(selected) ? null : selected;
        return Task.CompletedTask;
    }

    private void SetAccountGroupsChartMode(AccountGroupsChartMode mode)
    {
        _accountGroupsChartMode = mode;
    }

    private string GetAccountGroupsChartModeButtonClass(AccountGroupsChartMode mode)
    {
        return _accountGroupsChartMode == mode ? "btn-primary" : "btn-outline-primary";
    }

    private static string GetValueColorClass(long cents, bool hasData)
    {
        return hasData ? MoneyFormatter.GetColorClass(cents) : "text-muted";
    }

    private void SetAccountsChartMode(AccountsChartMode mode)
    {
        _accountsChartMode = mode;
    }

    private string GetAccountsChartModeButtonClass(AccountsChartMode mode)
    {
        return _accountsChartMode == mode ? "btn-primary" : "btn-outline-primary";
    }

    private void SetAccountsCompositionNature(AccountNature nature)
    {
        _accountsCompositionNature = nature;
    }

    private string GetAccountsCompositionButtonClass(AccountNature nature)
    {
        return _accountsCompositionNature == nature ? "btn-primary" : "btn-outline-primary";
    }

    private string GetAccountsCompositionTitle()
    {
        return _accountsCompositionNature == AccountNature.Expense
            ? "Expense Composition"
            : "Income Composition";
    }

    private string GetAccountsCompositionNatureLabel()
    {
        return _accountsCompositionNature == AccountNature.Expense ? "Expense" : "Income";
    }

    private IReadOnlyList<AnnualCompositionSlice> GetAccountsCompositionSlices(AnnualChartsViewModel charts)
    {
        return _accountsCompositionNature == AccountNature.Expense
            ? charts.ExpenseComposition
            : charts.IncomeComposition;
    }

    private async Task LoadReportAsync()
    {
        _isLoading = true;
        _error = null;
        _report = null;
        StateHasChanged();

        try
        {
            _report = await ReportsApi.GetMonthlyEvolutionAsync(_selectedYear, _activeScope);
            if (_activeScope == MonthlyEvolutionScope.Accounts)
            {
                await LoadAccountNatureLookupBestEffortAsync();
                _accountGroupNaturesById = new Dictionary<Guid, IReadOnlySet<AccountNature>>();
            }
            else if (_activeScope == MonthlyEvolutionScope.AccountGroups)
            {
                _accountNatureById = new Dictionary<Guid, AccountNature>();
                await LoadAccountGroupNatureLookupBestEffortAsync();
            }
            else
            {
                _accountNatureById = new Dictionary<Guid, AccountNature>();
                _accountGroupNaturesById = new Dictionary<Guid, IReadOnlySet<AccountNature>>();
            }

            SyncFocusedMonth();
            SyncSelectedAccountSeries();
            _expandedSeriesKey = null;
        }
        catch (UnauthorizedAccessException)
        {
            _error = "You are not authorized to view this report. Please log in again.";
        }
        catch (Exception ex)
        {
            _error = $"Failed to load report: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private string GetTabClass(MonthlyEvolutionScope tabScope)
    {
        return _activeScope == tabScope ? "active" : string.Empty;
    }

    private string GetScopeTitle()
    {
        return _activeScope switch
        {
            MonthlyEvolutionScope.Accounts => "Accounts Evolution",
            MonthlyEvolutionScope.AccountGroups => "Account Group Evolution",
            _ => "Monthly Evolution"
        };
    }

    private string GetScopeDescription()
    {
        return _activeScope switch
        {
            MonthlyEvolutionScope.Accounts => "One row per account grouped by nature. Expand only the series you need.",
            _ => "One row per series. Expand only the series you need."
        };
    }

    private AnnualChartsViewModel BuildAnnualChartsViewModel()
    {
        if (_report is null || _report.Series.Count == 0)
            return AnnualChartsViewModel.Empty;

        try
        {
            var focusedCompositionMonth = GetFocusedCompositionMonth();

            var assetEndBalanceEvolution = _activeScope == MonthlyEvolutionScope.AssetTotal
                ? AnnualChartDatasetAdapter.BuildEndBalanceSeries(_report, key: "end-balance", label: "End Balance")
                : Array.Empty<AnnualChartSeries>();

            var selectedAccountKeys = _activeScope == MonthlyEvolutionScope.Accounts &&
                                      !string.IsNullOrWhiteSpace(_selectedAccountSeriesKeyForChart)
                ? new HashSet<string>(StringComparer.Ordinal) { _selectedAccountSeriesKeyForChart }
                : null;

            var accountEvolution = _activeScope == MonthlyEvolutionScope.Accounts
                ? AnnualChartDatasetAdapter.BuildSeriesEvolution(
                    _report,
                    maxSeries: selectedAccountKeys is null ? 12 : 1,
                    includedSeriesKeys: selectedAccountKeys)
                : Array.Empty<AnnualChartSeries>();

            var accountGroupEvolution = _activeScope == MonthlyEvolutionScope.AccountGroups
                ? AnnualChartDatasetAdapter.BuildSeriesEvolution(_report, maxSeries: 12)
                : Array.Empty<AnnualChartSeries>();

            var expenseComposition = _activeScope == MonthlyEvolutionScope.Accounts &&
                                     focusedCompositionMonth is not null
                ? AnnualChartDatasetAdapter.BuildCompositionByNatureAtMonth(
                    _report,
                    _accountNatureById,
                    AccountNature.Expense,
                    focusedCompositionMonth.Value)
                : Array.Empty<AnnualCompositionSlice>();

            var incomeComposition = _activeScope == MonthlyEvolutionScope.Accounts &&
                                    focusedCompositionMonth is not null
                ? AnnualChartDatasetAdapter.BuildCompositionByNatureAtMonth(
                    _report,
                    _accountNatureById,
                    AccountNature.Income,
                    focusedCompositionMonth.Value)
                : Array.Empty<AnnualCompositionSlice>();

            var accountGroupExpenseComposition = _activeScope == MonthlyEvolutionScope.AccountGroups &&
                                                 focusedCompositionMonth is not null
                ? AnnualChartDatasetAdapter.BuildCompositionFromSeriesAtMonth(
                    _report,
                    IsExpenseOrientedGroup,
                    focusedCompositionMonth.Value)
                : Array.Empty<AnnualCompositionSlice>();

            return new AnnualChartsViewModel(
                AssetEndBalanceEvolution: assetEndBalanceEvolution,
                AccountEvolution: accountEvolution,
                AccountGroupEvolution: accountGroupEvolution,
                ExpenseComposition: expenseComposition,
                IncomeComposition: incomeComposition,
                AccountGroupExpenseComposition: accountGroupExpenseComposition,
                Error: null);
        }
        catch (Exception ex)
        {
            return new AnnualChartsViewModel(
                AssetEndBalanceEvolution: Array.Empty<AnnualChartSeries>(),
                AccountEvolution: Array.Empty<AnnualChartSeries>(),
                AccountGroupEvolution: Array.Empty<AnnualChartSeries>(),
                ExpenseComposition: Array.Empty<AnnualCompositionSlice>(),
                IncomeComposition: Array.Empty<AnnualCompositionSlice>(),
                AccountGroupExpenseComposition: Array.Empty<AnnualCompositionSlice>(),
                Error: $"Failed to build annual chart datasets: {ex.Message}");
        }
    }

    private bool IsExpenseOrientedGroup(MonthlyEvolutionSeriesDto series)
    {
        if (series.EntityId is null)
            return false;

        if (!_accountGroupNaturesById.TryGetValue(series.EntityId.Value, out var natures))
            return true;

        return natures.Contains(AccountNature.Expense);
    }

    private bool ShouldShowComparabilityDisclaimer(bool usesAssetOnly)
    {
        return true;
    }

    private string GetComparabilityDisclaimerText(bool usesAssetOnly)
    {
        if (usesAssetOnly || _activeScope == MonthlyEvolutionScope.AssetTotal)
        {
            return $"{_assetBalanceMetric.CanonicalName} and related deltas are stock metrics. " +
                $"{_periodNetResultMetric.CanonicalName} in Period Summary is a flow metric; they are not directly comparable.";
        }

        return $"Monthly evolution end balances and deltas are stock metrics. " +
            $"{_periodNetResultMetric.CanonicalName} in Period Summary is a flow metric; they are not directly comparable.";
    }

    private string GetLatestEndBalanceLabel(bool usesAssetOnly)
    {
        return usesAssetOnly || _activeScope == MonthlyEvolutionScope.AssetTotal
            ? $"Latest {_assetBalanceMetric.CanonicalName}"
            : "Latest End Balance";
    }

    private string GetLatestDeltaPrevLabel(bool usesAssetOnly)
    {
        return usesAssetOnly || _activeScope == MonthlyEvolutionScope.AssetTotal
            ? $"Latest {_assetBalanceMetric.CanonicalName} {_deltaPrevMetric.CanonicalName}"
            : $"Latest {_deltaPrevMetric.CanonicalName}";
    }

    private string GetLatestDeltaYearStartLabel(bool usesAssetOnly)
    {
        return usesAssetOnly || _activeScope == MonthlyEvolutionScope.AssetTotal
            ? $"Latest {_assetBalanceMetric.CanonicalName} {_deltaYearStartMetric.CanonicalName}"
            : $"Latest {_deltaYearStartMetric.CanonicalName}";
    }

    private IReadOnlyList<int> GetAvailableMonths()
    {
        if (_report is null || _report.Series.Count == 0)
            return Array.Empty<int>();

        return _report.Series
            .SelectMany(s => s.Points.Select(p => p.Month))
            .Distinct()
            .OrderBy(m => m)
            .ToList();
    }

    private IReadOnlyList<int> GetAvailableMonthsForFocusedSelection()
    {
        var months = GetAvailableMonths();
        var dataUntilMonth = GetDataUntilMonthForSelectedYear();
        return dataUntilMonth is null
            ? months
            : months.Where(m => m <= dataUntilMonth.Value).ToList();
    }

    private int? GetDataUntilMonthForSelectedYear()
    {
        return _selectedYear == DateHelper.GetCurrentYear()
            ? DateHelper.GetCurrentMonth()
            : null;
    }

    private int? GetReferenceMonthForSelectedYear()
    {
        var months = GetAvailableMonthsForFocusedSelection();
        if (months.Count == 0)
            return null;

        var preferredMonth = _selectedYear == DateHelper.GetCurrentYear()
            ? DateHelper.GetCurrentMonth()
            : months.Max();

        if (months.Contains(preferredMonth))
            return preferredMonth;

        var fallback = months
            .Where(m => m <= preferredMonth)
            .DefaultIfEmpty(months.Max())
            .Max();

        return fallback;
    }

    private int? GetFocusedCompositionMonth()
    {
        var months = GetAvailableMonthsForFocusedSelection();
        if (months.Count == 0)
            return null;

        if (_focusedMonth is not null && months.Contains(_focusedMonth.Value))
            return _focusedMonth.Value;

        return GetReferenceMonthForSelectedYear();
    }

    private void SyncFocusedMonth()
    {
        var availableMonths = GetAvailableMonthsForFocusedSelection();
        if (availableMonths.Count == 0)
        {
            _focusedMonth = null;
            return;
        }

        var preferredMonth = GetReferenceMonthForSelectedYear() ?? availableMonths.Max();

        if (_focusedMonth is null || !availableMonths.Contains(_focusedMonth.Value))
            _focusedMonth = availableMonths.Contains(preferredMonth)
                ? preferredMonth
                : availableMonths.Max();
    }

    private void ToggleSeriesDetails(string seriesKey)
    {
        _expandedSeriesKey = _expandedSeriesKey == seriesKey ? null : seriesKey;
    }

    private static MonthlyEvolutionPointDto? GetPointAtOrBeforeMonth(MonthlyEvolutionSeriesDto series, int month)
    {
        return series.Points
            .Where(p => p.Month <= month)
            .OrderByDescending(p => p.Month)
            .FirstOrDefault();
    }

    private static IReadOnlyList<MonthlyEvolutionPointDto> GetSeriesPointsForDetails(
        MonthlyEvolutionSeriesDto series,
        int? dataUntilMonth)
    {
        return series.Points
            .Where(p => dataUntilMonth is null || p.Month <= dataUntilMonth.Value)
            .OrderBy(p => p.Month)
            .ToList();
    }

    private MonthlyEvolutionPointDto GetFocusedPoint(MonthlyEvolutionSeriesDto series)
    {
        var focusMonth = _focusedMonth
            ?? GetReferenceMonthForSelectedYear()
            ?? series.Points.Max(p => p.Month);

        return GetPointAtOrBeforeMonth(series, focusMonth)
            ?? series.Points.OrderByDescending(p => p.Month).First();
    }

    private async Task LoadAccountNatureLookupBestEffortAsync()
    {
        try
        {
            var accounts = await AccountsApi.ListAsync(default);
            _accountNatureById = accounts.ToDictionary(a => a.Id, a => a.Nature);
        }
        catch
        {
            _accountNatureById = new Dictionary<Guid, AccountNature>();
        }
    }

    private async Task LoadAccountGroupNatureLookupBestEffortAsync()
    {
        try
        {
            var groups = await AccountGroupsApi.ListAsync(default);
            var detailTasks = groups.Select(async group => new
            {
                group.Id,
                Details = await AccountGroupsApi.GetByIdAsync(group.Id, default)
            });

            var details = await Task.WhenAll(detailTasks);
            _accountGroupNaturesById = details.ToDictionary(
                x => x.Id,
                x => (IReadOnlySet<AccountNature>)x.Details.Accounts
                    .Select(a => a.Nature)
                    .Where(n => n != AccountNature.Liability)
                    .Distinct()
                    .ToHashSet());
        }
        catch
        {
            _accountGroupNaturesById = new Dictionary<Guid, IReadOnlySet<AccountNature>>();
        }
    }

    private IReadOnlyList<MonthlyEvolutionSeriesDto> GetSelectableAccountSeries()
    {
        if (_report is null)
            return Array.Empty<MonthlyEvolutionSeriesDto>();

        return _report.Series
            .OrderBy(s => s.DisplayName)
            .ThenBy(s => s.SeriesKey)
            .ToList();
    }

    private void SyncSelectedAccountSeries()
    {
        if (_activeScope != MonthlyEvolutionScope.Accounts || _report is null)
        {
            _selectedAccountSeriesKeyForChart = null;
            return;
        }

        if (string.IsNullOrWhiteSpace(_selectedAccountSeriesKeyForChart))
            return;

        var exists = _report.Series.Any(s => s.SeriesKey == _selectedAccountSeriesKeyForChart);
        if (!exists)
            _selectedAccountSeriesKeyForChart = null;
    }

    private IReadOnlyList<AccountNatureSeriesGroup> GetAccountSeriesGroups()
    {
        if (_report is null || _report.Series.Count == 0)
            return Array.Empty<AccountNatureSeriesGroup>();

        var grouped = _report.Series
            .OrderBy(s => s.DisplayName)
            .ThenBy(s => s.SeriesKey)
            .GroupBy(ResolveSeriesNature)
            .Select(g => new AccountNatureSeriesGroup(g.Key, g.ToList()))
            .ToList();

        var ordered = grouped
            .Where(g => g.Nature is not null && _natureOrder.Contains(g.Nature.Value))
            .OrderBy(g => Array.IndexOf(_natureOrder, g.Nature!.Value))
            .ToList();

        ordered.AddRange(grouped
            .Where(g => g.Nature is null || !_natureOrder.Contains(g.Nature.Value))
            .OrderBy(g => g.Nature is null ? 1 : 0)
            .ThenBy(g => g.Nature?.ToString()));

        return ordered;
    }

    private AccountNature? ResolveSeriesNature(MonthlyEvolutionSeriesDto series)
    {
        if (series.EntityId is null)
            return null;

        return _accountNatureById.TryGetValue(series.EntityId.Value, out var nature)
            ? nature
            : null;
    }

    private static string GetNatureLabel(AccountNature? nature)
    {
        return nature switch
        {
            AccountNature.Asset => "Asset",
            AccountNature.Liability => "Liability",
            AccountNature.Expense => "Expense",
            AccountNature.Income => "Income",
            AccountNature.Equity => "Equity",
            _ => "Uncategorized"
        };
    }

    private static string GetNatureIcon(AccountNature? nature)
    {
        return nature switch
        {
            AccountNature.Asset => "bi-piggy-bank",
            AccountNature.Liability => "bi-credit-card",
            AccountNature.Expense => "bi-arrow-up-circle",
            AccountNature.Income => "bi-arrow-down-circle",
            AccountNature.Equity => "bi-bank",
            _ => "bi-question-circle"
        };
    }

    private (long EndBalance, long DeltaPrev, long DeltaYearStart, bool UsesAssetOnly) GetLatestSummary()
    {
        if (_report is null || _report.Series.Count == 0)
            return (0L, 0L, 0L, false);

        var seriesForSummary = _report.Series.AsEnumerable();
        var usesAssetOnly = false;

        if (_activeScope == MonthlyEvolutionScope.Accounts)
        {
            var assetSeries = _report.Series
                .Where(s => ResolveSeriesNature(s) == AccountNature.Asset)
                .ToList();

            if (assetSeries.Count > 0)
            {
                seriesForSummary = assetSeries;
                usesAssetOnly = true;
            }
        }

        var referenceMonth = GetReferenceMonthForSelectedYear();
        var latestPoints = seriesForSummary
            .Select(s => referenceMonth is not null
                ? GetPointAtOrBeforeMonth(s, referenceMonth.Value)
                : s.Points.OrderByDescending(p => p.Month).FirstOrDefault())
            .Where(p => p is not null)
            .Select(p => p!)
            .ToList();

        if (latestPoints.Count == 0)
            return (0L, 0L, 0L, usesAssetOnly);

        return (
            EndBalance: latestPoints.Sum(p => p.EndBalanceCents),
            DeltaPrev: latestPoints.Sum(p => p.DeltaVsPreviousMonthCents),
            DeltaYearStart: latestPoints.Sum(p => p.DeltaVsYearStartCents),
            UsesAssetOnly: usesAssetOnly
        );
    }

    private sealed record AnnualChartsViewModel(
        IReadOnlyList<AnnualChartSeries> AssetEndBalanceEvolution,
        IReadOnlyList<AnnualChartSeries> AccountEvolution,
        IReadOnlyList<AnnualChartSeries> AccountGroupEvolution,
        IReadOnlyList<AnnualCompositionSlice> ExpenseComposition,
        IReadOnlyList<AnnualCompositionSlice> IncomeComposition,
        IReadOnlyList<AnnualCompositionSlice> AccountGroupExpenseComposition,
        string? Error)
    {
        public static AnnualChartsViewModel Empty => new(
            AssetEndBalanceEvolution: Array.Empty<AnnualChartSeries>(),
            AccountEvolution: Array.Empty<AnnualChartSeries>(),
            AccountGroupEvolution: Array.Empty<AnnualChartSeries>(),
            ExpenseComposition: Array.Empty<AnnualCompositionSlice>(),
            IncomeComposition: Array.Empty<AnnualCompositionSlice>(),
            AccountGroupExpenseComposition: Array.Empty<AnnualCompositionSlice>(),
            Error: null);
    }

    private enum AccountGroupsChartMode
    {
        Evolution,
        Composition
    }

    private enum AccountsChartMode
    {
        Evolution,
        Composition
    }

    private sealed record AccountNatureSeriesGroup(
        AccountNature? Nature,
        IReadOnlyList<MonthlyEvolutionSeriesDto> Series);
}
