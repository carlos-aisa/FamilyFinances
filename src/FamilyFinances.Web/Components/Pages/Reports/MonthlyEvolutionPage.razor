    private IReadOnlyList<int> GetAvailableMonths()
    {
        if (_report is null || _report.Series.Count == 0)
            return Array.Empty<int>();

        return _report.Series
            .SelectMany(s => s.Points.Select(p => p.Month))
            .Distinct()
            .OrderBy(m => m)
            .ToList();
    }

    private void SyncFocusedMonth()
    {
        var availableMonths = GetAvailableMonths();
        if (availableMonths.Count == 0)
        {
            _focusedMonth = null;
            return;
        }

        var preferredMonth = _selectedYear == DateHelper.GetCurrentYear()
            ? DateHelper.GetCurrentMonth()
            : availableMonths.Max();

        if (_focusedMonth is null || !availableMonths.Contains(_focusedMonth.Value))
            _focusedMonth = availableMonths.Contains(preferredMonth)
                ? preferredMonth
                : availableMonths.Max();
    }

    private void ToggleSeriesDetails(string seriesKey)
    {
        _expandedSeriesKey = _expandedSeriesKey == seriesKey ? null : seriesKey;
    }

    private MonthlyEvolutionPointDto GetFocusedPoint(MonthlyEvolutionSeriesDto series)
    {
        var focusMonth = _focusedMonth ?? series.Points.Max(p => p.Month);
        return series.Points.FirstOrDefault(p => p.Month == focusMonth)
            ?? series.Points.OrderByDescending(p => p.Month).First();
    }

    private async Task LoadAccountNatureLookupBestEffortAsync()
    {
        try
        {
            var accounts = await AccountsApi.ListAsync(default);
            _accountNatureById = accounts.ToDictionary(a => a.Id, a => a.Nature);
        }
        catch
        {
            _accountNatureById = new Dictionary<Guid, AccountNature>();
        }
    }

    private async Task LoadAccountGroupNatureLookupBestEffortAsync()
    {
        try
        {
            var groups = await AccountGroupsApi.ListAsync(default);
            var detailTasks = groups.Select(async group => new
            {
                group.Id,
                Details = await AccountGroupsApi.GetByIdAsync(group.Id, default)
            });

            var details = await Task.WhenAll(detailTasks);
            _accountGroupNaturesById = details.ToDictionary(
                x => x.Id,
                x => (IReadOnlySet<AccountNature>)x.Details.Accounts
                    .Select(a => a.Nature)
                    .Where(n => n != AccountNature.Liability)
                    .Distinct()
                    .ToHashSet());
        }
        catch
        {
            _accountGroupNaturesById = new Dictionary<Guid, IReadOnlySet<AccountNature>>();
        }
    }

    private IReadOnlyList<MonthlyEvolutionSeriesDto> GetSelectableAccountSeries()
    {
        if (_report is null)
            return Array.Empty<MonthlyEvolutionSeriesDto>();

        return _report.Series
            .OrderBy(s => s.DisplayName)
            .ThenBy(s => s.SeriesKey)
            .ToList();
    }

    private void SyncSelectedAccountSeries()
    {
        if (_activeScope != MonthlyEvolutionScope.Accounts || _report is null)
        {
            _selectedAccountSeriesKeyForChart = null;
            return;
        }

        if (string.IsNullOrWhiteSpace(_selectedAccountSeriesKeyForChart))
            return;

        var exists = _report.Series.Any(s => s.SeriesKey == _selectedAccountSeriesKeyForChart);
        if (!exists)
            _selectedAccountSeriesKeyForChart = null;
    }

    private IReadOnlyList<AccountNatureSeriesGroup> GetAccountSeriesGroups()
    {
        if (_report is null || _report.Series.Count == 0)
            return Array.Empty<AccountNatureSeriesGroup>();

        var grouped = _report.Series
            .OrderBy(s => s.DisplayName)
            .ThenBy(s => s.SeriesKey)
            .GroupBy(ResolveSeriesNature)
            .Select(g => new AccountNatureSeriesGroup(g.Key, g.ToList()))
            .ToList();

        var ordered = grouped
            .Where(g => g.Nature is not null && _natureOrder.Contains(g.Nature.Value))
            .OrderBy(g => Array.IndexOf(_natureOrder, g.Nature!.Value))
            .ToList();

        ordered.AddRange(grouped
            .Where(g => g.Nature is null || !_natureOrder.Contains(g.Nature.Value))
            .OrderBy(g => g.Nature is null ? 1 : 0)
            .ThenBy(g => g.Nature?.ToString()));

        return ordered;
    }

    private AccountNature? ResolveSeriesNature(MonthlyEvolutionSeriesDto series)
    {
        if (series.EntityId is null)
            return null;

        return _accountNatureById.TryGetValue(series.EntityId.Value, out var nature)
            ? nature
            : null;
    }

    private static string GetNatureLabel(AccountNature? nature)
    {
        return nature switch
        {
            AccountNature.Asset => "Asset",
            AccountNature.Liability => "Liability",
            AccountNature.Expense => "Expense",
            AccountNature.Income => "Income",
            AccountNature.Equity => "Equity",
            _ => "Uncategorized"
        };
    }

    private static string GetNatureIcon(AccountNature? nature)
    {
        return nature switch
        {
            AccountNature.Asset => "bi-piggy-bank",
            AccountNature.Liability => "bi-credit-card",
            AccountNature.Expense => "bi-arrow-up-circle",
            AccountNature.Income => "bi-arrow-down-circle",
            AccountNature.Equity => "bi-bank",
            _ => "bi-question-circle"
        };
    }

    private (long EndBalance, long DeltaPrev, long DeltaYearStart, bool UsesAssetOnly) GetLatestSummary()
    {
        if (_report is null || _report.Series.Count == 0)
            return (0L, 0L, 0L, false);

        var seriesForSummary = _report.Series.AsEnumerable();
        var usesAssetOnly = false;

        if (_activeScope == MonthlyEvolutionScope.Accounts)
        {
            var assetSeries = _report.Series
                .Where(s => ResolveSeriesNature(s) == AccountNature.Asset)
                .ToList();

            if (assetSeries.Count > 0)
            {
                seriesForSummary = assetSeries;
                usesAssetOnly = true;
            }
        }

        var latestPoints = seriesForSummary
            .Select(s => s.Points.OrderByDescending(p => p.Month).FirstOrDefault())
            .Where(p => p is not null)
            .Select(p => p!)
            .ToList();

        if (latestPoints.Count == 0)
            return (0L, 0L, 0L, usesAssetOnly);

        return (
            EndBalance: latestPoints.Sum(p => p.EndBalanceCents),
            DeltaPrev: latestPoints.Sum(p => p.DeltaVsPreviousMonthCents),
            DeltaYearStart: latestPoints.Sum(p => p.DeltaVsYearStartCents),
            UsesAssetOnly: usesAssetOnly
        );
    }

