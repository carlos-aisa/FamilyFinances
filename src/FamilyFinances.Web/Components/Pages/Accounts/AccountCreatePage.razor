@page "/accounts/new"
@inherits ApiPageBase
@using System.ComponentModel.DataAnnotations
@using FamilyFinances.Application.Ledger.Accounts.Dtos
@using FamilyFinances.Application.Ledger.Accounts.Requests
@using FamilyFinances.Domain.Ledger.Accounts
@using FamilyFinances.Web.Api
@using FamilyFinances.Web.Components.Base
@using Microsoft.Extensions.Localization
@using FamilyFinances.Web
@inject AccountsApi AccountsApi
@inject IStringLocalizer<SharedResource> L
@using FamilyFinances.Web.Features.Accounts

<h3>@L["Accounts_NewAccount_CardTitle"]</h3>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="alert alert-danger" role="alert">@_error</div>
}

<EditForm Model="_model" OnValidSubmit="CreateAsync">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label class="form-label">@L["Accounts_Field_Name"]</label>
        <InputText class="form-control" @bind-Value="_model.Name" />
    </div>

    <div class="mb-3">
        <label class="form-label">@L["Accounts_Field_Nature"]</label>
        <InputSelect class="form-select"
                 @bind-Value="_model.Nature"
                 @bind-Value:after="OnNatureChanged">
            @foreach (var n in Enum.GetValues<AccountNature>())
            {
                <option value="@n">@GetNatureLabel(n)</option>
            }
        </InputSelect>
    </div>

    <div class="mb-3">
        <label class="form-label">@L["Accounts_Field_Kind"]</label>
        <InputSelect class="form-select ff-account-kind-select" @bind-Value="_model.KindId">
            @foreach (var k in GetAllowedKinds(_model.Nature))
            {
                <option value="@k.Id">@GetKindLabel(k)</option>
            }
        </InputSelect>
    </div>

    <div class="d-flex gap-2">
        <button class="btn btn-primary" disabled="@_isBusy">@L["Accounts_Create"]</button>
        <button type="button" class="btn btn-secondary" @onclick="Cancel" disabled="@_isBusy">@L["Accounts_Cancel"]</button>
    </div>
</EditForm>

@code {
    private bool _isBusy;
    private string? _error;
    private IReadOnlyList<AccountKindCatalogDto> _kinds = Array.Empty<AccountKindCatalogDto>();

    private CreateAccountFormModel _model = new();

    protected override async Task OnInitializedAsync()
    {
        await ExecuteApiAsync(async ct =>
        {
            _kinds = await AccountsApi.ListKindsAsync(includeInactive: false, ct);
            _model.KindId = GetDefaultKind(_model.Nature)?.Id ?? Guid.Empty;
        });
    }

    private async Task CreateAsync()
    {
        if (_isBusy)
            return;

        _isBusy = true;
        _error = null;

        await ExecuteApiAsync(async ct =>
        {
            var request = new CreateAccountRequest(
                _model.Name.Trim(),
                _model.Nature,
                AccountKind.Other,
                DateOnly.FromDateTime(DateTime.Now),
                _model.KindId);

            await AccountsApi.CreateAsync(request, ct);
        });

        _isBusy = false;

        if (string.IsNullOrWhiteSpace(_error))
            Nav.NavigateTo("/accounts");
    }

    private void Cancel() => Nav.NavigateTo("/accounts");

    private Task OnNatureChanged()
    {
        _model.KindId = GetDefaultKind(_model.Nature)?.Id ?? Guid.Empty;
        return Task.CompletedTask;
    }

    private string GetNatureLabel(AccountNature nature) => nature switch
    {
        AccountNature.Asset => L["Dashboard_Nature_Asset"],
        AccountNature.Liability => L["Dashboard_Nature_Liability"],
        AccountNature.Expense => L["Dashboard_Nature_Expense"],
        AccountNature.Income => L["Dashboard_Nature_Income"],
        AccountNature.Equity => L["Accounts_Nature_Equity"],
        _ => nature.ToString()
    };

    private string GetKindLabel(AccountKindCatalogDto kind)
        => AccountKindLabelResolver.Resolve(kind, L);

    private AccountKindCatalogDto? GetDefaultKind(AccountNature nature)
    {
        var allowed = GetAllowedKinds(nature);
        return nature switch
        {
            AccountNature.Asset => allowed.FirstOrDefault(x => x.LegacyKind == AccountKind.Checking) ?? allowed.FirstOrDefault(),
            AccountNature.Liability => allowed.FirstOrDefault(x => x.LegacyKind == AccountKind.CreditCard) ?? allowed.FirstOrDefault(),
            AccountNature.Expense => allowed.FirstOrDefault(x => x.LegacyKind == AccountKind.ExpenseCategory) ?? allowed.FirstOrDefault(),
            AccountNature.Income => allowed.FirstOrDefault(x => x.LegacyKind == AccountKind.IncomeSource) ?? allowed.FirstOrDefault(),
            _ => allowed.FirstOrDefault()
        };
    }

    private IReadOnlyList<AccountKindCatalogDto> GetAllowedKinds(AccountNature nature)
    {
        var allowedSystemKinds = nature switch
        {
            AccountNature.Asset => new HashSet<AccountKind> { AccountKind.Cash, AccountKind.Checking, AccountKind.Savings, AccountKind.Investment, AccountKind.Other },
            AccountNature.Liability => new HashSet<AccountKind> { AccountKind.CreditCard, AccountKind.Loan, AccountKind.Mortgage, AccountKind.Other },
            AccountNature.Expense => new HashSet<AccountKind> { AccountKind.ExpenseCategory, AccountKind.Other },
            AccountNature.Income => new HashSet<AccountKind> { AccountKind.IncomeSource, AccountKind.Other },
            AccountNature.Equity => new HashSet<AccountKind> { AccountKind.Other },
            _ => new HashSet<AccountKind> { AccountKind.Other }
        };

        return _kinds
            .Where(x => x.IsActive)
            .Where(x => x.IsSystem
                ? allowedSystemKinds.Contains(x.LegacyKind)
                : x.Nature == nature)
            .OrderBy(x => GetKindLabel(x), StringComparer.CurrentCultureIgnoreCase)
            .ThenBy(x => x.IsSystem ? 0 : 1)
            .ToList();
    }

    private sealed class CreateAccountFormModel
    {
        [Required]
        [StringLength(100)]
        public string Name { get; set; } = "";

        [Required]
        public AccountNature Nature { get; set; } = AccountNature.Asset;

        [Required]
        public Guid KindId { get; set; }
    }
}
