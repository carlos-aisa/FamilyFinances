@page "/accounts"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using FamilyFinances.Application.Ledger.Accounts.Dtos
@using FamilyFinances.Application.Ledger.Accounts.Requests
@using FamilyFinances.Domain.Ledger.Accounts
@using FamilyFinances.Web.Api
@using Microsoft.AspNetCore.Components.Authorization
@inherits FamilyFinances.Web.Components.Base.ApiPageBase

@inject IAccountsApi AccountsApi
@inject IJSRuntime JS

<AuthorizeView>
    <Authorized Context="auth">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h3 class="m-0">Accounts</h3>

            <div class="d-flex gap-2 align-items-center">
                <div class="form-check form-switch m-0">
                    <input class="form-check-input" type="checkbox" role="switch" id="showClosedSwitch"
                           @bind="_showClosed" />
                    <label class="form-check-label" for="showClosedSwitch">Show closed</label>
                </div>

                <button class="btn btn-primary" @onclick="ToggleCreate">
                    @(_isCreating ? "Cancel" : "New account")
                </button>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="alert alert-danger" role="alert">@_error</div>
        }

        @if (!string.IsNullOrWhiteSpace(_info))
        {
            <div class="alert alert-success" role="alert">@_info</div>
        }

        @if (_isCreating)
        {
            <div class="card mb-3">
                <div class="card-body">
                    <h5 class="card-title">New account</h5>

                    <EditForm Model="_createModel" OnValidSubmit="CreateAsync">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <label class="form-label">Name</label>
                                <InputText class="form-control" @bind-Value="_createModel.Name" />
                            </div>

                            <div class="col-12 col-md-3">
                                <label class="form-label">Nature</label>
                                <InputSelect class="form-select"
                                             @bind-Value="_createModel.Nature"
                                             @bind-Value:after="OnNatureChanged">
                                    @foreach (var n in _natureOrder)
                                    {
                                        <option value="@n">@n</option>
                                    }
                                </InputSelect>
                            </div>

                            <div class="col-12 col-md-3">
                                <label class="form-label">Kind</label>
                                <InputSelect class="form-select" @bind-Value="_createModel.Kind">
                                    @foreach (var k in GetAllowedKinds(_createModel.Nature))
                                    {
                                        <option value="@k">@k</option>
                                    }
                                </InputSelect>
                            </div>
                        </div>

                        <div class="mt-3 d-flex gap-2">
                            <button class="btn btn-success" type="submit" disabled="@_isBusy">
                                @(_isBusy ? "Saving..." : "Create")
                            </button>
                            <button class="btn btn-outline-secondary" type="button" @onclick="ToggleCreate" disabled="@_isBusy">
                                Cancel
                            </button>
                        </div>

                        <div class="mt-2 text-muted" style="font-size: 0.9rem;">
                            OpenedOn is set to today's date automatically.
                        </div>
                    </EditForm>
                </div>
            </div>
        }

        @if (!_hasLoaded)
        {
            <p>Loading...</p>
        }
        else if (_accounts is null || _accounts.Count == 0)
        {
            <p class="text-muted">No accounts found.</p>
        }
        else
        {
            @foreach (var nature in _natureOrder)
            {
                var items = _accounts
                    .Where(a => a.Nature == nature)
                    .Where(a => _showClosed || !a.IsClosed)
                    .OrderBy(a => a.IsClosed)
                    .ThenBy(a => a.Name, StringComparer.OrdinalIgnoreCase)
                    .ToList();

                if (items.Count == 0)
                    continue;

                <details class="@GetNatureDetailsClass(nature)" open>
                    <summary class="@GetNatureSummaryClass(nature)">
                        <span>@nature</span>
                        <span class="badge rounded-pill @GetNatureCountBadgeClass(nature)">@items.Count</span>
                    </summary>

                    <div class="mt-2">
                        <table class="table table-sm align-middle">
                            <thead>
                                <tr>
                                    <th style="width: 45%;">Name</th>
                                    <th style="width: 25%;">Kind</th>
                                    <th style="width: 20%;">Status</th>
                                    <th style="width: 10%;"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var a in items)
                                {
                                    <tr>
                                        <td>@a.Name</td>
                                        <td>@a.Kind</td>
                                        <td>
                                            @if (a.IsClosed)
                                            {
                                                <span class="badge text-bg-secondary">Closed</span>
                                            }
                                            else
                                            {
                                                <span class="badge text-bg-success">Active</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            @if (_editingAccountId == a.Id)
                                            {
                                                <EditForm Model="_renameModel" OnValidSubmit="@(() => SaveRenameAsync(a.Id))">
                                                    <DataAnnotationsValidator />

                                                    <div class="d-flex justify-content-end gap-2">
                                                        <InputText class="form-control form-control-sm" style="min-width: 300px;"
                                                                @bind-Value="_renameModel.Name" />

                                                        <button class="btn btn-sm btn-success" type="submit" disabled="@_isBusy">
                                                            Save
                                                        </button>

                                                        <button class="btn btn-sm btn-outline-secondary" type="button" @onclick="CancelRename" disabled="@_isBusy">
                                                            Cancel
                                                        </button>
                                                    </div>
                                                </EditForm>
                                            }
                                            else
                                            {
                                                <div class="d-flex justify-content-end gap-2">
                                                    <button class="btn btn-sm btn-outline-primary" type="button" @onclick="@(() => StartRename(a))" disabled="@_isBusy">
                                                        Rename
                                                    </button>

                                                    @if (a.IsClosed)
                                                    {
                                                        <button class="btn btn-sm btn-outline-success" type="button" @onclick="@(() => ReopenAsync(a))" disabled="@_isBusy">
                                                            Reopen
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <button class="btn btn-sm btn-outline-danger" type="button" @onclick="@(() => CloseAsync(a))" disabled="@_isBusy">
                                                            Close
                                                        </button>
                                                    }
                                                </div>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </details>
            }
        }
    </Authorized>

    <NotAuthorized>
        <p>You must be logged in to view accounts.</p>
        <p><a href="/login">Login</a></p>
    </NotAuthorized>
</AuthorizeView>

@code {
    private IReadOnlyList<AccountDto>? _accounts;
    private string? _error;
    private string? _info;
    private bool _hasLoaded;

    private bool _showClosed;
    private bool _isCreating;
    private bool _isBusy;
    private Guid? _editingAccountId;
    private readonly RenameAccountModel _renameModel = new();

    private readonly CreateAccountModel _createModel = new();

    private static readonly AccountNature[] _natureOrder =
    [
        AccountNature.Asset,
        AccountNature.Liability,
        AccountNature.Expense,
        AccountNature.Income,
        AccountNature.Equity
    ];

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _error = null;
        _info = null;

        await ExecuteApiAsync(async ct =>
        {
            _accounts = await AccountsApi.ListAsync(ct);
            _hasLoaded = true;
        });
    }

    private void ToggleCreate()
    {
        _error = null;
        _info = null;
        _isCreating = !_isCreating;

        if (_isCreating)
            ResetCreateModel();
    }

    private void ResetCreateModel()
    {
        _createModel.Name = "";
        _createModel.Nature = AccountNature.Expense;
        _createModel.Kind = AccountKind.ExpenseCategory;
    }

    private Task OnNatureChanged()
    {
        // When the user changes nature, auto-suggest a sensible default kind.
        _createModel.Kind = GetDefaultKind(_createModel.Nature);
        return Task.CompletedTask;
    }

    private async Task CreateAsync()
    {
        if (_isBusy)
            return;

        _isBusy = true;
        _error = null;
        _info = null;

        try
        {
            await ExecuteApiAsync(async ct =>
            {
                var request = new CreateAccountRequest(
                    Name: _createModel.Name.Trim(),
                    Nature: _createModel.Nature,
                    Kind: _createModel.Kind,
                    OpenedOn: DateOnly.FromDateTime(DateTime.Today)); // Hidden in UI

                await AccountsApi.CreateAsync(request, ct);

                _isCreating = false;
                _info = "Account created.";
                await LoadAsync();
            });
        }
        catch (HttpRequestException ex)
        {
            _error = ex.Message;
        }
        catch (Exception ex)
        {
            _error = $"Unexpected error: {ex.Message}";
        }

        _isBusy = false;
    }

    private static AccountKind GetDefaultKind(AccountNature nature) => nature switch
    {
        AccountNature.Asset => AccountKind.Checking,
        AccountNature.Liability => AccountKind.CreditCard,
        AccountNature.Expense => AccountKind.ExpenseCategory,
        AccountNature.Income => AccountKind.IncomeSource,
        AccountNature.Equity => AccountKind.Other,
        _ => AccountKind.Other
    };

    private static IReadOnlyList<AccountKind> GetAllowedKinds(AccountNature nature) => nature switch
    {
        AccountNature.Asset =>
        [
            AccountKind.Cash,
            AccountKind.Checking,
            AccountKind.Savings,
            AccountKind.Investment,
            AccountKind.Other
        ],
        AccountNature.Liability =>
        [
            AccountKind.CreditCard,
            AccountKind.Loan,
            AccountKind.Mortgage,
            AccountKind.Other
        ],
        AccountNature.Expense =>
        [
            AccountKind.ExpenseCategory,
            AccountKind.Other
        ],
        AccountNature.Income =>
        [
            AccountKind.IncomeSource,
            AccountKind.Other
        ],
        AccountNature.Equity =>
        [
            AccountKind.Other
        ],
        _ => [AccountKind.Other]
    };

        private static string GetNatureDetailsClass(AccountNature nature)
    {
        // A subtle card-like container with a colored left border.
        return $"mb-3 border rounded overflow-hidden border-start border-4 {GetNatureBorderClass(nature)}";
    }

    private static string GetNatureSummaryClass(AccountNature nature)
    {
        // A subtle header background + padding. Using Bootstrap classes keeps it consistent with the rest of the UI.
        return $"px-3 py-2 d-flex justify-content-between align-items-center fw-semibold bg-body-tertiary {GetNatureTextClass(nature)}";
    }

    private static string GetNatureBorderClass(AccountNature nature) => nature switch
    {
        AccountNature.Asset => "border-primary",
        AccountNature.Liability => "border-warning",
        AccountNature.Expense => "border-danger",
        AccountNature.Income => "border-success",
        AccountNature.Equity => "border-secondary",
        _ => "border-secondary"
    };

    private static string GetNatureTextClass(AccountNature nature) => nature switch
    {
        AccountNature.Asset => "text-primary-emphasis",
        AccountNature.Liability => "text-warning-emphasis",
        AccountNature.Expense => "text-danger-emphasis",
        AccountNature.Income => "text-success-emphasis",
        AccountNature.Equity => "text-secondary-emphasis",
        _ => "text-body"
    };

    private static string GetNatureCountBadgeClass(AccountNature nature) => nature switch
    {
        AccountNature.Asset => "text-bg-primary",
        AccountNature.Liability => "text-bg-warning",
        AccountNature.Expense => "text-bg-danger",
        AccountNature.Income => "text-bg-success",
        AccountNature.Equity => "text-bg-secondary",
        _ => "text-bg-secondary"
    };

    private void StartRename(AccountDto account)
    {
        _error = null;
        _info = null;

        _editingAccountId = account.Id;
        _renameModel.Name = account.Name;
    }

    private void CancelRename()
    {
        _editingAccountId = null;
        _renameModel.Name = "";
    }

    private async Task SaveRenameAsync(Guid accountId)
    {
        if (_isBusy)
            return;

        _isBusy = true;
        _error = null;
        _info = null;

        try
        {
            await ExecuteApiAsync(async ct =>
            {
                await AccountsApi.RenameAsync(accountId, _renameModel.Name.Trim(), ct);
                _editingAccountId = null;
                _info = "Account renamed.";
                await LoadAsync();
            });
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task CloseAsync(AccountDto account)
    {
        if (_isBusy)
            return;

        if (!await ConfirmAsync($"Close account '{account.Name}'?"))
            return;

        _isBusy = true;
        _error = null;
        _info = null;

        try
        {
            await ExecuteApiAsync(async ct =>
            {
                await AccountsApi.CloseAsync(account.Id, ct);
                _info = "Account closed.";
                await LoadAsync();
            });
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task ReopenAsync(AccountDto account)
    {
        if (_isBusy)
            return;

        if (!await ConfirmAsync($"Reopen account '{account.Name}'?"))
            return;

        _isBusy = true;
        _error = null;
        _info = null;

        try
        {
            await ExecuteApiAsync(async ct =>
            {
                await AccountsApi.ReopenAsync(account.Id, ct);
                _info = "Account reopened.";
                await LoadAsync();
            });
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task<bool> ConfirmAsync(string message)
    {
        return await JS.InvokeAsync<bool>("confirm", message);
    }

    private sealed class CreateAccountModel
    {
        [Required]
        [StringLength(100, MinimumLength = 1)]
        public string Name { get; set; } = "";

        [Required]
        public AccountNature Nature { get; set; } = AccountNature.Expense;

        [Required]
        public AccountKind Kind { get; set; } = AccountKind.ExpenseCategory;
    }

    private sealed class RenameAccountModel
    {
        [Required]
        [StringLength(200, MinimumLength = 1)]
        public string Name { get; set; } = "";
    }
}
