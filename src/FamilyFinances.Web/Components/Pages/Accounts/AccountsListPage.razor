@page "/accounts"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using FamilyFinances.Application.Ledger.Accounts.Dtos
@using FamilyFinances.Application.Ledger.Accounts.Requests
@using FamilyFinances.Application.Reporting.Dtos
@using FamilyFinances.Domain.Ledger.Accounts
@using FamilyFinances.Web.Api
@using FamilyFinances.Web.Components.Shared
@using FamilyFinances.Web.Features.Reports
@using Microsoft.Extensions.Localization
@using Microsoft.AspNetCore.Components.Authorization
@using FamilyFinances.Web
@inherits FamilyFinances.Web.Components.Base.ApiPageBase

@inject IAccountsApi AccountsApi
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResource> L

<AuthorizeView>
    <Authorized Context="auth">
        <!-- Header -->
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <h3 class="mb-1">@L["Accounts_Title"]</h3>
                <p class="text-muted mb-0">
                    @if (_accounts is not null)
                    {
                        var visibleCount = _accounts.Count(a => _showClosed || !a.IsClosed);
                        <i class="bi bi-wallet2 me-1"></i>
                        <span>@(visibleCount == 1 ? L["Accounts_Count_Singular", visibleCount] : L["Accounts_Count_Plural", visibleCount])</span>
                    }
                </p>
                <p class="text-muted mb-0">
                    <i class="bi bi-clock-history me-1"></i>@L["Accounts_UpdatedAsOf", DateTime.Today.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)]
                </p>
            </div>

            <div class="d-flex gap-2 align-items-center">
                <div class="form-check form-switch m-0">
                    <input class="form-check-input" type="checkbox" role="switch" id="showClosedSwitch"
                           @bind="_showClosed" />
                    <label class="form-check-label" for="showClosedSwitch">
                        <i class="bi bi-eye me-1"></i>@L["Accounts_ShowClosed"]
                    </label>
                </div>

                <button class="btn @(_isCreating ? "btn-outline-secondary" : "btn-primary")" @onclick="ToggleCreate">
                    <i class="bi @(_isCreating ? "bi-x-circle" : "bi-plus-circle") me-1"></i>
                    @(_isCreating ? L["Accounts_Cancel"] : L["Accounts_NewAccount"])
                </button>
            </div>
        </div>

        <!-- Alerts -->
        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle me-2"></i>@_error
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@L["Common_Close"]"></button>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(_info))
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle me-2"></i>@_info
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@L["Common_Close"]"></button>
            </div>
        }

        <!-- Create Form -->
        @if (_isCreating)
        {
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-plus-circle me-2"></i>@L["Accounts_NewAccount_CardTitle"]
                    </h5>
                </div>
                <div class="card-body">
                    <EditForm Model="_createModel" OnValidSubmit="CreateAsync">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-danger" />

                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <label class="form-label">
                                    <i class="bi bi-pencil me-1"></i>@L["Accounts_Field_Name"]
                                </label>
                                <InputText class="form-control" @bind-Value="_createModel.Name" placeholder="@L["Accounts_Field_Name_Placeholder"]" />
                            </div>

                            <div class="col-12 col-md-3">
                                <label class="form-label">
                                    <i class="bi bi-diagram-3 me-1"></i>@L["Accounts_Field_Nature"]
                                </label>
                                <InputSelect class="form-select"
                                             @bind-Value="_createModel.Nature"
                                             @bind-Value:after="OnNatureChanged">
                                    @foreach (var n in _natureOrder)
                                    {
                                        <option value="@n">@GetNatureLabel(n)</option>
                                    }
                                </InputSelect>
                            </div>

                            <div class="col-12 col-md-3">
                                <label class="form-label">
                                    <i class="bi bi-tag me-1"></i>@L["Accounts_Field_Kind"]
                                </label>
                                <InputSelect class="form-select" @bind-Value="_createModel.Kind">
                                    @foreach (var k in GetAllowedKinds(_createModel.Nature))
                                    {
                                        <option value="@k">@GetKindLabel(k)</option>
                                    }
                                </InputSelect>
                            </div>
                        </div>

                        <div class="mt-3 d-flex gap-2 align-items-center">
                            <button class="btn btn-success" type="submit" disabled="@_isBusy">
                                @if (_isBusy)
                                {
                                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                }
                                <i class="bi bi-check-circle me-1"></i>@L["Accounts_Create"]
                            </button>
                            <button class="btn btn-outline-secondary" type="button" @onclick="ToggleCreate" disabled="@_isBusy">
                                <i class="bi bi-x-circle me-1"></i>@L["Accounts_Cancel"]
                            </button>
                            
                            <small class="text-muted ms-3">
                                <i class="bi bi-info-circle me-1"></i>@L["Accounts_OpenedOnHint"]
                            </small>
                        </div>
                    </EditForm>
                </div>
            </div>
        }

        <!-- Content -->
        @if (!_hasLoaded)
        {
            <div class="d-flex justify-content-center align-items-center ff-loading-shell">
                <div class="text-center">
                    <div class="spinner-border text-primary mb-3 ff-spinner-lg" role="status">
                        <span class="visually-hidden">@L["Common_Loading"]</span>
                    </div>
                    <p class="text-muted">@L["Accounts_Loading"]</p>
                </div>
            </div>
        }
        else if (_accounts is null || _accounts.Count == 0)
        {
            <div class="card shadow-sm">
                <div class="card-body text-center py-5">
                    <i class="bi bi-wallet2 display-1 text-muted mb-3"></i>
                    <h5 class="text-muted">@L["Accounts_Empty_Title"]</h5>
                    <p class="text-muted">@L["Accounts_Empty_Desc"]</p>
                    <button class="btn btn-primary mt-3" @onclick="ToggleCreate">
                        <i class="bi bi-plus-circle me-1"></i>@L["Accounts_CreateAccountButton"]
                    </button>
                </div>
            </div>
        }
        else
        {
            <SingleOpenAccordion Id="accounts-by-nature" Sections="@BuildNatureSections()">
                <HeaderTemplate Context="accordionSection">
                    @{
                        var nature = ParseNature(accordionSection.Key);
                    }
                    <div class="d-flex justify-content-between align-items-center w-100">
                        <h5 class="mb-0 @GetNatureTextClass(nature)">
                            <i class="@GetNatureIcon(nature) me-2"></i>@accordionSection.Title
                        </h5>
                        <span class="badge @GetNatureCountBadgeClass(nature) fs-6">@accordionSection.BadgeText</span>
                    </div>
                </HeaderTemplate>
                <SectionTemplate Context="accordionSection">
                    @{
                        var nature = ParseNature(accordionSection.Key);
                        var items = GetAccountsForNature(nature);
                    }
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 ff-data-table">
                            <thead class="table-light">
                                <tr>
                                    <th class="border-0 ps-3 ff-w-35p">
                                        <i class="bi bi-tag me-1"></i>@L["Accounts_Table_Name"]
                                    </th>
                                    <th class="border-0 ff-w-15p">
                                        <i class="bi bi-bookmark me-1"></i>@L["Accounts_Table_Kind"]
                                    </th>
                                    <th class="border-0 text-end ff-w-15p">
                                        <i class="bi bi-calendar-month me-1"></i>@L["Accounts_Table_CurrentMonthBalance"]
                                    </th>
                                    <th class="border-0 text-end ff-w-15p">
                                        <i class="bi bi-currency-euro me-1"></i>@L["Accounts_Table_AccumulatedBalance"]
                                    </th>
                                    <th class="border-0 ff-w-10p">
                                        <i class="bi bi-info-circle me-1"></i>@L["Accounts_Table_Status"]
                                    </th>
                                    <th class="border-0 text-end pe-3 ff-w-10p">@L["Accounts_Table_Actions"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var a in items)
                                {
                                    var accumulatedBalanceText = GetAccumulatedBalanceText(a.Id);
                                    var currentMonthBalanceText = GetCurrentMonthBalanceText(a.Id);
                                    <tr class="account-row">
                                        <td class="ps-3">
                                            <div class="d-flex align-items-center">
                                                <i class="bi bi-wallet2 text-muted me-2"></i>
                                                <span class="@(a.IsClosed ? "text-muted" : "fw-semibold")">@a.Name</span>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge bg-secondary-subtle text-secondary">@GetKindLabel(a.Kind)</span>
                                        </td>
                                        <td class="text-end">
                                            @if (currentMonthBalanceText is null)
                                            {
                                                <span class="text-muted">&mdash;</span>
                                            }
                                            else
                                            {
                                                <span class="fw-semibold">@currentMonthBalanceText</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            @if (accumulatedBalanceText is null)
                                            {
                                                <span class="text-muted">&mdash;</span>
                                            }
                                            else
                                            {
                                                <span class="fw-semibold">@accumulatedBalanceText</span>
                                            }
                                        </td>
                                        <td>
                                            @if (a.IsClosed)
                                            {
                                                <span class="badge bg-secondary">
                                                    <i class="bi bi-lock me-1"></i>@L["Accounts_Status_Closed"]
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success">
                                                    <i class="bi bi-check-circle me-1"></i>@L["Accounts_Status_Active"]
                                                </span>
                                            }
                                        </td>
                                        <td class="text-end pe-3">
                                            @if (_editingAccountId == a.Id)
                                            {
                                                <EditForm Model="_renameModel" OnValidSubmit="@(() => SaveRenameAsync(a.Id))">
                                                    <DataAnnotationsValidator />

                                                    <div class="d-flex justify-content-end gap-2">
                                                        <InputText class="form-control form-control-sm ff-input-min-w-200"
                                                                   @bind-Value="_renameModel.Name" />

                                                        <button class="btn btn-sm btn-success" type="submit" disabled="@_isBusy">
                                                            <i class="bi bi-check me-1"></i>@L["Accounts_Save"]
                                                        </button>

                                                        <button class="btn btn-sm btn-outline-secondary" type="button" @onclick="CancelRename" disabled="@_isBusy">
                                                            <i class="bi bi-x me-1"></i>@L["Accounts_Cancel"]
                                                        </button>
                                                    </div>
                                                </EditForm>
                                            }
                                            else
                                            {
                                                <div class="d-flex justify-content-end gap-1">
                                                    <button class="btn btn-sm btn-outline-primary" type="button" @onclick="@(() => StartRename(a))" disabled="@_isBusy" title="@L["Accounts_Action_Rename"]">
                                                        <i class="bi bi-pencil"></i>
                                                    </button>

                                                    <button class="btn btn-sm btn-outline-secondary" type="button" @onclick="@(() => ViewMovements(a.Id))" title="@L["Accounts_Action_ViewMovements"]">
                                                        <i class="bi bi-list-ul"></i>
                                                    </button>

                                                    @if (a.IsClosed)
                                                    {
                                                        <button class="btn btn-sm btn-outline-success" type="button" @onclick="@(() => ReopenAsync(a))" disabled="@_isBusy" title="@L["Accounts_Action_Reopen"]">
                                                            <i class="bi bi-unlock"></i>
                                                        </button>
                                                        <button class="btn btn-sm btn-outline-danger"
                                                                type="button"
                                                                @onclick="@(() => DeleteAsync(a))"
                                                                disabled="@_isBusy"
                                                                title="@L["Accounts_Action_Delete"]">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <button class="btn btn-sm btn-outline-warning" type="button" @onclick="@(() => CloseAsync(a))" disabled="@_isBusy" title="@L["Accounts_Action_Close"]">
                                                            <i class="bi bi-lock"></i>
                                                        </button>
                                                    }
                                                </div>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </SectionTemplate>
            </SingleOpenAccordion>
        }
    </Authorized>

    <NotAuthorized>
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <i class="bi bi-shield-lock display-1 text-muted mb-3"></i>
                <h5 class="text-muted">@L["Accounts_AuthRequired_Title"]</h5>
                <p class="text-muted">@L["Accounts_AuthRequired_Desc"]</p>
                <a class="btn btn-primary mt-3" href="/login">
                    <i class="bi bi-box-arrow-in-right me-1"></i>@L["Common_Login"]
                </a>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>

<style>
    .account-row {
        transition: all 0.2s ease-in-out;
    }

    .account-row:hover {
        background-color: rgba(13, 110, 253, 0.05) !important;
    }
</style>

@code {
    private IReadOnlyList<AccountDto>? _accounts;
    private string? _error;
    private string? _info;
    private bool _hasLoaded;

    private bool _showClosed;
    private bool _isCreating;
    private bool _isBusy;
    private Guid? _editingAccountId;
    private readonly RenameAccountModel _renameModel = new();

    private readonly CreateAccountModel _createModel = new();

    // balances loaded from the API: accountId -> dual balance perspectives (euros)
    private Dictionary<Guid, AccountBalanceDto> _balances = new();

    private static readonly AccountNature[] _natureOrder =
    [
        AccountNature.Asset,
        AccountNature.Liability,
        AccountNature.Expense,
        AccountNature.Income,
        AccountNature.Equity
    ];

    private IReadOnlyList<SingleOpenAccordion.Section> BuildNatureSections()
    {
        if (_accounts is null)
            return Array.Empty<SingleOpenAccordion.Section>();

        var sections = new List<SingleOpenAccordion.Section>();
        foreach (var nature in _natureOrder)
        {
            var items = GetAccountsForNature(nature);
            if (items.Count == 0)
                continue;

            sections.Add(new SingleOpenAccordion.Section
            {
                Key = nature.ToString(),
                Title = GetNatureLabel(nature),
                BadgeText = items.Count.ToString(CultureInfo.InvariantCulture),
                ItemCssClass = $"border-start border-4 {GetNatureBorderClass(nature)}",
                IsInitiallyOpen = sections.Count == 0
            });
        }

        return sections;
    }

    private List<AccountDto> GetAccountsForNature(AccountNature nature)
    {
        if (_accounts is null)
            return [];

        return _accounts
            .Where(a => a.Nature == nature)
            .Where(a => _showClosed || !a.IsClosed)
            .OrderBy(a => a.IsClosed)
            .ThenBy(a => a.Name, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private static AccountNature ParseNature(string key)
        => Enum.TryParse<AccountNature>(key, out var nature) ? nature : AccountNature.Expense;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _error = null;
        _info = null;

        await ExecuteApiAsync(async ct =>
        {
            _accounts = await AccountsApi.ListAsync(ct);

            // Try to load balances; keep UI resilient if API client / endpoint is not available yet
            try
            {
                var balances = await AccountsApi.GetBalancesAsync(ct);
                _balances = balances.ToDictionary(b => b.AccountId, b => b);
            }
            catch
            {
                // If balances endpoint isn't implemented yet, silently ignore and leave balances empty.
                _balances = new();
            }

            _hasLoaded = true;
        });
    }

    private void ToggleCreate()
    {
        _error = null;
        _info = null;
        _isCreating = !_isCreating;

        if (_isCreating)
            ResetCreateModel();
    }

    private void ResetCreateModel()
    {
        _createModel.Name = "";
        _createModel.Nature = AccountNature.Expense;
        _createModel.Kind = AccountKind.ExpenseCategory;
    }

    private Task OnNatureChanged()
    {
        _createModel.Kind = GetDefaultKind(_createModel.Nature);
        return Task.CompletedTask;
    }

    private async Task CreateAsync()
    {
        if (_isBusy)
            return;

        _isBusy = true;
        _error = null;
        _info = null;

        try
        {
            await ExecuteApiAsync(async ct =>
            {
                var request = new CreateAccountRequest(
                    Name: _createModel.Name.Trim(),
                    Nature: _createModel.Nature,
                    Kind: _createModel.Kind,
                    OpenedOn: DateOnly.FromDateTime(DateTime.Today));

                await AccountsApi.CreateAsync(request, ct);

                _isCreating = false;
                _info = L["Accounts_Message_Created"];
                await LoadAsync();
            });
        }
        catch (HttpRequestException ex)
        {
            _error = ex.Message;
        }
        catch (Exception ex)
        {
            _error = L["Common_UnexpectedErrorWithDetails", ex.Message];
        }

        _isBusy = false;
    }

    private static AccountKind GetDefaultKind(AccountNature nature) => nature switch
    {
        AccountNature.Asset => AccountKind.Checking,
        AccountNature.Liability => AccountKind.CreditCard,
        AccountNature.Expense => AccountKind.ExpenseCategory,
        AccountNature.Income => AccountKind.IncomeSource,
        AccountNature.Equity => AccountKind.Other,
        _ => AccountKind.Other
    };

    private static IReadOnlyList<AccountKind> GetAllowedKinds(AccountNature nature) => nature switch
    {
        AccountNature.Asset =>
        [
            AccountKind.Cash,
            AccountKind.Checking,
            AccountKind.Savings,
            AccountKind.Investment,
            AccountKind.Other
        ],
        AccountNature.Liability =>
        [
            AccountKind.CreditCard,
            AccountKind.Loan,
            AccountKind.Mortgage,
            AccountKind.Other
        ],
        AccountNature.Expense =>
        [
            AccountKind.ExpenseCategory,
            AccountKind.Other
        ],
        AccountNature.Income =>
        [
            AccountKind.IncomeSource,
            AccountKind.Other
        ],
        AccountNature.Equity =>
        [
            AccountKind.Other
        ],
        _ => [AccountKind.Other]
    };

    private string GetNatureLabel(AccountNature nature) => nature switch
    {
        AccountNature.Asset => L["Dashboard_Nature_Asset"],
        AccountNature.Liability => L["Dashboard_Nature_Liability"],
        AccountNature.Expense => L["Dashboard_Nature_Expense"],
        AccountNature.Income => L["Dashboard_Nature_Income"],
        AccountNature.Equity => L["Accounts_Nature_Equity"],
        _ => nature.ToString()
    };

    private string GetKindLabel(AccountKind kind) => kind switch
    {
        AccountKind.Cash => L["Accounts_Kind_Cash"],
        AccountKind.Checking => L["Accounts_Kind_Checking"],
        AccountKind.Savings => L["Accounts_Kind_Savings"],
        AccountKind.Investment => L["Accounts_Kind_Investment"],
        AccountKind.CreditCard => L["Accounts_Kind_CreditCard"],
        AccountKind.Loan => L["Accounts_Kind_Loan"],
        AccountKind.Mortgage => L["Accounts_Kind_Mortgage"],
        AccountKind.ExpenseCategory => L["Accounts_Kind_ExpenseCategory"],
        AccountKind.IncomeSource => L["Accounts_Kind_IncomeSource"],
        AccountKind.Other => L["Accounts_Kind_Other"],
        _ => kind.ToString()
    };

    private static string GetNatureBorderClass(AccountNature nature) => nature switch
    {
        AccountNature.Asset => "border-primary",
        AccountNature.Liability => "border-warning",
        AccountNature.Expense => "border-danger",
        AccountNature.Income => "border-success",
        AccountNature.Equity => "border-secondary",
        _ => "border-secondary"
    };

    private static string GetNatureHeaderClass(AccountNature nature) => nature switch
    {
        AccountNature.Asset => "bg-primary-subtle",
        AccountNature.Liability => "bg-warning-subtle",
        AccountNature.Expense => "bg-danger-subtle",
        AccountNature.Income => "bg-success-subtle",
        AccountNature.Equity => "bg-secondary-subtle",
        _ => "bg-light"
    };

    private static string GetNatureTextClass(AccountNature nature) => nature switch
    {
        AccountNature.Asset => "text-primary-emphasis",
        AccountNature.Liability => "text-warning-emphasis",
        AccountNature.Expense => "text-danger-emphasis",
        AccountNature.Income => "text-success-emphasis",
        AccountNature.Equity => "text-secondary-emphasis",
        _ => "text-body"
    };

    private static string GetNatureCountBadgeClass(AccountNature nature) => nature switch
    {
        AccountNature.Asset => "bg-primary text-white",
        AccountNature.Liability => "bg-warning text-dark",
        AccountNature.Expense => "bg-danger text-white",
        AccountNature.Income => "bg-success text-white",
        AccountNature.Equity => "bg-secondary text-white",
        _ => "bg-secondary text-white"
    };

    private static string GetNatureIcon(AccountNature nature) => nature switch
    {
        AccountNature.Asset => "bi bi-bank",
        AccountNature.Liability => "bi bi-credit-card",
        AccountNature.Expense => "bi bi-arrow-up-circle",
        AccountNature.Income => "bi bi-arrow-down-circle",
        AccountNature.Equity => "bi bi-diagram-3",
        _ => "bi bi-wallet2"
    };

    private void StartRename(AccountDto account)
    {
        _error = null;
        _info = null;

        _editingAccountId = account.Id;
        _renameModel.Name = account.Name;
    }

    private void CancelRename()
    {
        _editingAccountId = null;
        _renameModel.Name = "";
    }

    private async Task SaveRenameAsync(Guid accountId)
    {
        if (_isBusy)
            return;

        _isBusy = true;
        _error = null;
        _info = null;

        try
        {
            await ExecuteApiAsync(async ct =>
            {
                await AccountsApi.RenameAsync(accountId, _renameModel.Name.Trim(), ct);
                _editingAccountId = null;
                _info = L["Accounts_Message_Renamed"];
                await LoadAsync();
            });
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task CloseAsync(AccountDto account)
    {
        if (_isBusy)
            return;

        if (!await ConfirmAsync(L["Accounts_Confirm_Close", account.Name]))
            return;

        _isBusy = true;
        _error = null;
        _info = null;

        try
        {
            await ExecuteApiAsync(async ct =>
            {
                await AccountsApi.CloseAsync(account.Id, ct);
                _info = L["Accounts_Message_Closed"];
                await LoadAsync();
            });
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task ReopenAsync(AccountDto account)
    {
        if (_isBusy)
            return;

        if (!await ConfirmAsync(L["Accounts_Confirm_Reopen", account.Name]))
            return;

        _isBusy = true;
        _error = null;
        _info = null;

        try
        {
            await ExecuteApiAsync(async ct =>
            {
                await AccountsApi.ReopenAsync(account.Id, ct);
                _info = L["Accounts_Message_Reopened"];
                await LoadAsync();
            });
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task DeleteAsync(AccountDto account)
    {
        if (_isBusy)
            return;

        var confirmed = await ConfirmAsync(L["Accounts_Confirm_Delete", account.Name]);
        if (!confirmed)
            return;

        _isBusy = true;
        _error = null;
        _info = null;

        try
        {
            await ExecuteApiAsync(async ct =>
            {
                await AccountsApi.DeleteAsync(account.Id, ct);
                _info = L["Accounts_Message_Deleted"];
                await LoadAsync();
            });
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task<bool> ConfirmAsync(string message)
    {
        return await JS.InvokeAsync<bool>("confirm", message);
    }

    private string? GetAccumulatedBalanceText(Guid accountId)
    {
        if (_balances.TryGetValue(accountId, out var balance))
            return MoneyFormatter.FormatEuros(balance.Balance);

        return null;
    }

    private string? GetCurrentMonthBalanceText(Guid accountId)
    {
        if (_balances.TryGetValue(accountId, out var balance))
            return MoneyFormatter.FormatEuros(balance.CurrentMonthBalance);

        return null;
    }

    private void ViewMovements(Guid accountId)
    {
        Nav.NavigateTo($"/accounts/{accountId}/movements");
    }

    private sealed class CreateAccountModel
    {
        [Required]
        [StringLength(100, MinimumLength = 1)]
        public string Name { get; set; } = "";

        [Required]
        public AccountNature Nature { get; set; } = AccountNature.Expense;

        [Required]
        public AccountKind Kind { get; set; } = AccountKind.ExpenseCategory;
    }

    private sealed class RenameAccountModel
    {
        [Required]
        [StringLength(200, MinimumLength = 1)]
        public string Name { get; set; } = "";
    }
}


