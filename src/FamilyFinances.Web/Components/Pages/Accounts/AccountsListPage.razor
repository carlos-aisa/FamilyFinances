@page "/accounts"
@rendermode InteractiveServer
@using FamilyFinances.Web.Api
@using FamilyFinances.Web.Auth
@using Microsoft.AspNetCore.Components.Authorization
@inherits FamilyFinances.Web.Components.Base.ApiPageBase

@inject FamilyFinances.Web.Api.AccountsApi AccountsApi
@inject AccountsApi AccountsApi
@inject NavigationManager Nav
@inject IApiTokenStore TokenStore
@inject IHttpClientFactory HttpClientFactory
@inject JwtAuthStateProvider AuthProvider

<AuthorizeView>
    <Authorized>
        <h3>Accounts</h3>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <p style="color:red">@_error</p>
        }
        else if (_accounts is null)
        {
            <p>Loading...</p>
        }
        else
        {
            <ul>
                @foreach (var a in _accounts)
                {
                    <li>@a.Name</li>
                }
            </ul>
        }
    </Authorized>
    <NotAuthorized>
        <p>You must be logged in to view accounts.</p>
        <p><a href="/login">Login</a></p>
    </NotAuthorized>
</AuthorizeView>

@code {
    private IReadOnlyList<FamilyFinances.Application.Ledger.Accounts.Dtos.AccountDto>? _accounts;
    private string? _error;
    private bool _hasLoaded;

    protected override async Task OnInitializedAsync()
    {
        await ExecuteApiAsync(async ct =>
        {
            _accounts = await AccountsApi.ListAsync(ct);
        });
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _hasLoaded)
            return;

        _hasLoaded = true;

        try
        {
             var token = await TokenStore.WaitForTokenAsync(TimeSpan.FromSeconds(1), CancellationToken.None);
            if (string.IsNullOrWhiteSpace(token))
            {
                _error = "No access token available.";
                return;
            }
            _accounts = await AccountsApi.ListAsync(CancellationToken.None);
        }
        catch (UnauthorizedAccessException)
        {
            // Token expired/invalid: clear both circuit token and cookie session
            var http = HttpClientFactory.CreateClient();
            var url = new Uri(new Uri(Nav.BaseUri), "auth/session");
            await http.DeleteAsync(url);

            TokenStore.Clear();
            await AuthProvider.RefreshAsync();

            Nav.NavigateTo("/login?reason=expired");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            StateHasChanged();
        }
    }
}
