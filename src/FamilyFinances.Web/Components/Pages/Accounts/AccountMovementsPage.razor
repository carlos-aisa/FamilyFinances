@page "/accounts/{Id:guid}/movements"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using Microsoft.AspNetCore.Components.Forms
@using FamilyFinances.Application.Reporting.Dtos
@using FamilyFinances.Web.Api
@using FamilyFinances.Web.Components.Base
@using FamilyFinances.Web.Components.Shared
@using FamilyFinances.Web.Features.Reports
@using Microsoft.AspNetCore.Components.Authorization
@inherits ApiPageBase

@inject IAccountsApi AccountsApi
@inject NavigationManager Nav

<AuthorizeView>
    <Authorized Context="auth">
        <!-- Header -->
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-2">
                        <li class="breadcrumb-item"><a href="/accounts">Accounts</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Movements</li>
                    </ol>
                </nav>
                <h3 class="mb-0">
                    <i class="bi bi-list-ul me-2"></i>@(_movements?.AccountName ?? "Account Movements")
                </h3>
            </div>

            <div class="d-flex gap-2">
                <button class="btn btn-warning" @onclick="OpenReconcileModal" disabled="@_isBusy">
                    <i class="bi bi-check2-square me-1"></i>Reconcile
                </button>
                <button class="btn btn-outline-secondary" @onclick="GoBack">
                    <i class="bi bi-arrow-left me-1"></i>Back to Accounts
                </button>
            </div>
        </div>

        <!-- Filters -->
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-light">
                <h5 class="card-title mb-0">
                    <i class="bi bi-funnel me-2"></i>Filters
                </h5>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <!-- Quick Date Presets -->
                    <div class="col-12">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-calendar-range me-1"></i>Quick Select
                        </label>
                        <div>
                            <DateRangePresets OnPresetSelected="HandlePresetSelected" ActivePreset="@_activePreset" />
                        </div>
                    </div>

                    <!-- Date Range -->
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-calendar3 me-1"></i>From Date
                        </label>
                        <input type="date" class="form-control" @bind="_fromDate" @bind:event="oninput" @bind:after="OnDateChanged" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-calendar3 me-1"></i>To Date
                        </label>
                        <input type="date" class="form-control" @bind="_toDate" @bind:event="oninput" @bind:after="OnDateChanged" />
                    </div>

                    <!-- Search -->
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-search me-1"></i>Search
                        </label>
                        <input type="text" class="form-control" placeholder="Search by description or payee..." @bind="_searchQuery" @bind:event="oninput" />
                    </div>

                    <!-- Actions -->
                    <div class="col-md-2">
                        <label class="form-label">&nbsp;</label>
                        <button class="btn btn-primary w-100" @onclick="LoadMovementsAsync" disabled="@_isBusy">
                            @if (_isBusy)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            }
                            else
                            {
                                <i class="bi bi-search me-1"></i>
                            }
                            Search
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Alerts -->
        @if (!string.IsNullOrWhiteSpace(_success))
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle me-2"></i>@_success
                <button type="button" class="btn-close" @onclick="@(() => _success = null)"></button>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle me-2"></i>@_error
                <button type="button" class="btn-close" @onclick="@(() => _error = null)"></button>
            </div>
        }

        <!-- Content -->
        @if (_movements is null)
        {
            <div class="d-flex justify-content-center align-items-center" style="min-height: 400px;">
                <div class="text-center">
                    <div class="spinner-border text-primary mb-3" role="status" style="width: 3rem; height: 3rem;">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="text-muted">Loading movements...</p>
                </div>
            </div>
        }
        else if (_movements.Items.Count == 0)
        {
            <div class="card shadow-sm">
                <div class="card-body text-center py-5">
                    <i class="bi bi-inbox display-1 text-muted mb-3"></i>
                    <h5 class="text-muted">No movements found</h5>
                    <p class="text-muted">
                        @if (string.IsNullOrWhiteSpace(_searchQuery))
                        {
                            <span>No transactions for this account in the selected date range.</span>
                        }
                        else
                        {
                            <span>No transactions match your search criteria. Try adjusting your filters.</span>
                        }
                    </p>
                </div>
            </div>
        }
        else
        {
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">
                            <i class="bi bi-list-ul me-2"></i>Movements
                        </h5>
                        <span class="badge bg-primary">
                            @_movements.Items.Count of @_movements.TotalCount total
                        </span>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="border-0 ps-3" style="width: 120px;">
                                        <i class="bi bi-calendar3 me-1"></i>Date
                                    </th>
                                    <th class="border-0">
                                        <i class="bi bi-file-text me-1"></i>Description
                                    </th>
                                    <th class="border-0" style="width: 200px;">
                                        <i class="bi bi-person me-1"></i>Payee
                                    </th>
                                    <th class="border-0" style="width: 200px;">
                                        <i class="bi bi-arrow-left-right me-1"></i>Counterparty
                                    </th>
                                    <th class="border-0 text-end pe-3" style="width: 160px;">
                                        <i class="bi bi-currency-euro me-1"></i>Amount
                                    </th>
                                    <th class="border-0 text-end pe-3" style="width: 180px;">
                                        <i class="bi bi-graph-up-arrow me-1"></i>Running Balance
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var movement in _movements.Items)
                                {
                                    <tr class="movement-row" style="cursor: pointer;" @onclick="@(() => NavigateToTransaction(movement.TransactionId))">
                                        <td class="ps-3">
                                            <div class="d-flex flex-column">
                                                <span class="fw-semibold">@movement.BookedOn.ToString("dd MMM", new CultureInfo("es-ES"))</span>
                                                <small class="text-muted">@movement.BookedOn.Year</small>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="fw-semibold">@movement.Description</span>
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrWhiteSpace(movement.PayeeName))
                                            {
                                                <span class="badge bg-secondary-subtle text-secondary">
                                                    <i class="bi bi-person me-1"></i>@movement.PayeeName
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrWhiteSpace(movement.CounterpartyAccountName))
                                            {
                                                <small class="text-muted">
                                                    <i class="bi bi-arrow-left-right me-1"></i>@movement.CounterpartyAccountName
                                                </small>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                        <td class="text-end pe-3">
                                            <span class="badge @GetAmountBadgeClass(movement.SignedAmount) fs-6 px-3 py-2">
                                                @FormatAmount(movement.SignedAmount)
                                            </span>
                                        </td>
                                        <td class="text-end pe-3">
                                            <span class="fw-semibold @GetRunningBalanceClass(movement.RunningBalance)">
                                                @FormatAmount(movement.RunningBalance)
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Footer with pagination info -->
                <div class="card-footer bg-light">
                    <div class="d-flex justify-content-between align-items-center">
                        <small class="text-muted">
                            Showing @_movements.Items.Count of @_movements.TotalCount movements
                        </small>
                        <small class="text-muted">
                            <i class="bi bi-info-circle me-1"></i>Click on a movement to view transaction details
                        </small>
                    </div>
                </div>
            </div>
        }
    </Authorized>

    <NotAuthorized>
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <i class="bi bi-shield-lock display-1 text-muted mb-3"></i>
                <h5 class="text-muted">Authentication Required</h5>
                <p class="text-muted">You must be logged in to view account movements.</p>
                <a class="btn btn-primary mt-3" href="/login">
                    <i class="bi bi-box-arrow-in-right me-1"></i>Login
                </a>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>

<!-- Reconciliation Modal -->
@if (_showReconcileModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-warning">
                    <h5 class="modal-title">
                        <i class="bi bi-check2-square me-2"></i>Reconcile Account
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseReconcileModal" disabled="@_isReconciling"></button>
                </div>
                <EditForm Model="_reconcileModel" OnValidSubmit="SubmitReconcileAsync">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        @if (!string.IsNullOrWhiteSpace(_reconcileError))
                        {
                            <div class="alert alert-danger">
                                <i class="bi bi-exclamation-triangle me-2"></i>@_reconcileError
                            </div>
                        }

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Actual Balance</label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-currency-euro"></i>
                                </span>
                                <InputNumber @bind-Value="_reconcileModel.ActualBalance" class="form-control" step="0.01" />
                            </div>
                            <ValidationMessage For="@(() => _reconcileModel.ActualBalance)" class="text-danger small" />
                            <small class="text-muted">Enter the real balance as shown in your bank statement or wallet.</small>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">As of Date</label>
                            <InputDate @bind-Value="_reconcileModel.AsOfDate" class="form-control" />
                            <ValidationMessage For="@(() => _reconcileModel.AsOfDate)" class="text-danger small" />
                            <small class="text-muted">The date when this balance was accurate.</small>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Note (Optional)</label>
                            <InputText @bind-Value="_reconcileModel.Note" class="form-control" placeholder="e.g., Bank statement reconciliation" />
                            <ValidationMessage For="@(() => _reconcileModel.Note)" class="text-danger small" />
                            <small class="text-muted">Optional note to explain this adjustment.</small>
                        </div>

                        <div class="alert alert-info mb-0">
                            <i class="bi bi-info-circle me-2"></i>
                            <small>
                                This will create an adjustment transaction if needed. Historical transactions will NOT be modified.
                            </small>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseReconcileModal" disabled="@_isReconciling">
                            <i class="bi bi-x-circle me-1"></i>Cancel
                        </button>
                        <button type="submit" class="btn btn-warning" disabled="@_isReconciling">
                            @if (_isReconciling)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            }
                            <i class="bi bi-check2-square me-1"></i>Reconcile
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

<style>
    .movement-row {
        transition: background-color 0.2s ease-in-out;
    }

        .movement-row:hover {
            background-color: rgba(13, 110, 253, 0.05) !important;
        }
</style>

@code {
[Parameter]
public Guid Id { get; set; }

private AccountMovementsDto? _movements;
private string? _error;
private string? _success;
private bool _isBusy;

private DateOnly _fromDate = DateHelper.GetCurrentMonthStart();
private DateOnly _toDate = DateHelper.GetCurrentMonthEnd();
private string _searchQuery = string.Empty;
private string? _activePreset = "this-month";

// Reconciliation
private bool _showReconcileModal;
private bool _isReconciling;
private string? _reconcileError;
private readonly ReconcileModel _reconcileModel = new();

    private async Task HandlePresetSelected(DateRangePresets.DateRangePreset preset)
    {
        var (from, to) = preset.GetDateRange();
        _fromDate = from;
        _toDate = to;
        _activePreset = preset.Type.ToString().ToLowerInvariant().Replace("_", "-");
        
        // Auto-load movements when preset selected
        await LoadMovementsAsync();
    }

    private void OnDateChanged()
    {
        _activePreset = null; // Clear preset when manually changing dates
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadMovementsAsync();
    }

    private async Task LoadMovementsAsync()
    {
        if (_isBusy)
            return;

        _isBusy = true;
        _error = null;
        _movements = null;

        try
        {
            await ExecuteApiAsync(async ct =>
            {
                var search = string.IsNullOrWhiteSpace(_searchQuery) ? null : _searchQuery.Trim();

                _movements = await AccountsApi.GetMovementsAsync(Id, _fromDate, _toDate, search, 1, 50, ct);
            });
        }
        catch (KeyNotFoundException)
        {
            _error = "Account not found.";
        }
        catch (Exception ex)
        {
            _error = $"Error loading movements: {ex.Message}";
        }
        finally
        {
            _isBusy = false;
        }
    }

    private void GoBack()
    {
        Nav.NavigateTo("/accounts");
    }

    private void NavigateToTransaction(Guid transactionId)
    {
        Nav.NavigateTo($"/transactions/{transactionId}");
    }

    private string GetAmountBadgeClass(decimal amount)
    {
        return amount < 0 ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger";
    }

    private string GetRunningBalanceClass(decimal runningBalance)
    {
        if (runningBalance > 0)
            return "text-success";
        if (runningBalance < 0)
            return "text-danger";
        return "text-muted";
    }

    private void OpenReconcileModal()
    {
        _reconcileModel.ActualBalance = 0m;
        _reconcileModel.AsOfDate = DateTime.Today;
        _reconcileModel.Note = string.Empty;
        _reconcileError = null;
        _showReconcileModal = true;
    }

    private void CloseReconcileModal()
    {
        _showReconcileModal = false;
        _reconcileError = null;
    }

    private async Task SubmitReconcileAsync()
    {
        if (_isReconciling)
            return;

        _isReconciling = true;
        _reconcileError = null;
        _success = null;
        _error = null;

        try
        {
            await ExecuteApiAsync(async ct =>
            {
                var result = await AccountsApi.ReconcileAsync(
                    Id,
                    _reconcileModel.ActualBalance,
                    DateOnly.FromDateTime(_reconcileModel.AsOfDate),
                    string.IsNullOrWhiteSpace(_reconcileModel.Note) ? null : _reconcileModel.Note.Trim(),
                    ct);

                _showReconcileModal = false;

                if (result.AdjustmentCreated)
                {
                    _success = $"Reconciliation complete! {result.Message} (Computed: {result.ComputedBalance:C2}, Actual: {result.ActualBalance:C2}, Difference: {result.Difference:C2})";
                }
                else
                {
                    _success = result.Message;
                }

                // Reload movements to show the new adjustment transaction
                await LoadMovementsAsync();
            });
        }
        catch (InvalidOperationException ex)
        {
            _reconcileError = ex.Message;
        }
        catch (KeyNotFoundException ex)
        {
            _reconcileError = ex.Message;
            _showReconcileModal = false;
        }
        catch (Exception ex)
        {
            _reconcileError = $"Unexpected error: {ex.Message}";
        }
        finally
        {
            _isReconciling = false;
        }
    }

    private string FormatAmount(decimal amount)
    {
        // Display with correct sign: positive for inflows, negative for outflows
        return amount.ToString("C2", CultureInfo.CurrentCulture);
    }

    private sealed class ReconcileModel
    {
        [Required]
        public decimal ActualBalance { get; set; }

        [Required]
        public DateTime AsOfDate { get; set; } = DateTime.Today;

        [MaxLength(200)]
        public string Note { get; set; } = string.Empty;
    }
}
