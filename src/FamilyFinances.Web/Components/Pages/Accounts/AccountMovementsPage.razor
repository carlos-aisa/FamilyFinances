@page "/accounts/{Id:guid}/movements"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using FamilyFinances.Application.Reporting.Dtos
@using FamilyFinances.Web.Api
@using FamilyFinances.Web.Components.Base
@using FamilyFinances.Web.Components.Pages.Transactions
@using FamilyFinances.Web.Components.Shared
@using FamilyFinances.Web.Features.Reports
@using FamilyFinances.Web
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.Extensions.Localization
@inherits ApiPageBase

@inject IAccountsApi AccountsApi
@inject IStringLocalizer<SharedResource> L

<AuthorizeView>
    <Authorized Context="auth">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-2">
                        <li class="breadcrumb-item"><a href="/accounts">@L["AccountMovements_BreadcrumbAccounts"]</a></li>
                        <li class="breadcrumb-item active" aria-current="page">@L["AccountMovements_BreadcrumbMovements"]</li>
                    </ol>
                </nav>
                <h3 class="mb-0">
                    <i class="bi bi-list-ul me-2"></i>@(_movements?.AccountName ?? L["AccountMovements_DefaultTitle"])
                </h3>
            </div>

            <div class="d-flex gap-2">
                <button class="btn btn-warning" @onclick="OpenReconcileModal" disabled="@_isBusy">
                    <i class="bi bi-check2-square me-1"></i>@L["AccountMovements_Reconcile"]
                </button>
                <button class="btn btn-outline-secondary" @onclick="GoBack">
                    <i class="bi bi-arrow-left me-1"></i>@L["AccountMovements_BackToAccounts"]
                </button>
            </div>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-header bg-light">
                <h5 class="card-title mb-0">
                    <i class="bi bi-funnel me-2"></i>@L["AccountMovements_Filters"]
                </h5>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-calendar-range me-1"></i>@L["AccountMovements_QuickSelect"]
                        </label>
                        <div>
                            <DateRangePresets OnPresetSelected="HandlePresetSelected" ActivePreset="@_activePreset" />
                        </div>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-calendar3 me-1"></i>@L["AccountMovements_FromDate"]
                        </label>
                        <input type="date" class="form-control" @bind="_fromDate" @bind:event="oninput" @bind:after="OnDateChanged" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-calendar3 me-1"></i>@L["AccountMovements_ToDate"]
                        </label>
                        <input type="date" class="form-control" @bind="_toDate" @bind:event="oninput" @bind:after="OnDateChanged" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-search me-1"></i>@L["AccountMovements_Search"]
                        </label>
                        <input type="text" class="form-control" placeholder="@L["AccountMovements_SearchPlaceholder"]" @bind="_searchQuery" @bind:event="oninput" />
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">&nbsp;</label>
                        <button class="btn btn-primary w-100" @onclick="LoadMovementsAsync" disabled="@_isBusy">
                            @if (_isBusy)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            }
                            else
                            {
                                <i class="bi bi-search me-1"></i>
                            }
                            @L["AccountMovements_SearchButton"]
                        </button>
                    </div>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(_success))
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle me-2"></i>@_success
                <button type="button" class="btn-close" @onclick="@(() => _success = null)"></button>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle me-2"></i>@_error
                <button type="button" class="btn-close" @onclick="@(() => _error = null)"></button>
            </div>
        }

        @if (_movements is null)
        {
            <div class="d-flex justify-content-center align-items-center ff-loading-shell">
                <div class="text-center">
                    <div class="spinner-border text-primary mb-3 ff-spinner-lg" role="status">
                        <span class="visually-hidden">@L["Common_Loading"]</span>
                    </div>
                    <p class="text-muted">@L["AccountMovements_LoadingMovements"]</p>
                </div>
            </div>
        }
        else if (_movements.Items.Count == 0)
        {
            <div class="card shadow-sm">
                <div class="card-body text-center py-5">
                    <i class="bi bi-inbox display-1 text-muted mb-3"></i>
                    <h5 class="text-muted">@L["AccountMovements_EmptyTitle"]</h5>
                    <p class="text-muted">@GetEmptyDescription()</p>
                </div>
            </div>
        }
        else
        {
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">
                            <i class="bi bi-list-ul me-2"></i>@L["AccountMovements_Movements"]
                        </h5>
                        <span class="badge bg-primary">
                            @L["AccountMovements_ShowingOfTotal", _movements.Items.Count, _movements.TotalCount]
                        </span>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="border-0 ps-3 ff-w-120">
                                        <i class="bi bi-calendar3 me-1"></i>@L["AccountMovements_TableDate"]
                                    </th>
                                    <th class="border-0">
                                        <i class="bi bi-file-text me-1"></i>@L["AccountMovements_TableDescription"]
                                    </th>
                                    <th class="border-0 ff-w-200">
                                        <i class="bi bi-person me-1"></i>@L["AccountMovements_TablePayee"]
                                    </th>
                                    <th class="border-0 ff-w-200">
                                        <i class="bi bi-arrow-left-right me-1"></i>@L["AccountMovements_TableCounterparty"]
                                    </th>
                                    <th class="border-0 text-end pe-3 ff-w-160">
                                        <i class="bi bi-currency-euro me-1"></i>@L["AccountMovements_TableAmount"]
                                    </th>
                                    <th class="border-0 text-end pe-3 ff-w-180">
                                        <i class="bi bi-graph-up-arrow me-1"></i>@L["AccountMovements_TableRunningBalance"]
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var movement in _movements.Items)
                                {
                                    <tr class="movement-row ff-clickable" @onclick="@(() => NavigateToTransaction(movement.TransactionId))">
                                        <td class="ps-3">
                                            <div class="d-flex flex-column">
                                                <span class="fw-semibold">@movement.BookedOn.ToString("dd MMM", CultureInfo.CurrentCulture)</span>
                                                <small class="text-muted">@movement.BookedOn.Year</small>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="fw-semibold">@movement.Description</span>
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrWhiteSpace(movement.PayeeName))
                                            {
                                                <span class="badge bg-secondary-subtle text-secondary">
                                                    <i class="bi bi-person me-1"></i>@movement.PayeeName
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrWhiteSpace(movement.CounterpartyAccountName))
                                            {
                                                <small class="text-muted">
                                                    <i class="bi bi-arrow-left-right me-1"></i>@movement.CounterpartyAccountName
                                                </small>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td class="text-end pe-3">
                                            <span class="badge @GetAmountBadgeClass(movement.SignedAmount) fs-6 px-3 py-2">
                                                @FormatAmount(movement.SignedAmount)
                                            </span>
                                        </td>
                                        <td class="text-end pe-3">
                                            <span class="fw-semibold @GetRunningBalanceClass(movement.RunningBalance)">
                                                @FormatAmount(movement.RunningBalance)
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="card-footer bg-light">
                    <div class="d-flex justify-content-between align-items-center">
                        <small class="text-muted">
                            @L["AccountMovements_FooterShowing", _movements.Items.Count, _movements.TotalCount]
                        </small>
                        <small class="text-muted">
                            <i class="bi bi-info-circle me-1"></i>@L["AccountMovements_ClickMovementHint"]
                        </small>
                    </div>
                </div>
            </div>
        }
    </Authorized>

    <NotAuthorized>
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <i class="bi bi-shield-lock display-1 text-muted mb-3"></i>
                <h5 class="text-muted">@L["AccountMovements_AuthenticationRequired"]</h5>
                <p class="text-muted">@L["AccountMovements_MustLogin"]</p>
                <a class="btn btn-primary mt-3" href="/login">
                    <i class="bi bi-box-arrow-in-right me-1"></i>@L["Common_Login"]
                </a>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>

@if (_showReconcileModal)
{
    <div class="modal fade show d-block ff-modal-overlay" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-warning">
                    <h5 class="modal-title">
                        <i class="bi bi-check2-square me-2"></i>@L["AccountMovements_ReconcileTitle"]
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseReconcileModal" disabled="@_isReconciling"></button>
                </div>
                <EditForm Model="_reconcileModel" OnValidSubmit="SubmitReconcileAsync">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        @if (!string.IsNullOrWhiteSpace(_reconcileError))
                        {
                            <div class="alert alert-danger">
                                <i class="bi bi-exclamation-triangle me-2"></i>@_reconcileError
                            </div>
                        }

                        <div class="mb-3">
                            <label class="form-label fw-semibold">@L["AccountMovements_ActualBalance"]</label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-currency-euro"></i>
                                </span>
                                <InputNumber @bind-Value="_reconcileModel.ActualBalance" class="form-control" step="0.01" />
                            </div>
                            <ValidationMessage For="@(() => _reconcileModel.ActualBalance)" class="text-danger small" />
                            <small class="text-muted">@L["AccountMovements_ActualBalanceHint"]</small>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">@L["AccountMovements_AsOfDate"]</label>
                            <InputDate @bind-Value="_reconcileModel.AsOfDate" class="form-control" />
                            <ValidationMessage For="@(() => _reconcileModel.AsOfDate)" class="text-danger small" />
                            <small class="text-muted">@L["AccountMovements_AsOfDateHint"]</small>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">@L["AccountMovements_NoteOptional"]</label>
                            <InputText @bind-Value="_reconcileModel.Note" class="form-control" placeholder="@L["AccountMovements_NotePlaceholder"]" />
                            <ValidationMessage For="@(() => _reconcileModel.Note)" class="text-danger small" />
                            <small class="text-muted">@L["AccountMovements_NoteHint"]</small>
                        </div>

                        <div class="alert alert-info mb-0">
                            <i class="bi bi-info-circle me-2"></i>
                            <small>@L["AccountMovements_ReconcileInfo"]</small>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseReconcileModal" disabled="@_isReconciling">
                            <i class="bi bi-x-circle me-1"></i>@L["TransactionEdit_Cancel"]
                        </button>
                        <button type="submit" class="btn btn-warning" disabled="@_isReconciling">
                            @if (_isReconciling)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            }
                            <i class="bi bi-check2-square me-1"></i>@L["AccountMovements_Reconcile"]
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

<style>
    .movement-row {
        transition: background-color 0.2s ease-in-out;
    }

    .movement-row:hover {
        background-color: rgba(13, 110, 253, 0.05) !important;
    }
</style>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private AccountMovementsDto? _movements;
    private string? _error;
    private string? _success;
    private bool _isBusy;

    private DateOnly _fromDate = DateHelper.GetCurrentMonthStart();
    private DateOnly _toDate = DateHelper.GetCurrentMonthEnd();
    private string _searchQuery = string.Empty;
    private string? _activePreset = "this-month";

    private bool _showReconcileModal;
    private bool _isReconciling;
    private string? _reconcileError;
    private readonly ReconcileModel _reconcileModel = new();
    private TransactionOriginContext _originContext = new(TransactionOrigin.AccountsMovements);

    private async Task HandlePresetSelected(DateRangePresets.DateRangePreset preset)
    {
        var (from, to) = preset.GetDateRange();
        _fromDate = from;
        _toDate = to;
        _activePreset = preset.Type.ToString().ToLowerInvariant().Replace("_", "-");

        await LoadMovementsAsync();
    }

    private void OnDateChanged()
    {
        _activePreset = null;
    }

    protected override async Task OnInitializedAsync()
    {
        _originContext = TransactionOriginContext.FromNavigation(Nav);
        await LoadMovementsAsync();
    }

    private async Task LoadMovementsAsync()
    {
        if (_isBusy)
            return;

        _isBusy = true;
        _error = null;
        _movements = null;

        try
        {
            await ExecuteApiAsync(async ct =>
            {
                var search = string.IsNullOrWhiteSpace(_searchQuery) ? null : _searchQuery.Trim();

                _movements = await AccountsApi.GetMovementsAsync(Id, _fromDate, _toDate, search, 1, 50, ct);
            });
        }
        catch (KeyNotFoundException)
        {
            _error = L["AccountMovements_AccountNotFound"];
        }
        catch (Exception ex)
        {
            _error = L["AccountMovements_LoadError", ex.Message];
        }
        finally
        {
            _isBusy = false;
        }
    }

    private void GoBack()
    {
        Nav.NavigateTo("/accounts");
    }

    private void NavigateToTransaction(Guid transactionId)
    {
        var detailOrigin = _originContext.Origin switch
        {
            TransactionOrigin.ReportCategoryTotals => TransactionOrigin.ReportCategoryTotals,
            TransactionOrigin.ReportAccountTotals => TransactionOrigin.ReportAccountTotals,
            _ => TransactionOrigin.AccountsMovements
        };

        var context = new TransactionOriginContext(
            Origin: detailOrigin,
            AccountId: Id,
            From: _fromDate,
            To: _toDate,
            Year: _originContext.Year);

        Nav.NavigateTo(context.BuildUri($"/transactions/{transactionId}"));
    }

    private string GetAmountBadgeClass(decimal amount)
    {
        return amount < 0 ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger";
    }

    private string GetRunningBalanceClass(decimal runningBalance)
    {
        return MoneyFormatter.GetColorClass(runningBalance);
    }

    private string GetEmptyDescription()
    {
        return string.IsNullOrWhiteSpace(_searchQuery)
            ? L["AccountMovements_EmptyDescriptionNoSearch"]
            : L["AccountMovements_EmptyDescriptionWithSearch"];
    }

    private void OpenReconcileModal()
    {
        _reconcileModel.ActualBalance = 0m;
        _reconcileModel.AsOfDate = DateTime.Today;
        _reconcileModel.Note = string.Empty;
        _reconcileError = null;
        _showReconcileModal = true;
    }

    private void CloseReconcileModal()
    {
        _showReconcileModal = false;
        _reconcileError = null;
    }

    private async Task SubmitReconcileAsync()
    {
        if (_isReconciling)
            return;

        _isReconciling = true;
        _reconcileError = null;
        _success = null;
        _error = null;

        try
        {
            await ExecuteApiAsync(async ct =>
            {
                var result = await AccountsApi.ReconcileAsync(
                    Id,
                    _reconcileModel.ActualBalance,
                    DateOnly.FromDateTime(_reconcileModel.AsOfDate),
                    string.IsNullOrWhiteSpace(_reconcileModel.Note) ? null : _reconcileModel.Note.Trim(),
                    ct);

                _showReconcileModal = false;

                if (result.AdjustmentCreated)
                {
                    _success = L[
                        "AccountMovements_ReconcileSuccessWithAmounts",
                        result.Message,
                        MoneyFormatter.FormatEuros(result.ComputedBalance),
                        MoneyFormatter.FormatEuros(result.ActualBalance),
                        MoneyFormatter.FormatEuros(result.Difference)
                    ];
                }
                else
                {
                    _success = result.Message;
                }

                await LoadMovementsAsync();
            });
        }
        catch (InvalidOperationException ex)
        {
            _reconcileError = ex.Message;
        }
        catch (KeyNotFoundException ex)
        {
            _reconcileError = ex.Message;
            _showReconcileModal = false;
        }
        catch (Exception ex)
        {
            _reconcileError = L["AccountMovements_ReconcileUnexpectedError", ex.Message];
        }
        finally
        {
            _isReconciling = false;
        }
    }

    private string FormatAmount(decimal amount)
    {
        return MoneyFormatter.FormatEuros(amount);
    }

    private sealed class ReconcileModel
    {
        [Required]
        public decimal ActualBalance { get; set; }

        [Required]
        public DateTime AsOfDate { get; set; } = DateTime.Today;

        [MaxLength(200)]
        public string Note { get; set; } = string.Empty;
    }
}


