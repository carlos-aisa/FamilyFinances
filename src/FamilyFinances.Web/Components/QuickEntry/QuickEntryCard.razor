@using FamilyFinances.Web.Components.Dashboard

<div class="card shadow-sm mb-3 border-start border-4 @GetBorderClass()">
    <div class="card-header @GetHeaderClass() cursor-pointer" @onclick="OnHeaderClick">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h6 class="mb-0 @GetTextClass()">
                    <i class="@GetIcon() me-2"></i>@Title
                </h6>
                <small class="@GetSubtitleClass()">@Subtitle</small>
            </div>
            <i class="bi @(IsActive ? "bi-chevron-up" : "bi-chevron-down") @GetTextClass()"></i>
        </div>
    </div>

    @if (IsActive)
    {
        <div class="card-body">
            @ChildContent
        </div>
    }
</div>

<style>
    .cursor-pointer {
        cursor: pointer;
    }

    .cursor-pointer:hover {
        opacity: 0.9;
    }
</style>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public QuickEntryType? Type { get; set; }
    [Parameter] public bool IsActive { get; set; }
    [Parameter] public EventCallback OnHeaderClick { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string GetBorderClass() => ResolveType() switch
    {
        QuickEntryType.Expense => "border-danger",
        QuickEntryType.Income => "border-success",
        QuickEntryType.Transfer => "border-primary",
        QuickEntryType.Refund => "border-info",
        _ => "border-secondary"
    };

    private string GetHeaderClass() => ResolveType() switch
    {
        QuickEntryType.Expense => "bg-danger-subtle",
        QuickEntryType.Income => "bg-success-subtle",
        QuickEntryType.Transfer => "bg-primary-subtle",
        QuickEntryType.Refund => "bg-info-subtle",
        _ => "bg-secondary-subtle"
    };

    private string GetTextClass() => ResolveType() switch
    {
        QuickEntryType.Expense => "text-danger-emphasis",
        QuickEntryType.Income => "text-success-emphasis",
        QuickEntryType.Transfer => "text-primary-emphasis",
        QuickEntryType.Refund => "text-info-emphasis",
        _ => "text-secondary-emphasis"
    };

    private string GetSubtitleClass() => ResolveType() switch
    {
        QuickEntryType.Expense => "text-danger-emphasis opacity-75",
        QuickEntryType.Income => "text-success-emphasis opacity-75",
        QuickEntryType.Transfer => "text-primary-emphasis opacity-75",
        QuickEntryType.Refund => "text-info-emphasis opacity-75",
        _ => "text-secondary-emphasis opacity-75"
    };

    private string GetIcon() => ResolveType() switch
    {
        QuickEntryType.Expense => "bi-arrow-up-circle",
        QuickEntryType.Income => "bi-arrow-down-circle",
        QuickEntryType.Transfer => "bi-arrow-left-right",
        QuickEntryType.Refund => "bi-arrow-counterclockwise",
        _ => "bi-wallet2"
    };

    private QuickEntryType? ResolveType()
    {
        if (Type is not null)
            return Type.Value;

        return Title.ToLowerInvariant() switch
        {
            "expense" => QuickEntryType.Expense,
            "income" => QuickEntryType.Income,
            "transfer" => QuickEntryType.Transfer,
            "refund" => QuickEntryType.Refund,
            _ => null
        };
    }
}
