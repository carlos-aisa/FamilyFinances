@inherits FamilyFinances.Web.Components.Base.ApiPageBase

@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using FamilyFinances.Application.Ledger.Accounts.Dtos
@using FamilyFinances.Application.Ledger.Payees.Dtos
@using FamilyFinances.Application.Ledger.Transactions.Dtos
@using FamilyFinances.Domain.Ledger.Accounts
@using FamilyFinances.Web
@using FamilyFinances.Web.Components.Dashboard
@using FamilyFinances.Web.Components.Shared
@using FamilyFinances.Web.Features.Reports
@using FamilyFinances.Web.Features.Transactions
@using Microsoft.Extensions.Localization
@inject FamilyFinances.Web.Api.TransactionsApi TransactionsApi
@inject IStringLocalizer<SharedResource> L

<div class="mb-3 p-3 bg-light rounded border">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div class="flex-grow-1">
            <small class="text-muted d-block">
                <i class="bi bi-arrow-up-right me-1"></i>
                <strong>@L["QuickEntryDrawer_From"]:</strong> <span class="text-body">@(FromAccountName ?? "-")</span>
            </small>
            <small class="text-muted d-block">
                <i class="bi bi-arrow-down-left me-1"></i>
                <strong>@L["QuickEntryDrawer_To"]:</strong> <span class="text-body">@(ToAccountName ?? "-")</span>
            </small>
        </div>

        <div class="d-flex gap-2">
            @if (Mode == QuickEntryType.Transfer)
            {
                <button type="button"
                        class="btn btn-sm btn-outline-primary"
                        @onclick="SwapAccountsClicked"
                        disabled="@(SelectedFromAccountId is null || SelectedToAccountId is null)"
                        title="@L["QuickEntryDrawer_SwapAccounts"]">
                    <i class="bi bi-arrow-left-right me-1"></i>@L["QuickEntryDrawer_SwapAccounts"]
                </button>
            }

            <button type="button"
                    class="btn btn-sm btn-outline-secondary"
                    @onclick="ClearSelectionClicked"
                    title="@L["QuickEntryDrawer_ClearSelection"]">
                <i class="bi bi-x-circle me-1"></i>@L["QuickEntryDrawer_ClearSelection"]
            </button>
        </div>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-2"></i>@_error
        <button type="button" class="btn-close" @onclick="@(() => _error = null)"></button>
    </div>
}

@if (!string.IsNullOrWhiteSpace(_info))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2"></i>@_info
        <button type="button" class="btn-close" @onclick="@(() => _info = null)"></button>
    </div>
}

<EditForm Model="_model" OnValidSubmit="CreateAsync">
    <ValidationSummary class="text-danger" />

    <div class="row g-3">
        <div class="col-md-4">
            <label class="form-label">
                <i class="bi bi-calendar-event me-1"></i>@L["QuickEntryDrawer_Date"]
            </label>
            <InputDate class="form-control" @bind-Value="_model.BookedOn" @bind-Value:after="ValidateForm" />
        </div>

        <div class="col-md-8">
            <label class="form-label">
                <i class="bi bi-pencil me-1"></i>@L["QuickEntryDrawer_Description"]
            </label>
            <input type="text"
                   class="form-control"
                   placeholder="@L["QuickEntryDrawer_DescriptionPlaceholder"]"
                   @bind="_model.Description"
                   @bind:event="oninput"
                   @bind:after="ValidateForm" />
        </div>

        <div class="col-md-4">
            <label class="form-label">
                <i class="bi bi-currency-euro me-1"></i>@L["QuickEntryDrawer_Amount"]
            </label>
            <div class="input-group">
                <input type="text"
                       class="form-control"
                       placeholder="@L["QuickEntryDrawer_AmountPlaceholder"]"
                       @bind="_amountText"
                       @bind:event="oninput"
                       @bind:after="OnAmountChanged" />
                <span class="input-group-text">&euro;</span>
            </div>
        </div>

        @if (Mode != QuickEntryType.Transfer)
        {
            <div class="col-md-8">
                <PayeeSelector @bind-SelectedPayeeId="_model.PayeeId"
                               IsRequired="false"
                               IsDisabled="@_isBusy"
                               @bind-SelectedPayeeId:after="OnPayeeChanged" />
            </div>
        }

        @if (Mode == QuickEntryType.Refund)
        {
            <div class="col-12 mt-2">
                <div class="card border-secondary">
                    <div class="card-header bg-secondary-subtle" style="cursor: pointer;" @onclick="ToggleExpenseSearch">
                        <small class="text-muted">
                            <i class="bi bi-link-45deg me-1"></i>
                            <strong>@L["QuickEntryDrawer_LinkOriginalExpense"]</strong>
                            <i class="bi @(_showExpenseSearch ? "bi-chevron-up" : "bi-chevron-down") float-end"></i>
                        </small>
                    </div>
                    @if (_showExpenseSearch)
                    {
                        <div class="card-body">
                            <input type="text"
                                   class="form-control mb-2"
                                   placeholder="@L["QuickEntryDrawer_SearchExpensesPlaceholder"]"
                                   @bind="_expenseSearchQuery"
                                   @bind:event="oninput"
                                   @bind:after="SearchExpensesAsync" />

                            @if (_isSearching)
                            {
                                <div class="text-center py-2">
                                    <span class="spinner-border spinner-border-sm" role="status"></span>
                                </div>
                            }
                            else if (_expenseSearchResults.Any())
                            {
                                <div class="list-group">
                                    @foreach (var expense in _expenseSearchResults)
                                    {
                                        <button type="button"
                                                class="list-group-item list-group-item-action @(_model.RelatedTransactionId == expense.Id ? "active" : "")"
                                                @onclick="() => SelectExpense(expense)">
                                            <div class="d-flex justify-content-between align-items-start">
                                                <div class="flex-grow-1">
                                                    <strong>@expense.Description</strong>
                                                    <small class="d-block text-muted">
                                                        @expense.BookedOn.ToString("MMM dd, yyyy", CultureInfo.CurrentCulture)
                                                        @if (!string.IsNullOrWhiteSpace(expense.PayeeName))
                                                        {
                                                            <span> - @expense.PayeeName</span>
                                                        }
                                                        <br />
                                                        <i class="bi bi-tag me-1"></i>@expense.ExpenseAccountName
                                                    </small>
                                                </div>
                                                <span class="badge bg-primary">@MoneyFormatter.FormatEuros(expense.Amount)</span>
                                            </div>
                                        </button>
                                    }
                                </div>
                            }
                            else if (!string.IsNullOrWhiteSpace(_expenseSearchQuery) && _expenseSearchQuery.Length >= 2 && !_isSearching)
                            {
                                <div class="alert alert-info mb-0">
                                    <i class="bi bi-info-circle me-2"></i>
                                    <small>@L["QuickEntryDrawer_NoExpensesFound"]</small>
                                </div>
                            }

                            @if (_model.RelatedTransactionId is not null)
                            {
                                <div class="mt-2">
                                    <button type="button" class="btn btn-sm btn-outline-danger" @onclick="ClearExpenseLink">
                                        <i class="bi bi-x-circle me-1"></i>@L["QuickEntryDrawer_ClearLink"]
                                    </button>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(_formError))
    {
        <div class="alert alert-warning mt-3" role="alert">
            <i class="bi bi-exclamation-circle me-2"></i>@_formError
        </div>
    }

    <div class="mt-3 d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div class="form-check">
            <InputCheckbox class="form-check-input" id="@_checkboxId" @bind-Value="_model.KeepSource" />
            <label class="form-check-label" for="@_checkboxId">
                <i class="bi bi-pin me-1"></i>@L["QuickEntryDrawer_KeepSourceAccount"]
            </label>
        </div>

        <button type="submit" class="btn btn-primary" disabled="@(!_canSubmit || _isBusy)">
            @if (_isBusy)
            {
                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
            }
            else
            {
                <i class="bi bi-plus-circle me-1"></i>
            }
            @L["QuickEntryDrawer_CreateTransaction"]
        </button>
    </div>
</EditForm>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<AccountDto> Accounts { get; set; } = Array.Empty<AccountDto>();
    [Parameter, EditorRequired] public IReadOnlyList<PayeeDto> Payees { get; set; } = Array.Empty<PayeeDto>();

    [Parameter] public Guid? SelectedFromAccountId { get; set; }
    [Parameter] public Guid? SelectedToAccountId { get; set; }

    [Parameter] public EventCallback OnTransactionCreated { get; set; }
    [Parameter] public EventCallback OnClearSelection { get; set; }
    [Parameter] public EventCallback OnSwapAccounts { get; set; }

    [Parameter] public QuickEntryType Mode { get; set; }

    [Parameter] public required Dictionary<QuickEntryType, QuickEntrySpec> Specs { get; set; }

    private bool _isBusy;
    private bool _canSubmit;
    private string? _error;
    private string? _info;
    private string? _formError;
    private string _amountText = "";
    private readonly string _checkboxId = Guid.NewGuid().ToString();

    private QuickEntryModel _model = new()
    {
        BookedOn = DateOnly.FromDateTime(DateTime.Today)
    };

    private string? FromAccountName => Accounts.FirstOrDefault(a => a.Id == SelectedFromAccountId)?.Name;
    private string? ToAccountName => Accounts.FirstOrDefault(a => a.Id == SelectedToAccountId)?.Name;

    private bool _showExpenseSearch;
    private bool _isSearching;
    private string _expenseSearchQuery = "";
    private List<ExpenseSearchResultDto> _expenseSearchResults = new();

    protected override void OnParametersSet()
    {
        ValidateForm();
    }

    private void OnAmountChanged()
    {
        if (string.IsNullOrWhiteSpace(_amountText))
        {
            _model.Amount = 0;
        }
        else
        {
            var normalizedText = _amountText.Replace(',', '.');

            if (decimal.TryParse(
                normalizedText,
                NumberStyles.AllowDecimalPoint | NumberStyles.AllowLeadingSign,
                CultureInfo.InvariantCulture,
                out var amount))
            {
                _model.Amount = amount;
            }
        }

        ValidateForm();
    }

    private void OnPayeeChanged()
    {
        ValidateForm();
    }

    private void ValidateForm()
    {
        _formError = null;

        var spec = Specs[Mode];

        if (SelectedFromAccountId is null)
        {
            _formError = GetMissingFromAccountMessage();
        }
        else if (SelectedToAccountId is null)
        {
            _formError = GetMissingToAccountMessage();
        }
        else if (SelectedFromAccountId == SelectedToAccountId)
        {
            _formError = L["QuickEntryDrawer_Error_FromToDifferent"];
        }
        else
        {
            var from = Accounts.FirstOrDefault(a => a.Id == SelectedFromAccountId);
            if (from is not null && !spec.FromAllowed.Contains(from.Nature))
            {
                _formError = L["QuickEntryDrawer_Error_FromAllowedNatures", FormatNatureList(spec.FromAllowed)];
            }

            var to = Accounts.FirstOrDefault(a => a.Id == SelectedToAccountId);
            if (_formError is null && to is not null && !spec.ToAllowed.Contains(to.Nature))
            {
                _formError = L["QuickEntryDrawer_Error_ToAllowedNatures", FormatNatureList(spec.ToAllowed)];
            }
        }

        if (_formError is null)
        {
            if (string.IsNullOrWhiteSpace(_model.Description))
            {
                _formError = L["QuickEntryDrawer_Error_DescriptionRequired"];
            }
            else if (_model.Amount <= 0)
            {
                _formError = L["QuickEntryDrawer_Error_AmountGreaterThanZero"];
            }
        }

        _canSubmit = string.IsNullOrWhiteSpace(_formError);

        if (_canSubmit)
        {
            _error = null;
        }
    }

    private async Task CreateAsync()
    {
        ValidateForm();

        if (!_canSubmit || _isBusy)
        {
            return;
        }

        _isBusy = true;
        _error = null;
        _info = null;
        StateHasChanged();

        try
        {
            await ExecuteApiAsync(async ct =>
            {
                var request = Mode switch
                {
                    QuickEntryType.Expense => ExpenseTransactionFactory.Build(
                        bookedOn: _model.BookedOn,
                        description: _model.Description.Trim(),
                        fromAccountId: SelectedFromAccountId!.Value,
                        expenseAccountId: SelectedToAccountId!.Value,
                        amount: _model.Amount,
                        payeeId: _model.PayeeId,
                        memo: null),

                    QuickEntryType.Income => IncomeTransactionFactory.Build(
                        bookedOn: _model.BookedOn,
                        description: _model.Description.Trim(),
                        incomeAccountId: SelectedFromAccountId!.Value,
                        destinationAccountId: SelectedToAccountId!.Value,
                        amount: _model.Amount,
                        payeeId: _model.PayeeId,
                        memo: null),

                    QuickEntryType.Transfer => TransferTransactionFactory.Build(
                        bookedOn: _model.BookedOn,
                        description: _model.Description.Trim(),
                        fromAccountId: SelectedFromAccountId!.Value,
                        toAccountId: SelectedToAccountId!.Value,
                        amount: _model.Amount,
                        memo: null),

                    QuickEntryType.Refund => RefundTransactionFactory.Build(
                        bookedOn: _model.BookedOn,
                        description: _model.Description.Trim(),
                        expenseAccountId: SelectedFromAccountId!.Value,
                        destinationAccountId: SelectedToAccountId!.Value,
                        amount: _model.Amount,
                        payeeId: _model.PayeeId,
                        memo: null,
                        relatedTransactionId: _model.RelatedTransactionId),

                    _ => throw new InvalidOperationException($"Unknown transaction type: {Mode}")
                };

                await TransactionsApi.CreateAsync(request, ct);
            });

            _info = L["QuickEntryDrawer_Info_TransactionCreated"];

            _model.Amount = 0m;
            _model.Description = "";
            _model.PayeeId = null;
            _model.RelatedTransactionId = null;
            _amountText = "";
            _expenseSearchQuery = "";
            _expenseSearchResults.Clear();
            _showExpenseSearch = false;

            await OnTransactionCreated.InvokeAsync();

            if (!_model.KeepSource)
            {
                await OnClearSelection.InvokeAsync();
            }

            ValidateForm();
        }
        catch (Exception ex)
        {
            _error = L["QuickEntryDrawer_Error_CreateFailed", ex.Message];
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task ClearSelectionClicked()
    {
        await OnClearSelection.InvokeAsync();
        ValidateForm();
    }

    private async Task SwapAccountsClicked()
    {
        await OnSwapAccounts.InvokeAsync();
    }

    private void ToggleExpenseSearch()
    {
        _showExpenseSearch = !_showExpenseSearch;
    }

    private async Task SearchExpensesAsync()
    {
        if (string.IsNullOrWhiteSpace(_expenseSearchQuery) || _expenseSearchQuery.Length < 2)
        {
            _expenseSearchResults.Clear();
            return;
        }

        _isSearching = true;
        StateHasChanged();

        try
        {
            await ExecuteApiAsync(async ct =>
            {
                _expenseSearchResults = await TransactionsApi.SearchExpensesAsync(
                    query: _expenseSearchQuery,
                    expenseAccountId: SelectedFromAccountId,
                    limit: 20,
                    ct);
            });
        }
        catch (Exception ex)
        {
            _error = L["QuickEntryDrawer_Error_SearchFailed", ex.Message];
            _expenseSearchResults.Clear();
        }
        finally
        {
            _isSearching = false;
        }
    }

    private void SelectExpense(ExpenseSearchResultDto expense)
    {
        _model.RelatedTransactionId = expense.Id;
    }

    private void ClearExpenseLink()
    {
        _model.RelatedTransactionId = null;
    }

    private string GetMissingFromAccountMessage()
    {
        return Mode switch
        {
            QuickEntryType.Transfer => L["QuickEntryDrawer_Error_SelectFromTransfer"],
            QuickEntryType.Income => L["QuickEntryDrawer_Error_SelectFromIncome"],
            QuickEntryType.Refund => L["QuickEntryDrawer_Error_SelectFromRefund"],
            _ => L["QuickEntryDrawer_Error_SelectFromExpense"]
        };
    }

    private string GetMissingToAccountMessage()
    {
        return Mode switch
        {
            QuickEntryType.Transfer => L["QuickEntryDrawer_Error_SelectToTransfer"],
            QuickEntryType.Income => L["QuickEntryDrawer_Error_SelectToIncome"],
            QuickEntryType.Refund => L["QuickEntryDrawer_Error_SelectToRefund"],
            _ => L["QuickEntryDrawer_Error_SelectToExpense"]
        };
    }

    private string FormatNatureList(IEnumerable<AccountNature> natures)
    {
        return string.Join(", ", natures.Select(GetNatureLabel));
    }

    private string GetNatureLabel(AccountNature nature)
    {
        return nature switch
        {
            AccountNature.Asset => L["Dashboard_Nature_Asset"],
            AccountNature.Liability => L["Dashboard_Nature_Liability"],
            AccountNature.Expense => L["Dashboard_Nature_Expense"],
            AccountNature.Income => L["Dashboard_Nature_Income"],
            _ => nature.ToString()
        };
    }

    private sealed class QuickEntryModel
    {
        [Required]
        public DateOnly BookedOn { get; set; }

        [Required, StringLength(200)]
        public string Description { get; set; } = "";

        [Range(typeof(decimal), "0,01", "999999999")]
        public decimal Amount { get; set; }

        public Guid? PayeeId { get; set; }

        public bool KeepSource { get; set; } = true;

        public Guid? RelatedTransactionId { get; set; }
    }
}
