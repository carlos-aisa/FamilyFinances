@using System.Globalization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Localization
@using FamilyFinances.Web.Components.Auth
@using FamilyFinances.Web.Api
@using FamilyFinances.Web.Auth
@using FamilyFinances.Web.Features.Reports
@using FamilyFinances.Web
@inject NavigationManager Navigation
@inject ReportsApi ReportsApi
@inject IApiTokenStore TokenStore
@inject AuthenticationStateProvider AuthStateProvider
@inject ILogger<NavMenu> Logger
@inject IStringLocalizer<SharedResource> L

@rendermode InteractiveServer
@implements IDisposable

<div class="top-row ps-3 navbar navbar-dark ff-nav-top">
    <div class="container-fluid">
        <a class="navbar-brand ff-nav-brand" href="">FamilyFinances</a>

        <div class="d-flex align-items-center gap-2">
            <AuthorizeView>
                <Authorized>
                    <a class="btn btn-sm btn-outline-light ff-nav-settings-button"
                       href="settings"
                       title="@L["Nav_Settings"]"
                       data-testid="nav-settings-link">
                        <i class="bi bi-gear" aria-hidden="true"></i>
                    </a>
                </Authorized>
            </AuthorizeView>
        </div>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable ff-nav-scroll" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">

        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link ff-nav-link" href="" Match="NavLinkMatch.All">
                        <span class="bi bi-house-door me-2 align-middle" aria-hidden="true"></span>@L["Nav_Home"]
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link ff-nav-link" href="accounts">
                        <span class="bi bi-wallet2 me-2 align-middle" aria-hidden="true"></span>@L["Nav_Accounts"]
                    </NavLink>
                </div>

                <div class="nav-item px-3 nav-quick-entry">
                    <NavLink class="nav-link ff-nav-link" href="quick-entry">
                        <span class="bi bi-lightning-charge me-2 align-middle" aria-hidden="true"></span>@L["Nav_QuickEntry"]
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link ff-nav-link" href="account-groups">
                        <span class="bi bi-collection me-2 align-middle" aria-hidden="true"></span>@L["Nav_AccountGroups"]
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link ff-nav-link" href="payees">
                        <span class="bi bi-person me-2 align-middle" aria-hidden="true"></span>@L["Nav_Payees"]
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link ff-nav-link" href="transactions">
                        <span class="bi bi-receipt me-2 align-middle" aria-hidden="true"></span>@L["Nav_Transactions"]
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link ff-nav-link" href="history">
                        <span class="bi bi-clock-history me-2 align-middle" aria-hidden="true"></span>@L["Nav_History"]
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link ff-nav-link" href="reports">
                        <span class="bi bi-graph-up me-2 align-middle" aria-hidden="true"></span>@L["Nav_Reports"]
                    </NavLink>
                </div>

                <div class="nav-item px-3 nav-economic-state">
                    <NavLink class="nav-link ff-nav-link" href="reports/economic-state">
                        <span class="bi bi-piggy-bank me-2 align-middle" aria-hidden="true"></span>@L["Nav_EconomicState"]
                    </NavLink>
                    <div class="nav-economic-state-preview">
                        <small class="text-muted d-block">@L["Nav_AssetBalance"]</small>
                        @if (_isAssetStateLoading && _assetBalanceCents is null)
                        {
                            <small class="text-muted">@L["Common_Loading"]</small>
                        }
                        else if (_assetBalanceCents is not null)
                        {
                            <strong class="@GetAmountClass(_assetBalanceCents.Value)">
                                @MoneyFormatter.FormatCents(_assetBalanceCents.Value)
                            </strong>
                            @if (_assetAsOf is not null)
                            {
                                <small class="text-muted d-block">@L["Nav_AsOf", _assetAsOf.Value.ToString("d", CultureInfo.CurrentCulture)]</small>
                            }
                        }
                        else
                        {
                            <small class="text-muted">@L["Nav_Unavailable"]</small>
                        }
                    </div>
                </div>

                <div class="nav-item px-3 mt-2">
                    <LogoutButton />
                </div>
            </Authorized>

            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link ff-nav-link" href="login">
                        <span class="bi bi-box-arrow-in-right me-2 align-middle" aria-hidden="true"></span>@L["Common_Login"]
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>

    </nav>
</div>

@code {
    private long? _assetBalanceCents;
    private DateOnly? _assetAsOf;
    private bool _isAssetStateLoading;
    private bool _isRefreshingAssetState;

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
        AuthStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await RefreshAssetStateAsync();
            StateHasChanged();
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _ = InvokeAsync(RefreshAssetStateAsync);
    }

    private void OnAuthenticationStateChanged(Task<AuthenticationState> authenticationStateTask)
    {
        _ = InvokeAsync(RefreshAssetStateAsync);
    }

    private async Task RefreshAssetStateAsync()
    {
        if (_isRefreshingAssetState)
            return;

        _isRefreshingAssetState = true;
        _isAssetStateLoading = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            if (authState.User?.Identity?.IsAuthenticated != true)
            {
                _assetBalanceCents = null;
                _assetAsOf = null;
                return;
            }

            var token = TokenStore.GetAccessToken();
            if (string.IsNullOrWhiteSpace(token))
            {
                token = await TokenStore.WaitForTokenAsync(TimeSpan.FromSeconds(3), CancellationToken.None);
            }

            if (string.IsNullOrWhiteSpace(token))
            {
                Logger.LogDebug("NavMenu: Economic state preview skipped because token is not ready.");
                _assetBalanceCents = null;
                _assetAsOf = null;
                return;
            }

            var asOf = DateOnly.FromDateTime(DateTime.Today);
            var state = await ReportsApi.GetEconomicStateAsync(asOf);
            _assetBalanceCents = state.AssetsTotalCents;
            _assetAsOf = state.AsOf;
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "NavMenu: Economic state preview unavailable.");
            _assetBalanceCents = null;
            _assetAsOf = null;
        }
        finally
        {
            _isAssetStateLoading = false;
            _isRefreshingAssetState = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private static string GetAmountClass(long cents)
    {
        return MoneyFormatter.GetColorClass(cents);
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        AuthStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }
}
