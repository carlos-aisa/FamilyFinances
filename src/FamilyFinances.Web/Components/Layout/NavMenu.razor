@using Microsoft.AspNetCore.Components.Authorization
@using FamilyFinances.Web.Components.Auth

@rendermode InteractiveServer

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">FamilyFinances</a>
    </div>
</div>  

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">

        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="accounts">
                        <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Accounts
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="payees">
                        <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Payees
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="transactions">
                        <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Transactions
                    </NavLink>
                </div>

                <div class="nav-item px-3 mt-2">
                    <LogoutButton />
                </div>
            </Authorized>

            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="login">
                        <span class="bi bi-box-arrow-in-right" aria-hidden="true"></span> Login
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>

    </nav>
</div>
