@using Microsoft.AspNetCore.Components.Authorization
@using FamilyFinances.Web.Components.Auth
@using FamilyFinances.Web.Api
@using FamilyFinances.Web.Auth
@using Microsoft.JSInterop
@using FamilyFinances.Web.Features.Reports
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject ReportsApi ReportsApi
@inject IApiTokenStore TokenStore
@inject AuthenticationStateProvider AuthStateProvider
@inject ILogger<NavMenu> Logger

@rendermode InteractiveServer
@implements IDisposable

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">FamilyFinances</a>
        <button type="button" class="btn btn-sm btn-outline-light" @onclick="ToggleTheme" title="Toggle theme">
            <i class="bi @(_isDarkMode ? "bi-sun" : "bi-moon")"></i>
        </button>
    </div>
</div>  

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">

        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                        <span class="bi bi-house-door me-2 align-middle" aria-hidden="true"></span>Home
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="accounts">
                        <span class="bi bi-wallet2 me-2 align-middle" aria-hidden="true"></span>Accounts
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="account-groups">
                        <span class="bi bi-collection me-2 align-middle" aria-hidden="true"></span>Account Groups
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="payees">
                        <span class="bi bi-person me-2 align-middle" aria-hidden="true"></span>Payees
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="transactions">
                        <span class="bi bi-receipt me-2 align-middle" aria-hidden="true"></span>Transactions
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="history">
                        <span class="bi bi-clock-history me-2 align-middle" aria-hidden="true"></span>History
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="reports">
                        <span class="bi bi-graph-up me-2 align-middle" aria-hidden="true"></span>Reports
                    </NavLink>
                </div>

                <div class="nav-item px-3 nav-economic-state">
                    <NavLink class="nav-link" href="reports/economic-state">
                        <span class="bi bi-piggy-bank me-2 align-middle" aria-hidden="true"></span>Economic State
                    </NavLink>
                    <div class="nav-economic-state-preview">
                        <small class="text-muted d-block">Asset Balance</small>
                        @if (_isAssetStateLoading && _assetBalanceCents is null)
                        {
                            <small class="text-muted">Loading...</small>
                        }
                        else if (_assetBalanceCents is not null)
                        {
                            <strong class="@GetAmountClass(_assetBalanceCents.Value)">
                                @MoneyFormatter.FormatCents(_assetBalanceCents.Value)
                            </strong>
                            @if (_assetAsOf is not null)
                            {
                                <small class="text-muted d-block">As of @_assetAsOf.Value.ToString("yyyy-MM-dd")</small>
                            }
                        }
                        else
                        {
                            <small class="text-muted">Unavailable</small>
                        }
                    </div>
                </div>

                <div class="nav-item px-3 mt-2">
                    <LogoutButton />
                </div>
            </Authorized>

            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="login">
                        <span class="bi bi-box-arrow-in-right me-2 align-middle" aria-hidden="true"></span>Login
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>

    </nav>
</div>

@code {
    private bool _isDarkMode = true;
    private long? _assetBalanceCents;
    private DateOnly? _assetAsOf;
    private bool _isAssetStateLoading;
    private bool _isRefreshingAssetState;

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
        AuthStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await Task.Delay(50); // Small delay to ensure JS is loaded
                var theme = await JS.InvokeAsync<string>("themeHelper.getTheme");
                _isDarkMode = theme == "dark";
                Logger.LogInformation("NavMenu: Initial theme is {Theme}, isDarkMode = {IsDark}", theme, _isDarkMode);
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "NavMenu: Error getting initial theme");
                _isDarkMode = true;
            }

            await RefreshAssetStateAsync();
            StateHasChanged();
        }
    }

    private async Task ToggleTheme()
    {
        try
        {
            Logger.LogInformation("NavMenu: Toggle theme clicked, current isDarkMode = {IsDark}", _isDarkMode);
            var newTheme = await JS.InvokeAsync<string>("themeHelper.toggleTheme");
            _isDarkMode = newTheme == "dark";
            Logger.LogInformation("NavMenu: Theme toggled to {Theme}, isDarkMode = {IsDark}", newTheme, _isDarkMode);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "NavMenu: Error toggling theme");
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _ = InvokeAsync(RefreshAssetStateAsync);
    }

    private void OnAuthenticationStateChanged(Task<AuthenticationState> authenticationStateTask)
    {
        _ = InvokeAsync(RefreshAssetStateAsync);
    }

    private async Task RefreshAssetStateAsync()
    {
        if (_isRefreshingAssetState)
            return;

        _isRefreshingAssetState = true;
        _isAssetStateLoading = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            if (authState.User?.Identity?.IsAuthenticated != true)
            {
                _assetBalanceCents = null;
                _assetAsOf = null;
                return;
            }

            var token = TokenStore.GetAccessToken();
            if (string.IsNullOrWhiteSpace(token))
            {
                token = await TokenStore.WaitForTokenAsync(TimeSpan.FromSeconds(3), CancellationToken.None);
            }

            if (string.IsNullOrWhiteSpace(token))
            {
                Logger.LogDebug("NavMenu: Economic state preview skipped because token is not ready.");
                _assetBalanceCents = null;
                _assetAsOf = null;
                return;
            }

            var asOf = DateOnly.FromDateTime(DateTime.Today);
            var state = await ReportsApi.GetEconomicStateAsync(asOf);
            _assetBalanceCents = state.AssetsTotalCents;
            _assetAsOf = state.AsOf;
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "NavMenu: Economic state preview unavailable.");
            _assetBalanceCents = null;
            _assetAsOf = null;
        }
        finally
        {
            _isAssetStateLoading = false;
            _isRefreshingAssetState = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private static string GetAmountClass(long cents)
    {
        return MoneyFormatter.GetColorClass(cents);
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        AuthStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }
}
