@using System.ComponentModel.DataAnnotations
@using FamilyFinances.Application.Ledger.Payees.Dtos
@using FamilyFinances.Application.Ledger.Payees.Requests
@using FamilyFinances.Web
@using FamilyFinances.Web.Api
@using FamilyFinances.Web.Components.Base
@using Microsoft.Extensions.Localization
@inject PayeesApi PayeesApi
@inject IStringLocalizer<SharedResource> L

<div class="payee-selector-container">
    <div class="d-flex gap-2 align-items-end">
        <div class="flex-grow-1">
            <label class="form-label">
                <i class="bi bi-person me-1"></i>@L["PayeeSelector_Label", IsRequired ? "*" : L["PayeeSelector_OptionalSuffix"].Value]
            </label>

            <InputSelect class="@GetSelectCssClass()"
                         TValue="Guid?"
                         Value="@SelectedPayeeId"
                         ValueExpression="@(() => SelectedPayeeId)"
                         ValueChanged="@(async (Guid? value) => { SelectedPayeeId = value; await SelectedPayeeIdChanged.InvokeAsync(value); })"
                         disabled="@IsDisabled">
                <option value="">@L["PayeeSelector_OptionSelect"]</option>
                @if (_payees is not null)
                {
                    @foreach (var payee in _payees.OrderBy(p => p.Name))
                    {
                        <option value="@payee.Id">@payee.Name</option>
                    }
                }
            </InputSelect>
            @if (!string.IsNullOrWhiteSpace(ValidationMessage))
            {
                <div class="invalid-feedback d-block">
                    @ValidationMessage
                </div>
            }
        </div>

        <button class="btn btn-outline-primary"
                type="button"
                @onclick="ToggleCreateForm"
                disabled="@IsDisabled"
                title="@L["PayeeSelector_CreateNew"]">
            <i class="bi bi-plus-circle"></i>
        </button>

        @if (_loadError is not null)
        {
            <button class="btn btn-outline-warning"
                    type="button"
                    @onclick="LoadPayeesAsync"
                    disabled="@_isBusy"
                    title="@L["PayeeSelector_RetryLoad"]">
                <i class="bi bi-arrow-clockwise"></i>
            </button>
        }
    </div>

    @if (_showCreateForm)
    {
        <div class="card border-primary mt-2 animate-slide-down">
            <div class="card-body p-3">
                <h6 class="card-title mb-3">
                    <i class="bi bi-person-plus me-2 text-primary"></i>@L["PayeeSelector_CreateTitle"]
                </h6>

                <EditForm Model="_createModel" OnValidSubmit="CreatePayeeAsync">
                    <DataAnnotationsValidator />

                    @if (!string.IsNullOrWhiteSpace(_createError))
                    {
                        <div class="alert alert-danger alert-dismissible fade show py-2 px-3 mb-3 small" role="alert">
                            <i class="bi bi-exclamation-triangle me-2"></i>@_createError
                            <button type="button" class="btn-close" @onclick="() => _createError = null" aria-label="@L["Common_Close"]"></button>
                        </div>
                    }

                    <div class="d-flex gap-2 align-items-start">
                        <div class="flex-grow-1">
                            <label class="form-label small mb-1">@L["PayeeSelector_NameRequired"]</label>
                            <InputText class="form-control form-control-sm"
                                       @bind-Value="_createModel.Name"
                                       placeholder="@L["PayeeSelector_NamePlaceholder"]"
                                       disabled="@_isBusy" />
                            <ValidationMessage For="@(() => _createModel.Name)" class="small" />
                        </div>

                        <div class="d-flex gap-1 pt-4">
                            <button class="btn btn-sm btn-success" type="submit" disabled="@_isBusy">
                                @if (_isBusy)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                }
                                else
                                {
                                    <i class="bi bi-check-circle me-1"></i>
                                }
                                @L["PayeeSelector_Create"]
                            </button>

                            <button class="btn btn-sm btn-outline-secondary"
                                    type="button"
                                    @onclick="CancelCreate"
                                    disabled="@_isBusy">
                                <i class="bi bi-x-circle me-1"></i>@L["PayeeSelector_Cancel"]
                            </button>
                        </div>
                    </div>
                </EditForm>
            </div>
        </div>
    }

    @if (_loadError is not null && !_showCreateForm)
    {
        <div class="alert alert-warning alert-dismissible fade show mt-2 py-2 px-3 small" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>
            @L["PayeeSelector_LoadFailed"] <button class="btn btn-link btn-sm p-0" @onclick="LoadPayeesAsync">@L["PayeeSelector_Retry"]</button>
            <button type="button" class="btn-close" @onclick="() => _loadError = null" aria-label="@L["Common_Close"]"></button>
        </div>
    }
</div>

<style>
    .animate-slide-down {
        animation: slideDown 0.3s ease-out;
    }

    @@keyframes slideDown {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

@code {
    [Parameter] public Guid? SelectedPayeeId { get; set; }

    [Parameter] public EventCallback<Guid?> SelectedPayeeIdChanged { get; set; }

    [Parameter] public bool IsRequired { get; set; }

    [Parameter] public bool IsDisabled { get; set; }

    [Parameter] public bool IsInvalid { get; set; }

    [Parameter] public string? ValidationMessage { get; set; }

    private IReadOnlyList<PayeeDto>? _payees;
    private bool _isBusy;
    private string? _loadError;
    private string? _createError;
    private bool _showCreateForm;
    private CreatePayeeFormModel _createModel = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadPayeesAsync();
    }

    private string GetSelectCssClass()
    {
        return IsInvalid ? "form-select is-invalid" : "form-select";
    }

    private async Task LoadPayeesAsync()
    {
        _loadError = null;
        _isBusy = true;

        try
        {
            _payees = await PayeesApi.ListAsync(CancellationToken.None);
        }
        catch (Exception ex)
        {
            _loadError = L["PayeeSelector_ErrorLoad", ex.Message];
            _payees = Array.Empty<PayeeDto>();
        }
        finally
        {
            _isBusy = false;
        }
    }

    private void ToggleCreateForm()
    {
        _showCreateForm = !_showCreateForm;
        _createError = null;

        if (_showCreateForm)
        {
            _createModel = new();
        }
    }

    private void CancelCreate()
    {
        _showCreateForm = false;
        _createError = null;
        _createModel = new();
    }

    private async Task CreatePayeeAsync()
    {
        if (_isBusy)
            return;

        _isBusy = true;
        _createError = null;

        try
        {
            var created = await PayeesApi.CreateAsync(
                new CreatePayeeRequest(_createModel.Name.Trim()),
                CancellationToken.None);

            await LoadPayeesAsync();

            SelectedPayeeId = created.Id;
            await SelectedPayeeIdChanged.InvokeAsync(SelectedPayeeId);

            _showCreateForm = false;
            _createModel = new();
        }
        catch (InvalidOperationException ex)
        {
            _createError = ex.Message;
        }
        catch (Exception ex)
        {
            _createError = L["PayeeSelector_ErrorUnexpected", ex.Message];
        }
        finally
        {
            _isBusy = false;
        }
    }

    private sealed class CreatePayeeFormModel
    {
        [Required]
        [StringLength(100, MinimumLength = 1)]
        public string Name { get; set; } = "";
    }
}
