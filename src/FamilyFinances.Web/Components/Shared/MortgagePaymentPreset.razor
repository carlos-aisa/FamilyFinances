@using System.ComponentModel.DataAnnotations
@using FamilyFinances.Application.Ledger.Accounts.Dtos
@using FamilyFinances.Domain.Ledger.Accounts
@using FamilyFinances.Web
@using FamilyFinances.Web.Features.Reports
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> L

<div class="card border-primary">
    <div class="card-header bg-primary text-white">
        <h6 class="mb-0">
            <i class="bi bi-house me-2"></i>@L["MortgagePreset_Title"]
        </h6>
    </div>
    <div class="card-body">
        <p class="small text-muted mb-3">
            @L["MortgagePreset_Subtitle"]
        </p>

        <EditForm Model="_model" OnValidSubmit="@(() => Task.CompletedTask)">
            <DataAnnotationsValidator />

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label small fw-semibold">
                        <i class="bi bi-calendar-event me-1"></i>@L["MortgagePreset_DateRequired"]
                    </label>
                    <InputDate class="form-control" @bind-Value="_model.BookedOn" @bind-Value:after="ValidateAndNotify" />
                </div>

                <div class="col-md-12">
                    <label class="form-label small fw-semibold">
                        <i class="bi bi-bank me-1"></i>@L["MortgagePreset_PaymentAccount"]
                    </label>
                    <select class="form-select" @bind="_model.PaymentAccountId" @bind:after="ValidateAndNotify">
                        <option value="">@L["MortgagePreset_SelectAccountOption"]</option>
                        @foreach (var account in Accounts.Where(a => a.Nature == AccountNature.Asset || a.Nature == AccountNature.Liability))
                        {
                            <option value="@account.Id">@account.Name (@GetNatureLabel(account.Nature))</option>
                        }
                    </select>
                </div>

                <div class="col-md-6">
                    <label class="form-label small fw-semibold">
                        <i class="bi bi-house-door me-1"></i>@L["MortgagePreset_MortgageAccount"]
                    </label>
                    <select class="form-select" @bind="_model.MortgagePrincipalAccountId" @bind:after="ValidateAndNotify">
                        <option value="">@L["MortgagePreset_SelectAccountOption"]</option>
                        @foreach (var account in Accounts.Where(a => a.Nature == AccountNature.Liability))
                        {
                            <option value="@account.Id">@account.Name</option>
                        }
                    </select>
                </div>

                <div class="col-md-6">
                    <label class="form-label small fw-semibold">
                        <i class="bi bi-percent me-1"></i>@L["MortgagePreset_InterestExpenseAccount"]
                    </label>
                    <select class="form-select" @bind="_model.InterestExpenseAccountId" @bind:after="ValidateAndNotify">
                        <option value="">@L["MortgagePreset_SelectAccountOption"]</option>
                        @foreach (var account in Accounts.Where(a => a.Nature == AccountNature.Expense))
                        {
                            <option value="@account.Id">@account.Name</option>
                        }
                    </select>
                </div>

                <div class="col-md-6">
                    <label class="form-label small fw-semibold">
                        <i class="bi bi-currency-euro me-1"></i>@L["MortgagePreset_PrincipalAmount"]
                    </label>
                    <input type="text" 
                           class="form-control" 
                           placeholder="@L["QuickEntryDrawer_AmountPlaceholder"]"
                           @bind="_principalText" 
                           @bind:event="oninput"
                           @bind:after="OnPrincipalChanged" />
                    <small class="text-muted">@L["MortgagePreset_PrincipalAmountHint"]</small>
                </div>

                <div class="col-md-6">
                    <label class="form-label small fw-semibold">
                        <i class="bi bi-currency-euro me-1"></i>@L["MortgagePreset_InterestAmount"]
                    </label>
                    <input type="text" 
                           class="form-control" 
                           placeholder="@L["QuickEntryDrawer_AmountPlaceholder"]"
                           @bind="_interestText" 
                           @bind:event="oninput"
                           @bind:after="OnInterestChanged" />
                    <small class="text-muted">@L["MortgagePreset_InterestAmountHint"]</small>
                </div>

                <div class="col-12">
                    <div class="alert @GetTotalAlertClass() mb-0" role="alert">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-semibold">@L["MortgagePreset_TotalPayment"]</span>
                            <span class="fs-5 fw-bold">@MoneyFormatter.FormatEuros(_model.PrincipalAmount + _model.InterestAmount)</span>
                        </div>
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(_validationMessage))
            {
                <div class="alert alert-warning mt-3 small mb-0" role="alert">
                    <i class="bi bi-exclamation-triangle me-1"></i>@_validationMessage
                </div>
            }
        </EditForm>

        <div class="mt-3 d-flex gap-2">
            <button class="btn btn-primary btn-sm" 
                    @onclick="ApplyPreset" 
                    disabled="@(!_isValid)">
                <i class="bi bi-check-circle me-1"></i>@L["MortgagePreset_Apply"]
            </button>
            <button class="btn btn-outline-secondary btn-sm" @onclick="Clear">
                <i class="bi bi-x-circle me-1"></i>@L["MultiSplitWidget_Clear"]
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<AccountDto> Accounts { get; set; } = Array.Empty<AccountDto>();
    [Parameter] public EventCallback<MortgagePresetModel> OnPresetApplied { get; set; }

    private PresetFormModel _model = new();
    private string _principalText = "";
    private string _interestText = "";
    private bool _isValid;
    private string? _validationMessage;

    private void OnPrincipalChanged()
    {
        var normalizedText = _principalText?.Replace(',', '.');
        
        if (decimal.TryParse(normalizedText,
                            System.Globalization.NumberStyles.AllowDecimalPoint | System.Globalization.NumberStyles.AllowLeadingSign,
                            System.Globalization.CultureInfo.InvariantCulture,
                            out var amount))
        {
            _model.PrincipalAmount = amount;
        }
        else
        {
            _model.PrincipalAmount = 0m;
        }
        ValidateAndNotify();
    }

    private void OnInterestChanged()
    {
        var normalizedText = _interestText?.Replace(',', '.');
        
        if (decimal.TryParse(normalizedText,
                            System.Globalization.NumberStyles.AllowDecimalPoint | System.Globalization.NumberStyles.AllowLeadingSign,
                            System.Globalization.CultureInfo.InvariantCulture,
                            out var amount))
        {
            _model.InterestAmount = amount;
        }
        else
        {
            _model.InterestAmount = 0m;
        }
        ValidateAndNotify();
    }

    private void ValidateAndNotify()
    {
        _validationMessage = null;
        _isValid = false;

        if (_model.PaymentAccountId == Guid.Empty)
        {
            _validationMessage = L["MortgagePreset_Validation_PaymentAccountRequired"];
            return;
        }

        if (_model.MortgagePrincipalAccountId == Guid.Empty)
        {
            _validationMessage = L["MortgagePreset_Validation_MortgageAccountRequired"];
            return;
        }

        if (_model.InterestExpenseAccountId == Guid.Empty)
        {
            _validationMessage = L["MortgagePreset_Validation_InterestAccountRequired"];
            return;
        }

        if (_model.PrincipalAmount <= 0)
        {
            _validationMessage = L["MortgagePreset_Validation_PrincipalGreaterThanZero"];
            return;
        }

        if (_model.InterestAmount <= 0)
        {
            _validationMessage = L["MortgagePreset_Validation_InterestGreaterThanZero"];
            return;
        }

        // All valid
        _isValid = true;
    }

    private async Task ApplyPreset()
    {
        if (!_isValid)
            return;

        var preset = new MortgagePresetModel
        {
            BookedOn = _model.BookedOn,
            PaymentAccountId = _model.PaymentAccountId,
            MortgagePrincipalAccountId = _model.MortgagePrincipalAccountId,
            InterestExpenseAccountId = _model.InterestExpenseAccountId,
            PrincipalAmount = _model.PrincipalAmount,
            InterestAmount = _model.InterestAmount
        };

        await OnPresetApplied.InvokeAsync(preset);
    }

    private void Clear()
    {
        _model = new PresetFormModel();
        _principalText = "";
        _interestText = "";
        _isValid = false;
        _validationMessage = null;
    }

    private string GetTotalAlertClass()
    {
        var total = _model.PrincipalAmount + _model.InterestAmount;
        return total > 0 ? "alert-info" : "alert-secondary";
    }

    private string GetNatureLabel(AccountNature nature)
    {
        return nature switch
        {
            AccountNature.Asset => L["Dashboard_Nature_Asset"],
            AccountNature.Liability => L["Dashboard_Nature_Liability"],
            AccountNature.Expense => L["Dashboard_Nature_Expense"],
            AccountNature.Income => L["Dashboard_Nature_Income"],
            AccountNature.Equity => L["Accounts_Nature_Equity"],
            _ => nature.ToString()
        };
    }

    private sealed class PresetFormModel
    {
        public DateOnly BookedOn { get; set; } = DateOnly.FromDateTime(DateTime.Today);
        public Guid PaymentAccountId { get; set; }
        public Guid MortgagePrincipalAccountId { get; set; }
        public Guid InterestExpenseAccountId { get; set; }
        public decimal PrincipalAmount { get; set; }
        public decimal InterestAmount { get; set; }
    }

    public sealed class MortgagePresetModel
    {
        public DateOnly BookedOn { get; set; }
        public Guid PaymentAccountId { get; set; }
        public Guid MortgagePrincipalAccountId { get; set; }
        public Guid InterestExpenseAccountId { get; set; }
        public decimal PrincipalAmount { get; set; }
        public decimal InterestAmount { get; set; }
    }
}
