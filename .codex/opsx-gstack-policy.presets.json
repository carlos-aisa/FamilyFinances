{
  "version": 1,
  "presets": {
    "ui-heavy": {
      "mode": "assist",
      "confirmation": {
        "enabled": true,
        "mode": "ask-per-invocation"
      },
      "allowlist": {
        "explore": [
          "gstack-plan-design-review",
          "gstack-plan-eng-review"
        ],
        "apply": [
          "gstack-review",
          "gstack-qa",
          "gstack-browse"
        ],
        "verify": [
          "gstack-review",
          "gstack-qa-only"
        ]
      },
      "notes": "Use browse for visual diagnostics only. Do not use browse as a strict gate."
    },
    "security-heavy": {
      "mode": "strict",
      "confirmation": {
        "enabled": true,
        "mode": "ask-per-invocation"
      },
      "allowlist": {
        "explore": [
          "gstack-plan-ceo-review",
          "gstack-plan-eng-review"
        ],
        "apply": [
          "gstack-review",
          "gstack-cso",
          "gstack-qa-only"
        ],
        "verify": [
          "gstack-review",
          "gstack-cso",
          "gstack-qa-only",
          "gstack-benchmark"
        ]
      },
      "strict": {
        "requiredVerifyGates": [
          "gstack-review",
          "gstack-cso"
        ]
      }
    },
    "backend-only": {
      "mode": "assist",
      "confirmation": {
        "enabled": true,
        "mode": "ask-per-invocation"
      },
      "allowlist": {
        "explore": [
          "gstack-plan-eng-review"
        ],
        "apply": [
          "gstack-review",
          "gstack-cso"
        ],
        "verify": [
          "gstack-review",
          "gstack-cso",
          "gstack-benchmark"
        ]
      }
    }
  }
}
